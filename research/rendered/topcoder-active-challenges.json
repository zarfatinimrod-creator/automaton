[{"id":"ce0647a1-e1d4-40ab-a9e3-92c5abdf0ddc","name":"Scan-to-3D Factory Layout Automation - POD to PRT Conversion PoC","description":"Creating a digital factory layout from a point-cloud scan is still a labor-intensive process. Engineers identify equipment and structures, find matching CAD library parts, and manually place and align them — repeating the same work across an entire building.\n\nThis Topcoder challenge explores how to automate that process. Build a proof of concept that converts industrial point-cloud scans (`.pod`) into native, editable Siemens NX assemblies (`.prt`), helping reduce manual engineering effort and making scan data more useful for factory planning.\n\nThe challenge brings together 3D point-cloud processing, computer vision, AI/ML, and CAD automation. If you enjoy solving spatial problems and turning real-world data into practical engineering tools, this is an opportunity to put those skills to work.\n\n**Register for the challenge to view the full specification.** Detailed requirements, technical resources, submission instructions, and evaluation criteria are available only after registration. Access to confidential project data also requires the applicable NDA and Topcoder confidentiality terms.","descriptionFormat":"markdown","projectId":1001494,"typeId":"927abff4-7af9-4145-8ba1-577c16e64e2e","trackId":"9b6fc876-f4d9-4ccb-9dfd-419247628825","timelineTemplateId":"7ebf1c69-f62f-4d3a-bdfb-fe9ddb56861c","numOfRegistrants":181,"numOfSubmissions":32,"numOfCheckpointSubmissions":0,"currentPhaseNames":["Review"],"wiproAllowed":false,"funChallenge":false,"tags":[],"groups":[],"submissionStartDate":"2026-09-07T12:17:24.500Z","submissionEndDate":"2026-09-21T12:17:24.754Z","registrationStartDate":"2026-09-07T12:17:24.502Z","registrationEndDate":"2026-09-21T12:18:00.011Z","startDate":"2026-09-07T12:17:24.500Z","endDate":"2026-09-21T16:17:59.967Z","status":"ACTIVE","approvalStatus":"APPROVED","approvalApprovedBy":"rnandagopal","createdBy":"22776011