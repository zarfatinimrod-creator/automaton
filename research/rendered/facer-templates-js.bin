latform: \'wff\'})">\n                            Wear OS (WFF)\n                        </a>\n                    </li>\n                    <li>\n                        <a ui-sref="facer.editor.community({platform: \'android\', targetPlatform: \'android\'})">\n                            Wear OS (Legacy)\n                        </a>\n                    </li>\n                    <li>\n                        <a ui-sref="facer.editor.community({platform: \'android\', targetPlatform: \'tizen\'})">\n                            Tizen\n                        </a>\n                    </li>\n                    <li ng-if="isAdmin()">\n                        <a ui-sref="facer.editor.community({platform: \'android\', targetPlatform: \'lpfe\'})">\n                            VEE Wear\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    <div class="dashboard-page-body">\n        <div class="dashboard-watchface-list">\n            <watchface-browser-item watchface="watchface" config="watchfaceItemConfig" ng-repeat="watchface in watchfaces"></watchface-browser-item>\n        </div>\n        <loader class="inspect-list-loader" ng-show="loading">\n        </loader>\n        <div ng-if="!loading && !done && watchfaces.length > 0" class="show-more-wrapper">\n            <div class="f-btn-rounded-primary" ng-click="loadMoreWatchfaces()">\n                Show More\n            </div>\n        </div>\n\n        <div ng-if="!loading && watchfaces.length == 0">\n            <div class="gray-header">No results</div>\n            <br><br>\n        </div>\n    </div>\n</div>')}]),e.exports=n},66340:e=>{var n="/html/watchface-edit-browser-my-designs.partial.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div id="myDesigns" class="dashboard-page">\n\n    <div ng-if="!loading && watchfaces.length > 0" class="dashboard-page-header">\n        <div class="dashboard-watchface-stats">\n            <div class="dashboard-watchface-stat">\n                <div class="dashboard-watchface-stat-label">\n                    Watch Faces\n                </div>\n                <div class="dashboard-watchface-stat-value">\n                    <span ng-show="loading">--</span>\n                    <span ng-hide="loading">{{getFilteredWatchfaceList(true).length|number}}</span>\n                </div>\n            </div>\n            <div class="dashboard-watchface-stat">\n                <div class="dashboard-watchface-stat-label">\n                    Total Syncs\n                </div>\n                <div class="dashboard-watchface-stat-value">\n                    <span ng-show="loading">--</span>\n                    <span ng-hide="loading">{{getTotalSyncs()|number}}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class="dashboard-watchface-list-filters">\n            <div class="dashboard-watchface-list-filter dashboard-watchface-list-filter--search form-group">\n                <input type="text" class="form-control search-bar" id="dashboardSearch" placeholder="Search titles and tags..." ng-change="onFilterChange()" ng-model="filters.text">\n            </div>\n            <div ng-repeat="dropdownFilter in filters.dropdowns" class="dashboard-watchface-list-filter dropdown" ng-class="{\'dashboard-watchface-list-filter--sort\': dropdownFilter.type == \'sort\'}">\n                <span class="dashboard-watchface-list-sort-label" ng-if="dropdownFilter.type == \'sort\'">Sort by</span>\n                <button class="btn btn-default dropdown-toggle" type="button" id="{{dropdownFilter.id}}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                    <span class="dashboard-watchface-list-filter-value" ng-class="{\'is-filtered\': dropdownFilterIsApplied(dropdownFilter)}">\n                        {{dropdownFilter.selected.label}}\n                    </span>\n                    <spa