tions)" ng-class="{\'rectangular-complication\': selectedIsRectangular()}" class="complication-select-panel-list-option">\n                    <div ng-click="updateComplicationDefault(complication, editor.selectedElement);updateSelectedElement()" class="complication-select-panel-list-option-preview" ng-class="{\n                            \'selected\': isSelectedDefault(complication, editor.selectedElement)\n                        }">\n                        \x3c!-- comp. list preview --\x3e\n                        <div class="complication-select-panel-list-option-preview-image-wrapper">\n                            <img ng-src="{{complication.getSrcForKey(getSelectedComplicationShapeKey())}}" class="complication-select-panel-list-option-preview-image"/>\n                        </div>\n                    </div>\n                    <small class="complication-select-panel-list-option-label">{{complication.displayName}}</small>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},95885:e=>{var n="/html/zoom-tool.component.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div class="watch-canvas-corner-tool-button-group">\n    <a class="watch-canvas-corner-tool-button watch-canvas-corner-tool-icon-button disabled" ng-click="zoomIn()" ng-class="{\'disabled\': !canZoomIn()}" ng-disabled="!canZoomIn()" title="Zoom In (Ctrl/Cmd +)">\n        <i class="icon-plus-1"></i>\n    </a>\n    <div class="dropup watch-canvas-corner-tool-dropdown">\n        <a id="zoomDropdown" class="watch-canvas-corner-tool-button double-width disabled" data-toggle="dropdown" type="button" ng-class="{\'disabled\': !zoomReady()}" ng-disabled="editor.loaded" aria-haspopup="true" aria-expanded="true" title="Zoom">\n            {{ getZoom() }}\n        </a>\n        <ul class="dropdown-menu text-center" role="menu" aria-labelledby="zoomDropdown">\n            <li ng-click="zoomTo(option.value)" ng-repeat="option in