entity watchface imported retool\')">\n                <span class="admin-hub__card-icon">\n                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 4.8 5.3.8-3.8 3.7.9 5.3L12 14.8 7.2 16.6l.9-5.3L4.3 7.6l5.3-.8z"></path></svg>\n                </span>\n                <span class="admin-hub__card-body">\n                    <span class="admin-hub__card-title">Brand Partners</span>\n                    <span class="admin-hub__card-desc">Browse brand partners and mark a user as a verified brand.</span>\n                </span>\n                <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n            </a>\n            </div>\n        </div>\n\n        <div class="admin-hub__subgroup" ng-show="matchesQuery(\'licensing license revenue split brand partner financial royalty model watchface compliance gdpr legal delete deletion takedown dmca exception infringement log privacy move transaction order subscription purchase transfer user imported retool requests data hard pending takedowns exceptions copyright moderation\')">\n            <h3 class="admin-hub__subgroup-title">Financial &amp; Compliance</h3>\n            <div class="admin-hub__grid">\n            <a ui-sref="facer.admin.licensing" class="admin-hub__card" ng-show="matchesQuery(\'licensing license revenue split brand partner financial royalty model watchface imported retool\')">\n                <span class="admin-hub__card-icon">\n                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>\n                </span>\n                <span class="admin-hub__card-body">\n                    <span class="admin-hub__card-title">Watchface Licensing</span>\n                    <span class="admin-hub__card-desc">Licensing models, revenue splits, and watchface license assignment.</span>\n                </span>\n                <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n            </a>\n\n            <a ui-sref="facer.admin.gdprRequests" class="admin-hub__card" ng-show="matchesQuery(\'gdpr requests legal delete deletion privacy user data hard delete pending imported retool\')">\n                <span class="admin-hub__card-icon">\n                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="17" y1="8" x2="23" y2="14"></line><line x1="23" y1="8" x2="17" y2="14"></line></svg>\n                </span>\n                <span class="admin-hub__card-body">\n                    <span class="admin-hub__card-title">GDPR Requests</span>\n                    <span class="admin-hub__card-desc">Look up a user, review their data footprint, and process a permanent deletion.</span>\n                </span>\n                <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n            </a>\n            <a ui-sref="facer.admin.takedowns" class="admin-hub__card" ng-show="matchesQuery(\'takedown takedowns dmca exception exceptions infringement log legal copyright moderation imported retool\')">\n                <span class="admin-hub__card-icon">\n                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>\n                </span>\n                <span class="admin-hub__card-body">\n                    <span class="admin-hub__card-title">Takedowns</span>\n                    <span class="admin-hub__card-desc">Manage takedown exceptions and browse the infringement log.</span>\n                </span>\n                <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n            </a>\n            <a ui-sref="facer.admin.moveTransaction" class="admin-hub__card" ng-show="matchesQuery(\'move transaction order subscription purchase transfer user financial imported retool\')">\n                <span class="admin-hub__card-icon">\n                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>\n                </span>\n                <span class="admin-hub__card-body">\n                    <span class="admin-hub__card-title">Move Transaction</span>\n                    <span class="admin-hub__card-desc">Move a purchase or subscription from one user to another.</span>\n                </span>\n                <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n            </a>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},99110:e=>{var n="/html/admin/admin-watchface-stats.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<debug-info ng-if="$root.toggleAdminWatchfaceStats" data="getDebugStats()" class="nested small" type="list"></debug-info>\n')}]),e.exports=n},95670:e=>{var n="/html/admin/admin.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container-fluid admin-container">\n    <div ui-view="admin"></div>\n</div>\n')}]),e.exports=n},81277:e=>{var n="/html/admin/collection.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="panel panel-default">\n    <div class="panel-heading">\n        <h3>\n            {{collection.adminListName}}\n            <small ng-if="option!==\'archive\'"><small>\n                    &nbsp;\n                    <a ng-if="collection.status == \'pre-live\'" ui-sref="facer.collection({collection: collection.slug, preLive: true})" class="text-link" target="_blank">VIEW PRE-LIVE</a>\n                    &nbsp;&nbsp;\n                    <a ng-if="collection.status == \'live\'" ui-sref="facer.collection({collection: collection.slug, preLive: false})" class="text-link" target="_blank">VIEW LIVE</a>\n                    &nbsp;&nbsp;\n                    \x3c!--<a ng-if="!collection.hasStaging && collection.checkedForStaging" ng-click="createStagingCollection()" class="text-link">CREATE STAGING VERSION</a>\n                <a ng-if="!collection.checkedForStaging">Checking for staging collection...</a>\n                &nbsp;&nbsp;--\x3e\n                    <a ng-if="collection.status == \'pre-live\'" ng-click="editCollection(collection)" class="text-link">EDIT</a>\n                    &nbsp;&nbsp;\n                    <a ng-if="collection.status == \'pre-live\'" ng-click="smartSortCollection(collection)" class="text-link">SMART SORT</a>\n                    &nbsp;&nbsp;\n                    <a ng-if="collection.status == \'pre-live\'" ng-click="trimCollection(collection)" class="text-link">TRIM</a>\n                    &nbsp;&nbsp;\n                    <a ng-if="collection.status == \'pre-live\'" ng-if="linkedStoreSectionCount(collection) == 0" ng-click="deleteCollection(collection)" class="text-link">\n                        {{ option==\'live\' ? \'ARCHIVE\' : \'DELETE\' }}\n                    </a>\n                    <span ng-if="linkedStoreSectionCount(collection) > 0">\n                        Linked to {{linkedStoreSectionCount(collection)}} store\n                        <ng-pluralize count="linkedStoreSectionCount(collection)" when="{\'1\': \'section\', \'other\': \'sections\'}"></ng-pluralize>\n                    </span> </small></small>\n        </h3>\n    </div>\n    \x3c!-- Table --\x3e\n    <table class="table">\n        <thead>\n            <tr>\n                <th class="col-md-1">Status</th>\n                <th ng-if="option==\'staging\'" class="col-md-1">Is ready</th>\n                <th ng-if="option!==\'staging\'" class="col-md-2" ng-class="{\'success\': isNewlyPublished(collection)}">\n                    Published At\n                </th>\n                <th class="col-md-2" ng-class="{\'info\': isNewlyCreated(collection)}">\n                    Created At\n                </th>\n                <th ng-if="option==\'archive\'" class="col-md-2">Archived At</th>\n                <th class="col-md-1">Platform</th>\n                <th class="col-md-6">Description</th>\n                <th class="col-md-2">\n                    Hero Image\n                    <small ng-if="option==\'staging\'" ng-click="triggerHeroUpdate()" class="hide-file-input text-link">CHANGE<input id="collection_{{collection.id}}" type="file" upload="{{collection.id}} hero"/></small>\n                </th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <th>{{collection.status|uppercase}}</th>\n                <td ng-if="option==\'staging\'">\n                    <span ng-show="collection.isPublishable()" class="green-text"><b>YES</b></span>\n                    <span ng-show="!collection.isPublishable()" class="red-text"><b>NO</b></span>\n                </td>\n                <td ng-if="option!==\'staging\'" ng-class="{\'success\': isNewlyPublished(collection)}">\n                    {{collection.publishedAt|date:\'medium\'}}\n                </td>\n                <td ng-class="{\'info\': isNewlyCreated(collection)}">\n                    {{collection.createdAt|date:\'medium\'}}\n                </td>\n                <td ng-if="option==\'archive\'">\n                    {{collection.archivedAt|date:\'medium\'}}\n                </td>\n                <td>{{collection.platform_type}}</td>\n                <td>{{collection.description}}</td>\n                <td>\n                    <img ng-src="{{collection.hero}}" width="150"/>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    <div class="panel-body">\n        <a ng-show="collection.watchfacesFetched" href ng-click="showWatchfaces=!showWatchfaces" class="text-link small">\n            {{ showWatchfaces ? \'hide\' : \'show\' }} {{\n            collection.watchfaces.length }} watchfaces\n        </a>\n        <span ng-show="!collection.watchfacesFetched" class="small">Loading watchfaces...</span>\n    </div>\n\n    <div ng-if="showWatchfaces" class="draggable-table">\n        <table class="table">\n            <thead>\n                <tr>\n                    <th ng-if="collection.status == \'pre-live\'" class="col-md-1"></th>\n                    <th class="col-md-1">#</th>\n                    <th class="col-md-1">Live</th>\n                    <th class="col-md-2">ID</th>\n                    <th class="col-md-1">$</th>\n                    <th class="col-md-1">Preview</th>\n                    <th class="col-md-2">Name</th>\n                    <th class="col-md-2">Author</th>\n                    <th class="col-md-6">Description</th>\n                    <th class="col-md-1"></th>\n                </tr>\n            </thead>\n        </table>\n        <ul dnd-list="collection.watchfaces\'" dnd-drop="updateProducts(item, index, true);" dnd-allowed-types="[collection.id]" dnd-disable-if="collection.status !== \'pre-live\'">\n            <li ng-repeat="watchface in collection.watchfaces" dnd-draggable="watchface" dnd-effect-allowed="move" dnd-type="collection.id" dnd-disable-if="collection.loading || collection.status !== \'pre-live\'" ng-class="{\'info\': collection.watchfaceIsNew(watchface)}">\n                <table class="table">\n                    <tbody>\n                        <tr>\n                            <th ng-if="collection.status == \'pre-live\'" class="col-md-1 handle inline-row-tools" ng-class="{\'disabled\': collection.loading}">\n                                <span class="vertical-arrow-toggle inline-row-tool">\n                                    <i class="icon-grab-dots"></i>\n                                </span>\n                                <span class="vertical-arrow-toggle inline-row-tool">\n                                    <div ng-click="moveToTop(watchface)">\n                                        <i class="icon-angle-double-up"></i>\n                                    </div>\n                                    <div class="upside-down" ng-click="moveToBottom(watchface)">\n                                        <i class="icon-angle-double-up"></i>\n                                    </div>\n                                </span>\n                                <span class="vertical-arrow-toggle inline-row-tool">\n                                    <div ng-click="moveUp(watchface, $index)">\n                                        <i class="icon-angle-up"></i>\n                                    </div>\n                                    <div class="upside-down" ng-click="moveDown(watchface, $index)">\n                                        <i class="icon-angle-up"></i>\n                                    </div>\n                                </span>\n                            </th>\n                            <th ng-if="collection.status == \'pre-live\'" class="col-md-1 inline-row-tools">\n                                <span class="inline-row-tool">\n                                    <input type="number" min="0" class="square" ng-model="$index" ng-blur="updateProducts(watchface, $index)"/>\n                                </span>\n                            </th>\n                            <th ng-if="collection.status !== \'pre-live\'" class="col-md-1 inline-row-tools">\n                                {{$index}}\n                            </th>\n                            <th class="col-md-1">\n                                <span ng-show="watchface.isLive()" class="green-text">YES</span>\n                                <span ng-show="!watchface.isLive()" class="red-text">NO</span>\n                            </th>\n                            <td class="col-md-2">\n                                <a ui-sref="facer.watchface({\'watchface\': watchface.id})" class="text-link">{{watchface.id}}</a>\n                            </td>\n                            <th class="col-md-1">\n                                <span ng-show="watchface.isPremium" class="green-text">YES</span>\n                                <span ng-show="!watchface.isPremium" class="red-text">NO</span>\n                            </th>\n                            <td class="col-md-1">\n                                <img ng-src="{{watchface.image}}" width="30" height="30"/>\n                            </td>\n                            <td class="col-md-2">{{watchface.title}}</td>\n                            <td class="col-md-2">\n                                <a user-profile-link="watchface.author" class="text-link">{{watchface.author.name}}</a>\n                            </td>\n                            <td class="col-md-6" ellipsis="20">\n                                {{watchface.description}}\n                            </td>\n                            <td ng-if="option==\'staging\'" class="col-md-6" ng-class="{\'disabled\': collection.loading}">\n                                <i class="icon-close" ng-click="updateProducts(watchface, -1)"></i>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </li>\n            <li class="dndPlaceholder"></li>\n        </ul>\n    </div>\n</div>\n')}]),e.exports=n},52536:e=>{var n="/html/admin/flash-sale-pushes.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<admin-page page-title="Flash Sale Pushes">\n    <a ui-sref="facer.admin.flashSales" class="text-link">Back to Flash Sale Page</a>\n\n    <h1>Flash Sale Pushes</h1>\n\n    <table class="table">\n        <thead>\n            <tr>\n                <th class="col-md-1">Date</th>\n                <th class="col-md-3 text-center">Query</th>\n                <th class="col-md-4 text-center">Content</th>\n                <th class="col-md-1">Count</th>\n                <th class="col-md-1">Sent</th>\n                <th class="col-md-1">Failed</th>\n                <th class="col-md-1">Status</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat="pushStatus in pushStatuses">\n                <th>{{pushStatus.date.toDate()|date:\'short\'}}</th>\n                <td class="col-md-4 text-center" title="{{pushStatus.timezones}}">\n                    {{pushStatus.timezones.join(\', \').slice(0, 50)}}\n                </td>\n                <td class="col-md-4 text-center" title="{{pushStatus.message}}">\n                    {{pushStatus.message.slice(0, 50)}}\n                </td>\n                <td>{{pushStatus.count}}</td>\n                <td>{{pushStatus.numSent}}</td>\n                <td>{{pushStatus.numFailed}}</td>\n                <td>{{pushStatus.status}}</td>\n            </tr>\n        </tbody>\n    </table>\n</admin-page>\n')}]),e.exports=n},45382:e=>{var n="/html/admin/flash-sales.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<admin-page page-title="Flash Sales">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n\n    <h1>\n        Flash Sale Schedule\n        <button ng-click="createFlashSale()" class="btn btn-primary pull-right">\n            Create Flash Sale\n        </button>\n    </h1>\n\n    <table class="table">\n        <thead>\n            <tr>\n                <th class="col-md-1">#</th>\n                <th class="col-md-1 text-center">Alert</th>\n                <th class="col-md-1 text-center">Active</th>\n                <th class="col-md-1 text-center">Email Sent</th>\n                <th class="col-md-1 text-center">Pushes Sent</th>\n\n                <th class="col-md-1">Start</th>\n                <th class="col-md-1">End</th>\n                <th class="col-md-1">Duration</th>\n                <th class="col-md-">Collection</th>\n                <th class="col-md-1">Options</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat="sale in flashSales" class="admin-flash-sale" ng-class="{\'flash-sale-gap\': sale.isGapPlaceholder()}">\n                <th>{{$index+1}}</th>\n                <td>\n                    <div ng-show="sale.issues.length" class="sale-alert" tooltip tooltip-title="sale.getIssueTooltipContent()">\n                        <i class="icon-exclamation"></i>\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="sale.isActive" class="sale-active">\n                        <i class="icon-checkmark"></i>\n                    </div>\n                </td>\n                <td class="col-md-1 text-center">\n                    <div ng-show="sale.emailDelivered" class="sale-active">\n                        <i class="icon-checkmark"></i>\n                    </div>\n                </td>\n                <th class="col-md-1 text-center" title="{{sale.pushesSentTooltip}}">\n                    {{sale.pushesDelivered|number}}\n                </th>\n                <td>{{sale.startDate.toDate()|date:\'short\'}}</td>\n                <td>{{sale.endDate.toDate()|date:\'short\'}}</td>\n                <td>{{sale.duration}} days</td>\n                <td>\n                    <span ng-show="!sale.collection">{{sale.name}}</span>\n                    <a ui-sref="facer.collection({\n\t            \t\t\tcollection: sale.collection.slug,\n\t            \t\t\tpreLive: sale.collection.status == \'pre-live\'\n\t            \t\t})" target="_blank" class="text-link" ng-show="sale.collection">\n                        {{sale.collection.name}}\n                    </a>\n                </td>\n                <td class="col-md-2">\n                    <button ng-if="!sale.isGapPlaceholder()" class="btn btn-default" ng-class="{\'disabled\': !sale.loaded}" ng-click="sale.edit()">\n                        <i class="icon-pencil"></i>\n                    </button>\n                    <button ng-if="!sale.isGapPlaceholder()" class="btn btn-default" ng-class="{\'disabled\': !sale.loaded}" ng-click="sale.testMarketing()">\n                        <i class="icon-phone"></i>\n                    </button>\n                    <button ng-if="!sale.isGapPlaceholder()" class="btn btn-default" ng-class="{\'disabled\': !sale.loaded}" ng-click="sale.delete()">\n                        <i class="icon-close"></i>\n                    </button>\n                    <button ng-if="sale.isGapPlaceholder()" class="btn btn-default" ng-click="createFlashSale(sale.startDate)">\n                        Fix\n                    </button>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</admin-page>\n')}]),e.exports=n},76444:e=>{var n="/html/admin/premium.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n    <h2>Premium watchface submissions</h2>\n    <div id="watchface-list" class="row">\n        <div ng-show="watchfaces" class="fade" admin-watchfaces="watchfaces"></div>\n        <loader ng-if="loading"/>\n        <endless margin="0" trigger="loadMoreWatchfaces()" end-on="done"/>\n    </div>\n</div>\n')}]),e.exports=n},54667:e=>{var n="/html/admin/qa.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<admin-header page-title="{{pageConfig.title}}">\n    <h4>\n        {{count}} Left &nbsp;<i class="icon-refresh text-link" ng-click="refresh()"></i>\n        &nbsp;<small><a select-all href="#" class="text-link">SELECT ALL</a></small>\n    </h4>\n    <div class="m-t-md text-center">\n        <div class="d-inline-block" style="padding: 16px 20px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;">\n            <div class="m-b-sm"><strong>User Filter</strong></div>\n            <input type="text" class="form-control d-inline-block" style="width: 260px" ng-model="filters.userId" ng-model-options="{ debounce: 300 }" ng-change="filters.userId && filters.userId.trim() && applyUserFilter()" placeholder="Filter by user id or display name"/>\n            <select class="form-control d-inline-block m-l-sm" style="width: 180px" ng-model="filters.userFilterMode" ng-options="option.value as option.label for option in userFilterModeOptions" ng-change="applyUserFilter()"></select>\n        </div>\n    </div>\n</admin-header>\n\n<watchface-list watchfaces="watchfaces" collections="collections" type="qa"></watchface-list>\n')}]),e.exports=n},4237:e=>{var n="/html/admin/review.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n