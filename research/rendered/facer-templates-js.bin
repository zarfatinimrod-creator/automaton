img/landing/appstores/btn_appstore.png\')}}" alt="Download Facer from the App Store"/>\n                    </a>\n\n                    <button ng-if="shouldShowManualClose()" type="button" class="home-download-sheet__close text-link" ng-click="closePlatformOptions()">\n                        Close\n                    </button>\n                </div>\n\n                <div ng-switch-when="android" class="home-download-sheet__platform-options">\n                    <a class="home-download-sheet__store-button home-download-sheet__store-button--google-play" app-link="android" app-link-placement="{{ androidAppLinkPlacement }}" href target="_blank">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/landing/appstores/btn_gplay.png\')}}" alt="Get it on Google Play"/>\n                    </a>\n\n                    <button ng-if="shouldShowManualClose()" type="button" class="home-download-sheet__close text-link" ng-click="closePlatformOptions()">\n                        Close\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},60173:e=>{var n="/components/looks/looks-card/looks-card.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<article ng-class="getCardClass()">\n    <div class="looks-media-protection">\n        <img class="looks-media-protection__media" ng-class="getMediaClass()" ng-if="\n                (!look.media.isAnimated && !isRelatedLayout()) ||\n                (isRelatedLayout() && getRelatedPosterUrl())\n            " ng-src="{{\n                isRelatedLayout() ? getRelatedPosterUrl() : look.media.url\n            }}" alt="{{ look.watchfaceTitle }}" draggable="false"/>\n\n        <video class="looks-media-protection__media" ng-class="getMediaClass()" ng-if="look.media.isAnimated && !isRelatedLayout()" autoplay muted loop playsinline disablepictureinpicture disableremoteplayback controlslist="nodownload nop