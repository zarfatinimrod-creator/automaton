as id="watchface1"></canvas>\n    </div>\n    <div ng-clic="display.increment()" class="presentation-view" ng-class="{\'faded-out\': !display.featureOverride}">\n        <canvas id="watchfaceFeatureOverride"></canvas>\n    </div>\n    <div ng-if="!display.initialized && false" class="fade-in-out loader-wrapper">\n        <div class="loader">\n            <i class="icon-refresh"></i>\n        </div>\n    </div>\n\n    <button ng-if="currentUser()" ng-click="syncWatchface()" class="sync-button btn btn-lg btn-default">\n        <i class="icon-pushtowatch"></i>\n        Send to my watch\n    </button>\n    <a app-link="android" app-link-placement="collection_fullscreen" class="sync-button" ng-if="!currentUser()" href target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/get-it-on-android.png\')}}"/></a>\n\n    <div ng-if="!display.loading && display.faceOnScreen()" class="fullscreen-watchface-name">\n        <a ng-href="watchface/{{display.faceOnScreen().watchface.id}}" target="_blank">\n            <h3>{{display.faceOnScreen().watchface.get(\'title\')}}</h3>\n        </a>\n    </div>\n</div>\n')}]),e.exports=n},14336:e=>{var n="/html/collection.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div>\n    <admin-collection ng-if="isList()" collection="collection"></admin-collection>\n    <div ng-if="isGrid()" class="collection-grid-item">\n        <a ng-href="{{ collection.getUrl() }}" class="hero-image" style="background: linear-gradient(130deg, rgba({{\n                collection.rgb[0].r\n            }},{{ collection.rgb[0].g }},{{\n                collection.rgb[0].b\n            }},1) 0%, rgba({{ collection.rgb[1].r }},{{\n                collection.rgb[1].g\n            }},{{ collection.rgb[1].b }},1) 100%);" ng-class="{ \'banner-bg\': collection.hero }">\n            <img class="hero" title="{{ collection.name }}" alt="{{ collection.name | collectionHeroAlt }}" ng-src="{{ collection.hero || facerStaticAssetUrl