eed == 60}">\n                <i class="icon-forward-2x"></i>\n            </div>\n            <div ng-click="runAt(3600)" class="time-reset play-button play-button-3x" ng-class="{\'active\': editor.quartz && editor.options.speed == 3600}">\n                <i class="icon-forward-3x"></i>\n            </div>\n\n        </div>\n    </div>\n\n    <div id="timeMachineDisplay" class="time-machine-section">\n        <div id="timeMachineTitle" ng-class="{\'running pulse\': editor.quartz}">\n            Time Machine <span ng-click="stop(true)" class="time-machine-reset"><i class="icon-reset"></i></span>\n            <br>\n            <span id="currentTimeValue">\n                00:00:00 PM\n            </span>\n        </div>\n\n        <div id="dateInputWrapper">\n            <div id="dateInput">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/calendar.png?v=2\')}}"/>\n                <span>\n                    {{moment(editor.options.time).format(\'M/D\')}}\n                </span>\n            </div>\n        </div>\n\n        <input date-picker="timeMachineDateInput" id="timeMachineDateInput" ng-model="editor.options.time" date-input>\n    </div>\n\n    <div ng-show="!isExtraCompactCanvas" title="Timeline" class="timeline time-machine-section">\n        <div id="currentTimeSliderWrapper">\n            <div class="slider-input-scale slider-input-scale-top">\n                <i class="icon-night"></i>\n                <i class="icon-daytime"></i>\n                <i class="icon-night"></i>\n            </div>\n            <div>\n                <input id="currentTimeSlider" type="range" min="{{slider.min}}" max="{{slider.max}}" range-time ng-model="editor.options.time" class="slider-input"/>\n            </div>\n            <div class="slider-input-scale slider-input-scale-bottom">\n                <span>MIDNIGHT</span>\n                <span>NOON</span>\n                <span>MIDNIGHT</span>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div id