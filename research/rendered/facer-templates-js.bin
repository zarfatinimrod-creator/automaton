-offset-3">\n            <img class="facer-header" ng-src="{{facerStaticAssetUrl(\'/img/facer.png\')}}"/>\n\n            <div id="signup_container">\n                <div class="panel panel-default">\n                    <div class="panel-body">\n                        <div>\n                            <h4 class="text-center">\n                                Claim your watchface from MWC 2017!\n                            </h4>\n                        </div>\n\n                        <form id="signup-form" ng-submit="claimGoogleIoWatchface()" novalidate>\n                            <center>\n                                <div class="form-group">\n                                    <input name="claimCode" class="form-control" id="claimCode" placeholder="Enter your claim code..." ng-model="claimForm.claimCode" maxlength="30" required/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n\n                                <button id="signup-button" type="submit" class="btn btn-default btn-primary btn-lg" disable>\n                                    Claim my watchface!\n                                </button>\n                            </center>\n\n                            <div ng-if="claimForm.error" class="alert alert-danger margin-top no-margin-bottom">\n                                {{claimForm.error}}\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},88502:e=>{var n="/html/grid-watchface.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="grid-watchface-wrapper" ng-class="{\n\t\t\'selected\': watchface.selected,\n\t\t\'options-only\': isOptionsList(),\n\t\t\'premium\': watchface.isPremium\n\t}">\n    <label class="batch-select">\n        <input id="select{{watchface.id}}" type="checkbox