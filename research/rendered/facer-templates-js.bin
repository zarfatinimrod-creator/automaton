2.76 1.222-2.76 2.73v1.864c0 1.508 1.268 2.79 2.76 2.79h1.843c1.492 0 2.7-1.163 2.759-2.613v-2.1M11.361 15.298v-.06c-.058-1.449-1.267-2.612-2.759-2.612H6.76C5.21 12.626 4 13.848 4 15.356v1.864c0 1.508 1.268 2.79 2.76 2.79h1.842c1.492 0 2.7-1.163 2.76-2.613v-2.1M20 15.298v-.06c-.058-1.449-1.267-2.612-2.76-2.612h-1.842c-1.55 0-2.76 1.222-2.76 2.73v1.864c0 1.508 1.268 2.79 2.76 2.79h1.843c1.492 0 2.7-1.163 2.759-2.613v-2.1"/>\n    </g>\n    <defs>\n        <clipPath id="design-clip">\n            <path fill="#fff" d="M4 4h16v16H4z"/>\n        </clipPath>\n    </defs>\n</svg>\n\n<svg ng-switch-when="send" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">\n    <path fill="#424242" d="M5.4 19.425a.99.99 0 0 1-.95-.088Q4 19.051 4 18.5V14l8-2-8-2V5.5q0-.55.45-.838a.99.99 0 0 1 .95-.087l15.4 6.5q.625.275.625.925t-.625.925z"/>\n</svg>\n\n<svg ng-switch-when="arrow-pills-right" xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none">\n    <path fill="#424242" d="M13.125 20.375a.63.63 0 0 1-.437-.172.59.59 0 0 1-.188-.453v-9.5q0-.281.188-.453a.63.63 0 0 1 .437-.172q.063 0 .438.188l4.53 4.53a1 1 0 0 1 .22.313.9.9 0 0 1 .062.344q0 .188-.062.344a1 1 0 0 1-.22.312l-4.53 4.531a.588.588 0 0 1-.437.188"/>\n</svg>\n</span>\n')}]),e.exports=n},25512:e=>{var n="/html/about.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h1>Facer is the #1 premium watchface designer for Android Wear</h1>\n    With thousands of Free watchfaces available to users and powerful design &\n    editing tools, the possibilities are endless.\n\n    <h2>Reviews</h2>\n\n    <ul>\n        <li>\n            “The De Facto Custom Watch Face Maker For Android Wear” ­- Android\n            Police\n        </li>\n        <li>\n            “Facer allows you to create anything you can imagine” ­- Phandroid\n        </li>\n        <li>“Essentially the Zooper of watch faces” ­- Android Headlines</li>\n    </ul>\n\n    <h2>Tons of Watch Faces</h2>\n    Thousands of free watch faces are available to Facer users today, with new\n    ones added daily. Download as many as you like and build your personal\n    collection\n\n    <h2>Design & Remix</h2>\n    Facer’s built-in editing tools allows you to edit & remix existing watch\n    faces or design your own unique creation from scratch.\n\n    <h2>Editing Features Include</h2>\n\n    <ul>\n        <li>Import images & custom fonts</li>\n        <li>Multiple time formats: analog, digital & text</li>\n        <li>Numerous Date Layouts</li>\n        <li>Weather Conditions with Fahrenheit and Celsius support</li>\n        <li>Dynamic Watchface Backgrounds</li>\n        <li>Battery Level</li>\n        <li>Step Counter</li>\n    </ul>\n\n    <h2>Sharing</h2>\n    Facer’s sharing features allow you to post images of your watch face, making\n    it easier than ever to show off your design skills.\n\n    <h2>Supported Devices</h2>\n    Facer supports all Android Wear smartwatches, including Asus Zen Watch, LG G\n    Watch, LG G Watch R, Motorola Moto 360, Samsung Gear Live and the Sony\n    Smartwatch 3.\n\n    <b>#GetFacer</b> today, one of the must haves for Android Wear users. Facer.\n    Think it. Build it. Wear it. Share it.\n</div>')}]),e.exports=n},47351:e=>{var n="/html/abtw-submissions.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h2>ABTW Contest Submissions</h2>\n    <div id="watchface-list" class="row">\n        <div id="watchface-list" class="row" ui-view="watchfaces"></div>\n        <endless margin="0" trigger="loadMoreWatchfaces()" end-on="done"/>\n    </div>\n</div>\n')}]),e.exports=n},22595:e=>{var n="/html/abtw.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container abtw">\n    <div class="text-center" style="margin-bottom: 2em">\n        <img width="100%" ng-src="{{facerStaticAssetUrl(\'/img/abtw/contestbanner.jpg\')}}"/>\n\n        <h1>\n            <b style="font-size: 125%"> DEADLINE EXTENDED TO MARCH 23rd !!! </b>\n        </h1>\n\n        <hr/>\n\n        <h1>Watch Face Design Competition</h1>\n        <h2>\n            Create awesome watch faces for the Samsung Gear S3 with Facer &\n            aBlogtoWatch\n        </h2>\n    </div>\n    <p>\n        In collaboration with\n        <a class="text-link" href="http://www.samsung.com/us/mobile/wearables/">Samsung Mobile</a>\n        and\n        <a class="text-link" href="http://www.ablogtowatch.com/">aBlogtoWatch</a>, we are proud to announce a watch face design competition for the\n        groundbreaking <b>Samsung Gear S3</b> smartwatch.\n    </p>\n\n    <p>\n        Facer and ABTW are truly excited about the capabilities of the Samsung\n        Gear S3 and its "always-on" display, which unlike most other\n        smartwatches is capable of offering rich, full-color, and animated watch\n        faces without needing to switch to an "off-state" through the day to\n        preserve battery. Thanks to this technological breakthrough, the Gear\n        S3\'s watch face is visible all day long by the wearer and onlookers and\n        makes this device the first true "digital fashion" piece. You can read\n        all about the Gear S3 in\n        <a class="text-link" href="http://www.ablogtowatch.com/samsung-gear-s3-frontier-classic-smartwatch-debut/">ABTW\'s hands-on review.</a>\n    </p>\n\n    <hr/>\n\n    <h2>The Contest: Design The Best Digital Face For the Samsung Gear S3</h2>\n\n    <p>\n        From now until March 23rd, 2017 aBlogtoWatch and Facer invite watch\n        afficionados, designers, and developers to submit watch face designs for\n        the Samsung Gear S3 on the Facer platform. A panel composed of high-end\n        watch designers and industry experts will review and evaluate the\n        submissions based on their quality, creativity, and innovative use of\n        the smartwatch platform and select a total of 5 winners who will be\n        publicly announced at the end of March.\n    </p>\n\n    <hr/>\n\n    <h2>Jury</h2>\n    <ul>\n        <li>\n            Yvan Arpa: Swiss watch creator, and designer of the Samsung Gear S3\n        </li>\n        <li>Ariel Adams: Founder of aBlogtoWatch</li>\n        <li>Ariel Vardi: Co-Founder of Little Labs, makers of Facer</li>\n    </ul>\n\n    And that\'s not all! Additional jury members will be announced throughout the\n    month.\n\n    <hr/>\n\n    <h2>Prizes</h2>\n\n    The jury will select 1 winning design among 5 finalists who will receive the\n    following prizes:\n    <br/>\n\n    <h3>For the winning design</h3>\n    <ul>\n        <li>$500 cash for the best design selected in the 5 finalists</li>\n    </ul>\n\n    <h3 style="margin-top: 1.5em">For all 5 finalists</h3>\n    <ul>\n        <li>A Samsung Gear S3 smartwatch</li>\n        <li>\n            Designs featured in aBlogtoWatch.com, the Facer platform, and\n            Samsung\'s social channels\n        </li>\n        <li>\n            Designs turned into functional watch faces distributed to hundreds\n            of thousands of smartwatch users on the Facer platform\n        </li>\n        <li>\n            Enrollement in the Premium Designer Program of Facer, including\n            ongoing royalties on the revenue generated by their winning designs\n        </li>\n    </ul>\n    <hr/>\n\n    <h2>Rules</h2>\n    <ul>\n        <li>The designs must be 100% original.</li>\n        <li>\n            Designs infringing on any copyright/trademarks will be disqualified.\n        </li>\n        <li>\n            Unlimited entries per participant, but only 1 entry can be selected\n            as finalist by the jury.\n        </li>\n        <li>\n            The designs must be submitted before March 23rd at midnight Pacific\n            Time.\n        </li>\n    </ul>\n\n    <hr/>\n\n    <h2>How to enter:</h2>\n    <p>Two types of submissions will be accepted:</p>\n    <ol>\n        <li>\n            Fully functional watch faces created with the\n            <a class="text-link" href="/creator">Facer Creator</a>. This is the\n            <b>recommended</b> submission method as it will allow you to have\n            full control over the design of the watch face and preview its\n            functionality in the design tool\n        </li>\n        <li>\n            Photoshop/Illustrator file with each animated or functional element\n            on a separate layer, along with mockups describing the functionality\n            of the watch face. Here’s a\n            <a class="text-link" target="_blank" ng-href="{{facerStaticAssetUrl(\'/img/abtw/JohnDoe-submission1.zip\')}}">sample submission.</a>\n        </li>\n    </ol>\n\n    <hr/>\n\n    <h3>Inspiration</h3>\n\n    <p>\n        Need some inspiration? Check out some of the\n        <a class="text-link" href="https://www.facer.io/explore/popular">most popular watch faces</a>\n        on Facer or some sample submissions below:\n    </p>\n\n    <p class="text-center">\n        <a href="https://www.facer.io/watchface/dMk84eP81n"><img width="360px" ng-src="{{facerStaticAssetUrl(\'/img/abtw/timeless-classic.gif\')}}"/>\n        </a>\n        <a href="https://www.facer.io/watchface/53ky0hizda"><img width="360px" ng-src="{{facerStaticAssetUrl(\'/img/abtw/ap-classico.gif\')}}"/>\n        </a>\n        <a href="https://www.facer.io/watchface/5Q9HJFaWmA"><img width="360px" ng-src="{{facerStaticAssetUrl(\'/img/abtw/ap-planetary.gif\')}}"/>\n        </a>\n    </p>\n\n    <p>\n        Good luck!\n        <br/>\n        The aBlogtoWatch & Facer teams\n    </p>\n\n    <hr/>\n    <div class="entry-box">\n        <h2 class="text-center">Enter the contest</h2>\n        <p class="text-center" style="color: grey">\n            Choose your submission method:\n        </p>\n        <p>&nbsp;</p>\n\n        <div class="row">\n            <div class="col-md-3 col-md-offset-2 text-center">\n                <a class="text-link" href="/creator">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/abtw/facer-editor-logo.png\')}}"/>\n                    <p>via Facer Creator</p>\n                </a>\n                <p>\n                    <small><i>Recommended</i><br/>See your watch face in action\n                        as you design it!</small>\n                </p>\n            </div>\n            <div class="col-md-2 text-center">\n                <p>&nbsp;</p>\n                <span class="text-center" style="color: grey">OR</span>\n                <p>&nbsp;</p>\n            </div>\n            <div class="col-md-3 text-center">\n                <a class="text-link" href="mailto:[redacted:email]@facer.io?subject=ABTW Contest Entry"><img ng-src="{{facerStaticAssetUrl(\'/img/abtw/photoshop_icon.png\')}}"/>\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/abtw/illustrator_icon.png\')}}"/>\n                    <p>via email</p>\n                </a>\n                <p>\n                    <small><i>Note</i><br/>Please ensure all necessary resources\n                        are provided.<br/>See sample submission\n                        <a class="text-link" target="_blank" ng-href="{{facerStaticAssetUrl(\'/img/abtw/JohnDoe-submission1.zip\')}}">here</a>.</small>\n                </p>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},9040:e=>{var n="/html/ad.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="ad" ng-if="showAd()" ng-class="{\'simple-ad\': ad.isSimple()}">\n    <div class="content">\n        <div class="icon">\n            <img ng-src="{{ad.icon}}"/>\n        </div>\n        <div class="btn-container" style="background:{{ad.isSimple() && ad.buttonColor}}">\n            <a id="mainAdLink{{ad.id}}" class="btn" target="_blank" track-link="adLinkTrackingData" style="background:{{ad.buttonColor}}" ng-href="{{ad.url}}">\n                <div class="inner-btn-container">\n                    {{ad.urlDescription}}\n                    <i class="ad-caret icon-angle-right"></i>\n                </div>\n            </a>\n            <div class="btn-subtitle">{{ad.bannerText}}</div>\n            <div class="simple-ad-shade"></div>\n        </div>\n    </div>\n    <div class="bg" style="background:url({{ad.background}})"></div>\n</div>\n')}]),e.exports=n},69380:e=>{var n="/html/admin/accounting.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<admin-page page-title="Financial Reports">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n\n    <h1>\n        Financial Reports\n        <button ng-click="createNew()" class="btn btn-primary pull-right">\n            Create New Financial Report\n        </button>\n    </h1>\n\n    <table class="table">\n        <thead>\n            <tr>\n                <th class="col-md-1">Period</th>\n                <th class="col-md-1 text-center">Google Play Report</th>\n                <th class="col-md-1 text-center">Samsung Report (Optional)</th>\n                <th class="col-md-1 text-center">Apple Report</th>\n                <th class="col-md-1 text-center">Stripe Revenue</th>\n                <th class="col-md-1 text-center">Aggregated Report</th>\n                <th class="text-center">Aggregated At</th>\n                <th class="text-center">Approved At</th>\n                <th class="text-center">Approved By</th>\n                <th class="col-md-1">Actions</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat="report in reports|orderBy:\'period\':true" class="admin-flash-sale">\n                <th>{{report.period}}</th>\n                <td>\n                    <div ng-show="report.googlePlayReport" class="sale-default">\n                        <a href="{{report.googlePlayReport}}" target="_blank">\n                            <i class="icon-checkmark"></i>\n                        </a>\n                    </div>\n                    <div ng-show="report.canUploadNewReport()" class="upload-control">\n                        <loader ng-show="uploading.googlePlayReport && uploading.period === report.period" class="accounting-loader"></loader>\n                        <button class="btn btn-link" ng-click="" ng-hide="uploading.googlePlayReport && uploading.period === report.period">\n                            <i class="icon-pencil"></i>\n                        </button>\n                        <input id="{{report.id}}" type="file" upload="googleReport" ng-hide="uploading.googlePlayReport && uploading.period === report.period"/>\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="report.galaxyAppsReport" class="sale-default">\n                        <a href="{{report.galaxyAppsReport}}" target="_blank">\n                            <i class="icon-checkmark"></i>\n                        </a>\n                    </div>\n                    <div ng-show="report.canUploadNewReport()" class="upload-control">\n                        <loader ng-show="uploading.galaxyAppsReport && uploading.period === report.period" class="accounting-loader"></loader>\n                        <button class="btn btn-link" ng-click="" ng-hide="uploading.galaxyAppsReport && uploading.period === report.period">\n                            <i class="icon-pencil"></i>\n                        </button>\n                        <input id="{{report.id}}" type="file" upload="samsungReport" ng-hide="uploading.galaxyAppsReport && uploading.period === report.period"/>\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="report.appStoreReport" class="sale-default">\n                        <a href="{{report.appStoreReport}}" target="_blank">\n                            <i class="icon-checkmark"></i>\n                        </a>\n                    </div>\n                    <div ng-show="report.canUploadNewReport()" class="upload-control">\n                        <loader ng-show="uploading.appStoreReport && uploading.period === report.period" class="accounting-loader"></loader>\n                        <button class="btn btn-link" ng-click="" ng-hide="uploading.appStoreReport && uploading.period === report.period">\n                            <i class="icon-pencil"></i>\n                        </button>\n                        <input id="{{report.id}}" type="file" upload="appleReport" ng-hide="uploading.appStoreReport && uploading.period === report.period"/>\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="report.stripeRevenueTotal">\n                        <b>{{report.stripeRevenueTotal|currency:\'$\'}}</b>\n                    </div>\n                    <div ng-show="report.canUploadNewReport()" class="accounting-button">\n                        <button class="btn btn-link" ng-click="report.updateRevenueTotal(\'stripeRevenueTotal\')">\n                            <i class="icon-pencil"></i>\n                        </button>\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="report.aggregatedReport" class="sale-active">\n                        <a href="{{report.aggregatedReport}}" ng-if="!isSafari" target="_blank">\n                            <i class="icon-arrow-down"></i>\n                        </a>\n                        <a href="javascript:void(0)" ng-if="isSafari" ng-click="downloadReport(report)">\n                            <i class="icon-arrow-down"></i>\n                        </a>\n                    </div>\n                    <div ng-show="!report.aggregatedReport">\n                        No report available\n                    </div>\n                </td>\n                <td>\n                    <div ng-show="report.aggregatedAt">\n                        <b>{{report.aggregatedAt|date:"medium"}}</b>\n                        <br/>\n                        <small>{{report.aggregatedAt|timeAgo}}</small>\n                    </div>\n                    <div ng-show="!report.aggregatedAt">-</div>\n                </td>\n                <td>\n                    <div ng-show="report.approvedAt">\n                        <b>{{report.approvedAt|date:"medium"}}</b>\n                        <br/>\n                        <small>{{report.approvedAt|timeAgo}}</small>\n                    </div>\n                    <div ng-show="!report.approvedAt">-</div>\n                </td>\n                <td>\n                    <div ng-show="report.approvedBy">\n                        <b>{{report.approvedBy.name}}</b>\n                        <br/>\n                        <small>{{report.approvedBy.email}}</small>\n                    </div>\n                    <div ng-show="!report.approvedBy">-</div>\n                </td>\n                <td class="col-md-2 text-left">\n                    <button class="btn btn-default" ng-class="{\'disabled\': !report.canAggregate() || report.loading}" ng-click="report.aggregate()" title="Aggregate reports">\n                        <i class="icon-rotate"></i>\n                    </button>\n                    <button class="btn btn-default" ng-class="{\'disabled\': !report.canApprove() || report.loading}" ng-click="report.approve()" title="Approved aggregated reports">\n                        <i class="icon-checkmark"></i>\n                    </button>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    <loader ng-if="loading"></loader>\n</admin-page>')}]),e.exports=n},76406:e=>{var n="/html/admin/admin-header.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-header-wrapper">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n    <h2>{{title}}</h2>\n    <ng-transclude></ng-transclude>\n</div>\n')}]),e.exports=n},92262:e=>{var n="/html/admin/admin-main.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-hub">\n    <div class="admin-hub__header">\n        <h1 class="admin-hub__title">Admin</h1>\n        <p class="admin-hub__subtitle">Internal tools, moderation and configuration.</p>\n    </div>\n\n    <div class="admin-hub__search">\n        <svg class="admin-hub__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">\n            <circle cx="11" cy="11" r="7"></circle>\n            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>\n        </svg>\n        <input type="text" class="admin-hub__search-input" ng-model="hub.query" placeholder="Search admin tools…" aria-label="Search admin tools"/>\n        <button type="button" class="admin-hub__search-clear" ng-show="hub.query" ng-click="hub.query = \'\'" aria-label="Clear search">\n            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">\n                <line x1="6" y1="6" x2="18" y2="18"></line>\n                <line x1="18" y1="6" x2="6" y2="18"></line>\n            </svg>\n        </button>\n    </div>\n\n    \x3c!-- Content Review --\x3e\n    <div feature-id="content-review-pages" ng-show="accessible" class="admin-hub__section">\n        <div ng-show="matchesQuery(\'content review tos terms of service qa queue new updated moderation quality assurance general\')">\n            <div class="admin-hub__section-head">\n                <svg class="admin-hub__section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">\n                    <circle cx="12" cy="12" r="9"></circle>\n                    <polyline points="8.5 12.5 11 15 15.5 9.5"></polyline>\n                </svg>\n                <h2 class="admin-hub__section-title">Content Review</h2>\n            </div>\n            <div class="admin-hub__grid">\n                <a ui-sref="facer.admin.tosReview" class="admin-hub__card" ng-show="matchesQuery(\'tos review queue terms of service moderation content\')">\n                    <span class="admin-hub__card-icon">\n                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><polyline points="8.5 12.5 11 15 15.5 9.5"></polyline></svg>\n                    </span>\n                    <span class="admin-hub__card-body">\n                        <span class="admin-hub__card-title">ToS Review Queue</span>\n                        <span class="admin-hub__card-desc">Review watchfaces flagged for terms-of-service issues.</span>\n                    </span>\n                    <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n                </a>\n\n                <a ui-sref="facer.admin.qa.option({option: \'new\'})" class="admin-hub__card" ng-show="matchesQuery(\'qa queue new quality assurance moderation content\')">\n                    <span class="admin-hub__card-icon">\n                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><polyline points="8.5 12.5 11 15 15.5 9.5"></polyline></svg>\n                    </span>\n                    <span class="admin-hub__card-body">\n                        <span class="admin-hub__card-title">QA Queue (new)</span>\n                        <span class="admin-hub__card-desc">Quality-check newly submitted watchfaces.</span>\n                    </span>\n                    <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n                </a>\n\n                <a ui-sref="facer.admin.qa.option({option: \'updated\'})" class="admin-hub__card" ng-show="matchesQuery(\'qa queue updated quality assurance moderation content\')">\n                    <span class="admin-hub__card-icon">\n                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><polyline points="8.5 12.5 11 15 15.5 9.5"></polyline></svg>\n                    </span>\n                    <span class="admin-hub__card-body">\n                        <span class="admin-hub__card-title">QA Queue (updated)</span>\n                        <span class="admin-hub__card-desc">Quality-check updated watchface submissions.</span>\n                    </span>\n                    <svg class="admin-hub__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>\n                </a>\n\n                <a ui-sref="facer.admin.review" class="admin-hub__card" ng-show="matchesQuery(\'review queue moderation content general\')">\n                    <span class="admin-hub__card-icon">\n                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><polyline points="8.5 12.5 11 15 15.5 9.5"></polyline></svg>\n                    </span>\n                    <span class="admin-hub__card-body">\n      