lettes.right.isActive(\'properties\')}" ng-click="palettes.right.toggle(\'properties\')" ng-disabled="!editor.loaded" title="Element Properties">\n                            <i class="icon-rocket"></i>\n                        </a>\n                    </div>\n                    <div class="corner-tool-container-item">\n                        <a ng-if="palettes.right.isAccessible(\'preview\')" class="dropdown-toggle watch-canvas-corner-tool-button watch-canvas-corner-tool-icon-button disabled" ng-class="{\'disabled\': !editor.loaded, \'active\': palettes.right.isActive(\'preview\')}" ng-click="palettes.right.toggle(\'preview\')" ng-disabled="!editor.loaded" title="Preview Tools">\n                            <i class="icon-watch"></i>\n                        </a>\n                    </div>\n                    <div class="corner-tool-container-item">\n                        <a ng-if="palettes.right.isAccessible(\'themes\')" class="dropdown-toggle watch-canvas-corner-tool-button watch-canvas-corner-tool-icon-button disabled" ng-class="{\'disabled\': !editor.loaded, \'active\': palettes.right.isActive(\'themes\')}" ng-click="palettes.right.toggle(\'themes\')" ng-disabled="!editor.loaded" title="Themes">\n                            <i class="icon-themes"></i>\n                        </a>\n                    </div>\n                    <div class="corner-tool-container-item">\n                        <a ng-if="palettes.right.isAccessible(\'statistics\')" class="dropdown-toggle watch-canvas-corner-tool-button watch-canvas-corner-tool-icon-button disabled" ng-class="{\'disabled\': !editor.loaded, \'active\': palettes.right.isActive(\'statistics\')}" ng-click="palettes.right.toggle(\'statistics\')" ng-disabled="!editor.loaded" title="statistics">\n                            <facer-icon icon="statistics"></facer-icon>\n                        </a>\n                    </div>\n                    <div class="corner-tool-container-item">\n                        <a ng-if="palettes.right.isAccessible(\'info\')" class="dropdown-toggle watch-canvas-corner-tool-button watch-canvas-corner-tool-icon-button disabled" ng-class="{\'disabled\': !editor.loaded, \'active\': palettes.right.isActive(\'info\')}" ng-click="palettes.right.toggle(\'info\')" ng-disabled="!editor.loaded" title="Info">\n                            <i class="icon-info"></i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div ng-show="!publishMode.enabled" class="watch-canvas-container" ng-click="closeDropdowns();$event.stopPropagation()" ng-mouseleave="unhoverCanvasElement()" ng-class="{\n            \'fullscreen\': fullScreen,\n            \'ios\': mode==\'ios\' || isIosDesignPlayground,\n            \'is-pan-ready\': isPanModifierActive,\n            \'is-panning-canvas\': isPanningCanvas\n        }">\n        <div class="watch-canvas-rulers-overlay" ng-if="areRulersVisible()">\n            <div class="watch-canvas-ruler-corner"></div>\n\n            <div class="watch-canvas-ruler watch-canvas-ruler-horizontal" ng-mousedown="startGuideCreation(\'y\', $event)">\n                <div class="watch-canvas-ruler-mark" ng-class="mark.className" ng-repeat="mark in rulers.horizontalMarks track by mark.value" ng-style="{ left: mark.position + \'px\' }">\n                    <span class="watch-canvas-ruler-label" ng-if="mark.label !== null">{{mark.label}}</span>\n                </div>\n            </div>\n\n            <div class="watch-canvas-ruler watch-canvas-ruler-vertical" ng-mousedown="startGuideCreation(\'x\', $event)">\n                <div class="watch-canvas-ruler-mark" ng-class="mark.className" ng-repeat="mark in rulers.verticalMarks track by mark.value" ng-style="{ top: mark.position + \'px\' }">\n                    <span class="watch-canvas-ruler-label" ng-if="mark.label !== null">{{mark.label}}</span>\n                </div>\n            </div>\n\n            <div ng-if="areGuidesVisible()" class="watch-canvas-guide watch-canvas-guide-vertical" ng-class="{ \'is-active-snap\': guide.isActiveSnap }" ng-repeat="guide in guideOverlay.x track by guide.id" ng-style="{ left: guide.position + \'px\' }" ng-mouseenter="showGuideHoverLabel(guide)" ng-mouseleave="hideGuideHoverLabel()" ng-mousedown="startGuideDrag(guide, $event)" ng-dblclick="removeGuideOnDoubleClick(guide, $event)"></div>\n\n            <div ng-if="areGuidesVisible()" class="watch-canvas-guide watch-canvas-guide-horizontal" ng-class="{ \'is-active-snap\': guide.isActiveSnap }" ng-repeat="guide in guideOverlay.y track by guide.id" ng-style="{ top: guide.position + \'px\' }" ng-mouseenter="showGuideHoverLabel(guide)" ng-mouseleave="hideGuideHoverLabel()" ng-mousedown="startGuideDrag(guide, $event)" ng-dblclick="removeGuideOnDoubleClick(guide, $event)"></div>\n\n            <div ng-if="areGuidesVisible() && guidePreview && guidePreview.axis === \'x\'" class="watch-canvas-guide-preview watch-canvas-guide-preview-vertical" ng-style="{ left: guidePreview.overlayPosition + \'px\' }">\n                <span class="watch-canvas-guide-preview-label">{{guidePreview.label}}</span>\n            </div>\n\n            <div ng-if="areGuidesVisible() && guidePreview && guidePreview.axis === \'y\'" class="watch-canvas-guide-preview watch-canvas-guide-preview-horizontal" ng-style="{ top: guidePreview.overlayPosition + \'px\' }">\n                <span class="watch-canvas-guide-preview-label">{{guidePreview.label}}</span>\n            </div>\n\n            <div ng-if="areGuidesVisible() && !guidePreview && guideHoverLabel && guideHoverLabel.axis === \'x\'" class="watch-canvas-guide-hover-label watch-canvas-guide-hover-label-vertical" ng-style="{ left: guideHoverLabel.overlayPosition + \'px\' }">\n                <span class="watch-canvas-guide-preview-label">{{guideHoverLabel.label}}</span>\n            </div>\n\n            <div ng-if="areGuidesVisible() && !guidePreview && guideHoverLabel &&