collection.rgb[0].b\n                            }},0.5) 0%, rgba({{ collection.rgb[1].r }},{{\n                                collection.rgb[1].g\n                            }},{{ collection.rgb[1].b }}, 0.72) 100%);"></div>\n                        <div class="hero-placeholder-wrapper" ng-show="!collection.hero">\n                            <div class="hero-placeholder">\n                                {{ collection.name }}\n                            </div>\n                        </div>\n                    </div>\n                    <div class="hero-bg blur">\n                        <img title="{{ collection.name }}" alt="{{ collection.name | collectionHeroAlt }}" draggable="false" ng-src="{{\n                                collection.hero || facerStaticAssetUrl(\'/img/default-banner.png\')\n                            }}"/>\n                        <div ng-if="!collection.hero" class="hero-color" style="background: linear-gradient(130deg, rgba({{\n                                collection.rgb[0].r\n                            }},{{ collection.rgb[0].g }},{{\n                                collection.rgb[0].b\n                            }},0.5) 0%, rgba({{ collection.rgb[1].r }},{{\n                                collection.rgb[1].g\n                            }},{{ collection.rgb[1].b }}, 0.72) 100%);"></div>\n                    </div>\n                    <div ng-if="video" class="collection-video" banner-video video="video" fit-height="true" autoplay="true" muted="true" reveal="true" ng-class="{ stopped: video.stopped }"></div>\n                </div>\n                <ad target="collection.id" type="collection"></ad>\n\n                <div class="container fade">\n                    <div class="row user-widget">\n                        <div ng-if="collection.user" class="col-md-3 col-sm-4 col-xs-12">\n                            <div class="row user-widget-info-wrapper">\n                                <div class="col-sm-12 col-xs-2">\n                                    <a user-profile-link="collection.user" class="artist" role="img" ng-attr-aria-label="{{ collection.user.name | profilePictureAlt }}" style="background-image: url(\'{{\n                                            collection.user.avatar\n                                        }}\')" square-fit></a>\n                                </div>\n                                <div class="artist-name col-sm-12 col-xs-10">\n                                    <a class="watchface-artist" user-profile-link="collection.user">\n                                        {{ collection.user.name }}\n                                        <user-badge user="collection.user"></user-badge>\n                                    </a>\n                                </div>\n                                <div>\n                                    <follow-button class="follow-button-inline-block" user="collection.user"></follow-button>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="{{ collection.user ? \'col-md-9 col-sm-8 col-xs-12\' : \'col-md-12\' }} collection-details">\n                            <p class="collection-header-byline">\n                                WATCH FACE COLLECTION\n                            </p>\n                            <div class="collection-header-title-container">\n                                <h1>\n                                    {{ collection.name }}\n                                </h1>\n                                <span ng-if="!isFavorites()">\n                                    <span ng-show="\n                                            collection.canEdit() &&\n                                            !page.isMobile()\n                                        " class="btn-icon dropdown">\n                                        <a class="dropdown-toggle very-small" type="button" id="collectionOptions" data-toggle="dropdown" aria-expanded="true">\n                                            <i class="icon-settings very-small"></i>\n                                        </a>\n    \n                                        <ul ng-if="collection" class="dropdown-menu dropdown-menu--underlined" role="menu" aria-labelledby="collectionOptions">\n                                            <li>\n                                                <a ng-click="editCollection()">\n                                                    Edit\n                                                </a>\n                                            </li>\n    \n                                            <li>\n                                                <a ng-click="deleteCollection()">\n                                                    Delete collection\n                                                </a>\n                                            </li>\n    \n                                            <li ng-if="isAdmin" class="dropdown-header">\n                                                Admin Store Actions\n                                            </li>\n    \n                                            <li ng-if="isAdmin" ng-class="{\n                                                    disabled:\n                                                        !!collection.publishedAt\n                                                }">\n                                                <a ng-show="\n                                                        !collection.publishedAt\n                                                    " ng-click="collection.publishBundle()" class="watch-select">\n                                                    Publish Bundle\n                                                </a>\n                                                <a ng-show="\n                                                        !!collection.publishedAt\n                                                    " class="watch-select">\n                                                    Published\n                                                </a>\n                                            </li>\n    \n                                            <li ng-if="isAdmin" class="dropdown-header">\n                                                Galaxy Store Actions\n                                            </li>\n    \n                                            <li ng-if="isAdmin">\n                                                <button type="button" class="watch-select" role="menuitem" ng-click="collection.triggerBuild()">\n                                                    Trigger Build\n                                                </button>\n                                            </li>\n                                        </ul>\n                                    </span>\n                                    <a ng-show="\n                                            collection.isShareable() &&\n                                            !page.isIosClient()\n                                        " ng-click="shareCollection()" class="very-small">\n                                        <i class="icon-share-alt very-small"></i>\n                                    </a>\n                                </span>\n                            </div>\n\n                            <hr class="hidden-xs"/>\n\n                            <p>\n                                {{ collection.description }}\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class="container">\n                <div id="watchface-list" class="row" ui-view="watchfaces"></div>\n\n                <div id="upload-cta" ng-if="allWatchfaces && watchfaces.length == 0">\n                    <span>No watch faces yet</span>\n                </div>\n\n                <endless margin="200" trigger="showMoreWatchfaces()" end-on="done" busy-when="loading || loadingMore"></endless>\n                <loader ng-if="loadingMore"></loader>\n            </div>\n        </div>\n        <loader id="watchfaceSpinner" ng-if="loading"></loader>\n    </div>\n</div>\n')}]),e.exports=n},62981:e=>{var n="/html/collection.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<collection collection="collection" type="page"></collection>\n')}]),e.exports=n},83200:e=>{var n="/html/collections.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n<h2>\n    Collections &nbsp;&nbsp;\n    \x3c!--<small><a ui-sref="facer.admin.collections.option({option: \'all\'})" ui-sref-active="active" class="option-link">All</a></small>\n\t&nbsp;&nbsp;--\x3e\n    <small><a ui-sref="facer.admin.collections.option({option: \'live\'})" ui-sref-active="active" class="option-link">Live</a></small>\n    &nbsp;&nbsp;\n    <small><a ui-sref="facer.admin.collections.option({option: \'staging\'})" ui-sref-active="active" class="option-link">Staging</a></small>\n\n    \x3c!--<button ng-if="!loading && option==\'staging\' && publishableCollectionCount() > 0" ng-click="publishCollections()" class="btn btn-primary pull-right margin-left">\n        Publish {{publishableCollectionCount()}} Collection<span ng-show="publishableCollectionCount() > 1">s</span>\n    </button>--\x3e\n    \x3c!--<button ng-if="!loading && option==\'staging\'" ng-click="createCollection()" class="btn btn-default pull-right">Create Collection</button>--\x3e\n</h2>\n\n<br/>\n\n<div ng-if="option==\'archive\'">\n    <form class="form-inline">\n        <div class="form-group">\n            <label>Show live collections on:</label>\n            <input type="datetime-local" class="form-control" ng-model="filters.date"/>\n        </div>\n    </form>\n\n    <br/>\n</div>\n\n<div>\