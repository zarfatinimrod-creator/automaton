tch Faces" title="Popular Watch Faces" ui-sref="facer.explore.option({option:\'popular\'})">\n                                Trending\n                            </a>\n                        </li>\n                        <li class="browse-menu">\n                            <a aria-label="Recent Watch Faces" title="Recent Watch Faces" ui-sref="facer.explore.option({option:\'newest\'})">\n                                Recent\n                            </a>\n                        </li>\n\n                        \x3c!--<li class="dropdown-header">Categories</li>\n                        <li ng-repeat="category in categories">\n                            <a\n                                alt="Category - {{category.name}}"\n                                ui-sref="facer.explore.category({category:category.id})"\n                            >\n                                {{category.name}}\n                            </a>\n                        </li>--\x3e\n                    </ul>\n                </li>\n\n                <li id="createYourOwn" class="nav-link">\n                    <a ui-sref="facer.editor(page.getLocaleStateParams())" target="_blank" aria-label="Facer Creator" title="Facer Creator">\n                        Create\n                    </a>\n                </li>\n\n                <li id="searchWatchfaces">\n                    <form ng-submit="$state.go(\'facer.search\', {search: search.query, shape: search.options.shape})" class="navbar-form" role="search">\n                        <div class="input-group">\n                            <input ng-model="search.query" type="text" class="form-control" placeholder="Search watch faces" name="srch-term" id="srch-term"/>\n                            <div class="input-group-btn">\n                                <button class="btn btn-default" type="submit">\n                                    <i class="icon-search"></i>\n                                </button>\n                            </div>\n                        </div>\n                    </form>\n                </li>\n\n                <li class="divider-vertical hidden-sm hidden-xs"></li>\n\n                <li ng-show="currentUser() && !userService.hasRole(\'All Access\')">\n                    <form class="navbar-form upgrade-button-wrapper">\n                        <div class="form-group">\n                            <a class="btn btn-premium btn-default" id="upgradeButton" aria-label="Upgrade" title="Upgrade" ui-sref="facer.premium">Upgrade</a>\n                        </div>\n                    </form>\n                </li>\n\n                <li id="deviceSelection" ng-class="{\'nav-link-image\': settings.selectedDevice, \'is-not-selected\': !settings.selectedDevice}">\n                    <button type="button" aria-label="Select Device" title="Select Device" ng-click="$root.settings.promptDeviceSelection()">\n                        <span ng-show="!settings.selectedDevice">Select Device</span>\n                        <span ng-show="settings.selectedDevice == \'apple\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/apple-logo.png\')}}" alt="Apple Watch" title="Select your device type"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'android\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/wearos-logo.png\')}}" alt="Android Wear" title="Select your device type"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'tizen\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/tizen-logo.png\')}}" alt="Samsung Tizen" title="Select your device type"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'wff\'">\n                            <facer-icon icon="wearos6"></facer-icon