e per row per digest;\n\t     a field that must not show switches to "" and matches no case. --\x3e\n\t<div ng-repeat="field in getElementTypeAdvancedSettingsConfig(editor.selectedElement)" ng-switch="shouldShow(field) ? field.type : \'\'">\n\t\t<div ng-switch-when="text" class="form-group palette-item">\n\t\t\t<div class="palette-item-title-bar palette-item-title-bar--value">\n\t\t\t\t<div class="palette-item-title">\n\t\t\t\t\t{{field.label}} <span ng-if="field.admin" class="admin-tag-pill tag-pill tag-pill-gray tag-pill-small">ADMIN</span>\n\t\t\t\t</div>\n\t\t\t\t<div class="palette-item-value" title="{{getFieldDisplayValue(field)}}">\n\t\t\t\t\t{{getFieldDisplayValue(field)}}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="palette-item-input" ng-class="{\'tag-input\': fieldIsDynamic(field)}">\n\t\t\t\t<input ng-show="!shouldUseGetterSetter(field)" type="text" ng-model="editor.selectedElement[field.value]" ng-change="onChange(field)" class="js-palette-input form-control" face-input debounced expression-highlight="fieldIsDynamic(field)" expression-highlight-autocomplete="fieldIsDynamic(field)" tag-list="false" static-value="{{!fieldIsDynamic(field) && field.static}}" ng-disabled="field.disabled"/>\n\t\t\t\t<input ng-show="shouldUseGetterSetter(field)" type="text" ng-model="field.value" ng-model-options="{ getterSetter: true }" ng-change="onChange(field)" class="js-palette-input form-control" face-input debounced expression-highlight="fieldIsDynamic(field)" expression-highlight-autocomplete="fieldIsDynamic(field)" tag-list="false" static-value="{{!fieldIsDynamic(field) && field.static}}"/>\n\t\t\t\t<button ng-show="fieldIsDynamic(field)" ng-click="captureInputFocusAndToggle(field, $event)" anchored-portal="field._expanded" portal-placement="top-left" class="palette-expanded__toggle js-palette-expanded-toggle" ng-class="{\'palette-expanded__toggle--active\': field._expanded}" type="button" aria-label="Open expression editor" title="Open expression editor">\n\t\t\t