tion palette-section-new">\n            <div class="palette-title">\n                Complications\n            </div>\n            <div class="palette-body">\n                <div class="layer-list layer-list-top-level">\n                    <div class="layer" ng-mouseenter="hoverCanvasElement(element);hover=true" ng-mouseleave="unhoverCanvasElement(element);hover=false" ng-click="selectElement(element, $event)" ng-class="{\n                            \'hovered\': editor.hoveredElement.id == element.id, \n                            \'selected\': elementIsSelected(element),\n                            \'interactive\': elementIsInteractionWidget(element)\n                        }" ng-repeat="element in getWatchOsCompLayerList()">\n                        <div class="layer-selection-box"></div>\n\n                        <div class="layer-content-section layer-title-wrapper">\n                            <div class="z-1 layer-title">\n                                {{getComplicationSlotDisplayName(element.name)}}\n                            </div>\n                            <div class="layer-detail">\n                                {{getProviderName(element)}}\n                            </div>\n                        </div>\n                        <div class="layer-content-section z-1 element-thumbnail complication-preview {{getComplicationPreviewClass(element)}}">\n                            <div ng-show="!getComplicationPreview(element)" class="complication-preview-content"></div>\n                            <img ng-show="getComplicationPreview(element)" class="complication-preview-content" ng-src="{{getComplicationPreview(element)}}">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div ng-show="hasPhotoAlbum()" class="palette-section palette-section-new">\n            <div class="palette-title">\n                Photos\n            </div>\n            <div class="palette-body">\n                <div photo-album-layer photo-album-events class="photo-album-toolbar">\n                    <ul class="photo-album-toolbar-list" ng-mouseenter="unhoverCanvasElement(currentLayer())">\n                        <li ng-repeat="image in getPhotoAlbum().layers" ng-click="selectLayer($index)" class="photo-album-toolbar-image-container" ng-class="{\'selected\': isSelected($index)}">\n                            <img ng-if="useCorsEnabledImageCaching" ng-src="{{editor.face.images[image.hash_cropped].data}}" style="display:none;" crossorigin="anonymous">\n                            <div class="photo-album-toolbar-image" ng-style="{\'background-image\': \'url(\' + editor.face.images[image.hash_cropped].data + \')\'}">\n                            </div>\n                            <div ng-click="removeLayer($index)" class="remove-image">\n                                <i class="icon-close"></i>\n                            </div>\n                        </li>\n                        <li class="photo-album-toolbar-image-container add-image" ng-click="triggerPhotoAlbumImageUpload(getPhotoAlbum())" ng-disable="loading" ng-class="{\'disabled\': loading}">\n                            <div class="photo-album-toolbar-image">\n                                <i class="icon-plus"></i>\n                            </div>\n                            <input id="photoAlbumImageUpload" type="file" upload-image="both" layer-type="set"/>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div ng-if="isWatchOs11Template() && getLayerMenuConfig().type == \'watchos-complication\'" class="palette-wrapper palette-wrapper--content-height">\n    <div class="palette-section-scroll-group palette-section palette-section-new">\n        <div class="palette-section palette-section-new"></div>\n        <hr/>\n        <div class="palette-title">\n            Watch face configuration\n        </div>\n        <div class="palette-body">\n            <div class="configurator-option">\n                <div class="configurator-option__label">Font</div>\n                <div class="configurator-option__options">\n                    <watchface-configurator-select-field options="configuratorFontOptions" default-value="configuratorDefaultFontValue" on-select="handleConfiguratorFontSelection(selectedOption)" type="text-img-list"></watchface-configurator-select-field>\n                    <watchface-configurator-color-picker default-value="configuratorDefaultColorValue" on-select="handleConfiguratorColorSelection(selectedOption)"></watchface-configurator-color-picker>\n                </div>\n            </div>\n            <div class="configurator-option">\n                <div class="configurator-option__label">Top Complication</div>\n                <div class="configurator-option__options">\n                    <watchface-configurator-select-field options="configuratorComplicationOptions" default-value="configuratorDefaultTopComplicationValue" on-select="handleConfiguratorComplicationSelection(selectedOption, \'top\')" type="pill-list"></watchface-configurator-select-field>\n                </div>\n            </div>\n            <div class="configurator-option">\n                <div class="configurator-option__label">Bottom Complication</div>\n                <div class="configurator-option__options">\n                    <watchface-configurator-select-field options="configuratorComplicationOptions" default-value="configuratorDefaultBottomComplicationValue" on-select="handleConfiguratorComplicationSelection(selectedOption, \'bottom\')" type="pill-list"></watchface-configurator-select-field>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div ng-if="getLayerMenuConfig().type == \'standard\'" class="palette-wrapper layer-list-standard">\n    <div ng-if="getLayerMenuConfig().goBack" class="layer-list-nav layer-list-nav-nested palette-section-scroll-group palette-wrapper-animated">\n        <div class="layer-list-nav-btn-left" ng-click="goBack()">\n            <i class="icon-arrow-left"></i>\n        </div>\n        {{getLayerMenuConfig().navTitle}}\n    </div>\n    <div ng-class="{\'palette-section-scroll-group-flex\': palettes.newElement.isOpen(\'new-element\'), \'palette-section-scroll-group-flex-hide\': !palettes.newElement.isOpen(\'new-element\')}" class="palette-section-scroll-group palette-wrapper-animated">\n        <new-element-menu></new-element-menu>\n    </div>\n\n    <div class="palette-section-scroll-group">\n        <div title="Add a new element" ng-click="palettes.newElement.toggle(\'new-element\')" class="palette-button layer-list-standard__add-btn" ng-class="{\'primary-button\': !palettes.newElement.isOpen(\'new-element\'), \'cancel-button\': palettes.newElement.isOpen(\'new-element\')}">\n            <i ng-show="!palettes.newElement.isOpen(\'new-element\')" class="icon-layers"></i>{{\n            palettes.newElement.isOpen(\'new-element\') ? \'Cancel\' : \'Add Element\' }}\n        </div>\n    </div>\n\n    <div class="palette-section-scroll-group palette-wrapper palette-section-scroll-group-flex palette-wrapper-animated" ng-class="{\'palette-section-scroll-group-flex-hide\': palettes.newElement.isOpen(\'new-element\')}">\n\n        <div ng-show="canSelectAmbientMode()" class="palette-section-scroll-group">\n            <div class="palette-section palette-section-new">\n                <div class="palette-tabs layer-list-standard__tabs">\n                    <a class="palette-tab" ng-click="editor.options.dimMode=false;editor.previews[3].options.dimMode=false;editor.previews[4].options.dimMode=false;refreshCanvas(false,false,true);refreshCanvas(false, false)" ng-class="{\'active\': !editor.options.dimMode}">\n                        <i class="icon-regular-mode"></i><span ng-show="!isCompactCanvas">Active</span>\n                    </a>\n                    <a class="palette-tab" ng-click="editor.options.dimMode=true;editor.previews[3].options.dimMode=true;editor.previews[4].options.dimMode=true;refreshCanvas(false,false,false);refreshCanvas(false, false)" ng-class="{\'active\': editor.options.dimMode}">\n                        <i class="icon-dim-mode"></i><span ng-show="!isCompactCanvas">Ambient</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n\n        <div class="palette-section-scroll-group layer-list-standard__search-wrap">\n            <div class="layer-list-standard__search-inner">\n                <div class="layer-list-standard__search-field-wrap">\n                    <input type="text" class="layer-list-standard__search" placeholder="Search elements..." ng-model="layerSearch.query" ng-model-options="{ debounce: 150 }"/>\n                    <i ng-show="(layerSearch.query || \'\').length" class="icon-close layer-list-standard__search-clear" ng-click="layerSearch.query = \'\'" title="Clear search"></i>\n                </div>\n                <button type="button" class="layer-list-standard__add-group-btn" title="Add group" ng-if="layerGroupsEnabled" ng-click="addEmptyGroupAtTop()" ng-disabled="(layerSearch.query || \'\').trim()">\n                    <facer-icon icon="folder-add"></facer-icon>\n                </button>\n            </div>\n        </div>\n\n        <div class="palette-section-scroll-group palette-section-scroll-group-flex">\n            <div class="palette-section palette-section-new palette-section-end-margin">\n                <div class="layer-list layer-list-standard__list" ng-mouseleave="unhoverCanvasElement()">\n                    <div class="layer-list-standard__dnd-list" ng-class="{\'layer-list-standard__dnd-list--dragging\': isDragging}" dnd-list="editor.face.elements" dnd-drop="onDropGroupedElements(item, index, event)" dnd-dragover="canDragoverGroupedElements(event, index)" dnd-disable-if="(layerSearch.query || \'\').trim()">\n                        <div class="dndPlaceholder layer drop-placeholder" ng-class="getGroupedDropPlaceholderClass()"></div>\n                        <div data-layer-list-index="{{$index}}" ng-repeat="item in filteredStandardLayerList track by (item.type === \'group\' ? (\'g-\' + item.group.uid) : (\'l-\' + item.element.uid))">\n\n                            \x3c!-- GROUP HEADER ROW --\x3e\n                            <div ng-if="item.type === \'group\'" class="layer layer--small layer--group" ng-init="headerGroup = item.group" dnd-list="[]" dnd-drop="onDropOnGroupHeader(headerGroup, item, event)" dnd-dragover="onDragoverGroupHeader(headerGroup, event)" dnd-disable-if="_draggingGroupUid || (layerSearch.query || \'\').trim()" dnd-draggable="getGroupElements(item.group)" dnd-effect-allowed="move" dnd-moved="onMovedMultipleElements()" dnd-dragstart="onDragstartGroup(item.group)" dnd-dragend="onDragendGroup(event)" ng-hide="isDragging && isGroupSelected(item.group.uid)" ng-click="selectGroup(item.group, $event)" ng-class="{\n                                    \'selected\': isGroupSelected(item.group.uid),\n                                    \'layer--drop-disabled\': isGroupDropTargetDisabled(item)\n                                }" layer-context-menu-trigger>\n                                <div class="dndPlaceholder" style="display:none"></div>\n                                <div class="layer-selection-box"></div>\n                                <div class="layer-content-section layer-group-chevron" ng-click="$event.stopPropagation(); toggleGroupExpand(item.group.uid)">\n                                    <facer-icon icon="chevron-right" ng-if="!isGroupExpanded(item.group.uid)"></facer-icon>\n                                    <facer-icon icon="chevron-down" ng-if="isGroupExpanded(item.group.uid)"></facer-icon>\n                                </div>\n                                <div class="layer-content-section element-thumbnail">\n                                    <facer-icon icon="folder"></facer-icon>\n                                </div>\n                                <div class="layer-content-section layer-title-wrapper" ng-dblclick="$event.stopPropagation();startRenamingGroup(item.group)">\n                                    <span class="z-1 layer-title" ng-if="!item.group.rename">{{item.group.name}}</span>\n                                    <input ng-if="item.group.rename" select-all maxlength="20" blur-on-enter ng-model="item.group.name" data-group-rename-uid="{{item.group.uid}}" ng-keydown="cancelGroupRename($event, item.group)" ng-blur="finishGroupRename(item.group)"/>\n                                </div>\n                                <div class="layer-content-section layer-action-stack" ng-if="groupHasThemeableLayers(item.group)">\n                                    <i feature-id="theming" class="layer-show z-1" ng-click="$event.stopPropagation();toggleGroupThemeability(item.group)" ng-class="{\n                                            \'icon-themes\': groupThemeState(item.group) !== \'intermediate\',\n                                            \'icon-themes-inter\': groupThemeState(item.group) === \'intermediate\',\n                                            \'active\': groupThemeState(item.group) === \'on\' || groupThemeState(item.group) === \'intermediate\'\n                                        }" title="Toggle themeable for group"></i>\n                                </div>\n                                <div class="layer-content-section layer-action-stack" ng-if="groupHasActionableElements(item.group)">\n                                    <i class="layer-show z-1" ng-click="$event.stopPropagation();toggleGroupVisibility(item.group)" ng-class="{\n                                            \'icon-preview\': groupVisibilityState(item.group) !== \'intermediate\',\n                                            \'icon-preview-inter\': groupVisibilityState(item.group) === \'intermediate\',\n                                            \'active\': groupVisibilityState(item.group) === \'on\' || groupVisibilityState(item.group) === \'intermediate\'\n                                        }" title="Show/Hide group"></i>\n                                </div>\n                                <div class="layer-content-section layer-action-stack layer-action-stack--menu">\n                                    <button type="button" class="layer-list-standard__context-trigger" title="Open context menu" aria-label="Open context menu" ng-mousedown="$event.stopPropagation()" ng-click="openItemContextMenu($event, item)">\n                                        <i class="icon-more z-1"></i>\n                                    </button>\n                                </div>\n                            </div>\n\n                            \x3c!-- LAYER ROW --\x3e\n                            <div ng-if="item.type === \'layer\'" dnd-draggable="getLayerDragPayload(item.element)" dnd-effect-allowed="move" dnd-disable-if="(layerSearch.query || \'\').trim() || item.element.lock" dnd-moved="onMovedMultipleElements()" dnd-dragstart="onDragstartMultipleElements(item.element)" dnd-dragend="onDragendMultipleElements(item.element, event)" ng-hide="isDragging && (elementIsSelected(item.element) || isDraggingGroup(item.groupUid))" ng-click="selectElement(item.element, $event)" ng-dblclick="item.element._renameOriginalName=item.element.name; item.element.rename=true" ng-mouseenter="hoverCanvasElement(item.element);hover=true" ng-mouseleave="unhoverCanvasElement(item.element);hover=false" layer-context-menu-trigger class="layer layer--small" ng-class="{\n                                \'layer--grouped\': item.depth > 0,\n                                \'hovered\': editor.hoveredElement.id == item.element.id,\n                                \'selected\': layerRowLooksSelected(item),\n                                \'interactive\': elementIsInteractionWidget(item.element),\n                                \'layer--locked\': item.element.lock,\n                                \'layer--hidden\': isLayerHiddenInCurrentMode(item.element),\n                                \'layer--drop-disabled\': isGroupDropTargetDisabled(item)\n                            }" ng-show="layerItemIsVisible(item.element)">\n                                <div class="layer-selection-box"></div>\n\n                                <div class="layer-content-section element-thumbnail">\n                                    <i class="z-1 {{item.element|typeIcon}}"></i>\n                                </div>\n\n                                <div class="layer-content-section layer-title-wrapper">\n                                    <span class="z-1 layer-title" ng-if="!item.element.rename && !(layerSearch.query || \'\').trim()">{{item.element.name\n                                        ||\n                                        getDefaultLayerName(item.element)}}</span>\n                                    <span class="z-1 layer-title" ng-if="!item.element.rename && (layerSearch.query || \'\').trim()" ng-bind-html="getLayerDisplayNameHighlighted(item.element)"></span>\n                                    <input class="z-1" ng-if="item.element.rename" select-all maxlength="20" blur-on-enter ng-model="item.element.name" ng-keydown="cancelLayerRename($event, item.element)" ng-blur="item.element.rename=false;updateComplicationName(item.element)"/>\n                                </div>\n\n                                <div class="layer-content-section layer-action-stack" ng-if="canUseThemes() && layerSupportsThemes(item.element)">\n                                    <i feature-id="theming" class="icon-themes icon-preview layer-show z-1" ng-click="$event.stopPropagation();toggleThemeability(item.element)" ng-class="{\n                                        \'active\': layerIsThemeable(item.element),\n                                        \'theme-intro-highlight\': needsThemeIntro && $index == 0,\n                                    }" title="Toggle themeable"></i>\n                                </div>\n\n                                <div class="layer-content-section layer-action-stack">\n                                    <i ng-if="!supportsDimMode()" class="icon-preview layer-show z-1" ng-click="$event.stopPropagation();toggleLayerVisibility(item.element)" ng-class="{\'active\': item.element.state_active_1}" title="Show/Hide"></i>\n                                    <i ng-if="supportsDimMode() && !editor.options.dimMode" class="icon-preview layer-show z-1" ng-click="$event.stopPropagation();toggleLayerVisibility(item.element)" ng-class="{\'active\': item.element.state_active_1}" title="Show/Hide in Active Mode"></i>\n\n                                    <i ng-if="supportsDimMode() && editor.options.dimMode" class="icon-preview layer-show z-1" ng-click="$event.stopPropagation();toggleLayerVisibility(item.element)" ng-class="{\'active\': item.element.low_power}" title="Show/Hide in Dim Mode"></i>\n                                </div>\n                                <div class="layer-content-section layer-action-stack layer-action-stack--menu">\n                                    <button type="button" class="layer-list-standard__context-trigger" title="Open context menu" aria-label="Open context menu" ng-mousedown="$event.stopPropagation()" ng-click="openItemContextMenu($event, item)">\n                                        <i class="icon-more z-1"></i>\n                                    </button>\n                                </div>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <div ng-if="!filteredStandardLayerList.length" class="layer-list-standard__empty-state">\n                        <span ng-if="layerSearch.query">No elements found.</span>\n                        <button ng-if="layerSearch.query" type="button" class="layer-list-standard__empty-state-reset" ng-click="layerSearch.query = \'\'">Clear search</button>\n                        <span ng-if="!layerSearch.query">No elements yet.</span>\n                    </div>\n\n                    <div ng-show="hasBackground() && !getLayerMenuConfig().hideBackgroundLayers" class="layer-list-standard__background-section">\n                        <hr class="layer-list-standard__separator"/>\n                        <div class="palette-items">\n                            <div ng-if="hasBackground()" ng-click="deselectElement();selectBackgroundImage();enableBackgroundDropdown(getBackgroundImage(editor.options.circularCanvas, editor.options.dimMode));addLayer.open = false;" class="layer layer--small" ng-class="{\'selected\': subpalette.name == \'background_image\' || editor.selectedElement.type_opt == \'background_image\', \'hovered\': editor.hoveredElement.id == 1}">\n                                <div class="layer-selection-box z-1"></div>\n                                <div class="layer-content-section element-thumbnail z-1">\n                                    <i class="icon-image"></i>\n                                </div>\n                                <div class="layer-content-section layer-title-wrapper z-1">\n                                    <span class="layer-title">\n                                        Background Image\n                                    </span>\n                                </div>\n                            </div>\n\n                            <div ng-if="hasBackground()" ng-click="deselectElement();addLayer.open = false" class="layer unhoverable layer--small">\n\n                                <div class="layer-content-section element-thumbnail">\n                                    <i class="icon-bg-color"></i>\n                                </div>\n                                <div class="layer-content-section layer-title-wrapper">\n                                    <span class="layer-title">\n                                        Background Color\n                                    </span>\n                                </div>\n                                <div class="layer-content-section">\n                                    <div id="bgColor" class="colorpicker-input btn btn-default color-control" style="background-color: {{getBackgroundColor()}}" bg-layer colorpicker colorpicker-palette="getColorsUsed()" ng-model="backgroundColor" ng-change="updateBackgroundColor(backgroundColor)" debounced face-input>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n\n                <div ng-show="editor.selectedComplicationLayer" class="palette-section-new palette-section">\n                    <hr>\n                    <div class="palette-title">\n                        LIMITED REFRESH RATE\n                    </div>\n                    <div class="palette-body">\n                        <div class="palette-body-text">\n                            Apple Watch complications may only refresh every 15 minutes on device. Please take this\n                            into\n                            account in your design.\n                            <a class="text-link" href="https://help.facercreator.io/hc/en-us/articles/4412565623579-Limitations-of-Apple-Watch" target="_blank">Read More</a>\n                        </div>\n                    </div>\n                </div>\n\n                <div ng-if="isChimesFeatureEnabled" class="palette-wrapper">\n                    <div class="palette-section-scroll-group palette-section palette-section-new">\n                        <div class="palette-section palette-section-new"></div>\n                        <hr/>\n                        <div class="palette-title">\n                            Watch face configuration\n                        </div>\n                        <div class="palette-body">\n                            <div class="configurator-option">\n                                <div class="configurator-option__label has-icon">Face Chime <facer-tooltip title="A subtle chime that plays at the top of the hour when the user wears your watch face." icon="info"></facer-tooltip></div>\n                                <div class="configurator-option__options">\n                                    <watchface-configurator-chime-select-field options="configuratorHourlyChimeOptions" default-value="configuratorDefaultHourlyChimeValue" on-select="handleConfiguratorHourlyChimeSelection(selectedOption)" watchface-id="{{watchfaceId}}" type="text-list"></watchface-configurator-chime-select-field>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},85234:e=>{var n="/html/legacy-toolbar.component.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div ng-show="(isWatchOs11Template() && isRawEditMode() || !isWatchOs11Template()) && !isSlideshowMode() && editor.selectedElement && !elementIsComplication(editor.selectedElement) && !elementIsWatchOsComplication(editor.selectedElement) && editor.selectedElement.type_opt !== \'image_sequence\' && editor.selectedElement.type_opt !== \'progress_bar\'" class="btn-toolbar">\n    <div ng-show="editor.selectedElement && (editor.selectedElement.type == \'dynamic_image\' || editor.selectedElement.type == \'image\') && editor.selectedElement.type_opt !== \'background_image\' && editor.selectedElement.type_opt && editor.selectedElement.type_opt !== \'weather_icons\' && editor.selectedElement.type_opt !== \'watch_battery_icons\' && editor.selectedElement.type_opt !== \'moon_phase_icons\' && editor.selectedElement.type_opt !== \'wifi\' && editor.selectedElement.type_opt !== \'complication_image\' && editor.selectedElement.type_opt !== \'image_sequence\'" class="btn-group btn-set">\n        <button id="styles" class="btn btn-default" ng-click="editor.toolbar.showStyles=!editor.toolbar.showStyles" ng-class="{\'active\': editor.toolbar.showStyles}">\n            <b>Styles</b>\n        </button>\n    </div>\n\n    <div ng-show="editor.options.rawEditMode && editor.selectedElement && (editor.selectedElement.tags || []).indexOf(\'watchos-complication\') > -1" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Source: </b><span ng-bind="getComplicationName(editor.selectedElement)"></span>\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div class="text-style-list-group">\n                    <div class="list-group">\n                        <a ng-click="updateComplicationDefault(null, editor.selectedElement);updateSelectedElement()" href class="list-group-item">\n                            <small class="list-group-item-text text-muted">\n                                --\n                            </small>\n                            <h4 class="list-group-item-heading">\n                                None\n                            </h4>\n                        </a>\n                    </div>\n                    <div class="list-group">\n                        <a ng-click="updateComplicationDefault(\'layer_\' + editor.selectedElement.uid, editor.selectedElement);updateSelectedElement()" href class="list-group-item">\n                            <small class="list-group-item-text text-muted">\n                                (for watchOS templates)\n                            </small>\n                            <h4 class="list-group-item-heading">\n                                Element Mask\n                            </h4>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n\n    <div ng-if="editor.selectedElement && (editor.selectedElement.type_opt.slice(0, 17) == \'complication_text\' || editor.selectedElement.type_opt == \'complication_image\')" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Default Data: </b><span ng-bind="getComplicationName(editor.selectedElement)"></span>\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div ng-if="editor.selectedElement.type_opt == preset.value" ng-repeat="preset in option.presets" class="text-style-list-group">\n                    <div class="list-group" ng-repeat="option in preset.options">\n                        <a ng-click="updateComplicationDefault(option.providerKey, editor.selectedElement);updateSelectedElement()" href class="list-group-item">\n                            <small class="list-group-item-text text-muted">\n                                {{option.name}}\n                            </small>\n                            <h4 ng-show="editor.selectedElement.type_opt.slice(0, 17) == \'complication_text\'" class="list-group-item-heading">\n                                {{parse(editor.tag.complication_data[option.providerKey][getComplicationType(editor.selectedElement)]())}}\n                            </h4>\n                            <div ng-show="editor.selectedElement.type_opt == \'complication_image\'" class="list-group-item-header-image">\n                                <img ng-src="{{getComplicationImage(option.providerKey)}}"/>\n                            </div>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'text\' && editor.selectedElement.type_opt && editor.selectedElement.type_opt.slice(0, 17) != \'complication_text\'" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Styles</b>\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div ng-if="editor.selectedElement.type == \'text\' && editor.selectedElement.type_opt == preset.value" ng-repeat="preset in option.presets" class="text-style-list-group">\n                    <div class="list-group" ng-repeat="style in preset.styles">\n                        <a ng-click="editor.selectedElement.text=style.value;updateSelectedElement()" href class="list-group-item" ng-class="{\'active\': editor.selectedElement.text == style.value}">\n                            <h4 class="list-group-item-heading">\n                                {{parse(style.value)}}\n                            </h4>\n                            <small class="list-group-item-text text-muted">\n                                {{style.name}}\n                            </small>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'shape_3d\'" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Presets: </b><span ng-bind="getShaderName(editor.selectedElement)"></span>\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div ng-if="editor.selectedElement.type == \'shape_3d\' && editor.selectedElement.type == preset.value" ng-repeat="preset in option.presets" class="text-style-list-group">\n                    <div class="list-group" ng-repeat="style in preset.styles">\n                        <a ng-click="editor.setLayerShader_____(editor.selectedElement, style.fragment_shader_raw_text);scriptEditor.value=style.fragment_shader_raw_text;updateSelectedElement()" href class="list-group-item" ng-class="{\'active\': editor.selectedElement.fragment_shader_raw_text == style.fragment_shader_raw_text}">\n                            <h4 class="list-group-item-heading">\n                                {{style.presetName}}\n                            </h4>\n                            <small class="list-group-item-text text-muted">\n                                {{style.description}}\n                            </small>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type_opt == \'sound_effect\'" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Presets: </b><span ng-bind="getSoundEffectName(editor.selectedElement)"></span>\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div ng-if="editor.selectedElement.type_opt == \'sound_effect\' && editor.selectedElement.type_opt == preset.value" ng-repeat="preset in option.presets" class="text-style-list-group">\n                    <div class="list-group" ng-repeat="style in preset.styles">\n                        <a ng-click="setLayerSoundEffect(editor.selectedElement, style.url);updateSelectedElement()" href class="list-group-item" ng-class="{\'active\': editor.selectedElement.interaction.action.sound_resource.filename == style.url}">\n                            <h4 class="list-group-item-heading">\n                                {{style.presetName}}\n                            </h4>\n                            <small class="list-group-item-text text-muted">\n                                {{style.description}}\n                            </small>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n    <div bg-layer ng-show="editor.selectedElement.type_opt == \'background_image\' && googleIoMode" class="btn-group btn-set">\n        <button ng-click="removeBackgroundImage()" class="btn btn-default" type="button">\n            <b>Reset Image</b>\n        </button>\n    </div>\n\n    <div bg-layer id="backgroundImage" ng-show="editor.selectedElement.type_opt == \'background_image\'" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default" ng-click="editor.toolbar.showStyles=!editor.toolbar.showStyles" ng-class="{\'active\': editor.toolbar.showStyles}">\n            <b>Styles</b>\n        </button>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'shape\' && elementIsInteractionWidget(editor.selectedElement) && interactionLayerHasStyles(editor.selectedElement)" class="btn-group dropup btn-set">\n        <button id="styles" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Action:</b> {{getInteractionDescription(editor.selectedElement)}}\n        </button>\n        <ul class="dropdown-menu text-style-list" role="menu" aria-labelledby="styles">\n            <div class="scroll">\n                <div ng-if="editor.selectedElement.type == \'shape\' && editor.selectedElement.type_opt == preset.value" ng-repeat="preset in option.presets" class="text-style-list-group">\n                    <div class="list-group" ng-repeat="style in preset.styles">\n                        <a ng-click="editor.selectedElement.interaction=style.interaction;updateSelectedElement()" href class="list-group-item" ng-class="{\'active\': editor.selectedElement.interaction == style.interaction}">\n                            <h4 class="list-group-item-heading">\n                                {{style.name}}\n                            </h4>\n                            <small class="list-group-item-text text-muted">\n                                {{style.description}}\n                            </small>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </ul>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'shape\'" class="btn-group btn-set">\n        <button class="btn btn-default" ng-click="editor.selectedElement.shape_type=0;updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.shape_type==0}">\n            Circle\n        </button>\n        <button class="btn btn-default" ng-click="editor.selectedElement.shape_type=1;applyShapeDefaults(\'square\');updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.shape_type==1}">\n            Rectangle\n        </button>\n        <button ng-if="!elementIsInteractionWidget(editor.selectedElement)" class="btn btn-default" ng-click="editor.selectedElement.shape_type=4;updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.shape_type==4}">\n            Triangle\n        </button>\n        <button ng-if="!elementIsInteractionWidget(editor.selectedElement)" class="btn btn-default" ng-click="editor.selectedElement.shape_type=5;applyShapeDefaults(\'donut\');updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.shape_type==5}">\n            Arc\n        </button>\n        <button feature-id="polygon-element" ng-if="accessible && !elementIsInteractionWidget(editor.selectedElement)" class="btn btn-default" ng-click="editor.selectedElement.shape_type=2;updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.shape_type==2}">\n            Polygon\n        </button>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'shape\' && !elementIsInteractionWidget(editor.selectedElement)" class="btn-group btn-set">\n        <div class="btn-group dropup" ng-show="editor.selectedElement.shape_type !== 5">\n            <button id="shapeOpt" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                {{ option.shape.colorType[editor.selectedElement.shape_opt] }}\n            </button>\n            <ul class="dropdown-menu" role="menu" aria-labelledby="textEffect">\n                <li ng-repeat="type in option.shape.colorType" role="presentation">\n                    <a href ng-click="editor.selectedElement.shape_opt=$index;updateSelectedElement(true);closeDropdown(\'shapeOpt\')" role="menuitem">{{type}}</a>\n                </li>\n            </ul>\n        </div>\n        <div ng-show="editor.selectedElement.shape_opt == 1 && editor.selectedElement.shape_type !== 5" class="btn-group dropup">\n            <button id="strokeWidth" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                {{ editor.selectedElement.stroke_size ? parseInt(editor.selectedElement.stroke_size) : 0 }}\n            </button>\n            <ul class="dropdown-menu" role="menu" aria-labelledby="strokeWidth">\n                <li ng-repeat="width in option.text.strokeWidth" role="presentation">\n                    <a href ng-click="editor.selectedElement.stroke_size=width+\'\';updateSelectedElement(true);closeDropdown(\'strokeWidth\')" role="menuitem">{{width}}</a>\n                </li>\n            </ul>\n        </div>\n        <div class="btn-group" ng-class="{\'is-theme-controlled\': layerIsThemeable(editor.selectedElement)}" ng-attr-title="{{layerIsThemeable(editor.selectedElement) ? \'Controlled by Theme\' : undefined}}" tooltip data-toggle="tooltip">\n            <button class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.color" ng-change="updateSelectedElement()" debounced face-input ng-class="{\'disabled\': layerIsThemeable(editor.selectedElement)}">\n                Color\n                <div class="button-label" style="background:{{editor.selectedElement.color|toHex}};">\n                </div>\n            </button>\n        </div>\n    </div>\n\n    <div ng-show="editor.selectedElement && (editor.selectedElement.type == \'dynamic_image\' || editor.selectedElement.type == \'image\') && subpalette.name !== \'background_image\' &&  !editor.selectedElement.type_opt" class="btn-group dropup btn-set">\n        <div ng-if="!googleIoMode" class="upload-control is-clickable toolbar-control">\n            <button class="btn btn-default btn-block" ng-click="triggerImageUpload()">\n                Set Image\n            </button>\n        </div>\n    </div>\n\n    <div ng-show="editor.selectedElement && (editor.selectedElement.type == \'dynamic_image\' || editor.selectedElement.type == \'image\') && !editor.selectedElement.uses_image_preset && editor.selectedElement.type_opt !== \'background_image\' && editor.selectedElement.type_opt !== \'image_sequence\'" class="btn-group dropup btn-set">\n        <button id="alignment" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            Align <i class="icon-align-{{ option.image.align[editor.selectedElement.alignment] }}"></i>\n        </button>\n        <ul class="dropdown-menu alignment-control" role="menu" aria-labelledby="alignment">\n            <li role="presentation">\n                <form class="alignment-form">\n                    <input type="radio" ng-repeat="(option, name) in option.image.align" ng-value="option" ng-model="editor.selectedElement.alignment" face-input int ng-change="updateSelectedElement()"/>\n                </form>\n            </li>\n        </ul>\n    </div>\n    <div ng-show="editor.selectedElement && (editor.selectedElement.type == \'dynamic_image\' || editor.selectedElement.type == \'image\') && editor.selectedElement.type_opt !== \'background_image\' && editor.selectedElement.type_opt !== \'image_sequence\' && !(editor.selectedElement.type_opt|isTintable)  && editor.selectedElement.type_opt !== \'complication_image\'" class="btn-group btn-set" ng-class="{\'is-theme-controlled\': layerIsThemeable(editor.selectedElement)}" ng-attr-title="{{layerIsThemeable(editor.selectedElement) ? \'Controlled by Theme\' : undefined}}" tooltip data-toggle="tooltip">\n        <button class="btn btn-default" ng-click="editor.selectedElement.is_tinted=!editor.selectedElement.is_tinted;updateSelectedElement(true, true)" ng-class="{\'active\': editor.selectedElement.is_tinted, \'disabled\': layerIsThemeable(editor.selectedElement)}">\n            Tint\n        </button>\n        <button ng-if="editor.selectedElement.is_tinted" class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.tint_color" ng-change="updateSelectedElement(false, true)" debounced face-input ng-class="{\'disabled\': layerIsThemeable(editor.selectedElement)}">\n            Color\n            <div class="button-label" style="background:{{editor.selectedElement.tint_color|toHex}};">\n            </div>\n        </button>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type_opt && (editor.selectedElement.type_opt|isTintable)" class="btn-group btn-set" ng-class="{\'is-theme-controlled\': layerIsThemeable(editor.selectedElement)}" ng-attr-title="{{layerIsThemeable(editor.selectedElement) ? \'Controlled by Theme\' : undefined}}" tooltip data-toggle="tooltip">\n        <button ng-class="{\'disabled\': layerIsThemeable(editor.selectedElement)}" class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.tint_color" ng-change="updateSelectedElement(false, true)" debounced face-input>\n            Color\n            <div class="button-label" style="background:{{editor.selectedElement.tint_color|toHex}};">\n            </div>\n        </button>\n    </div>\n\n    <div ng-show="subpalette.name == \'background_color\'" class="btn-group btn-set">\n        <button bg-layer class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="backgroundColor" ng-change="updateBackgroundColor(backgroundColor)" debounced face-input>\n            Color\n            <div class="button-label" style="background-color:{{backgroundColor}};">\n            </div>\n        </button>\n    </div>\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'text\'" class="btn-group btn-set">\n        <font-input label="font" field="font_hash" class="btn-group dropup"></font-input>\n        <div class="btn-group dropup">\n            <button id="fontSize" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                {{ editor.selectedElement.size && parseInt(editor.selectedElement.size) }}\n            </button>\n            <ul class="dropdown-menu" role="menu" aria-labelledby="fontSize">\n                <li ng-repeat="size in option.font.size" role="presentation">\n                    <a ng-click="editor.selectedElement.size=size+\'\';updateSelectedElement(true);closeDropdown(\'fontSize\')" role="menuitem" style="font-size:{{size}}px;font-family:{{font.value}} !important;">{{size}}</a>\n                </li>\n            </ul>\n        </div>\n        <div class="btn-group" ng-if="!editor.options.dimMode" ng-class="{\'is-theme-controlled\': layerIsThemeable(editor.selectedElement)}" ng-attr-title="{{layerIsThemeable(editor.selectedElement) ? \'Controlled by Theme\' : undefined}}" tooltip data-toggle="tooltip">\n            <button class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.color" ng-change="updateSelectedElement()" debounced face-input ng-class="{\'disabled\': layerIsThemeable(editor.selectedElement)}">\n                Color\n                <div class="button-label" style="background:{{editor.selectedElement.color|toHex}};">\n                </div>\n            </button>\n        </div>\n        <div class="btn-group" ng-if="editor.options.dimMode">\n            <button class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.low_power_color" ng-change="updateSelectedElement()" debounced face-input>\n                Dim Color\n                <div class="button-label" style="background:{{editor.selectedElement.low_power_color|toHex}};">\n                </div>\n            </button>\n        </div>\n    </div>\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'text\'" class="btn-group btn-set">\n        <button class="btn btn-default" ng-click="editor.selectedElement.alignment=0;updateSelectedElement()" ng-class="{\'active\': editor.selectedElement.alignment==0}">\n            <span class="glyphicon glyphicon-align-left"></span>\n        </button>\n        <button class="btn btn-default" ng-click="editor.selectedElement.alignment=1;updateSelectedElement()" ng-class="{\'active\': editor.selectedElement.alignment==1}">\n            <span class="glyphicon glyphicon-align-center"></span>\n        </button>\n        <button class="btn btn-default" ng-click="editor.selectedElement.alignment=2;updateSelectedElement()" ng-class="{\'active\': editor.selectedElement.alignment==2}">\n            <span class="glyphicon glyphicon-align-right"></span>\n        </button>\n        <button class="btn btn-default button-icon" ng-click="editor.selectedElement.transform=(editor.selectedElement.transform==1 ? 0 : 1);updateSelectedElement()" ng-class="{\'active\': editor.selectedElement.transform==1}">\n            <i class="icon-uppercase"></i>\n        </button>\n        <button class="btn btn-default button-icon" ng-click="editor.selectedElement.transform=(editor.selectedElement.transform==2 ? 0 : 2);updateSelectedElement()" ng-class="{\'active\': editor.selectedElement.transform==2}">\n            <i class="icon-lowercase"></i>\n        </button>\n    </div>\n\n    <div ng-show="editor.selectedElement && subpalette.name !== \'background_image\' && editor.selectedElement.type_opt !== \'weather_icons\' && editor.selectedElement.type_opt !== \'watch_battery_icons\' && editor.selectedElement.type_opt !== \'moon_phase_icons\' && editor.selectedElement.type_opt !== \'wifi\' && editor.selectedElement.type_opt !== \'image_sequence\' && !elementIsInteractionWidget(editor.selectedElement)" class="btn-group dropup btn-set">\n        <button id="opacity" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Opacity: </b>{{ parseInt(editor.selectedElement.opacity) }}%\n        </button>\n        <ul class="dropdown-menu vertical-slider" role="menu" aria-labelledby="opacity">\n            <li role="presentation">\n                <div class="relative">\n                    <input type="range" ng-model="editor.selectedElement.opacity" ng-change="updateSelectedElement();" debounce face-input min="0" max="100"/>\n                    <div ng-if="editor.selectedElement.opacityLock" ng-mousedown="checkLock(\'opacity\');" class="input-lock"></div>\n                </div>\n            </li>\n        </ul>\n    </div>\n\n    <div bg-layer ng-show="subpalette.name == \'background_image\'" class="btn-group dropup btn-set">\n        <button id="opacity" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n            <b>Opacity: </b>{{ parseInt(opacity) }}%\n        </button>\n        <ul class="dropdown-menu vertical-slider" role="menu" aria-labelledby="opacity">\n            <li role="presentation">\n                <div class="relative">\n                    <input type="range" ng-model="opacity" ng-change="updateBackgroundImage(\'opacity\')" debounce face-input min="0" max="100"/>\n                </div>\n            </li>\n        </ul>\n    </div>\n\n\n    <div ng-show="editor.selectedElement && editor.selectedElement.type == \'text\'" class="btn-group btn-set">\n        <div class="btn-group dropup">\n            <button id="textEffect" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true" ng-click="updateDropdowns();">\n                <b>Effect: </b>{{ option.text.effect[editor.selectedElement.text_effect || 0] }}\n            </button>\n            <ul class="dropdown-menu" role="menu" aria-labelledby="textEffect">\n                <li ng-repeat="effect in option.text.effect" role="presentation">\n                    <a href ng-click="editor.selectedElement.text_effect=$index;updateSelectedElement(true);closeDropdown(\'textEffect\');updateDropdowns();" role="menuitem">{{effect}}</a>\n                </li>\n            </ul>\n        </div>\n        <div ng-if="editor.selectedElement.text_effect == 1" ng-init="updateDropdowns()" class="btn-group dropup">\n            <button id="strokeWidth" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                {{ editor.selectedElement.stroke_size ? parseInt(editor.selectedElement.stroke_size) : 0 }}\n            </button>\n            <ul class="dropdown-menu" role="menu" aria-labelledby="strokeWidth">\n                <li ng-repeat="width in option.text.strokeWidth" role="presentation">\n                    <a href ng-click="editor.selectedElement.stroke_size=width+\'\';updateSelectedElement(true);closeDropdown(\'strokeWidth\')" role="menuitem">{{width}}</a>\n                </li>\n            </ul>\n        </div>\n        <button ng-if="editor.selectedElement.text_effect == 1" class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.stroke_color" ng-change="updateSelectedElement()" debounced face-input>\n            Color\n            <div class="button-label" style="background:{{editor.selectedElement.stroke_color|toHex}};">\n            </div>\n        </button>\n        <div ng-init="updateDropdowns();" ng-if="editor.selectedElement.text_effect == 2" class="btn-group dropup">\n            <button id="glowSize" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                {{ editor.selectedElement.glow_size ? parseInt(editor.selectedElement.glow_size) : 0 }}\n            </button>\n            <ul class="dropdown-menu vertical-slider" role="menu" aria-labelledby="glowSize">\n                <li role="presentation">\n                    <input type="range" min="0" max="100" ng-model="editor.selectedElement.glow_size" ng-value="editor.selectedElement.glow_size || 0" ng-change="updateSelectedElement()">\n                </li>\n            </ul>\n        </div>\n        <button ng-if="editor.selectedElement.text_effect == 2" class="btn btn-default color-control" colorpicker colorpicker-palette="getColorsUsed()" ng-model="editor.selectedElement.glow_color" ng-change="updateSelectedElement()" debounced face-input>\n            Color\n            <div class="button-label" style="background:{{editor.selectedElement.glow_color|toHex}};">\n            </div>\n        <