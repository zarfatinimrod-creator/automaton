 selected.type == \'user\'">\n\t\t\t\t\t\t\t\t\t<a class="text-link" show-sales-reports target="_blank">VIEW SALES REPORTS</a>\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t<span ng-show="selected.type == \'watchface\'">\n\t\t\t\t\t\t\t\t\t<a class="text-link" target="_blank" ui-sref="facer.watchface({watchface:selected.id})">VIEW</a>\n\t\t\t\t\t\t\t\t\t<a class="text-link" ui-sref="facer.editWatchface({watchface:selected.id})">EDIT</a>\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<a ui-sref="facer.admin.topCharts" ng-show="user.rank > 0 && selected.type == \'user\' && isAdmin" class="stat-label-secondary">\n\t\t\t\t\t\t\t\t#{{user.rank}} in Top Designers\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t<span ng-show="user.rank > 0 && selected.type == \'user\' && !isAdmin" class="stat-label-secondary">\n\t\t\t\t\t\t\t\t#{{user.rank}} in Top Designers\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</h2>\n\t\t\t\t\t<button class="pull-right" ng-disable>Last 30 days</button>\n\t\t\t\t</div>\n\t\t\t\t<div class="highlight-stats row">\n\t\t\t\t\t<div ng-repeat="stat in selected.stats.values" class="highlight-stat col-xs-4">\n\t\t\t\t\t\t<div class="highlight-stat-value">{{stat.aggregate.value|largeNumber}}</div>\n\t\t\t\t\t\t<div class="highlight-stat-label">{{stat.aggregate.label}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="insight-grid-wrapper main-grid-wrapper">\n\t\t\t\t\t<div class="insight-grid-2">\n\t\t\t\t\t\t<chart ng-if="data" data="data" no-use-alt-legend></chart>\n\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="insight-grid-1 insight-pie-wrapper">\n\t\t\t\t\t\t<h3>Top Devices <small class="text-muted">by sync count</small></h3>\n\t\t\t\t\t\t<div class="insight-pie-1">\n\t\t\t\t\t\t\t<chart ng-if="pieChartData" type="doughnut" cutout-percent="50" data="pieChartData" no-use-alt-legend></chart>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="insight-grid-wrapper">\n\t\t\t\t\t<div class="insight-grid-2">\n\t\t\t\t\t\