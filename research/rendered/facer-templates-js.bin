.attachment">\n                        <i class="icon-image"></i>\n                    </span>\n                    <span class="notification-feed-item-comment-reply-wrapper">\n                        <span class="notification-feed-item-comment-replied" ng-show="entry.item.hasReplied">\n                            - Replied\n                        </span>\n                        <span class="notification-feed-item-comment-reply" ng-click="$event.preventDefault();$event.stopPropagation();reply(entry.item)" ng-show="!entry.item.hasReplied">\n                            &nbsp; Reply\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <div class="notification-feed-item-image-wrapper">\n                <img ng-src="{{ entry.item.preview.image }}" class="notification-feed-item-image no-skin-watch-container {{ entry.item.preview.watch }}"/>\n            </div>\n        </a>\n    </ul>\n</div>\n')}]),e.exports=n},87593:e=>{var n="/html/header/current-user.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<profile-menu menu-align="right" toggle-class="btn btn-link dropdown-toggle" hide-caret="true" btn-group></profile-menu>')}]),e.exports=n},43461:e=>{var n="/html/header/editor-support.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-show="!browsingMode && currentUser()" id="editorSupport" class="btn-group scrollable dropdown">\n    <a alt="Editor Support" href="#" class="btn navbar-btn dropdown-toggle editor-navbar-btn" data-toggle="dropdown" role="button" aria-expanded="false">\n        <facer-icon icon="help-circle"></facer-icon>\n    </a>\n    <ul class="dropdown-menu dropdown-menu-right editor-dropdown__list" role="menu">\n        <a ng-repeat="item in links" ng-href="{{ item.url }}" class="editor-dropdown__item" ng-class="{ \'has-divider\': item.divider }" target="{{item.target}}">\n           