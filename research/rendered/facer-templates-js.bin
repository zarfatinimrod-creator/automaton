}">Search countries</label>\n        <input id="{{ searchId }}" class="country-select__search" type="search" ng-model="search.query" ng-keydown="onSearchKeydown($event)" placeholder="Search countries" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="{{ listboxId }}" aria-activedescendant="{{ activeOptionId() }}"/>\n\n        <ul id="{{ listboxId }}" class="country-select__options" role="listbox" aria-label="Countries">\n            <li role="none">\n                <button id="{{ listboxId }}-clear" type="button" class="country-select__option country-select__option--clear" role="option" tabindex="-1" ng-class="{ \'is-active\': activeIndex === 0 }" aria-selected="{{ !selectedCode }}" ng-mouseenter="setActiveIndex(0)" ng-click="selectCountry(null, $event)">\n                    Prefer not to say\n                </button>\n            </li>\n            <li ng-repeat="country in filteredCountries track by country.code" role="none">\n                <button id="{{ listboxId }}-{{ country.code }}" type="button" class="country-select__option" role="option" tabindex="-1" ng-class="{\n                        \'is-active\': activeIndex === $index + 1,\n                        \'is-selected\': selectedCode === country.code\n                    }" aria-selected="{{ selectedCode === country.code }}" ng-mouseenter="setActiveIndex($index + 1)" ng-click="selectCountry(country, $event)">\n                    <span class="country-select__label">\n                        <img class="country-select__flag" ng-src="{{ countryFlagUrl(country.code) }}" alt=""/>\n                        <span>{{ country.name }}</span>\n                    </span>\n                </button>\n            </li>\n        </ul>\n\n        <div class="country-select__empty" ng-if="!filteredCountries.length" role="status">\n            No countries found\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},11555:e=>{var n="/components/_global/facer-dropdown/facer-dropdown.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-dropdown" ng-class="{\'facer-dropdown--open\': isOpen()}">\n    <div ng-transclude></div>\n</div>')}]),e.exports=n},91151:e=>{var n="/components/_global/facer-pill/facer-pill.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,"<div class=\"facer-pill\" ng-class=\"{'facer-pill--dark': isDark, 'facer-pill--info': state === 'info', 'facer-pill--translucent': isTranslucent}\" style=\"background-color: {{ backgroundColor }}; color: {{ textColor }}; font-size: {{ selectedSize.fontSize }};\">\n    <span ng-if=\"label\">{{label}}</span>\n</div>")}]),e.exports=n},58253:e=>{var n="/components/_global/facer-pill/variants/facer-pill-beta.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<facer-tooltip title="WFF support is in beta. Please make sure to test your faces on a Wear OS 6 device before publishing" ng-if="!hideTooltip" placement="placement">\n    <facer-pill state="info" label="Beta" is-dark="isDark"></facer-pill>\n</facer-tooltip>\n\n<facer-pill state="info" label="Beta" is-dark="isDark" ng-if="hideTooltip"></facer-pill>')}]),e.exports=n},17710:e=>{var n="/components/_global/facer-pill/variants/facer-pill-pro.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<facer-pill label="PRO" background-color="var(--facer-gold)" text-color="var(--white)"></facer-pill>\n')}]),e.exports=n},93757:e=>{var n="/components/_global/facer-portal/facer-portal.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="anchored-portal__panel">\n    <div class="anchored-portal__content"></div>\n</div>')}]),e.exports=n},33297:e=>{var n="/components/admin/debug/admin-debug.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-debug">\n    <div class="admin-debug__back">\n        <a ui-sref="facer.admin">Back to Admin</a>\n    </div>\n    <div class="admin-debug__section">\n        <h3>Remote Config</h3>\n        <p>Get a remote config value by key. Make sure you configure the key in the <a href="https://console.firebase.google.com/u/0/project/api-project-455834515391/config/env/firebase?query=test" target="_blank">Facer\n                Firebase project</a>.</p>\n        <input type="text" ng-model="key" placeholder="Key"/>\n        <button ng-click="getRemoteConfig(key)">Fetch Config</button>\n        <h3>Response</h3>\n        <pre>{{ response }}</pre>\n    </div>\n</div>')}]),e.exports=n},68022:e=>{var n="/components/admin/feature-flags/feature-flags.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="feature-flags-admin">\n    <div class="admin-debug__back">\n        <a ui-sref="facer.admin">Back to Admin</a>\n    </div>\n\n    <div class="page-header">\n        <div class="d-flex justify-content-between align-items-center">\n            <div>\n                <h1>Feature Flags</h1>\n                <p class="text-muted">Inspect Remote Config per Firebase project; override flags locally for testing</p>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Success Message --\x3e\n    <div ng-if="successMessage" class="alert alert-success alert-dismissible" role="alert">\n        <button type="button" class="close" ng-click="clearSuccessMessage()" aria-label="Close">\n            <span aria-hidden="true">&times;</span>\n        </button>\n        {{ successMessage }}\n    </div>\n\n    \x3c!-- Error Message --\x3e\n    <div ng-if="error" class="alert alert-danger alert-dismissible" role="alert">\n        <button type="button" class="close" ng-click="clearError()" aria-label="Close">\n            <span aria-hidden="true">&times;</span>\n        </button>\n        {{ error }}\n    </div>\n\n    \x3c!-- Loading State --\x3e\n    <div ng-if="loading" class="text-center">\n        <div class="spinner-border" role="status">\n            <span class="sr-only">Loading...</span>\n        </div>\n        <p class="mt-2">Loading feature flags...</p>\n    </div>\n\n    \x3c!-- Missing in both Firebase projects --\x3e\n    <div ng-if="!loading && missingInBothFlags.length > 0" class="card mb-4">\n        <div class="card-header">\n            <h5 class="mb-0 text-warning">\n                <i class="fa fa-exclamation-triangle"></i>\n                Not in Remote Config (both projects)\n            </h5>\n        </div>\n        <div class="card-body">\n            <p class="text-muted mb-3">\n                These keys are in the app flag list but not published in either Firebase\n                project\'s Remote Config template. They may not be created yet or removed.\n            </p>\n            <ul class="mb-0 list-unstyled">\n                <li ng-repeat="flag in missingInBothFlags" class="mb-1">\n                    <code>{{ flag.key }}</code>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    \x3c!-- Feature Flags by project --\x3e\n    <div ng-if="!loading && featureFlags.length > 0">\n        <div class="card mb-4" ng-repeat="section in projectSections">\n            <div class="card-header">\n                <h5 class="mb-0">\n                    {{ section.title }}\n                    <small class="text-muted">{{ section.projectId }}</small>\n                </h5>\n            </div>\n            <div class="card-body">\n                <p ng-if="getFlagsForSection(section.key).length === 0" class="text-muted mb-0">\n                    No feature flags are published in this project\'s Remote Config.\n                </p>\n                <div class="table-responsive" ng-if="getFlagsForSection(section.key).length > 0">\n                    <table class="table table-hover">\n                        <thead>\n                            <tr>\n                                <th>Feature Flag</th>\n                                <th>Local Override</th>\n                                <th>Remote</th>\n                                <th>Effective</th>\n                                <th>Actions</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr ng-repeat="flag in getFlagsForSection(section.key)">\n                                <td>\n                                    <code>{{ flag.key }}</code>\n                                </td>\n                                <td>\n                                    <span class="badge" ng-class="getLocalOverrideBadgeClass(flag)">\n                                        {{ getLocalOverrideLabel(flag) }}\n                                    </span>\n                                </td>\n                                <td>\n                                    <span class="badge" ng-class="getStatusBadgeClass(getRemote(flag, section.key).enabled)">\n                                        {{ getRemoteStatusLabel(getRemote(flag, section.key)) }}\n                                    </span>\n                                    <span class="badge" ng-class="getRemoteSourceBadgeClass(getRemote(flag, section.key))">\n                                        {{ getRemoteSourceLabel(getRemote(flag, section.key)) }}\n                                    </span>\n                                </td>\n                                <td>\n                                    <span class="badge" ng-class="getStatusBadgeClass(getEffective(flag, section.key))">\n                                        {{ getEffective(flag, section.key) ? \'Enabled\' : \'Disabled\' }}\n                                    </span>\n                                </td>\n                                <td>\n                                    <div class="btn-group" role="group">\n                                        <button type="button" class="btn btn-sm" ng-class="getToggleEnabledState(flag, section.key) ? \'btn-outline-danger\' : \'btn-outline-success\'" ng-click="toggleFeatureFlag(flag, section.key)" title="{{ getToggleEnabledState(flag, section.key) ? \'Disable locally\' : \'Enable locally\' }}">\n                                            <i class="fa" ng-class="getToggleEnabledState(flag, section.key) ? \'fa-toggle-off\' : \'fa-toggle-on\'"></i>\n                                            {{ getToggleEnabledState(flag, section.key) ? \'Disable\' : \'Enable\' }}\n                                        </button>\n                                        <button ng-if="flag.isLocallySet" type="button" class="btn btn-sm btn-outline-secondary" ng-click="resetOverride(flag)" title="Reset to remote config value">\n                                            <i class="fa fa-undo"></i>\n                                            Reset\n                                        </button>\n                                    </div>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Empty State --\x3e\n    <div ng-if="!loading && featureFlags.length === 0" class="text-center">\n        <div class="card">\n            <div class="card-body">\n                <i class="fa fa-flag-o fa-3x text-muted mb-3"></i>\n                <h5>No Feature Flags Found</h5>\n                <p class="text-muted">No feature flags are currently available.</p>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Instructions --\x3e\n    <div class="card mt-4">\n        <div class="card-header">\n            <h5 class="mb-0">How to Use</h5>\n        </div>\n        <div class="card-body">\n            <ul class="mb-0">\n                <li><strong>Two tables:</strong> <em>Facer Main</em> covers the main site and admin; <em>Facer\n                        Creator</em> covers the editor. Each table only lists flags published in that project\'s Remote\n                    Config.</li>\n                <li><strong>Missing in both:</strong> Flags not published in either project appear in the warning\n                    section above. They may not be created in Firebase yet.</li>\n                <li><strong>Enable/Disable:</strong> Use the toggle in either table to set a local override. It applies\n                    to <strong>both</strong> projects and updates both tables.</li>\n                <li><strong>Local Override:</strong> Stored in your browser\'s local storage and takes precedence over\n                    each project\'s remote config.</li>\n                <li><strong>Reset:</strong> Clears the local override so Effective in each table follows that table\'s\n                    Remote value again.</li>\n                <li><strong>Remote source badges:</strong>\n                    <span class="badge badge-info">remote</span> = fetched from that project\'s Remote Config;\n                    <span class="badge badge-default">static</span> = default template value;\n                    <span class="badge badge-secondary">missing</span> = key is not in that project\'s published Remote\n                    Config template.\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>')}]),e.exports=n},47968:e=>{var n="/components/admin/prerender-operations/prerender-operations.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">Prerender Operations</h1>\n    <p class="admin-rt-page__subtitle">\n        Monitor the environment-wide sitemap-warm queue and start the existing\n        guarded warming process.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-callout">\n        Queue counts are shared across every worker in\n        <strong>{{ status.environment || "the current environment" }}</strong>.\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Operational status">\n            <span class="admin-rt-muted" ng-if="status && !statusLoading">\n                Updated {{ status.fetchedAt | date : "medium" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadStatus()" ng-disabled="statusLoading || scheduleBusy">\n                {{ statusLoading ? "Refreshing…" : "Refresh" }}\n            </button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="statusLoading || statusError" loading="statusLoading" error="statusError" empty="false" on-retry="loadStatus()">\n        </admin-status-states>\n\n        <p class="admin-rt-muted" ng-if="status && !statusLoading && !statusError">\n            Environment: <strong>{{ status.environment }}</strong> · Queue:\n            <strong>{{ status.queue.name }}</strong>\n        </p>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="status && !statusLoading && !statusError">\n        <admin-toolbar heading="Sitemap warm queue">\n            <span class="admin-rt-pill" ng-class="\n                    status.canSchedule\n                        ? \'admin-rt-pill--ok\'\n                        : \'admin-rt-pill--warn\'\n                ">\n                {{\n                    status.canSchedule\n                        ? "Ready for a new warm"\n                        : "Existing warm in progress"\n                }}\n            </span>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Visible</span>\n                <strong>{{ status.queue.visible | number }}</strong>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">In flight</span>\n                <strong>{{ status.queue.inFlight | number }}</strong>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Delayed</span>\n                <strong>{{ status.queue.delayed | number }}</strong>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Total</span>\n                <strong>{{ status.queue.total | number }}</strong>\n            </div>\n        </div>\n        <p class="admin-rt-muted">\n            Completion time is intentionally not estimated because renders yield\n            to live crawler traffic.\n        </p>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="status && !statusLoading && !statusError">\n        <admin-toolbar heading="Cache policy"></admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Fresh period</span>\n                <span>{{ status.cachePolicy.freshDays | number }} days</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">\n                    Stale-while-revalidate\n                </span>\n                <span>\n                    {{ status.cachePolicy.staleWhileRevalidateDays | number }}\n                    days\n                </span>\n            </div>\n        </div>\n        <p class="admin-rt-muted">\n            Policy values come from the deployed application code. Loading this\n            page does not inspect cache objects or individual hosts.\n        </p>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="status && !statusLoading && !statusError">\n        <admin-toolbar heading="Sitemap cache warm"></admin-toolbar>\n        <p>\n            Enqueue the same root sitemap scan used by the daily Lambda. The\n            server checks visible, in-flight, and delayed messages again before\n            starting.\n        </p>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--danger" ng-click="scheduleWarm()" ng-disabled="scheduleBusy || !status.canSchedule">\n                {{ scheduleBusy ? "Starting…" : "Start sitemap warm" }}\n            </button>\n        </div>\n\n        <div class="admin-rt-page__success" ng-if="scheduleMessage && scheduleOutcome === \'started\'" role="status">\n            {{ scheduleMessage }}\n        </div>\n        <div class="admin-rt-callout admin-rt-callout--warn" ng-if="scheduleMessage && scheduleOutcome === \'skipped\'" role="status">\n            {{ scheduleMessage }}\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="scheduleError" role="alert">\n            {{ scheduleError }}\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},64299:e=>{var n="/components/admin/retool/_shared/admin-confirm-modal/admin-confirm-modal.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-confirm-backdrop" ng-click="cancel()">\n    <div class="admin-rt-confirm" role="dialog" aria-modal="true" aria-labelledby="admin-rt-confirm-title" ng-click="$event.stopPropagation()">\n        <h3 class="admin-rt-confirm__title" id="admin-rt-confirm-title">{{ title }}</h3>\n        <p class="admin-rt-confirm__message" ng-if="message">{{ message }}</p>\n        <div class="admin-rt-confirm__actions">\n            <button type="button" class="admin-rt-btn" ng-click="cancel()">\n                {{ cancelText }}\n            </button>\n            <button type="button" class="admin-rt-btn" ng-class="danger ? \'admin-rt-btn--danger\' : \'admin-rt-btn--primary\'" ng-click="confirm()">{{ confirmText }}</button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},20119:e=>{var n="/components/admin/retool/_shared/admin-data-table/admin-data-table.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-table" ng-class="{ \'admin-rt-table--reorderable\': reorderable }">\n    <div class="admin-rt-table__search" ng-if="showSearch()">\n        <input type="search" class="admin-rt-input" ng-model="search.q" ng-change="onSearch()" placeholder="{{ searchPlaceholder || \'Search…\' }}" aria-label="Search table"/>\n    </div>\n\n    <admin-status-states ng-if="hasRetry" loading="loading" error="error" empty="!loading && !error && filteredCount === 0" empty-text="{{\n            emptyText ||\n                (search.q ? \'No results match your search.\' : \'No results.\')\n        }}" on-retry="retry()"></admin-status-states>\n    <admin-status-states ng-if="!hasRetry" loading="loading" error="error" empty="!loading && !error && filteredCount === 0" empty-text="{{\n            emptyText ||\n                (search.q ? \'No results match your search.\' : \'No results.\')\n        }}">\n    </admin-status-states>\n\n    <div class="admin-rt-table__wrap" ng-if="!loading && !error && filteredCount > 0">\n        <table class="admin-rt-table__el">\n            <thead>\n                <tr>\n                    <th ng-if="reorderable" class="admin-rt-table__drag-head">\n                        <span class="sr-only">Reorder</span>\n                    </th>\n                    <th ng-if="selectable" class="admin-rt-table__check">\n                        <input type="checkbox" ng-checked="allFilteredSelected()" ng-click="toggleSelectAll()" aria-label="Select all rows"/>\n                    </th>\n                    <th ng-repeat="col in columns" ng-class="{\n                            \'is-sortable\': col.sortable && !reorderable,\n                            \'admin-rt-align-right\': col.align === \'right\',\n                            \'admin-rt-align-center\': col.align === \'center\'\n                        }" ng-style="\n                            col.width\n                                ? { width: col.width, maxWidth: col.width }\n                                : {}\n                        " ng-click="setSort(col)">\n                        <span>{{ col.label }}</span>\n                        <span class="admin-rt-sort" ng-if="col.sortable && !reorderable">{{ sortIndicator(col) }}</span>\n                    </th>\n                    <th ng-if="hasActions()" class="admin-rt-table__actions-head">\n                        {{ actionsLabel || "Actions" }}\n                    </th>\n                </tr>\n            </thead>\n            <tbody dnd-list="viewRows" dnd-allowed-types="[\'admin-table-row\']" dnd-disable-if="!canReorderRows()" dnd-dragover="canDropAt(index)" dnd-drop="dropRow(item, index)">\n                <tr class="admin-rt-table__drop-placeholder dndPlaceholder">\n                    <td ng-attr-colspan="{{ colSpan() }}"></td>\n                </tr>\n                <tr ng-repeat="row in viewRows track by $index" ng-class="{\n                        \'is-selected\': isSelected(row),\n                        \'is-draggable\': rowCanBeReordered(row)\n                    }" dnd-draggable="row" dnd-type="\'admin-table-row\'" dnd-effect-allowed="move" dnd-disable-if="!isRowDraggable(row)" dnd-dragstart="beginReorder(row)" dnd-moved="finishReorder()">\n                    <td ng-if="reorderable" class="admin-rt-table__drag-cell" dnd-nodrag>\n                        <span ng-if="rowCanBeReordered(row)" dnd-handle class="admin-rt-table__drag-handle" ng-class="{ \'is-disabled\': reorderDisabled }" role="img" aria-label="Drag to reorder" title="Drag to reorder">\n                        </span>\n                    </td>\n                    <td ng-if="selectable" class="admin-rt-table__check" dnd-nodrag>\n                        <input type="checkbox" ng-checked="isSelected(row)" ng-click="toggleRow(row)" aria-label="Select row"/>\n                    </td>\n                    <td ng-repeat="col in columns" dnd-nodrag ng-class="{\n                            \'admin-rt-align-right\': col.align === \'right\',\n                            \'admin-rt-align-center\': col.align === \'center\',\n                            \'admin-rt-table__cell--clip\': !!col.width\n                        }" ng-style="\n                            col.width\n                                ? { width: col.width, maxWidth: col.width }\n                                : {}\n                        ">\n                        <span ng-if="col.type === \'badge\'" class="admin-rt-pill" ng-class="badgeClass(row, col)">{{ cellText(row, col) }}</span>\n                        <a ng-if="col.type === \'link\' && cellHref(row, col)" class="admin-rt-table__cell-text admin-rt-table__cell-link" ng-href="{{ cellHref(row, col) }}" title="{{ cellText(row, col) }}" target="_blank" rel="noopener noreferrer">{{ cellText(row, col) }}</a>\n                        <span ng-if="col.type === \'link\' && !cellHref(row, col)" class="admin-rt-table__cell-text" title="{{ cellText(row, col) }}">{{ cellText(row, col) }}</span>\n                        <img ng-if="col.type === \'image\' && cellHref(row, col)" class="admin-rt-table__image" ng-src="{{ cellHref(row, col) }}" alt="{{ cellImageAlt(row, col) }}"/>\n                        <span ng-if="col.type === \'image\' && !cellHref(row, col)" class="admin-rt-muted">—</span>\n                        <span ng-if="\n                                col.type !== \'badge\' &&\n                                col.type !== \'link\' &&\n                                col.type !== \'image\'\n                            " class="admin-rt-table__cell-text" title="{{ cellText(row, col) }}">{{ cellText(row, col) }}</span>\n                    </td>\n                    <td ng-if="hasActions()" class="admin-rt-table__actions" dnd-nodrag>\n                        <div class="admin-rt-table__action-group">\n                            <button ng-repeat="action in actions" ng-if="actionVisible(action, row)" type="button" class="admin-rt-btn admin-rt-btn--sm" ng-class="\n                                    \'admin-rt-btn--\' +\n                                    (action.kind || \'default\')\n                                " ng-disabled="actionDisabled(action, row)" ng-click="runAction(action, row)">\n                                {{ actionLabel(action, row) }}\n                            </button>\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div class="admin-rt-table__footer" ng-if="!loading && !error && filteredCount > 0">\n        <span class="admin-rt-table__count">\n            Showing {{ rangeStart() }}–{{ rangeEnd() }} of {{ filteredCount }}\n        </span>\n        <div class="admin-rt-pager" ng-if="pageCount > 1">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="prevPage()" ng-disabled="page <= 1">\n                Prev\n            </button>\n            <span class="admin-rt-pager__info">Page {{ page }} / {{ pageCount }}</span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="nextPage()" ng-disabled="page >= pageCount">\n                Next\n            </button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},20597:e=>{var n="/components/admin/retool/_shared/admin-env-banner/admin-env-banner.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-env" ng-class="\'admin-rt-env--\' + env.kind" role="status">\n    <span class="admin-rt-env__dot" aria-hidden="true"></span>\n    <span class="admin-rt-env__label">\n        <strong ng-if="isProduction">Production backend</strong>\n        <strong ng-if="env.kind === \'staging\'">Staging backend</strong>\n        <strong ng-if="env.kind === \'local\'">Local backend</strong>\n        <span class="admin-rt-env__host" ng-if="env.host">&mdash; {{ env.host }}</span>\n        <span class="admin-rt-env__name" ng-if="env.name">({{ env.name }})</span>\n    </span>\n    <span class="admin-rt-env__warn" ng-if="isProduction">\n        Changes here affect live data.\n    </span>\n</div>\n')}]),e.exports=n},70540:e=>{var n="/components/admin/retool/_shared/admin-file-input/admin-file-input.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<label class="admin-rt-file">\n    <span class="admin-rt-btn admin-rt-btn--sm">{{ label || "Choose file" }}</span>\n    <span class="admin-rt-file__name">{{ fileName || "No file selected" }}</span>\n    <input type="file" accept="{{ accept }}" class="admin-rt-file__input"/>\n</label>\n')}]),e.exports=n},84947:e=>{var n="/components/admin/retool/_shared/admin-status-states/admin-status-states.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-states">\n    <div class="admin-rt-states__loading" ng-if="loading" role="status" aria-live="polite">\n        <span class="admin-rt-spinner" aria-hidden="true"></span>\n        <span class="admin-rt-states__text">{{ loadingText || "Loading…" }}</span>\n    </div>\n\n    <div class="admin-rt-states__error" ng-if="!loading && error" role="alert">\n        <span class="admin-rt-states__error-icon" aria-hidden="true">!</span>\n        <span class="admin-rt-states__text">{{ errorMessage() }}</span>\n        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-if="hasRetry" ng-click="onRetry()">Retry</button>\n    </div>\n\n    <div class="admin-rt-states__empty" ng-if="!loading && !error && empty">\n        <span class="admin-rt-states__text">{{ emptyText || "No results." }}</span>\n    </div>\n</div>\n')}]),e.exports=n},90157:e=>{var n="/components/admin/retool/_showcase/admin-retool-showcase.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-showcase">\n    <div class="admin-rt-showcase__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-showcase__title">\n        Imported components\n    </h1>\n    <p class="admin-rt-showcase__subtitle">\n        Developer/QA harness for the shared building blocks used by the\n        "Imported from Retool" admin tools. No data is changed here.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <section class="admin-rt-showcase__section">\n        <h2 class="admin-rt-showcase__section-title">Backend health check</h2>\n        <p class="admin-rt-showcase__section-note">\n            Calls the read-only <code>adminRetoolPing</code> Cloud Function via\n            <code>AdminRetoolApi</code> to validate the admin-auth + Cloud pipeline.\n        </p>\n        <div class="admin-rt-showcase__row">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="runPing()" ng-disabled="ping.loading">\n                {{ ping.loading ? "Pinging…" : "Run ping" }}\n            </button>\n        </div>\n        <div class="admin-rt-showcase__ping" ng-if="ping.result">\n            ✓ ok — environment: <strong>{{ ping.result.environmentName || "(unset)" }}</strong>,\n            server time: {{ ping.result.serverTime }}\n        </div>\n        <div class="admin-rt-showcase__ping" ng-if="ping.error">\n            ✗ {{ ping.error }}\n        </div>\n    </section>\n\n    <section class="admin-rt-showcase__section">\n        <h2 class="admin-rt-showcase__section-title">Data table</h2>\n        <p class="admin-rt-showcase__section-note">\n            Search, sortable columns, pagination, row selection, badge cells and\n            an actions column (Delete opens the shared confirm modal).\n        </p>\n\n        <admin-toolbar heading="Sample rows">\n            <span ng-if="table.selectionCount">{{ table.selectionCount }} selected</span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="reloadTable()">\n                Reload\n            </button>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" loading="table.loading" error="table.error" selectable="true" page-size="8" search-placeholder="Search rows…" actions="actions" on-selection-change="onSelectionChange(selection)" on-retry="reloadTable()" empty-text="No demo rows.">\n        </admin-data-table>\n\n        <p class="admin-rt-showcase__ping" ng-if="table.lastAction">\n            Last action: {{ table.lastAction }}\n        </p>\n    </section>\n</div>\n')}]),e.exports=n},81670:e=>{var n="/components/admin/retool/advertisements/advertisements.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Advertisements\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage in-app advertisements: copy, lifecycle, and their collection or\n        watchface targets.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-segmented" role="tablist" aria-label="Status filter">\n        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-repeat="f in statusFilters" ng-class="{ \'admin-rt-btn--primary\': f.id === statusFilter }" ng-click="setStatusFilter(f.id)">\n            {{ f.label }}\n        </button>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="creating">\n        <h2 class="admin-rt-page__card-title">New advertisement</h2>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-new-type">Type</label>\n                <select id="ad-new-type" class="admin-rt-select" ng-model="creating.type" ng-options="t for t in adTypes"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-new-desc">Description</label>\n                <input id="ad-new-desc" type="text" class="admin-rt-input" ng-model="creating.urlDescription" placeholder="Button / link text"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-new-url">URL</label>\n                <input id="ad-new-url" type="text" class="admin-rt-input" ng-model="creating.url" placeholder="https://… (optional)"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-new-color">Button color</label>\n                <input id="ad-new-color" type="text" class="admin-rt-input" ng-model="creating.buttonColor" placeholder="#000000 (optional)"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="createError" role="alert">\n            {{ createError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="create()">Create</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelCreate()">Cancel</button>\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="selected">\n        <admin-toolbar heading="Manage: {{ selected.urlDescription || selected.objectId }}">\n            <span class="admin-rt-pill" ng-class="{ \'admin-rt-pill--ok\': selected.status === \'live\', \'admin-rt-pill--warn\': selected.status === \'archived\' }">\n                {{ selected.type }} · {{ selected.status || "draft" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="closeDetail()">Close</button>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-url">URL</label>\n                <input id="ad-url" type="text" class="admin-rt-input" ng-model="selected.url"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-desc">Description</label>\n                <input id="ad-desc" type="text" class="admin-rt-input" ng-model="selected.urlDescription"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="ad-color">Button color</label>\n                <input id="ad-color" type="text" class="admin-rt-input" ng-model="selected.buttonColor"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="editError" role="alert">\n            {{ editError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="saveEdit()">Save copy</button>\n        </div>\n\n        <h3 class="admin-rt-page__card-title" style="margin-top: 22px;">\n            Targets ({{ selected.type }})\n        </h3>\n        <admin-status-states ng-if="targetsLoading || targetsError" loading="targetsLoading" error="targetsError" empty="false" on-retry="loadTargets()"></admin-status-states>\n\n        <div ng-if="!targetsLoading && !targetsError">\n            <div class="admin-rt-page__empty" ng-if="!targets.length">\n                No targets linked yet.\n            </div>\n            <ul class="admin-rt-target-list" ng-if="targets.length">\n                <li class="admin-rt-target" ng-repeat="t in targets">\n                    <span class="admin-rt-target__label">{{ t.label }}</span>\n                    <span class="admin-rt-pill" ng-if="t.status">{{ t.status }}</span>\n                    <code class="admin-rt-target__id">{{ t.objectId }}</code>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="removeTarget(t)">Remove</button>\n                </li>\n            </ul>\n\n            <div class="admin-rt-page__field" style="margin-top: 14px;">\n                <input class="admin-rt-input" type="text" ng-model="candidateQuery" ng-keyup="$event.keyCode === 13 && findCandidate()" placeholder="{{ selected.type === \'collection\' ? \'Collection slug\' : \'Watchface objectId\' }}" aria-label="Target lookup"/>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="findCandidate()">Find</button>\n            </div>\n            <div class="admin-rt-page__field-error" ng-if="candidateMessage" role="alert">\n                {{ candidateMessage }}\n            </div>\n            <div class="admin-rt-candidate" ng-if="candidate">\n                <span class="admin-rt-target__label">{{ candidate.label }}</span>\n                <span class="admin-rt-pill" ng-if="candidate.status">{{ candidate.status }}</span>\n                <code class="admin-rt-target__id">{{ candidate.objectId }}</code>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--primary" ng-click="addTarget()">Add target</button>\n            </div>\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Advertisements">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ rows.length }} ad{{ rows.length === 1 ? "" : "s" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="startCreate()">New ad</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Reload</button>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" loading="loading" error="error" page-size="25" search-placeholder="Filter ads…" actions="actions" actions-label="Actions" on-retry="load()" empty-text="No advertisements.">\n        </admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},46484:e=>{var n="/components/admin/retool/bad-words/bad-words.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Bad Words\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage the profanity blocklist used for content moderation.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-page__card">\n        <h2 class="admin-rt-page__card-title">Add a word</h2>\n        <form class="admin-rt-page__field" ng-submit="addWord()" novalidate>\n            <input class="admin-rt-input" type="text" ng-model="newWord" placeholder="Word or phrase to block" aria-label="Word to add" ng-disabled="adding"/>\n            <button type="submit" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="adding || !newWord.trim()">\n                {{ adding ? "Adding…" : "Add" }}\n            </button>\n        </form>\n        <div class="admin-rt-page__field-error" ng-if="addError" role="alert">\n            {{ addError }}\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Blocklist">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ rows.length }} word{{ rows.length === 1 ? "" : "s" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Reload</button>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" loading="loading" error="error" page-size="25" search-placeholder="Filter words…" actions="actions" on-retry="load()" empty-text="No bad words.">\n        </admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},84676:e=>{var n="/components/admin/retool/brand-partners/brand-partners.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Brand Partners\n        <span class="admin-rt-pill admin-rt-pill--warn">Identity</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Browse watchface brand partners and mark a user as a verified brand.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    \x3c!-- Set user as brand ------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Set user as brand"></admin-toolbar>\n        <div class="admin-rt-callout admin-rt-callout--warn">\n            Setting a user as a brand changes <strong>account identity</strong>\n            (category=BRAND, verificationType=VERIFIED) and grants partner tier.\n        </div>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="lookup.query" ng-keyup="$event.keyCode === 13 && lookupUser()" placeholder="User ID, username, or email"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="lookupUser()" ng-disabled="lookupBusy">\n                {{ lookupBusy ? "Looking up…" : "Look up" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="lookupError" role="alert">{{ lookupError.message || lookupError }}</div>\n\n        <div class="admin-rt-field-grid" ng-if="user">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">User</span>\n                <span class="admin-rt-target__label">{{ user.displayName || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ user.objectId }}</code>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Category</span>\n                <span class="admin-rt-pill" ng-class="user.category === \'BRAND\' ? \'admin-rt-pill--ok\' : \'\'">\n                    {{ user.category || "none" }}\n                </span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Verification</span>\n                <span class="admin-rt-pill" ng-class="user.verificationType === \'VERIFIED\' ? \'admin-rt-pill--ok\' : \'\'">\n                    {{ user.verificationType || "none" }}\n                </span>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions" ng-if="user">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="setAsBrand()" ng-disabled="setBusy || isBrand()">\n                {{ isBrand() ? "Already a verified brand" : (setBusy ? "Saving…" : "Set as brand") }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="setResult" role="status">{{ setResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="setError" role="alert">{{ setError.message || setError }}</div>\n    </div>\n\n    \x3c!-- Brand partners list ----------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Brand partners">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadPartners()" ng-disabled="partnersLoading">\n                {{ partnersLoading ? "Loading…" : "Reload" }}\n            </button>\n        </admin-toolbar>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="search.q" ng-keyup="$event.keyCode === 13 && loadPartners()" placeholder="Filter by name"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadPartners()">Search</button>\n        </div>\n\n        <admin-status-states ng-if="partnersLoading || partnersError" loading="partnersLoading" error="partnersError" empty="false" on-retry="loadPartners()"></admin-status-states>\n\n        <ul class="admin-rt-target-list" ng-if="partners !== null && !partnersLoading && !partnersError">\n            <li class="admin-rt-target" ng-repeat="p in partners">\n                <span class="admin-rt-target__label">{{ p.name || "(unnamed)" }}</span>\n                <span class="admin-rt-muted">\n                    #{{ p.objectId }}\n                    <span ng-if="p.contactEmail"> · {{ p.contactEmail }}</span>\n                    · {{ p.userCount }} user(s) · {{ p.watchfaceCount }} watchface(s)\n                    <span ng-if="p.keywords.length"> · {{ p.keywords.join(", ") }}</span>\n                </span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="partners !== null && !partners.length && !partnersLoading && !partnersError">\n            No brand partners found.\n        </p>\n    </div>\n</div>\n')}]),e.exports=n},96028:e=>{var n="/components/admin/retool/collections/collections.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Collections\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Browse recent collections or find one by exact slug, and reassign a\n        collection\'s owner.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-page__card">\n        <form class="admin-rt-page__field" ng-submit="search()" novalidate>\n            <input class="admin-rt-input" type="text" ng-model="slug" placeholder="Exact slug (leave blank for recent)" aria-label="Collection slug"/>\n            <button type="submit" class="admin-rt-btn admin-rt-btn--primary">Find</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="clearSearch()" ng-if="slug">Show recent</button>\n        </form>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="moving">\n        <h2 class="admin-rt-page__card-title">Move collection</h2>\n        <p class="admin-rt-page__subtitle">\n            Reassign <strong>{{ moving.name }}</strong> (current owner:\n            {{ moving.currentUserId || "none" }}) to another user.\n        </p>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="moving.userId" placeholder="Target user objectId" aria-label="Target user objectId" ng-disabled="movingBusy"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="movingBusy || !moving.userId.trim()" ng-click="confirmMove()">{{ movingBusy ? "Moving…" : "Move" }}</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="movingBusy" ng-click="cancelMove()">Cancel</button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="moveError" role="alert">\n            {{ moveError }}\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Collections">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ rows.length }} shown\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Reload</button>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" loading="loading" error="error" page-size="25" searchable="false" actions="actions" actions-label="Owner" on-retry="load()" empty-text="No collections found.">\n        </admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},13120:e=>{var n="/components/admin/retool/gdpr-requests/gdpr-requests.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        GDPR Requests\n        <span class="admin-rt-pill admin-rt-pill--danger">Legal</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Look up a user, review their data footprint, and process a permanent deletion request.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    \x3c!-- User data & deletion --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="User data &amp; deletion"></admin-toolbar>\n        <div class="admin-rt-callout admin-rt-callout--warn">\n            Hard delete is <strong>permanent and irreversible</strong> — it removes the\n            user and all of their records and files. Verify the account first.\n        </div>\n\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="gdpr.userId" ng-keyup="$event.keyCode === 13 && gdprLookup()" placeholder="User ID (objectId)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="gdprLookup()" ng-disabled="gdprLookupBusy">\n                {{ gdprLookupBusy ? "Looking up…" : "Look up" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="gdprLookupError" role="alert">{{ gdprLookupError.message || gdprLookupError }}</div>\n\n        <div ng-if="gdprUser">\n            <div class="admin-rt-field-grid">\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">User</span>\n                    <span class="admin-rt-target__label">{{ gdprUser.displayName || "(no name)" }}</span>\n                    <code class="admin-rt-target__id">{{ gdprUser.objectId }}</code>\n                </div>\n                <div class="admin-rt-field-row" ng-if="gdprUser.email">\n                    <span class="admin-rt-field-row__label">Email</span>\n                    <span class="admin-rt-muted">{{ gdprUser.email }}</span>\n                </div>\n                <div class="admin-rt-field-row" ng-if="gdprUser.username">\n                    <span class="admin-rt-field-row__label">Username</span>\n                    <span class="admin-rt-muted">{{ gdprUser.username }}</span>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Pending deletion</span>\n                    <span class="admin-rt-pill" ng-class="gdprUser.gdprDelete ? \'admin-rt-pill--danger\' : \'admin-rt-pill--ok\'">\n                        {{ gdprUser.gdprDelete ? "Yes" : "No" }}\n                    </span>\n                </div>\n            </div>\n\n            <div class="admin-rt-page__actions">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadGdprCounts()" ng-disabled="gdprCountsBusy">\n                    {{ gdprCountsBusy ? "Counting…" : "Load record counts" }}\n                </button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="hardDelete()" ng-disabled="deleteBusy || gdprUser.gdprDelete">\n                    {{ gdprUser.gdprDelete ? "Already pending deletion" : (deleteBusy ? "Deleting…" : "Permanently delete user") }}\n                </button>\n            </div>\n            <div class="admin-rt-page__field-error" ng-if="gdprCountsError" role="alert">{{ gdprCountsError.message || gdprCountsError }}</div>\n\n            <table class="admin-rt-table" ng-if="gdprCounts">\n                <thead><tr><th>Class</th><th>Records</th></tr></thead>\n                <tbody>\n                    <tr ng-repeat="key in gdprCountKeys()">\n                        <td>{{ key }}</td>\n                        <td>{{ gdprCounts.counts[key] }}</td>\n                    </tr>\n                    <tr ng-if="!gdprCountKeys().length"><td colspan="2" class="admin-rt-muted">No records found.</td></tr>\n                </tbody>\n                <tfoot ng-if="gdprCountKeys().length"><tr><th>Total</th><th>{{ gdprCounts.total }}</th></tr></tfoot>\n            </table>\n\n            <div class="admin-rt-page__success" ng-if="deleteResult" role="status">{{ deleteResult }}</div>\n            <div class="admin-rt-page__field-error" ng-if="deleteError" role="alert">{{ deleteError.message || deleteError }}</div>\n        </div>\n\n        \x3c!-- Pending deletions --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Pending deletions</h3>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadPending()" ng-disabled="pendingBusy">\n                {{ pendingBusy ? "Loading…" : "Load pending deletions" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="pendingError" role="alert">{{ pendingError.message || pendingError }}</div>\n        <ul class="admin-rt-target-list" ng-if="pending && pending.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="u in pending" ng-click="selectPending(u)">\n                <span class="admin-rt-target__label">{{ u.displayName || u.email || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ u.objectId }}</code>\n                <span class="admin-rt-muted">requested {{ u.gdprDelete | date:\'short\' }}</span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="pending && !pending.length">No pending deletions.</p>\n    </div>\n</div>\n')}]),e.exports=n},83496:e=>{var n="/components/admin/retool/licensing/licensing.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Watchface Licensing\n        <span class="admin-rt-pill admin-rt-pill--warn">Financial</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage licensing models and their revenue splits, view assigned watchfaces,\n        and assign a license to a watchface.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        These changes affect <strong>revenue distribution</strong>. Splits must sum\n        to exactly 1. Edits go through validation and require engineer review.\n    </div>\n\n    <div class="admin-rt-page__success" ng-if="feedback" role="status">{{ feedback }}</div>\n    <div class="admin-rt-page__field-error" ng-if="feedbackError" role="alert">{{ feedbackError.message || feedbackError }}</div>\n\n    \x3c!-- Models list ------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Licensing models">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadModels()" ng-disabled="modelsLoading">\n                {{ modelsLoading ? "Loading…" : "Reload" }}\n            </button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="modelsLoading || modelsError" loading="modelsLoading" error="modelsError" empty="false" on-retry="loadModels()"></admin-status-states>\n\n        <ul class="admin-rt-target-list" ng-if="!modelsLoading && !modelsError">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="m in models" ng-class="{ \'admin-rt-target--active\': selected.objectId === m.objectId }" ng-click="select(m)">\n                <span class="admin-rt-target__label">\n                    {{ m.name || "(unnamed)" }}\n                    <span class="admin-rt-pill admin-rt-pill--ok" ng-if="m.isDefault">Default</span>\n                </span>\n                <span class="admin-rt-muted">\n                    #{{ m.objectId }}\n                    · {{ m.split.length }} split{{ m.split.length === 1 ? "" : "s" }}\n                    <span ng-if="m.revenueMax"> · max {{ m.revenueMax }}</span>\n                </span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="!modelsLoading && !modelsError && !models.length">\n            No licensing models found.\n        </p>\n    </div>\n\n    \x3c!-- Detail ------------------------------------------------------------ --\x3e\n    <div class="admin-rt-page__card" ng-if="selected">\n        <admin-toolbar heading="Edit “{{ selected.name }}”"></admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="lm-name">Name</label>\n                <input id="lm-name" type="text" class="admin-rt-input" ng-model="meta.name"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="lm-desc">Internal description</label>\n                <input id="lm-desc" type="text" class="admin-rt-input" ng-model="meta.internalDescription"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="lm-max">Revenue max (blank = none)</label>\n                <input id="lm-max" type="number" min="0" class="admin-rt-input" ng-model="meta.revenueMax"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="lm-next">Next model (chain)</label>\n                <select id="lm-next" class="admin-rt-select" ng-model="meta.nextId">\n                    <option value="">— none —</option>\n                    <option ng-repeat="m in models" ng-if="m.objectId !== selected.objectId" value="{{ m.objectId }}">{{ m.name }} (#{{ m.objectId }})</option>\n                </select>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="saveMeta()" ng-disabled="busy.meta">\n                {{ busy.meta ? "Saving…" : "Save metadata" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--danger admin-rt-btn--sm" ng-click="deleteModel()" ng-disabled="busy.del">\n                {{ busy.del ? "Deleting…" : "Delete model" }}\n            </button>\n        </div>\n\n        \x3c!-- Split editor --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Revenue split</h3>\n        <table class="admin-rt-split-table">\n            <thead>\n                <tr>\n                    <th>Type</th>\n                    <th>User ID (optional)</th>\n                    <th>Percent (0–1)</th>\n                    <th></th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr ng-repeat="row in splitRows">\n                    <td>\n                        <select class="admin-rt-select" ng-model="row.type" ng-options="t as t for t in splitTypes"></select>\n                    </td>\n                    <td>\n                        <input type="text" class="admin-rt-input" ng-model="row.userId" placeholder="User objectId"/>\n                    </td>\n                    <td>\n                        <input type="number" min="0" max="1" step="0.01" class="admin-rt-input" ng-model="row.percent"/>\n                    </td>\n                    <td>\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="removeSplitRow($index)">Remove</button>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="addSplitRow()">\n                + Add split row\n            </button>\n            <span class="admin-rt-muted">\n                Total:\n                <span ng-class="splitTotal() === 1 ? \'admin-rt-pill admin-rt-pill--ok\' : \'admin-rt-pill admin-rt-pill--danger\'">\n                    {{ splitTotal() }}\n                </span>\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="saveSplit()" ng-disabled="busy.split">\n                {{ busy.split ? "Saving…" : "Save split" }}\n            </button>\n        </div>\n\n        \x3c!-- Assigned watchfaces --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Assigned watchfaces</h3>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadAssigned()" ng-disabled="assignedLoading">\n                {{ assignedLoading ? "Loading…" : "Load assigned watchfaces" }}\n            </button>\n            <span class="admin-rt-muted" ng-if="assigned">{{ assigned.count }} total (showing up to 50)</span>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="assignedError" role="alert">{{ assignedError.message || assignedError }}</div>\n        <ul class="admin-rt-target-list" ng-if="assigned && assigned.watchfaces.length">\n            <li class="admin-rt-target" ng-repeat="wf in assigned.watchfaces">\n                <span class="admin-rt-target__label">{{ wf.title || "(untitled)" }}</span>\n                <span class="admin-rt-muted">\n                    #{{ wf.objectId }} · {{ wf.status }} · {{ wf.platform_type }}\n                    <span ng-if="wf.userDisplayName"> · {{ wf.userDisplayName }}</span>\n                </span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="assigned && !assigned.watchfaces.length">\n            No watchfaces assigned to this model.\n        </p>\n    </div>\n\n    \x3c!-- Create model ------------------------------------------------------ --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Create licensing model"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="cm-name">Name</label>\n                <input id="cm-name" type="text" class="admin-rt-input" ng-model="create.name"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="cm-desc">Internal description</label>\n                <input id="cm-desc" type="text" class="admin-rt-input" ng-model="create.internalDescription"/>\n            </div>\n        </div>\n        <p class="admin-rt-muted">New models start with a 100% platform split — edit the split afterward.</p>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="createModel()" ng-disabled="busy.create">\n                {{ busy.create ? "Creating…" : "Create model" }}\n            </button>\n        </div>\n    </div>\n\n    \x3c!-- Assign license to a watchface ------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Assign license to a watchface"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="al-wf">Watchface ID</label>\n                <input id="al-wf" type="text" class="admin-rt-input" ng-model="assign.watchfaceId" placeholder="Watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="al-model">Licensing model</label>\n                <select id="al-model" class="admin-rt-select" ng-model="assign.modelId">\n                    <option value="">— clear license —</option>\n                    <option ng-repeat="m in models" value="{{ m.objectId }}">{{ m.name }} (#{{ m.objectId }})</option>\n                </select>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="assignLicense()" ng-disabled="busy.assign">\n                {{ busy.assign ? "Saving…" : (assign.modelId ? "Assign license" : "Clear license") }}\n            </button>\n            <span class="admin-rt-muted" ng-if="assignResult">{{ assignResult }}</span>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="assignError" role="alert">{{ assignError.message || assignError }}</div>\n    </div>\n</div>\n')}]),e.exports=n},17048:e=>{var n="/components/admin/retool/look-popularity/look-popularity.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">Look Popularity</h1>\n    <p class="admin-rt-page__subtitle">\n        Set how many VIP, Partner, or total likes make a Look popular. Reaching\n        any one threshold adds the popular tag on the next like or unlike.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <admin-status-states ng-if="loading || error" loading="loading" error="error" empty="false" on-retry="load()"></admin-status-states>\n\n    <div class="admin-rt-page__card" ng-if="!loading && !error">\n        <admin-toolbar heading="Popularity thresholds">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">\n                Reload\n            </button>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row" ng-repeat="field in fields">\n                <label class="admin-rt-field-row__label" for="look-popularity-{{ field.key }}">\n                    {{ field.label }}\n                </label>\n                <input id="look-popularity-{{ field.key }}" type="number" min="1" step="1" required class="admin-rt-input" ng-model="editing[field.key]"/>\n                <span class="admin-rt-field-row__hint" ng-class="{\n                        \'is-changed\': editing[field.key] !== original[field.key]\n                    }">\n                    {{ field.description }}\n                    <span ng-if="editing[field.key] !== original[field.key]">\n                        Previously {{ original[field.key] }}.\n                    </span>\n                </span>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__field-error" ng-if="saveError" role="alert">\n            {{ saveError }}\n        </div>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="saving || !isDirty()" ng-click="save()">\n                {{ saving ? "Saving…" : "Save changes" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="saving || !isDirty()" ng-click="reset()">\n                Reset\n            </button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},49536:e=>{var n="/components/admin/retool/looks-whitelist/looks-whitelist.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Looks Whitelist\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage the looks-push push-notification whitelist, one user at a time.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    \x3c!-- Whitelist (looks-push) -------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Looks-push whitelist"></admin-toolbar>\n        <p class="admin-rt-muted">\n            Look up a user to check whether they are on the <code>looks-push</code> whitelist,\n            and add or remove them. (The whitelist is far too large to list in full.)\n        </p>\n        <div class="admin-rt-page__field">\n            <select class="admin-rt-select" ng-model="wl.field" ng-options="f.id as f.label for f in lookupFields"></select>\n            <input class="admin-rt-input" type="text" ng-model="wl.value" ng-keyup="$event.keyCode === 13 && wlLookup()" placeholder="Find a user"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="wlLookup()" ng-disabled="wlLookupBusy">\n                {{ wlLookupBusy ? "Looking up…" : "Look up" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="wlLookupError" role="alert">{{ wlLookupError.message || wlLookupError }}</div>\n\n        <ul class="admin-rt-target-list" ng-if="wlResults && wlResults.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="u in wlResults" ng-click="wlSelectUser(u)">\n                <span class="admin-rt-target__label">{{ u.displayName || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ u.objectId }}</code>\n                <span class="admin-rt-muted" ng-if="u.username"> · {{ u.username }}</span>\n            </li>\n        </ul>\n\n        <div class="admin-rt-field-grid" ng-if="wlUser">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">User</span>\n                <span class="admin-rt-target__label">{{ wlUser.displayName || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ wlUser.objectId }}</code>\n            </div>\n            <div class="admin-rt-field-row" ng-if="wlStatus">\n                <span class="admin-rt-field-row__label">Whitelisted</span>\n                <span class="admin-rt-pill" ng-class="wlStatus.whitelisted ? \'admin-rt-pill--ok\' : \'\'">\n                    {{ wlStatus.whitelisted ? "Yes" : "No" }}\n                </span>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions" ng-if="wlUser">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="wlAdd()" ng-disabled="wlActionBusy || (wlStatus && wlStatus.whitelisted)">Add to whitelist</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="wlRemove()" ng-disabled="wlActionBusy || (wlStatus && !wlStatus.whitelisted)">Remove from whitelist</button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="wlActionResult" role="status">{{ wlActionResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="wlActionError" role="alert">{{ wlActionError.message || wlActionError }}</div>\n    </div>\n</div>\n')}]),e.exports=n},39644:e=>{var n="/components/admin/retool/moderation-extras/moderation-extras.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Reject Reasons &amp; Counts\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage the canned QA reject reasons and view live vs. non-live Android\n        watchface counts.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    \x3c!-- QA reject reasons ------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="QA reject reasons">\n            <span class="admin-rt-page__count" ng-if="!reasonsLoading && !reasonsError">\n                {{ reasons.length }} reason{{ reasons.length === 1 ? "" : "s" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadReasons()">Reload</button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="reasonsLoading || reasonsError" loading="reasonsLoading" error="reasonsError" empty="false" on-retry="loadReasons()"></admin-status-states>\n\n        <div ng-if="!reasonsLoading && !reasonsError">\n            <div class="admin-rt-page__empty" ng-if="!reasons.length">\n                No QA reject reasons defined.\n            </div>\n            <ul class="admin-rt-target-list" ng-if="reasons.length">\n                <li class="admin-rt-target" ng-repeat="reason in reasons track by $index">\n                    <span class="admin-rt-target__label">{{ reason }}</span>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="removeReason(reason)">Remove</button>\n                </li>\n            </ul>\n\n            <div class="admin-rt-page__field" style="margin-top: 14px;">\n                <input class="admin-rt-input" type="text" ng-model="newReason" ng-keyup="$event.keyCode === 13 && addReason()" placeholder="Add a reject reason" aria-label="New reject reason"/>\n                <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="addReason()">Add reason</button>\n            </div>\n            <div class="admin-rt-page__field-error" ng-if="addError" role="alert">\n                {{ addError }}\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Watchface counts -------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Android watchface counts">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadCounts()">Reload</button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="countsLoading || countsError" loading="countsLoading" error="countsError" empty="false" on-retry="loadCounts()"></admin-status-states>\n\n        <div class="admin-rt-field-grid" ng-if="!countsLoading && !countsError && counts">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Live (Android)</span>\n                <span class="admin-rt-pill admin-rt-pill--ok">{{ counts.liveAndroid | number }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Non-live (Android)</span>\n                <span class="admin-rt-pill admin-rt-pill--warn">{{ counts.nonLiveAndroid | number }}</span>\n            </div>\n        </div>\n        <p class="admin-rt-muted" ng-if="!countsLoading && !countsError">\n            Counts use the legacy <code>platform_type</code> field to match the original Retool dashboard.\n        </p>\n    </div>\n</div>\n')}]),e.exports=n},91220:e=>{var n="/components/admin/retool/promo-text/promo-text.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Promo Text\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Edit the premium page marketing content, one section at a time.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <admin-status-states ng-if="loading || error" loading="loading" error="error" empty="false" on-retry="load()"></admin-status-states>\n\n    <div class="admin-rt-page__card" ng-if="!loading && !error">\n        <admin-toolbar heading="Section content">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Reload</button>\n        </admin-toolbar>\n\n        <div class="admin-rt-page__empty" ng-if="!sections.length">\n            No editable sections found.\n        </div>\n\n        <div ng-if="sections.length">\n            <div class="admin-rt-tabs" role="tablist">\n                <button type="button" class="admin-rt-tab" ng-repeat="section in sections" ng-class="{ \'is-active\': section === selectedSection }" ng-click="selectSection(section)">\n                    {{ section }}\n                    <span class="admin-rt-tab__dot" ng-if="section === selectedSection && isDirty()">•</span>\n                </button>\n            </div>\n\n            <label class="admin-rt-field-row__label" for="promo-text-editor">\n                {{ selectedSection }} (JSON)\n            </label>\n            <textarea id="promo-text-editor" class="admin-rt-textarea" ng-model="editorText" ng-change="onEditorChange()" rows="18" spellcheck="false" aria-label="Section content JSON"></textarea>\n\n            <div class="admin-rt-page__field-error" ng-if="jsonError" role="alert">\n                {{ jsonError }}\n            </div>\n            <div class="admin-rt-page__field-error" ng-if="saveError" role="alert">\n                {{ saveError }}\n            </div>\n\n            <div class="admin-rt-page__actions">\n                <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="saving || !isDirty() || jsonError" ng-click="save()">\n                    {{ saving ? "Saving…" : "Save changes" }}\n                </button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="saving || !isDirty()" ng-click="revert()">\n                    Revert\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},22144:e=>{var n="/components/admin/retool/rosetta-monitor/rosetta-monitor.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Rosetta\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Monitor the conversion pipeline (convert/discovery logs, counters) and run\n        conversion actions (single trigger, batch catalog, resource import).\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        Actions below enqueue work on <strong>production</strong> conversion queues\n        and create resources. They trigger real conversions — use with care.\n    </div>\n\n    \x3c!-- Actions ----------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Trigger conversion (single watchface)"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="tg-wf">Watchface ID</label>\n                <input id="tg-wf" type="text" class="admin-rt-input" ng-model="trigger.watchfaceId" placeholder="Watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="tg-strict">Strict level</label>\n                <select id="tg-strict" class="admin-rt-select" ng-model="trigger.strictLevel" ng-options="o.id as o.label for o in strictLevels"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="tg-priority">Priority</label>\n                <select id="tg-priority" class="admin-rt-select" ng-model="trigger.priority" ng-options="o.id as o.label for o in priorities"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="tg-import">Import URL (optional)</label>\n                <input id="tg-import" type="text" class="admin-rt-input" ng-model="trigger.importUrl" placeholder="Origin file URL override"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="tg-force">Force</label>\n                <input id="tg-force" type="checkbox" ng-model="trigger.force"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="runTrigger()" ng-disabled="triggerBusy">\n                {{ triggerBusy ? "Triggering…" : "Trigger" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="triggerResult" role="status">{{ triggerResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="triggerError" role="alert">{{ triggerError.message || triggerError }}</div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Batch convert a user\'s catalog"></admin-toolbar>\n        <p class="admin-rt-muted">\n            Enqueues every live Android watchface for the given user (WFF target),\n            reusing the existing <code>batchConvertUserCatalog</code> function.\n        </p>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="bt-user">User ID</label>\n                <input id="bt-user" type="text" class="admin-rt-input" ng-model="batch.userId" placeholder="User objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="bt-strict">Strict level</label>\n                <select id="bt-strict" class="admin-rt-select" ng-model="batch.strictLevel" ng-options="o.id as o.label for o in strictLevels"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="bt-priority">Priority</label>\n                <select id="bt-priority" class="admin-rt-select" ng-model="batch.priority" ng-options="o.id as o.label for o in priorities"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="bt-force">Force</label>\n                <input id="bt-force" type="checkbox" ng-model="batch.force"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="runBatch()" ng-disabled="batchBusy">\n                {{ batchBusy ? "Queuing…" : "Convert catalog" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="batchResult" role="status">{{ batchResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="batchError" role="alert">{{ batchError.message || batchError }}</div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Import resource file"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label">File</label>\n                <admin-file-input accept=".face,application/octet-stream" label="Choose resource file" on-file="onImportFilePicked(name, base64)"></admin-file-input>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="im-platform">Target platform</label>\n                <input id="im-platform" type="text" class="admin-rt-input" ng-model="importForm.targetPlatform" placeholder="e.g. wff, android, tizen"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="im-wf">Existing watchface ID (optional)</label>\n                <input id="im-wf" type="text" class="admin-rt-input" ng-model="importForm.watchfaceId" placeholder="Update existing, or leave blank"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="im-title">Title (new watchface)</label>\n                <input id="im-title" type="text" class="admin-rt-input" ng-model="importForm.title" placeholder="Required if no watchface ID"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="runImport()" ng-disabled="importBusy">\n                {{ importBusy ? "Importing…" : "Import" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="importResult" role="status">{{ importResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="importError" role="alert">{{ importError.message || importError }}</div>\n    </div>\n\n    \x3c!-- Convert counters -------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Conversion counters">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadCounters()" ng-disabled="countersLoading">\n                {{ countersLoading ? "Loading…" : "Load counters" }}\n            </button>\n        </admin-toolbar>\n        <p class="admin-rt-muted">\n            Counts every watchface resource grouped by platform — run on demand\n            (it scans a large collection).\n        </p>\n\n        <admin-status-states ng-if="countersLoading || countersError" loading="countersLoading" error="countersError" empty="false" on-retry="loadCounters()"></admin-status-states>\n\n        <div class="admin-rt-counter-cols" ng-if="counters && !countersLoading && !countersError">\n            <div>\n                <h3 class="admin-rt-page__card-title">All resources</h3>\n                <ul class="admin-rt-target-list">\n                    <li class="admin-rt-target" ng-repeat="c in counters.all">\n                        <span class="admin-rt-target__label">{{ c.targetPlatform }}{{ c.isDraft ? " (draft)" : "" }}</span>\n                        <span class="admin-rt-pill">{{ c.count | number }}</span>\n                    </li>\n                </ul>\n            </div>\n            <div>\n                <h3 class="admin-rt-page__card-title">Valid only</h3>\n                <ul class="admin-rt-target-list">\n                    <li class="admin-rt-target" ng-repeat="c in counters.valid">\n                        <span class="admin-rt-target__label">{{ c.targetPlatform }}{{ c.isDraft ? " (draft)" : "" }}</span>\n                        <span class="admin-rt-pill admin-rt-pill--ok">{{ c.count | number }}</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Convert log ------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Convert log"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="cv-wf">Watchface ID</label>\n                <input id="cv-wf" type="text" class="admin-rt-input" ng-model="convert.watchfaceId" ng-keyup="$event.keyCode === 13 && loadConvert()" placeholder="Filter by watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="cv-status">Status</label>\n                <select id="cv-status" class="admin-rt-select" ng-model="convert.status" ng-options="o.id as o.label for o in statusOptions"></select>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadConvert()">Reload</button>\n        </div>\n\n        <admin-data-table ng-if="convertRows !== null" columns="convertColumns" rows="convertRows" row-key="objectId" loading="convertLoading" error="convertError" page-size="25" search-placeholder="Filter loaded rows…" on-retry="loadConvert()" empty-text="No conversion log entries.">\n        </admin-data-table>\n        <admin-status-states ng-if="convertRows === null && (convertLoading || convertError)" loading="convertLoading" error="convertError" empty="false" on-retry="loadConvert()"></admin-status-states>\n    </div>\n\n    \x3c!-- Discovery log ----------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Discovery log"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="dl-wf">Watchface ID</label>\n                <input id="dl-wf" type="text" class="admin-rt-input" ng-model="discovery.watchfaceId" ng-keyup="$event.keyCode === 13 && loadDiscovery()" placeholder="Filter by watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="dl-status">Status</label>\n                <select id="dl-status" class="admin-rt-select" ng-model="discovery.status" ng-options="o.id as o.label for o in statusOptions"></select>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="dl-batch">Batches only</label>\n                <input id="dl-batch" type="checkbox" ng-model="discovery.batchesOnly" ng-change="loadDiscovery()"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadDiscovery()">Reload</button>\n        </div>\n\n        <admin-data-table ng-if="discoveryRows !== null" columns="discoveryColumns" rows="discoveryRows" row-key="objectId" loading="discoveryLoading" error="discoveryError" page-size="25" search-placeholder="Filter loaded rows…" on-retry="loadDiscovery()" empty-text="No discovery log entries.">\n        </admin-data-table>\n        <admin-status-states ng-if="discoveryRows === null && (discoveryLoading || discoveryError)" loading="discoveryLoading" error="discoveryError" empty="false" on-retry="loadDiscovery()"></admin-status-states>\n    </div>\n</div>\n')}]),e.exports=n},27624:e=>{var n="/components/admin/retool/safe-search/safe-search.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Safe Search Tolerance\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Set the maximum accepted likelihood per category for image moderation.\n        Imagery scored above the chosen likelihood for a category is rejected.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <admin-status-states ng-if="loading || error" loading="loading" error="error" empty="false" on-retry="load()"></admin-status-states>\n\n    <div class="admin-rt-page__card" ng-if="!loading && !error">\n        <admin-toolbar heading="Max accepted likelihood">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Reload</button>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row" ng-repeat="category in categories">\n                <label class="admin-rt-field-row__label" for="safe-search-{{ category }}">\n                    {{ category }}\n                </label>\n                <select id="safe-search-{{ category }}" class="admin-rt-select" ng-model="editing[category]" ng-options="opt.value as opt.label for opt in enumOptions">\n                </select>\n                <span class="admin-rt-field-row__hint" ng-class="{ \'is-changed\': editing[category] !== original[category] }">\n                    <span ng-if="editing[category] !== original[category]">\n                        was {{ original[category] }} — {{ labelFor(original[category]) }}\n                    </span>\n                    <span ng-if="editing[category] === original[category]">saved</span>\n                </span>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__field-error" ng-if="saveError" role="alert">\n            {{ saveError }}\n        </div>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="saving || !isDirty()" ng-click="save()">\n                {{ saving ? "Saving…" : "Save changes" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="saving || !isDirty()" ng-click="reset()">\n                Reset\n            </button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},51572:e=>{var n="/components/admin/retool/selfies-looks/selfies-looks.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Selfies / Looks\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Moderate wrist selfies ("Looks"): approve, reject, and review their comments.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    \x3c!-- Finder ------------------------------------------------------------ --\x3e\n    <div class="admin-rt-page__card">\n        <div class="admin-rt-segmented" role="tablist" aria-label="Status filter">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-repeat="f in statusFilters" ng-class="{ \'admin-rt-btn--primary\': f.id === statusFilter }" ng-click="setStatusFilter(f.id)">\n                {{ f.label }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field" style="margin-top: 10px;">\n            <input class="admin-rt-input" type="text" ng-model="selfieId" ng-keyup="$event.keyCode === 13 && load()" placeholder="Or find by selfie objectId" aria-label="Selfie ID"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()">Find</button>\n        </div>\n    </div>\n\n    <admin-status-states ng-if="loading || error" loading="loading" error="error" empty="false" on-retry="load()">\n    </admin-status-states>\n\n    <div ng-if="!loading && !error">\n        <div class="admin-rt-page__empty" ng-if="selfies !== null && !selfies.length">\n            No selfies match.\n        </div>\n\n        <div class="admin-rt-selfie-grid" ng-if="selfies.length">\n            <div class="admin-rt-selfie" ng-repeat="s in selfies">\n                <div class="admin-rt-selfie__media">\n                    <img ng-if="s.thumbnailUrl || s.imageUrl" ng-src="{{ s.thumbnailUrl || s.imageUrl }}" alt="Wrist selfie"/>\n                    <div class="admin-rt-selfie__noimg" ng-if="!s.thumbnailUrl && !s.imageUrl">\n                        No image\n                    </div>\n                    <span class="admin-rt-pill admin-rt-selfie__status" ng-class="statusBadge(s.status)">{{ s.status }}</span>\n                </div>\n                <div class="admin-rt-selfie__body">\n                    <div class="admin-rt-selfie__meta">\n                        <span ng-if="s.user">{{ s.user.displayName || s.user.objectId }}</span>\n                        <span class="admin-rt-muted" ng-if="s.watchface">· {{ s.watchface.title }}</span>\n                    </div>\n                    <div class="admin-rt-muted">\n                        ♥ {{ s.likeCount }} · 💬 {{ s.commentCount }}\n                        <span ng-if="s.isAnimated">· animated</span>\n                    </div>\n                    <code class="admin-rt-target__id">{{ s.objectId }}</code>\n                    <div class="admin-rt-selfie__actions">\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--primary" ng-if="s.status !== \'approved\'" ng-click="setStatus(s, \'approved\')">Approve</button>\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-if="s.status !== \'rejected\'" ng-click="setStatus(s, \'rejected\')">Reject</button>\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-if="s.status !== \'pending\'" ng-click="setStatus(s, \'pending\')">Pending</button>\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="openComments(s)">Comments</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Comments ---------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card" ng-if="selected">\n        <admin-toolbar heading="Comments">\n            <code class="admin-rt-target__id">{{ selected.objectId }}</code>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadComments()">Reload</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="closeComments()">Close</button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="commentsLoading || commentsError" loading="commentsLoading" error="commentsError" empty="false" on-retry="loadComments()"></admin-status-states>\n\n        <div ng-if="!commentsLoading && !commentsError">\n            <div class="admin-rt-page__empty" ng-if="comments !== null && !comments.length">\n                No comments on this selfie.\n            </div>\n            <ul class="admin-rt-target-list" ng-if="comments.length">\n                <li class="admin-rt-target" ng-repeat="c in comments">\n                    <span class="admin-rt-target__label">{{ c.text }}</span>\n                    <span class="admin-rt-muted" ng-if="c.user">— {{ c.user.displayName || c.user.objectId }}</span>\n                    <span class="admin-rt-pill" ng-class="(c.status || \'active\').toLowerCase() === \'active\' ? \'admin-rt-pill--ok\' : \'admin-rt-pill--danger\'">\n                        {{ c.status || "active" }}\n                    </span>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-class="{ \'admin-rt-btn--danger\': (c.status || \'active\').toLowerCase() === \'active\' }" ng-click="toggleComment(c)">\n                        {{ (c.status || "active").toLowerCase() === "active" ? "Hide" : "Restore" }}\n                    </button>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},33250:e=>{var n="/components/admin/retool/store-sections/store-sections.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Store Sections\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Reorder and edit the live store sections for each platform. Clear the\n        store cache to publish your changes to clients.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-segmented" role="tablist" aria-label="Platform">\n        <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-repeat="p in platforms" ng-class="{ \'admin-rt-btn--primary\': p === platform }" ng-disabled="busy" ng-click="selectPlatform(p)">\n            {{ p }}\n        </button>\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="editing">\n        <h2 class="admin-rt-page__card-title">Edit section</h2>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="store-section-name">Name</label>\n                <input id="store-section-name" type="text" class="admin-rt-input" ng-model="editing.name" aria-label="Section name"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="store-section-desc">Description</label>\n                <input id="store-section-desc" type="text" class="admin-rt-input" ng-model="editing.description" aria-label="Section description"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="editError" role="alert">\n            {{ editError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-disabled="!editing.name.trim()" ng-click="saveEdit()">Save changes</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelEdit()">Cancel</button>\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Live sections ({{ platform }})">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ rows.length }} section{{ rows.length === 1 ? "" : "s" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="busy" ng-click="load()">Reload</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="busy" ng-click="clearCache()">Clear store cache</button>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" loading="loading" error="error" page-size="500" searchable="false" actions="actions" actions-label="Reorder / edit" on-retry="load()" empty-text="No live store sections for this platform.">\n        </admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},35552:e=>{var n="/components/admin/retool/storefront-promotions/storefront-promotions.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">Storefront Promotions</h1>\n    <p class="admin-rt-page__subtitle">\n        Schedule compatible watchfaces at the front of the personalized\n        storefront collection in priority order.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        Times are shown in your local timezone ({{ localTimezone }}) and saved\n        as UTC. Mobile clients may keep a cached storefront for up to 10 minutes\n        after a campaign starts or ends.\n    </div>\n\n    <div class="admin-rt-page__card" ng-if="editor">\n        <admin-toolbar heading="{{ editor.objectId ? \'Edit campaign\' : \'New campaign\' }}">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="closeEditor()">\n                Close\n            </button>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="promotion-watchface">Watchface ID</label>\n                <div class="admin-rt-page__field">\n                    <input id="promotion-watchface" class="admin-rt-input" type="text" required ng-model="editor.watchfaceId" placeholder="Exact Watchface objectId" ng-keyup="$event.keyCode === 13 && lookupWatchface()"/>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="lookupWatchface()" ng-disabled="candidateLoading">\n                        {{ candidateLoading ? "Looking up…" : "Preview" }}\n                    </button>\n                </div>\n                <div class="admin-rt-page__field-error" ng-if="candidateMessage" role="alert">\n                    {{ candidateMessage }}\n                </div>\n                <div class="admin-rt-candidate" ng-if="candidate">\n                    <img class="admin-rt-promotion-preview" ng-if="candidate.previewUrl" ng-src="{{ candidate.previewUrl }}" alt="{{ candidate.title }} preview"/>\n                    <span class="admin-rt-target__label">{{\n                        candidate.title\n                    }}</span>\n                    <span class="admin-rt-pill" ng-class="{\n                            \'admin-rt-pill--ok\': candidate.eligible,\n                            \'admin-rt-pill--danger\': !candidate.eligible\n                        }">\n                        {{ candidate.status || "unknown" }}\n                    </span>\n                    <span class="admin-rt-muted">{{\n                        candidate.targetPlatforms.join(", ") || "No platforms"\n                    }}</span>\n                    <code class="admin-rt-target__id">{{\n                        candidate.objectId\n                    }}</code>\n                </div>\n                <div class="admin-rt-callout admin-rt-callout--warn admin-rt-callout--compact" ng-repeat="warning in candidate.eligibilityWarnings">\n                    {{ warning }}\n                </div>\n            </div>\n\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="promotion-start">Starts at ({{ localTimezone }})</label>\n                <input id="promotion-start" class="admin-rt-input" type="datetime-local" required ng-model="editor.startsAt"/>\n            </div>\n\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="promotion-end">Ends at ({{ localTimezone }})</label>\n                <input id="promotion-end" class="admin-rt-input" type="datetime-local" required ng-model="editor.endsAt"/>\n            </div>\n\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="promotion-priority">Priority</label>\n                <input id="promotion-priority" class="admin-rt-input" type="number" step="1" required ng-model="editor.priority"/>\n                <span class="admin-rt-muted">Higher priority places a promoted face earlier.</span>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__field-error" ng-if="editorError" role="alert">\n            {{ editorError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="save()" ng-disabled="saving">\n                {{ saving ? "Saving…" : "Save campaign" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="closeEditor()">\n                Cancel\n            </button>\n        </div>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Active & scheduled campaigns">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ activeRows.length }} campaign{{\n                    activeRows.length === 1 ? "" : "s"\n                }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--success" ng-disabled="reordering" ng-click="startCreate()">\n                New campaign\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-disabled="reordering" ng-click="load()">\n                Reload\n            </button>\n        </admin-toolbar>\n\n        <div class="admin-rt-muted admin-rt-page__table-help">\n            Drag active campaigns by the handle to change promotion order.\n            Changes save automatically. Scheduled campaigns remain ordered by\n            start date until they become active.\n        </div>\n\n        <div class="admin-rt-page__field-error" ng-if="reorderError" role="alert">\n            Could not save campaign order: {{ reorderError }}. The previous\n            order has been restored.\n        </div>\n\n        <admin-data-table columns="activeColumns" rows="activeRows" row-key="objectId" loading="loading" error="error" page-size="1000" searchable="false" actions="activeActions" actions-label="Actions" reorderable="true" row-draggable="isActiveCampaign" reorder-disabled="reordering" on-reorder="reorderActiveCampaigns(rows, previousRows)" on-retry="load()" empty-text="No active or scheduled storefront promotion campaigns.">\n        </admin-data-table>\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Campaign history">\n            <span class="admin-rt-page__count" ng-if="!loading && !error">\n                {{ historicalRows.length }} campaign{{\n                    historicalRows.length === 1 ? "" : "s"\n                }}\n            </span>\n        </admin-toolbar>\n\n        <admin-data-table columns="columns" rows="historicalRows" row-key="objectId" loading="loading" error="error" page-size="25" search-placeholder="Filter campaign history…" actions="historicalActions" actions-label="Actions" on-retry="load()" empty-text="No historical storefront promotion campaigns.">\n        </admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},87224:e=>{var n="/components/admin/retool/takedowns/takedowns.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Takedowns\n        <span class="admin-rt-pill admin-rt-pill--danger">Legal</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Manage takedown exceptions and browse the infringement log.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    \x3c!-- ================= Takedown exceptions ================= --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Takedown exceptions"></admin-toolbar>\n        <p class="admin-rt-muted">Objects exempt from automated takedown checks.</p>\n\n        \x3c!-- Add --\x3e\n        <div class="admin-rt-page__field">\n            <select class="admin-rt-select" ng-model="exAdd.targetClassName" ng-options="c as c for c in targetClasses"></select>\n            <input class="admin-rt-input" type="text" ng-model="exAdd.targetObjectId" placeholder="Object ID to exempt"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="addException()" ng-disabled="exAddBusy">\n                {{ exAddBusy ? "Adding…" : "Add exception" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="exAddResult" role="status">{{ exAddResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="exAddError" role="alert">{{ exAddError.message || exAddError }}</div>\n\n        \x3c!-- Filter --\x3e\n        <div class="admin-rt-page__field" style="margin-top: 16px;">\n            <select class="admin-rt-select" ng-model="exFilter.targetClassName">\n                <option value="">Any class</option>\n                <option ng-repeat="c in targetClasses" value="{{ c }}">{{ c }}</option>\n            </select>\n            <input class="admin-rt-input" type="text" ng-model="exFilter.targetObjectId" ng-keyup="$event.keyCode === 13 && loadExceptions(true)" placeholder="Filter by object ID (needs a class)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadExceptions(true)">Filter</button>\n        </div>\n\n        <admin-status-states ng-if="exLoading || exError" loading="exLoading" error="exError" empty="false" on-retry="loadExceptions(false)"></admin-status-states>\n\n        <table class="admin-rt-table" ng-if="exceptions !== null && !exLoading && !exError">\n            <thead><tr><th>Class</th><th>Object ID</th><th>Added</th><th></th></tr></thead>\n            <tbody>\n                <tr ng-repeat="ex in exceptions">\n                    <td>{{ ex.targetClassName }}</td>\n                    <td><code>{{ ex.targetObjectId }}</code></td>\n                    <td class="admin-rt-muted">{{ ex.createdAt | date:\'short\' }}</td>\n                    <td>\n                        <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="removeException(ex)" ng-disabled="ex._busy">Remove</button>\n                    </td>\n                </tr>\n                <tr ng-if="!exceptions.length"><td colspan="4" class="admin-rt-muted">No exceptions found.</td></tr>\n            </tbody>\n        </table>\n        <div class="admin-rt-page__actions" ng-if="exTotal > pageSize">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="exPage(-1)" ng-disabled="exSkip <= 0">Prev</button>\n            <span class="admin-rt-muted">{{ exSkip + 1 }}–{{ exSkip + exceptions.length }} of {{ exTotal }}</span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="exPage(1)" ng-disabled="exSkip + pageSize >= exTotal">Next</button>\n        </div>\n    </div>\n\n    \x3c!-- ================= Infringement log ================= --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Infringement log"></admin-toolbar>\n\n        \x3c!-- Filter / browse --\x3e\n        <div class="admin-rt-page__field">\n            <select class="admin-rt-select" ng-model="infFilter.targetClassName">\n                <option value="">Any class</option>\n                <option ng-repeat="c in targetClasses" value="{{ c }}">{{ c }}</option>\n            </select>\n            <input class="admin-rt-input" type="text" ng-model="infFilter.targetObjectId" ng-keyup="$event.keyCode === 13 && loadInfringements(true)" placeholder="Filter by object ID (needs a class)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadInfringements(true)">Browse</button>\n        </div>\n\n        <admin-status-states ng-if="infLoading || infError" loading="infLoading" error="infError" empty="false" on-retry="loadInfringements(false)"></admin-status-states>\n\n        <table class="admin-rt-table" ng-if="infringements !== null && !infLoading && !infError">\n            <thead><tr><th>Class</th><th>Object ID</th><th>Type</th><th>Reason</th><th>Auto</th><th>When</th></tr></thead>\n            <tbody>\n                <tr ng-repeat="log in infringements">\n                    <td>{{ log.targetClassName }}</td>\n                    <td><code>{{ log.targetObjectId }}</code></td>\n                    <td>{{ log.type }}</td>\n                    <td class="admin-rt-muted">{{ log.reason }}</td>\n                    <td>{{ log.automatedFlag ? "yes" : "no" }}</td>\n                    <td class="admin-rt-muted">{{ log.createdAt | date:\'short\' }}</td>\n                </tr>\n                <tr ng-if="!infringements.length"><td colspan="6" class="admin-rt-muted">No infringements found.</td></tr>\n            </tbody>\n        </table>\n        <div class="admin-rt-page__actions" ng-if="infTotal > pageSize">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="infPage(-1)" ng-disabled="infSkip <= 0">Prev</button>\n            <span class="admin-rt-muted">{{ infSkip + 1 }}–{{ infSkip + infringements.length }} of {{ infTotal }}</span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="infPage(1)" ng-disabled="infSkip + pageSize >= infTotal">Next</button>\n        </div>\n\n        \x3c!-- Count by user --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Count infringements by user</h3>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="infCount.userId" ng-keyup="$event.keyCode === 13 && countInfringements()" placeholder="User ID (objectId)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="countInfringements()" ng-disabled="infCountBusy">\n                {{ infCountBusy ? "Counting…" : "Count" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="infCountError" role="alert">{{ infCountError.message || infCountError }}</div>\n        <table class="admin-rt-table" ng-if="infGroups">\n            <thead><tr><th>Type</th><th>Class</th><th>Count</th></tr></thead>\n            <tbody>\n                <tr ng-repeat="g in infGroups">\n                    <td>{{ g.type }}</td>\n                    <td>{{ g.targetClassName }}</td>\n                    <td>{{ g.count }}</td>\n                </tr>\n                <tr ng-if="!infGroups.length"><td colspan="3" class="admin-rt-muted">No infringements for this user.</td></tr>\n            </tbody>\n            <tfoot ng-if="infGroups.length"><tr><th>Total</th><th></th><th>{{ infCountTotal }}</th></tr></tfoot>\n        </table>\n        <p class="admin-rt-muted" ng-if="infCountTruncated">Showing first {{ infCountTotal }} (capped).</p>\n    </div>\n</div>\n')}]),e.exports=n},64024:e=>{var n="/components/admin/retool/transactions-move/transactions-move.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Move Transaction\n        <span class="admin-rt-pill admin-rt-pill--danger">Financial</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Move a purchase or subscription from one user to another.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        Moving a transaction reassigns a <strong>paid purchase</strong>: its status\n        becomes “needs validation” and the previous owner loses All Access.\n    </div>\n\n    \x3c!-- Step 1: find order ------------------------------------------------ --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="1 · Find order"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="orderLookup.orderId" ng-keyup="$event.keyCode === 13 && findOrder()" placeholder="Order ID (e.g. GPA.xxxx-xxxx-xxxx-xxxxx)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="findOrder()" ng-disabled="orderLoading">\n                {{ orderLoading ? "Searching…" : "Find order" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="orderError" role="alert">{{ orderError.message || orderError }}</div>\n\n        <ul class="admin-rt-target-list" ng-if="orders !== null && orders.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="o in orders" ng-class="{ \'admin-rt-target--active\': selectedOrder.objectId === o.objectId }" ng-click="selectOrder(o)">\n                <span class="admin-rt-target__label">\n                    {{ o.productId || "(product)" }}\n                    <span class="admin-rt-pill">{{ o.status }}</span>\n                </span>\n                <span class="admin-rt-muted">\n                    #{{ o.objectId }} · {{ o.productType }}\n                    · owner: {{ o.user.email || "(none)" }}\n                    <span ng-if="o.expiresAt"> · expires {{ o.expiresAt | date:"yyyy-MM-dd" }}</span>\n                </span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="orders !== null && !orders.length">No transactions for that order ID.</p>\n    </div>\n\n    \x3c!-- Step 2: find new user --------------------------------------------- --\x3e\n    <div class="admin-rt-page__card" ng-if="selectedOrder">\n        <admin-toolbar heading="2 · Find new owner"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="newUserLookup.email" ng-keyup="$event.keyCode === 13 && findNewUser()" placeholder="New owner\'s email"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="findNewUser()" ng-disabled="newUserLoading">\n                {{ newUserLoading ? "Searching…" : "Find user" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="newUserError" role="alert">{{ newUserError.message || newUserError }}</div>\n\n        <ul class="admin-rt-target-list" ng-if="newUsers !== null && newUsers.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="u in newUsers" ng-class="{ \'admin-rt-target--active\': selectedUser.objectId === u.objectId }" ng-click="selectUser(u)">\n                <span class="admin-rt-target__label">{{ u.displayName || "(no name)" }}</span>\n                <span class="admin-rt-muted">{{ u.email }} · #{{ u.objectId }}</span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="newUsers !== null && !newUsers.length">No user with that email.</p>\n    </div>\n\n    \x3c!-- Step 3: confirm + move -------------------------------------------- --\x3e\n    <div class="admin-rt-page__card" ng-if="selectedOrder && selectedUser">\n        <admin-toolbar heading="3 · Move"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Order</span>\n                <span>{{ selectedOrder.orderId }} ({{ selectedOrder.productId }})</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">From</span>\n                <span>{{ selectedOrder.user.email || "(none)" }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">To</span>\n                <span>{{ selectedUser.email }}</span>\n            </div>\n        </div>\n        <p class="admin-rt-page__field-error" ng-if="sameUser()" role="alert">\n            The order already belongs to that user.\n        </p>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--danger admin-rt-btn--sm" ng-click="move()" ng-disabled="moveBusy || sameUser()">\n                {{ moveBusy ? "Moving…" : "Move transaction" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="result" role="status">{{ result }}</div>\n        <div class="admin-rt-page__field-error" ng-if="moveError" role="alert">{{ moveError.message || moveError }}</div>\n    </div>\n</div>\n')}]),e.exports=n},21520:e=>{var n="/components/admin/retool/user-lists/user-lists.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        User Lists\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Curate featured user lists (e.g. brands / designers) shown in store sections.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    \x3c!-- User lists -------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="User lists">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadLists()" ng-disabled="listsLoading">\n                {{ listsLoading ? "Loading…" : "Reload" }}\n            </button>\n        </admin-toolbar>\n\n        <admin-status-states ng-if="listsLoading || listsError" loading="listsLoading" error="listsError" empty="false" on-retry="loadLists()"></admin-status-states>\n\n        <ul class="admin-rt-target-list" ng-if="lists !== null && !listsLoading && !listsError">\n            <li class="admin-rt-target admin-rt-target--btn" ng-class="{ \'admin-rt-target--active\': selected.objectId === list.objectId }" ng-repeat="list in lists" ng-click="selectList(list)">\n                <span class="admin-rt-target__label">{{ list.name || "(unnamed)" }}</span>\n                <span class="admin-rt-pill" ng-class="list.status === \'live\' ? \'admin-rt-pill--ok\' : \'\'">{{ list.status || "—" }}</span>\n                <span class="admin-rt-muted">\n                    {{ list.slug }} · {{ list.userCount }} user(s)\n                </span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="lists !== null && !lists.length && !listsLoading && !listsError">\n            No user lists yet.\n        </p>\n    </div>\n\n    \x3c!-- Selected list detail ---------------------------------------------- --\x3e\n    <div class="admin-rt-page__card" ng-if="selected">\n        <admin-toolbar heading="{{ selected.name }}"></admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">ID</span>\n                <code class="admin-rt-target__id">{{ selected.objectId }}</code>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Slug</span>\n                <span class="admin-rt-target__label">{{ selected.slug }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Description</span>\n                <span class="admin-rt-muted">{{ selected.description || "—" }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Status</span>\n                <span class="admin-rt-pill" ng-class="selected.status === \'live\' ? \'admin-rt-pill--ok\' : \'\'">{{ selected.status }}</span>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="setStatus(\'live\')" ng-disabled="statusBusy || selected.status === \'live\'">Set live</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="setStatus(\'pending\')" ng-disabled="statusBusy || selected.status === \'pending\'">Set pending</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="deleteList()" ng-disabled="deleteBusy">{{ deleteBusy ? "Deleting…" : "Delete list" }}</button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="statusResult" role="status">{{ statusResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="statusError" role="alert">{{ statusError.message || statusError }}</div>\n        <div class="admin-rt-page__field-error" ng-if="deleteError" role="alert">{{ deleteError.message || deleteError }}</div>\n\n        \x3c!-- Members ------------------------------------------------------- --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Members</h3>\n\n        <admin-status-states ng-if="membersLoading || membersError" loading="membersLoading" error="membersError" empty="false" on-retry="loadMembers()"></admin-status-states>\n\n        <ul class="admin-rt-target-list" ng-if="members !== null && !membersLoading && !membersError">\n            <li class="admin-rt-target" ng-repeat="m in members track by m.objectId">\n                <span class="admin-rt-target__label">{{ m.displayName || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ m.objectId }}</code>\n                <span class="admin-rt-muted" ng-if="m.username"> · {{ m.username }}</span>\n                <span class="admin-rt-pill admin-rt-pill--danger" ng-if="m.missing">missing</span>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="removeMember($index)">Remove</button>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="members !== null && !members.length && !membersLoading && !membersError">\n            No members.\n        </p>\n\n        \x3c!-- Add member by lookup --\x3e\n        <div class="admin-rt-page__field" style="margin-top: 12px;">\n            <select class="admin-rt-select" ng-model="memberLookup.field" ng-options="f.id as f.label for f in lookupFields"></select>\n            <input class="admin-rt-input" type="text" ng-model="memberLookup.value" ng-keyup="$event.keyCode === 13 && lookupMember()" placeholder="Find a user to add"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="lookupMember()" ng-disabled="memberLookupBusy">\n                {{ memberLookupBusy ? "Looking up…" : "Look up" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="memberLookupError" role="alert">{{ memberLookupError.message || memberLookupError }}</div>\n        <ul class="admin-rt-target-list" ng-if="memberResults && memberResults.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="u in memberResults" ng-click="addMember(u)">\n                <span class="admin-rt-target__label">{{ u.displayName || "(no name)" }}</span>\n                <code class="admin-rt-target__id">{{ u.objectId }}</code>\n                <span class="admin-rt-muted" ng-if="u.username"> · {{ u.username }}</span>\n            </li>\n        </ul>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="saveMembers()" ng-disabled="saveMembersBusy || !membersDirty">\n                {{ saveMembersBusy ? "Saving…" : (membersDirty ? "Save members" : "No changes") }}\n            </button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="saveMembersResult" role="status">{{ saveMembersResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="saveMembersError" role="alert">{{ saveMembersError.message || saveMembersError }}</div>\n    </div>\n\n    \x3c!-- Create list ------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Create user list"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="create.name" placeholder="Name"/>\n        </div>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="create.slug" placeholder="Slug (optional — derived from name)"/>\n        </div>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="create.description" placeholder="Description (optional)"/>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="createList()" ng-disabled="createBusy">{{ createBusy ? "Creating…" : "Create list" }}</button>\n        </div>\n        <div class="admin-rt-page__success" ng-if="createResult" role="status">{{ createResult }}</div>\n        <div class="admin-rt-page__field-error" ng-if="createError" role="alert">{{ createError.message || createError }}</div>\n    </div>\n</div>\n')}]),e.exports=n},66796:e=>{var n="/components/admin/retool/users-access/users-access.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Users &amp; Access\n        <span class="admin-rt-pill admin-rt-pill--danger">Auth</span>\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Look up a user, view their transactions, manage the “All Access” role,\n        control QA auto-approval exclusion, and (dev only) reset a password.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        These actions change <strong>account access</strong>. Granting All Access\n        gives premium access; password reset is permitted in dev environments only.\n    </div>\n\n    <div class="admin-rt-page__success" ng-if="feedback" role="status">{{ feedback }}</div>\n    <div class="admin-rt-page__field-error" ng-if="feedbackError" role="alert">{{ feedbackError.message || feedbackError }}</div>\n\n    \x3c!-- Lookup ------------------------------------------------------------ --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Find a user"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <select class="admin-rt-select" ng-model="search.field" ng-options="o.id as o.label for o in lookupFields"></select>\n            <input class="admin-rt-input" type="text" ng-model="search.value" ng-keyup="$event.keyCode === 13 && find()" placeholder="Value (exact match)"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="find()" ng-disabled="searchLoading">\n                {{ searchLoading ? "Searching…" : "Find" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="searchError" role="alert">{{ searchError.message || searchError }}</div>\n\n        <ul class="admin-rt-target-list" ng-if="results !== null && results.length">\n            <li class="admin-rt-target admin-rt-target--btn" ng-repeat="u in results" ng-class="{ \'admin-rt-target--active\': selected.objectId === u.objectId }" ng-click="select(u)">\n                <span class="admin-rt-target__label">\n                    {{ u.displayName || "(no name)" }}\n                    <span class="admin-rt-pill admin-rt-pill--ok" ng-if="u.hasAllAccess">All Access</span>\n                </span>\n                <span class="admin-rt-muted">{{ u.email }} · {{ u.username }} · #{{ u.objectId }}</span>\n            </li>\n        </ul>\n        <p class="admin-rt-muted" ng-if="results !== null && !results.length">No matching users.</p>\n    </div>\n\n    \x3c!-- Selected user ----------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card" ng-if="selected">\n        <admin-toolbar heading="{{ selected.displayName || selected.email || selected.objectId }}"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">User ID</span>\n                <code class="admin-rt-target__id">{{ selected.objectId }}</code>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Email</span>\n                <span>{{ selected.email || "—" }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Username</span>\n                <span>{{ selected.username || "—" }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Roles</span>\n                <span>{{ selected.rolesArray.length ? selected.rolesArray.join(", ") : "—" }}</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">All Access</span>\n                <span class="admin-rt-pill" ng-class="selected.hasAllAccess ? \'admin-rt-pill--ok\' : \'\'">\n                    {{ selected.hasAllAccess ? "yes" : "no" }}\n                </span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">QA auto-approval</span>\n                <span class="admin-rt-pill" ng-class="selected.requiresManualQaReview ? \'admin-rt-pill--warn\' : \'admin-rt-pill--ok\'">\n                    {{ selected.requiresManualQaReview ? "manual only" : "eligible" }}\n                </span>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary admin-rt-btn--sm" ng-click="giveAllAccess()" ng-disabled="busy.grant || selected.hasAllAccess">\n                {{ busy.grant ? "Granting…" : "Grant All Access" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--danger admin-rt-btn--sm" ng-click="removeAllAccess()" ng-disabled="busy.remove || !selected.hasAllAccess">\n                {{ busy.remove ? "Removing…" : "Remove All Access" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="excludeFromQaAutoApproval()" ng-disabled="busy.qaExclude || selected.requiresManualQaReview">\n                {{ busy.qaExclude ? "Saving…" : "Exclude from QA auto-approval" }}\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="allowQaAutoApproval()" ng-disabled="busy.qaAllow || !selected.requiresManualQaReview">\n                {{ busy.qaAllow ? "Saving…" : "Allow QA auto-approval" }}\n            </button>\n        </div>\n\n        \x3c!-- Transactions --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Purchase transactions</h3>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadTransactions()" ng-disabled="txLoading">\n                {{ txLoading ? "Loading…" : "Load transactions" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="txError" role="alert">{{ txError.message || txError }}</div>\n        <table class="admin-rt-split-table" ng-if="transactions && transactions.length">\n            <thead>\n                <tr>\n                    <th>Order ID</th>\n                    <th>Product</th>\n                    <th>Type</th>\n                    <th>Status</th>\n                    <th>Expires</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr ng-repeat="t in transactions">\n                    <td>{{ t.orderId }}</td>\n                    <td>{{ t.productId }}</td>\n                    <td>{{ t.productType }}</td>\n                    <td><span class="admin-rt-pill">{{ t.status }}</span></td>\n                    <td>{{ t.expiresAt ? (t.expiresAt | date:"yyyy-MM-dd") : "—" }}</td>\n                </tr>\n            </tbody>\n        </table>\n        <p class="admin-rt-muted" ng-if="transactions && !transactions.length">No transactions for this user.</p>\n\n        \x3c!-- Set password (dev only) --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 24px;">Set password (dev only)</h3>\n        <p class="admin-rt-muted">Permitted in development environments only — the server rejects this in production.</p>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="password" ng-model="password.value" placeholder="New password (min 6 chars)" autocomplete="new-password"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--danger admin-rt-btn--sm" ng-click="setPassword()" ng-disabled="busy.pw">\n                {{ busy.pw ? "Setting…" : "Set password" }}\n            </button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},79004:e=>{var n="/components/admin/retool/watchface-access-type/watchface-access-type.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">Watchface Access Type</h1>\n    <p class="admin-rt-page__subtitle">\n        Override automatic monetization for marketing campaigns: make faces free\n        or premium-only. Later publish and QA will not restore a Google Play ID.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    <div class="admin-rt-callout admin-rt-callout--warn">\n        This unlinks the Google Play IAP from the watchface; it does not delete\n        the SKU in Play Console or refund past purchases. Do not use Edit\n        platform mapping to clear a Google Play ID — that path can restore the\n        SKU on the next QA approve.\n    </div>\n\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Look up watchfaces"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <label class="admin-rt-field-row__label" for="access-type-ids">\n                Watchface object IDs\n            </label>\n            <textarea id="access-type-ids" class="admin-rt-textarea" rows="5" ng-model="idsText" placeholder="Paste one ID per line (commas or spaces also work). Max 50." aria-label="Watchface object IDs"></textarea>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="lookup()" ng-disabled="loading">\n                {{ loading ? "Looking up…" : "Look up" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="lookupError" role="alert">\n            {{ lookupError }}\n        </div>\n    </div>\n\n    <admin-status-states ng-if="loading" loading="true" error="false" empty="false"></admin-status-states>\n\n    <div class="admin-rt-page__card" ng-if="rows !== null && !loading">\n        <admin-toolbar heading="Current access type">\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="setAccessType(\'free\')" ng-disabled="saving || !actionableRows().length">\n                Make free\n            </button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--primary" ng-click="setAccessType(\'premium-only\')" ng-disabled="saving || !actionableRows().length">\n                Make premium-only\n            </button>\n        </admin-toolbar>\n\n        <div class="admin-rt-page__field-error" ng-if="saveError" role="alert">\n            {{ saveError }}\n        </div>\n\n        <admin-data-table columns="columns" rows="rows" row-key="objectId" page-size="50" search-placeholder="Filter results…" empty-text="No matching watchfaces."></admin-data-table>\n    </div>\n</div>\n')}]),e.exports=n},63916:e=>{var n="/components/admin/retool/watchface-moderation/watchface-moderation.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Watchface Moderation\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Find a watchface by search or object ID, then edit it, reinstate or take\n        it down, manage internal tags, and review its comments.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    \x3c!-- Find -------------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Find a watchface"></admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="wf-lookup">By object ID</label>\n                <input id="wf-lookup" type="text" class="admin-rt-input" ng-model="lookupId" ng-keyup="$event.keyCode === 13 && lookup()" placeholder="Watchface objectId" aria-label="Watchface object ID"/>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="lookup()">Open</button>\n            </div>\n        </div>\n\n        <div class="admin-rt-page__field" style="margin-top: 14px;">\n            <div class="admin-rt-segmented" role="tablist" aria-label="Search platform">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-repeat="p in platforms" ng-class="{ \'admin-rt-btn--primary\': p.id === platform }" ng-click="platform = p.id">\n                    {{ p.label }}\n                </button>\n            </div>\n            <input class="admin-rt-input" type="text" ng-model="searchQuery" ng-keyup="$event.keyCode === 13 && search()" placeholder="Search title / keywords…" aria-label="Search watchfaces"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="search()" ng-disabled="searching">\n                {{ searching ? "Searching…" : "Search" }}\n            </button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="searchError" role="alert">\n            {{ searchError }}\n        </div>\n\n        <admin-data-table ng-if="results !== null" columns="resultColumns" rows="results" row-key="objectId" page-size="25" actions="resultActions" actions-label="Actions" search-placeholder="Filter results…" empty-text="No matching watchfaces.">\n        </admin-data-table>\n    </div>\n\n    \x3c!-- Detail ------------------------------------------------------------ --\x3e\n    <admin-status-states ng-if="detailLoading || detailError" loading="detailLoading" error="detailError" empty="false">\n    </admin-status-states>\n\n    <div class="admin-rt-page__card" ng-if="selected && !detailLoading">\n        <admin-toolbar heading="{{ selected.title || \'Untitled watchface\' }}">\n            <span class="admin-rt-pill" ng-class="statusBadge(selected.status)">\n                {{ selected.status || "—" }}\n            </span>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="closeDetail()">Close</button>\n        </admin-toolbar>\n\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Object ID</span>\n                <code class="admin-rt-target__id">{{ selected.objectId }}</code>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Owner</span>\n                <span ng-if="selected.owner">\n                    {{ selected.owner.displayName || "(no name)" }}\n                    <code class="admin-rt-target__id">{{ selected.owner.objectId }}</code>\n                </span>\n                <span ng-if="!selected.owner" class="admin-rt-muted">No owner</span>\n            </div>\n            <div class="admin-rt-field-row">\n                <span class="admin-rt-field-row__label">Platforms</span>\n                <span>{{ (selected.targetPlatforms || []).join(", ") || selected.platform_type || "—" }}</span>\n            </div>\n            <div class="admin-rt-field-row" ng-if="selected.deleteReason">\n                <span class="admin-rt-field-row__label">Delete reason</span>\n                <span class="admin-rt-pill admin-rt-pill--danger">{{ selected.deleteReason }}</span>\n            </div>\n        </div>\n\n        \x3c!-- Edit copy / status --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 22px;">Edit</h3>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="wf-title">Title</label>\n                <input id="wf-title" type="text" class="admin-rt-input" ng-model="selected.title"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="wf-status">Status</label>\n                <select id="wf-status" class="admin-rt-select" ng-model="selected.status" ng-options="s for s in statuses"></select>\n            </div>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="editError" role="alert">\n            {{ editError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="saveEdit()">Save</button>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="reinstate()">Reinstate (draft)</button>\n        </div>\n\n        \x3c!-- Takedown --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 22px;">Take down</h3>\n        <div class="admin-rt-page__field">\n            <select class="admin-rt-select" ng-model="rejectType" ng-options="r.id as r.label for r in rejectTypes" aria-label="Takedown reason"></select>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="reject()">Take down watchface</button>\n        </div>\n\n        \x3c!-- Internal tags --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 22px;">Internal tags</h3>\n        <div class="admin-rt-page__empty" ng-if="!selected.internal_tags.length">\n            No internal tags.\n        </div>\n        <ul class="admin-rt-target-list" ng-if="selected.internal_tags.length">\n            <li class="admin-rt-target" ng-repeat="tag in selected.internal_tags">\n                <span class="admin-rt-target__label">{{ tag }}</span>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="removeTag(tag)">Remove</button>\n            </li>\n        </ul>\n        <div class="admin-rt-page__field" style="margin-top: 12px;">\n            <input class="admin-rt-input" type="text" ng-model="newTag" ng-keyup="$event.keyCode === 13 && addTag()" placeholder="Add internal tag" aria-label="New internal tag"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="addTag()">Add tag</button>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="tagError" role="alert">\n            {{ tagError }}\n        </div>\n\n        \x3c!-- Comments --\x3e\n        <h3 class="admin-rt-page__card-title" style="margin-top: 22px;">\n            Comments\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadComments()">Reload</button>\n        </h3>\n        <admin-status-states ng-if="commentsLoading || commentsError" loading="commentsLoading" error="commentsError" empty="false" on-retry="loadComments()"></admin-status-states>\n        <div ng-if="!commentsLoading && !commentsError">\n            <div class="admin-rt-page__empty" ng-if="comments !== null && !comments.length">\n                No comments on this watchface.\n            </div>\n            <ul class="admin-rt-target-list" ng-if="comments.length">\n                <li class="admin-rt-target" ng-repeat="c in comments">\n                    <span class="admin-rt-target__label">{{ c.text }}</span>\n                    <span class="admin-rt-muted" ng-if="c.author">\n                        — {{ c.author.displayName || c.author.objectId }}\n                    </span>\n                    <span class="admin-rt-muted">{{ c.createdAt | date:"short" }}</span>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--danger" ng-click="deleteComment(c)">Delete</button>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},79788:e=>{var n="/components/admin/retool/watchface-resources/watchface-resources.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">\n        Watchface Resources &amp; Sync\n    </h1>\n    <p class="admin-rt-page__subtitle">\n        Inspect watchface build resources and set their status, manage render\n        settings / live previews, and remote-sync a watchface to a user\'s device.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__success" ng-if="successMessage" role="status">\n        {{ successMessage }}\n    </div>\n\n    \x3c!-- Resources finder -------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Resources"></admin-toolbar>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="res-wf">Watchface ID</label>\n                <input id="res-wf" type="text" class="admin-rt-input" ng-model="filter.watchfaceId" ng-keyup="$event.keyCode === 13 && loadResources()" placeholder="Filter by watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="res-status">Status</label>\n                <select id="res-status" class="admin-rt-select" ng-model="filter.status" ng-disabled="filter.watchfaceId" ng-options="o.id as o.label for o in statusOptions"></select>\n            </div>\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="loadResources()">Find resources</button>\n        </div>\n        <p class="admin-rt-muted">\n            Filter by a watchface ID, or list the most recent resources for a status.\n        </p>\n\n        <admin-data-table ng-if="resources !== null" columns="resColumns" rows="resources" row-key="objectId" loading="resLoading" error="resError" page-size="25" search-placeholder="Filter results…" actions="resActions" actions-label="Set status" on-retry="loadResources()" empty-text="No resources match.">\n        </admin-data-table>\n        <admin-status-states ng-if="resources === null && (resLoading || resError)" loading="resLoading" error="resError" empty="false" on-retry="loadResources()"></admin-status-states>\n    </div>\n\n    \x3c!-- Render settings --------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Render settings &amp; live preview"></admin-toolbar>\n        <div class="admin-rt-page__field">\n            <input class="admin-rt-input" type="text" ng-model="settingsId" ng-keyup="$event.keyCode === 13 && loadSettings()" placeholder="Watchface objectId" aria-label="Watchface ID for render settings"/>\n            <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="loadSettings()">Load</button>\n        </div>\n\n        <admin-status-states ng-if="settingsLoading || settingsError" loading="settingsLoading" error="settingsError" empty="false">\n        </admin-status-states>\n\n        <div ng-if="settings && !settingsLoading">\n            <div class="admin-rt-field-grid">\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Watchface</span>\n                    <span>{{ settings.title || "Untitled" }}</span>\n                    <code class="admin-rt-target__id">{{ settings.objectId }}</code>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">overrideRenderPreviews</span>\n                    <span class="admin-rt-pill" ng-class="settings.overrideRenderPreviews ? \'admin-rt-pill--ok\' : \'admin-rt-pill--warn\'">\n                        {{ settings.overrideRenderPreviews ? "on" : "off" }}\n                    </span>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="toggleOverride()">\n                        Turn {{ settings.overrideRenderPreviews ? "off" : "on" }}\n                    </button>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Live preview</span>\n                    <a ng-if="settings.livePreviewUrl" ng-href="{{ settings.livePreviewUrl }}" target="_blank" rel="noopener">Current preview</a>\n                    <span ng-if="!settings.livePreviewUrl" class="admin-rt-muted">None set</span>\n                    <admin-file-input accept="image/*,video/*" label="Upload preview" on-file="onPreviewPicked(name, base64)"></admin-file-input>\n                </div>\n            </div>\n            <div class="admin-rt-page__field-error" ng-if="uploadError" role="alert">\n                {{ uploadError }}\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Remote sync ------------------------------------------------------- --\x3e\n    <div class="admin-rt-page__card">\n        <admin-toolbar heading="Remote sync">\n            <span class="admin-rt-pill admin-rt-pill--warn">Sensitive</span>\n        </admin-toolbar>\n        <p class="admin-rt-muted">\n            Pushes the watchface to the target user\'s device by running the sync as\n            that user. Use only for support/debugging.\n        </p>\n        <div class="admin-rt-field-grid">\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="sync-wf">Watchface ID</label>\n                <input id="sync-wf" type="text" class="admin-rt-input" ng-model="sync.watchfaceId" placeholder="Watchface objectId"/>\n            </div>\n            <div class="admin-rt-field-row">\n                <label class="admin-rt-field-row__label" for="sync-user">User ID</label>\n                <input id="sync-user" type="text" class="admin-rt-input" ng-model="sync.userId" placeholder="_User objectId"/>\n            </div>\n        </div>\n        <div class="admin-rt-page__field-error" ng-if="syncError" role="alert">\n            {{ syncError }}\n        </div>\n        <div class="admin-rt-page__actions">\n            <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="remoteSync()">Remote sync</button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},43954:e=>{var n="/components/admin/wearable-catalog/wearable-catalog.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="admin-rt-page">\n    <div class="admin-rt-page__back">\n        <a ui-sref="facer.admin">← Back to Admin</a>\n    </div>\n\n    <h1 class="admin-rt-page__title">Wearable Device Catalog</h1>\n    <p class="admin-rt-page__subtitle">\n        Manage the brands and devices behind the public device picker\n        (getWearableDeviceCatalog). Servers cache the catalog — changes may\n        take up to 5 minutes to appear everywhere.\n    </p>\n\n    <admin-env-banner></admin-env-banner>\n\n    <div class="admin-rt-page__field-error" ng-if="actionError" role="alert">\n        {{ actionError }}\n    </div>\n\n    <div class="admin-rt-tabs" role="tablist">\n        <button type="button" class="admin-rt-tab" ng-class="{ \'is-active\': tab === \'devices\' }" ng-click="setTab(\'devices\')">\n            Devices ({{ devices.length }})\n        </button>\n        <button type="button" class="admin-rt-tab" ng-class="{ \'is-active\': tab === \'brands\' }" ng-click="setTab(\'brands\')">\n            Brands ({{ brands.length }})\n        </button>\n    </div>\n\n    \x3c!-- Devices tab --------------------------------------------------------- --\x3e\n    <div ng-show="tab === \'devices\'">\n        \x3c!-- Device edit / new form --\x3e\n        <div class="admin-rt-page__card" ng-if="deviceForm">\n            <admin-toolbar heading="{{ deviceForm.objectId ? \'Edit device #\' + deviceForm.deviceId : \'New device\' }}">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelDeviceForm()">Close</button>\n            </admin-toolbar>\n\n            <div class="admin-rt-field-grid">\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-id">Device ID</label>\n                    <input id="wd-device-id" type="number" class="admin-rt-input" ng-model="deviceForm.deviceId" ng-disabled="!!deviceForm.objectId" placeholder="Unique numeric id (typed explicitly, never reused)"/>\n                    <span class="admin-rt-muted" ng-if="deviceForm.objectId">\n                        Immutable — wrist selfies reference it.\n                    </span>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-name">Name</label>\n                    <input id="wd-device-name" type="text" class="admin-rt-input" ng-model="deviceForm.deviceName" placeholder="Display name"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-brand">Brand</label>\n                    <select id="wd-device-brand" class="admin-rt-select" ng-model="deviceForm.brandId" ng-options="b.objectId as (b.brandName + (b.isActive ? \'\' : \' (inactive)\')) for b in brands">\n                        <option value="">— pick a brand —</option>\n                    </select>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-platform">Platform</label>\n                    <select id="wd-device-platform" class="admin-rt-select" ng-model="deviceForm.wearablePlatform" ng-options="p as p for p in meta.platforms">\n                        <option value="">— pick a platform —</option>\n                    </select>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-priority">Priority</label>\n                    <input id="wd-device-priority" type="number" class="admin-rt-input" ng-model="deviceForm.priority" placeholder="Lower sorts first (default 100)"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-update">Successor deviceId</label>\n                    <input id="wd-device-update" type="number" class="admin-rt-input" ng-model="deviceForm.updateDeviceId" placeholder="-1 for none; must be an existing deviceId"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-compat">Compatible device ids</label>\n                    <textarea id="wd-device-compat" class="admin-rt-textarea" rows="3" ng-model="deviceForm.compatibleDeviceIdsText" placeholder="One per line (or comma-separated)"></textarea>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wd-device-nodes">Matching node names</label>\n                    <textarea id="wd-device-nodes" class="admin-rt-textarea" rows="3" ng-model="deviceForm.matchingNodeNamesText" placeholder="One per line (or comma-separated)"></textarea>\n                </div>\n\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Flags</span>\n                    <span>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isActive"/> Active</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isRoundDevice"/> Round screen</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isWffCompatibleByDefault"/> WFF-compatible by default</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.showInAndroidCatalog"/> Android catalog</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.showInIosCatalog"/> iOS catalog</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isGenericDevice"/> Generic device</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isPopularAndroid"/> Popular (Android)</label>\n                        <label class="admin-rt-muted"><input type="checkbox" ng-model="deviceForm.isPopularApple"/> Popular (Apple)</label>\n                    </span>\n                </div>\n\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Device image</span>\n                    <img ng-if="deviceForm.currentDeviceImageUrl && deviceForm.deviceImage === undefined" ng-src="{{ deviceForm.currentDeviceImageUrl }}" alt="Device image" style="max-height: 40px"/>\n                    <span class="admin-rt-muted" ng-if="deviceForm.deviceImage">New: {{ deviceForm.deviceImage.name }}</span>\n                    <span class="admin-rt-muted" ng-if="deviceForm.deviceImage === null">Will be cleared</span>\n                    <admin-file-input accept="image/*" label="Choose image" on-file="onDeviceImagePicked(name, base64)"></admin-file-input>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="clearDeviceImage()">Clear</button>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Platform image</span>\n                    <img ng-if="deviceForm.currentPlatformImageUrl && deviceForm.platformImage === undefined && !deviceForm.platformImageFromObjectId" ng-src="{{ deviceForm.currentPlatformImageUrl }}" alt="Platform image" style="max-height: 40px"/>\n                    <span class="admin-rt-muted" ng-if="deviceForm.platformImage">New: {{ deviceForm.platformImage.name }}</span>\n                    <span class="admin-rt-muted" ng-if="deviceForm.platformImage === null && !deviceForm.platformImageFromObjectId">Will be cleared</span>\n                    <admin-file-input accept="image/*" label="Choose image" on-file="onPlatformImagePicked(name, base64)"></admin-file-input>\n                    <select class="admin-rt-select" ng-model="deviceForm.platformImageFromObjectId" ng-options="d.objectId as (\'Copy from \' + d.deviceName + \' (#\' + d.deviceId + \')\') for d in platformImageSources()">\n                        <option value="">— or copy from a device on this platform —</option>\n                    </select>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="clearPlatformImage()">Clear</button>\n                </div>\n            </div>\n\n            <div class="admin-rt-page__field-error" ng-if="deviceFormError" role="alert">\n                {{ deviceFormError }}\n            </div>\n            <div class="admin-rt-page__actions">\n                <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="saveDevice()" ng-disabled="deviceFormBusy">\n                    {{ deviceFormBusy ? "Saving…" : (deviceForm.objectId ? "Save device" : "Create device") }}\n                </button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelDeviceForm()" ng-disabled="deviceFormBusy">Cancel</button>\n            </div>\n        </div>\n\n        \x3c!-- Device list --\x3e\n        <div class="admin-rt-page__card">\n            <admin-toolbar heading="Devices">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--primary" ng-click="newDevice()">New device</button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()" ng-disabled="loading">\n                    {{ loading ? "Loading…" : "Reload" }}\n                </button>\n            </admin-toolbar>\n\n            <div class="admin-rt-page__field">\n                <select class="admin-rt-select" ng-model="deviceFilters.platform" ng-change="onDeviceFiltersChanged()" ng-options="p as p for p in meta.platforms" aria-label="Filter by platform">\n                    <option value="">All platforms</option>\n                </select>\n                <select class="admin-rt-select" ng-model="deviceFilters.brandId" ng-change="onDeviceFiltersChanged()" ng-options="b.objectId as b.brandName for b in brands" aria-label="Filter by brand">\n                    <option value="">All brands</option>\n                </select>\n                <label class="admin-rt-muted">\n                    <input type="checkbox" ng-model="deviceFilters.showInactive" ng-change="onDeviceFiltersChanged()"/>\n                    Show inactive\n                </label>\n            </div>\n\n            <admin-data-table columns="deviceColumns" rows="deviceRows" row-key="objectId" loading="loading" error="loadError" page-size="25" search-placeholder="Search name, id, node names…" actions="deviceActions" on-retry="load()" empty-text="No devices match the current filters.">\n            </admin-data-table>\n        </div>\n    </div>\n\n    \x3c!-- Brands tab ---------------------------------------------------------- --\x3e\n    <div ng-show="tab === \'brands\'">\n        \x3c!-- Brand edit / new form --\x3e\n        <div class="admin-rt-page__card" ng-if="brandForm">\n            <admin-toolbar heading="{{ brandForm.objectId ? \'Edit brand: \' + brandForm.brandName : \'New brand\' }}">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelBrandForm()">Close</button>\n            </admin-toolbar>\n\n            <div class="admin-rt-field-grid">\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wb-brand-key">Brand key</label>\n                    <input id="wb-brand-key" type="text" class="admin-rt-input" ng-model="brandForm.brandKey" placeholder="Stable slug, e.g. samsung (lowercase, a-z 0-9 _ -)"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wb-brand-name">Name</label>\n                    <input id="wb-brand-name" type="text" class="admin-rt-input" ng-model="brandForm.brandName" placeholder="Display name"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <label class="admin-rt-field-row__label" for="wb-brand-order">Sort order</label>\n                    <input id="wb-brand-order" type="number" class="admin-rt-input" ng-model="brandForm.sortOrder" placeholder="Lower sorts first"/>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Active</span>\n                    <label class="admin-rt-muted">\n                        <input type="checkbox" ng-model="brandForm.isActive"/> Active in catalog\n                    </label>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Brand logo</span>\n                    <img ng-if="brandForm.currentBrandLogoUrl && brandForm.brandLogo === undefined" ng-src="{{ brandForm.currentBrandLogoUrl }}" alt="Brand logo" style="max-height: 40px"/>\n                    <span class="admin-rt-muted" ng-if="brandForm.brandLogo">New: {{ brandForm.brandLogo.name }}</span>\n                    <span class="admin-rt-muted" ng-if="brandForm.brandLogo === null">Will be cleared</span>\n                    <admin-file-input accept="image/*" label="Choose logo" on-file="onBrandLogoPicked(name, base64)"></admin-file-input>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="clearBrandLogo()">Clear</button>\n                </div>\n                <div class="admin-rt-field-row">\n                    <span class="admin-rt-field-row__label">Onboarding logo</span>\n                    <img ng-if="brandForm.currentOnboardingBrandLogoUrl && brandForm.onboardingBrandLogo === undefined" ng-src="{{ brandForm.currentOnboardingBrandLogoUrl }}" alt="Onboarding logo" style="max-height: 40px"/>\n                    <span class="admin-rt-muted" ng-if="brandForm.onboardingBrandLogo">New: {{ brandForm.onboardingBrandLogo.name }}</span>\n                    <span class="admin-rt-muted" ng-if="brandForm.onboardingBrandLogo === null">Will be cleared</span>\n                    <admin-file-input accept="image/*" label="Choose logo" on-file="onOnboardingLogoPicked(name, base64)"></admin-file-input>\n                    <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="clearOnboardingLogo()">Clear</button>\n                </div>\n            </div>\n\n            <div class="admin-rt-page__field-error" ng-if="brandFormError" role="alert">\n                {{ brandFormError }}\n            </div>\n            <div class="admin-rt-page__actions">\n                <button type="button" class="admin-rt-btn admin-rt-btn--primary" ng-click="saveBrand()" ng-disabled="brandFormBusy">\n                    {{ brandFormBusy ? "Saving…" : (brandForm.objectId ? "Save brand" : "Create brand") }}\n                </button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="cancelBrandForm()" ng-disabled="brandFormBusy">Cancel</button>\n            </div>\n        </div>\n\n        \x3c!-- Brand list --\x3e\n        <div class="admin-rt-page__card">\n            <admin-toolbar heading="Brands">\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm admin-rt-btn--primary" ng-click="newBrand()">New brand</button>\n                <button type="button" class="admin-rt-btn admin-rt-btn--sm" ng-click="load()" ng-disabled="loading">\n                    {{ loading ? "Loading…" : "Reload" }}\n                </button>\n            </admin-toolbar>\n\n            <div class="admin-rt-page__field">\n                <label class="admin-rt-muted">\n                    <input type="checkbox" ng-model="brandFilters.showInactive" ng-change="onBrandFiltersChanged()"/>\n                    Show inactive\n                </label>\n            </div>\n\n            <div class="admin-rt-callout">\n                Deactivating a brand is blocked while it still has active\n                devices — deactivate or reassign those devices first.\n            </div>\n\n            <admin-data-table columns="brandColumns" rows="brandRows" row-key="objectId" loading="loading" error="loadError" page-size="25" search-placeholder="Search brands…" actions="brandActions" on-retry="load()" empty-text="No brands match the current filters.">\n            </admin-data-table>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},59358:e=>{var n="/components/creator/partner-program/partner-program.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="partner-program partner-program__wrapper">\n    <div class="partner-program-header">\n        <div class="partner-program-header__content">\n            <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-logo.svg\')}}" alt="Facer Creator Partner Program Logo"/>\n            <h2 class="partner-program__title">Monetize your watch faces on the #1 platform for <strong>Apple Watch,\n                    WearOS, Tizen, and more.</strong></h2>\n            <p>Join the top platform empowering independent watch face designers.</p>\n            <div class="partner-program-header__button">\n                <div ng-if="isCreatorPartner()" class="partner-program__status-label">\n                    <i class="icon-checkmark"></i>\n                    You are already a partner, congrats!\n                </div>\n                <button ng-if="!isCreatorPartner() && canApplyToPartnerPlan()" class="f-btn-rounded-primary-xl" ng-click="handleApply($event)">Apply Now</button>\n                <button ng-if="!isCreatorPartner() && !canApplyToPartnerPlan()" class="f-btn-rounded-primary-xl partner-program__button--disabled" disabled="disabled">\n                    Apply Now\n                </button>\n                <p ng-if="!isCreatorPartner() && !canApplyToPartnerPlan()" class="partner-program__apply-note">\n                    {{ getPartnerRequirementLabel() }}\n                </p>\n                <p ng-if="referralCode && referralCode.length > 0" class="partner-program__referral-code">\n                    You\'re applying with referral code {{referralCode}}\n                </p>\n            </div>\n        </div>\n        <img class="partner-program-header__visual" ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-visual.png\')}}" alt="Partner Program Header Illustration" role="img" aria-hidden="true"/>\n    </div>\n\n    <div class="partner-program-benefits">\n        <h2 class="partner-program__title">Designer Tools & Benefits</h2>\n        <ul class="partner-program-benefits__list">\n            <li>Facer Creator, without limits – Design and publish paid watch faces effortlessly with our\n                powerful\n                editor.</li>\n            <li>Everything you need to grow – Access clear documentation and helpful tools to support every step\n                of\n                your creative journey.</li>\n            <li>Track your success in real time – Monitor revenue, syncs, and top-performing designs through the\n                built-in Insights dashboard.</li>\n            <li>Exclusive marketing and publishing opportunities, plus direct support from the Facer team and\n                access\n                to a real-time chatroom with other Partner creators.</li>\n        </ul>\n    </div>\n\n    <div class="partner-program-steps">\n        <h2 class="partner-program__title">How it works</h2>\n        <ul>\n            <li class="partner-program-steps__item">\n                <div>\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-step-1.svg\')}}" alt="Partner Program Step 1"/>\n                    <h3>Create and build</h3>\n                    <p>Use Facer Creator to design high-quality watch faces. Everything you need to bring your ideas to\n                        life is built in.</p>\n                </div>\n            </li>\n            <li class="partner-program-steps__arrow">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-step-arrow.svg\')}}" alt="Partner Program Step Arrow" role="img" aria-hidden="true"/>\n            </li>\n            <li class="partner-program-steps__item">\n                <div>\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-step-2.svg\')}}" alt="Partner Program Step 2"/>\n                    <h3>Get approval</h3>\n                    <p>We’ll review your designs to make sure they meet the quality standards for publishing and\n                        monetization.</p>\n                </div>\n            </li>\n            <li class="partner-program-steps__arrow">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-step-arrow.svg\')}}" alt="Partner Program Step Arrow" role="img" aria-hidden="true"/>\n            </li>\n            <li class="partner-program-steps__item">\n                <div>\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/partner-program/partner-program-step-3.svg\')}}" alt="Partner Program Step 3"/>\n                    <h3>Earn money</h3>\n                    <p>Once approved, your watch faces will be available for purchase by millions of users around the\n                        world.</p>\n                </div>\n            </li>\n        </ul>\n    </div>\n\n    <div class="partner-program-faq">\n        <h2 class="partner-program__title">Frequently Asked Questions</h2>\n        <div class="partner-program-faq__list">\n            <div class="partner-program-faq__list-item">\n                <ul>\n                    <li><strong>How do I earn money on Facer?</strong><br/>You earn revenue when users sync your paid\n                        watch faces through Facer Premium, or when they purchase them individually. The more users\n                        choose your designs, the more you earn.<br/><br/></li>\n                    <li><strong>How and when do I get paid?</strong><br/>Earnings are calculated monthly and\n                        distributed through supported payout options. A full performance and revenue breakdown is\n                        available in your dashboard.<br/><br/></li>\n                    <li><strong>What kind of support do partners receive?</strong><br/>Partners get access to dedicated\n                        support for program-related questions, tips on publishing best practices, and ongoing updates\n                        from the Facer team to help them succeed.<br/><br/></li>\n                    \x3c!-- <li><strong>Subscriptions:</strong><br />Earn recurring revenue based on how many of your paid watch\n                        faces are synced by Facer Premium subscribers. The more users choose your designs, the more you\n                        earn each month.<br /><br /></li>\n                    <li><strong>Individual purchases:</strong><br />Users can buy your paid watch faces\n                        individually from the Facer platform. Each time a user purchases and syncs your face, you earn a\n                        share of that sale.</li> --\x3e\n                </ul>\n            </div>\n            <div>\n                <ul>\n                    <li><strong>What kinds of designs can I sell?</strong><br/>Analog, digital, hybrid, interactive, or\n                        animated—any style is welcome, as long as it\'s original and high-quality. Infringement on\n                        copyrights and trademarks is not tolerated.<br/><br/></li>\n                    <li><strong>How much can I make as a Facer Creator Partner?</strong><br/>Your earnings depend on\n                        how many users sync or purchase your designs. Some partners in the Facer Creator Partner Program\n                        make a living from their watch face creations.<br/><br/></li>\n                    <li><strong>Do I retain ownership of my work?</strong><br/>Yes, your designs remain yours. By\n                        publishing on Facer, you grant permission for your work to be distributed and promoted through\n                        the platform.<br/><br/></li>\n                    \x3c!-- <li>You must be an independent designer who produces high-quality, innovative, and diverse watch\n                        faces on Facer.</li>\n                    <li>Your watch faces must have received at least 5,000 syncs in the past 30 days.</li>\n                    <li>You must have created at least one collection of watch faces showcasing your own designs, with a\n                        banner respecting our <a\n                            href="https://help.facercreator.io/hc/en-us/articles/4412565702811-Get-Featured-on-Facer"\n                            target="_blank">quality guidelines.</li>\n                    <li>You must be an active and constructive member of the Facer community, including its forums,\n                        comment threads, etc.</li> --\x3e\n                </ul>\n            </div>\n        </div>\n    </div>\n\n    <div class="partner-program-apply">\n        <h2 class="partner-program__title">Ready to start selling your watch faces?</h2>\n        <div ng-if="isCreatorPartner()" class="partner-program__status-label">\n            <i class="icon-checkmark"></i>\n            You are already a partner, congrats!\n        </div>\n        <button ng-if="!isCreatorPartner() && canApplyToPartnerPlan()" class="f-btn-rounded-primary-xl" ng-click="handleApply($event)">\n            Apply Now\n        </button>\n        <button ng-if="!isCreatorPartner() && !canApplyToPartnerPlan()" class="f-btn-rounded-primary-xl partner-program__button--disabled" disabled="disabled">\n            Apply Now\n        </button>\n        <p ng-if="!isCreatorPartner() && !canApplyToPartnerPlan()" class="partner-program__apply-note">\n            {{ getPartnerRequirementLabel() }}\n        </p>\n        <p ng-if="referralCode && referralCode.length > 0" class="partner-program__referral-code">\n            You\'re applying with referral code {{referralCode}}\n        </p>\n    </div>\n</div>\n')}]),e.exports=n},53808:e=>{var n="/components/creator/reference/creator-reference.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="creator-reference-page">\n    <header class="creator-reference-hero">\n        <h1 class="creator-reference-hero__title">Facer Creator Reference</h1>\n        <p class="creator-reference-hero__copy">\n            Learn what expression-ready fields do, then build up from tags to functions, constants, operators, and\n            conditionals.\n        </p>\n    </header>\n\n    <nav class="creator-reference-toc" aria-label="Reference table of contents">\n        <a class="creator-reference-toc__item" ng-repeat="section in tableOfContents track by section.id" href="#{{section.id}}">\n            <span class="creator-reference-toc__label">{{section.label}}</span>\n            <span class="creator-reference-toc__description">{{section.description}}</span>\n        </a>\n    </nav>\n\n    <section id="basics" class="creator-reference-section">\n        <creator-reference-section-header section-id="basics" title="Basics" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Fields like X, Y, Width, Height, Rotation, and Opacity can take plain values or full expressions. Facer\n                uses its own 320x320 design-space coordinate system rather than device pixels, and those expressions can\n                be built from <a href="#tag-reference">tags</a>, <a href="#functions">functions</a>, <a href="#constants">constants</a>, <a href="#operators">operators</a>, and <a href="#conditional">conditionals</a> to make a layer react to time, data, and motion.\n            </p>\n        </creator-reference-section-header>\n\n        <div class="creator-reference-table-scroll creator-reference-sticky-container">\n            <table class="creator-reference-guide-table">\n                <thead>\n                    <tr>\n                        <th>Field</th>\n                        <th>Definition</th>\n                        <th>Example Value</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr ng-repeat="attribute in attributes track by attribute.value">\n                        <th><span class="creator-reference-token">{{attribute.value}}</span></th>\n                        <td>{{attribute.definition}}</td>\n                        <td><span class="creator-reference-code">{{attribute.example}}</span></td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </section>\n\n    <section id="tag-reference" class="creator-reference-section">\n        <creator-reference-section-header section-id="tag-reference" title="Tags" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Tags are the dynamic values you can drop directly into expression-ready fields. The rows below come from\n                the same visible tag source as the expanded editor, and the platform columns use the same compatibility\n                matrix shown in Creator.\n            </p>\n        </creator-reference-section-header>\n\n        <section class="creator-reference-toolbar" aria-label="Expression reference filters">\n            <div class="creator-reference-search">\n                <input type="text" class="creator-reference-search__input" ng-model="search.query" placeholder="Search tags or definitions"/>\n                <button type="button" class="creator-reference-search__clear" ng-if="(search.query || \'\').length" ng-click="clearSearch($event)" aria-label="Clear search">\n                    <i class="icon-close"></i>\n                </button>\n            </div>\n            <div class="creator-reference-count">\n                {{filteredCount}} of {{totalCount}} tags\n            </div>\n        </section>\n\n        <section class="creator-reference-table creator-reference-sticky-container" aria-label="Expression reference table">\n            <div class="creator-reference-table__header">\n                <div>Tag</div>\n                <div>Definition</div>\n                <div>Example Output</div>\n                <div class="creator-reference-table__platforms">\n                    <div class="creator-reference-platform" ng-repeat="platform in platforms track by platform.value" title="{{platform.label}}">\n                        <facer-icon icon="{{platform.icon}}"></facer-icon>\n                        <span>{{platform.label}}</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class="creator-reference-empty" ng-if="filteredCount === 0">\n                No tags found matching "{{search.query}}"\n            </div>\n\n            <div class="creator-reference-category" ng-repeat="group in filteredGroups track by group.key">\n                <h3 class="creator-reference-category__title">{{group.label}}</h3>\n\n                <div class="creator-reference-row" ng-repeat="row in group.rows track by row.id" ng-class="getStatusClass(row.compatibilityStatus)">\n                    <div class="creator-reference-row__tag">\n                        <span class="expression-highlight__tag">{{row.tag}}</span>\n                    </div>\n                    <div class="creator-reference-row__definition">\n                        {{row.description}}\n                    </div>\n                    <div class="creator-reference-row__sample">\n                        <span ng-if="row.sampleOutput !== \'\'">{{row.sampleOutput}}</span>\n                        <span ng-if="row.sampleOutput === \'\'" class="creator-reference-muted">-</span>\n                    </div>\n                    <div class="creator-reference-row__compatibility">\n                        <div class="creator-reference-status" ng-repeat="item in row.compatibilityByPlatform track by item.platform.value" ng-class="getStatusClass(item.status)" tooltip tooltip-title="item.tooltipHtml" aria-label="{{item.tooltip}}">\n                            <facer-icon icon="{{item.icon}}"></facer-icon>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </section>\n\n    <section id="functions" class="creator-reference-section">\n        <creator-reference-section-header section-id="functions" title="Functions" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Functions transform values, generate motion, and help expressions react more elegantly to time and\n                sensor input. Remember that expressions need parentheses, so <span class="creator-reference-code">(1+1)</span> works and <span class="creator-reference-code">1+1</span> does not.\n            </p>\n        </creator-reference-section-header>\n\n        <creator-reference-guide-table table="functionTable" value-column-label="Function" value-class="expression-highlight__function" on-clear-search="clearGuideTableSearch(table, $event)"></creator-reference-guide-table>\n    </section>\n\n    <section id="constants" class="creator-reference-section">\n        <creator-reference-section-header section-id="constants" title="Constants" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Constants give you access to common values without hardcoding them yourself.\n            </p>\n        </creator-reference-section-header>\n\n        <creator-reference-guide-table table="constantTable" value-column-label="Constant" value-class="creator-reference-token" on-clear-search="clearGuideTableSearch(table, $event)"></creator-reference-guide-table>\n    </section>\n\n    <section id="operators" class="creator-reference-section">\n        <creator-reference-section-header section-id="operators" title="Operators" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Operators are the basic building blocks that let you add, subtract, multiply, and divide inside\n                expressions.\n            </p>\n        </creator-reference-section-header>\n\n        <creator-reference-guide-table table="operatorTable" value-column-label="Operator" value-class="creator-reference-token" on-clear-search="clearGuideTableSearch(table, $event)"></creator-reference-guide-table>\n    </section>\n\n    <section id="conditional" class="creator-reference-section">\n        <creator-reference-section-header section-id="conditional" title="Conditional" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                A conditional is the most flexible way to make a layer change based on time, sensor state, or tag\n                values. It follows this pattern:\n            </p>\n            <div class="creator-reference-example">\n                $ <b>EQUALITY TEST</b> ? <b>EXPRESSION IF TEST IS TRUE</b> : <b>EXPRESSION IF TEST IS FALSE</b> $\n            </div>\n            <p class="creator-reference-section__copy">\n                The equality test resolves to true or false, then the conditional returns one of the two expressions.\n                These comparison operators are available:\n            </p>\n        </creator-reference-section-header>\n\n        <creator-reference-guide-table table="conditionalTable" value-column-label="Operator" value-class="expression-highlight__conditional" on-clear-search="clearGuideTableSearch(table, $event)"></creator-reference-guide-table>\n\n        <div class="creator-reference-prose">\n            <p>\n                Want a layer to appear only before noon? Start with the blank conditional:\n            </p>\n            <div class="creator-reference-example">$ ____________ ? _ : _ $</div>\n            <p>\n                Use <span class="creator-reference-code">#Da#</span> to check whether it is AM:\n            </p>\n            <div class="creator-reference-example">$ <b>#Da# == "AM"</b> ? _ : _ $</div>\n            <p>\n                If the test is true, set the layer opacity to <span class="creator-reference-code">1</span>:\n            </p>\n            <div class="creator-reference-example">$ <b>#Da# == "AM"</b> ? <b>1</b> : _ $</div>\n            <p>\n                If the test is false, return <span class="creator-reference-code">0</span> so the layer disappears:\n            </p>\n            <div class="creator-reference-example">\n                $ <b>#Da# == "AM"</b> ? <b>1</b> : <b>0</b> $\n            </div>\n        </div>\n    </section>\n\n    <section id="tips-gotchas" class="creator-reference-section">\n        <creator-reference-section-header section-id="tips-gotchas" title="Tips and Gotchas" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Expression syntax is powerful, but there are a few easy traps. The biggest one is boolean logic inside\n                conditionals: avoid wrapping the whole boolean expression in extra parentheses.\n            </p>\n        </creator-reference-section-header>\n\n        <div class="creator-reference-boolean-grid">\n            <div class="creator-reference-boolean-card creator-reference-boolean-card--good">\n                <h3>These are safe</h3>\n                <div class="creator-reference-example">\n                    $ <b>1 == 1 || 1 == 1</b> ? <b>1</b> : <b>0</b> $\n                </div>\n                <div class="creator-reference-example">\n                    $ <b>(1+1) == (1) || (1) == (1)</b> ? <b>1</b> : <b>0</b> $\n                </div>\n            </div>\n\n            <div class="creator-reference-boolean-card creator-reference-boolean-card--bad">\n                <h3>These can misbehave</h3>\n                <div class="creator-reference-example">\n                    $ <b>(1 == 1) || (1 == 1)</b> ? <b>1</b> : <b>0</b> $\n                </div>\n                <div class="creator-reference-example">\n                    $ <b>(1 == 1 || 1 == 1)</b> ? <b>1</b> : <b>0</b> $\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id="more-help" class="creator-reference-section creator-reference-section--help">\n        <creator-reference-section-header section-id="more-help" title="Need more help?" copied-section-id="copiedSectionId" on-copy-link="copySectionLink(sectionId, $event)">\n            <p class="creator-reference-section__copy">\n                Need a hand with a tricky expression? If you are trying to create a specific effect or you are still\n                getting comfortable with Creator syntax, the community is still the best place to ask for examples and\n                debugging help.\n            </p>\n        </creator-reference-section-header>\n\n        <a class="creator-reference-help-link f-btn-rounded-primary f-btn-xl" href="https://community.facer.io" community-link>\n            <facer-icon icon="discussion"></facer-icon>\n            <span>Facer Creator Forum</span>\n        </a>\n    </section>\n</div>')}]),e.exports=n},62186:e=>{var n="/components/creator/reference/guide-table/creator-reference-guide-table.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="creator-reference-table-filter" ng-if="shouldShowSearch()">\n    <div class="creator-reference-search creator-reference-search--table">\n        <input type="text" class="creator-reference-search__input" ng-model="table.searchQuery" placeholder="{{getSearchPlaceholder()}}"/>\n        <button type="button" class="creator-reference-search__clear" ng-if="(table.searchQuery || \'\').length" ng-click="clearSearch($event)" aria-label="Clear table search">\n            <i class="icon-close"></i>\n        </button>\n    </div>\n    <div class="creator-reference-count">\n        {{table.filteredRows.length}} of {{table.rows.length}} items\n    </div>\n</div>\n\n<div class="creator-reference-table-scroll creator-reference-sticky-container">\n    <table class="creator-reference-guide-table">\n        <thead>\n            <tr>\n                <th>{{valueColumnLabel}}</th>\n                <th>Definition</th>\n                <th>Example Expression</th>\n                <th>Example Output</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat="row in table.filteredRows track by row.value">\n                <th><span ng-class="valueClass">{{row.value}}</span></th>\n                <td>{{row.definition}}</td>\n                <td><span class="creator-reference-code">{{row.example}}</span></td>\n                <td>\n                    <span ng-if="row.sampleOutput !== \'\'" class="creator-reference-code">{{row.sampleOutput}}</span>\n                    <span ng-if="row.sampleOutput === \'\'" class="creator-reference-muted">-</span>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n')}]),e.exports=n},78424:e=>{var n="/components/creator/reference/section-header/creator-reference-section-header.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="creator-reference-section__header">\n    <div class="creator-reference-section__title-row">\n        <h2 class="creator-reference-section__title">{{title}}</h2>\n        <button type="button" class="creator-reference-section__anchor-button" ng-click="handleCopyLink($event)" title="{{copiedSectionId === sectionId ? \'Copied!\' : \'Copy link to \' + title}}" aria-label="Copy link to {{title}}">\n            <i class="icon-link" aria-hidden="true"></i>\n        </button>\n    </div>\n    <div ng-transclude></div>\n</div>\n')}]),e.exports=n},88576:e=>{var n="/components/home/download-sheet/home-download-sheet.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="home-download-sheet" ng-class="{\n        \'is-visible\': isVisible,\n        \'is-open\': !detectedPlatform && isOpen,\n        \'is-detected\': !!detectedPlatform\n    }">\n    <div class="home-download-sheet__inner">\n        <div class="home-download-sheet__panel">\n            <p ng-if="eyebrowText" class="home-download-sheet__eyebrow">{{ eyebrowText }}</p>\n\n            <div ng-switch="sheetMode">\n                <button ng-switch-when="collapsed" type="button" class="facer-button btn-primary btn-rounded btn-xl home-download-sheet__trigger" ng-click="openPlatformOptions()">\n                    <span class="home-download-sheet__trigger-icon" aria-hidden="true">\n                        <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">\n                            <path d="M14.5312 19.3906C14.3854 19.3385 14.25 19.25 14.125 19.125L9.625 14.625C9.375 14.375 9.25521 14.0833 9.26562 13.75C9.27604 13.4167 9.39583 13.125 9.625 12.875C9.875 12.625 10.1719 12.4948 10.5156 12.4844C10.8594 12.474 11.1562 12.5938 11.4062 12.8438L13.75 15.1875V6.25C13.75 5.89583 13.8698 5.59896 14.1094 5.35938C14.349 5.11979 14.6458 5 15 5C15.3542 5 15.651 5.11979 15.8906 5.35938C16.1302 5.59896 16.25 5.89583 16.25 6.25V15.1875L18.5938 12.8438C18.8438 12.5938 19.1406 12.474 19.4844 12.4844C19.8281 12.4948 20.125 12.625 20.375 12.875C20.6042 13.125 20.724 13.4167 20.7344 13.75C20.7448 14.0833 20.625 14.375 20.375 14.625L15.875 19.125C15.75 19.25 15.6146 19.3385 15.4688 19.3906C15.3229 19.4427 15.1667 19.4688 15 19.4688C14.8333 19.4688 14.677