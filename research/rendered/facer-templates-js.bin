\'}">\n    <div class="app-header__inner">\n        <div class="app-header__logo">\n            <div class="app-header-portal" ng-mouseenter="isPortalOpen=true" ng-mouseleave="isPortalOpen=false">\n                <button class="app-header-portal__toggle" ng-class="{\'is-active\': isPortalOpen}" ng-click="togglePortal()">\n                    <facer-icon icon="menu-portal"></facer-icon>\n                </button>\n                <ul class="app-header-portal__dropdown" ng-class="{\'is-active\': isPortalOpen}" ng-mouseenter="isPortalOpen=true" ng-mouseleave="isPortalOpen=false">\n                    <a ng-repeat="service in facerServices" class="app-header-portal__dropdown-item" ng-if="service.route" ui-sref="{{service.uiSref}}" ui-sref-opts="{inherit: false}" ng-attr-target="{{service.openInNewTab ? \'_blank\' : undefined}}">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/logos/\' + service.id + \'-logo-symbol.svg\')}}" alt="{{service.label}}"/>\n                        <div class="app-header-portal__dropdown-item-content">\n                            <span>{{service.label}}</span>\n                            <p>{{service.description}}</p>\n                        </div>\n                    </a>\n                    <a ng-repeat="service in facerServices" class="app-header-portal__dropdown-item" ng-if="!service.route" ng-href="{{service.url}}" ng-attr-target="{{service.openInNewTab ? \'_blank\' : undefined}}" rel="noopener">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/logos/\' + service.id + \'-logo-symbol.svg\')}}" alt="{{service.label}}"/>\n                        <div class="app-header-portal__dropdown-item-content">\n                            <span>{{service.label}}</span>\n                            <p>{{service.description}}</p>\n                        </div>\n                    </a>\n                </ul>\n            </div>\n            <div class="app-header__logo-wrapper">\n                <a ng-if="homeLink" ui-sref="{{homeLink}}(localeStateParams)" aria-label="{{currentService.label}} {{headerCopy.logo.homeAriaSuffix}}" role="link" class="app-header__logo-link">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/logos/\' + currentService.id + \'-logo-full.svg\')}}" alt="{{currentService.label}}"/>\n                </a>\n\n                \x3c!-- User Status Logo --\x3e\n                <img ng-if="userStatusLogo.src && currentUser()" ng-src="{{userStatusLogo.src}}" alt="{{userStatusLogo.alt}}"/>\n\n            </div>\n        </div>\n        <div class="app-header__content">\n            <ul class="app-header__nav">\n                \x3c!-- Menu Links --\x3e\n                <li ng-if="!isCreator" ng-repeat="link in menuLinks track by link.id" class="app-header-menu app-header__nav-item" ng-class="{\'is-selected\': isMenuActive(link.route)}">\n                    <a ui-sref="{{link.uiSref}}" ui-sref-opts="{inherit: false}">{{link.label}}</a>\n                </li>\n\n                \x3c!-- Search --\x3e\n                <header-search ng-if="!isCreator"></header-search>\n\n                \x3c!-- Device Selection --\x3e\n                <header-device-selection ng-if="!isCreator"></header-device-selection>\n\n                \x3c!-- Divider --\x3e\n                <li ng-if="!isCreator" class="divider-vertical hidden-sm hidden-xs"></li>\n\n                \x3c!-- Comment Feed: Creator only --\x3e\n                <li ng-if="currentUser() && isCreator" class="app-header-comment-feed">\n                    <comment-feed is-v2="true"></comment-feed>\n                </li>\n\n                \x3c!-- Notification --\x3e\n                <header-notification ng-if="currentUser()"></header-notification>\n\n                \x3c!-- Profile Menu --\x3e\n                <div ng-if="currentUser()" class="app-header-profile-menu">\n                    <profile-menu menu-align="left" toggle-class="dropdown-toggle" show-create-link hide-login></profile-menu>\n       