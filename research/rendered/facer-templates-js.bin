.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">\n    <path fill="#424242" d="M12 21.5a2.006 2.006 0 0 0 2-2h-4a2 2 0 0 0 2 2Zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V3.5a1.5 1.5 0 1 0-3 0v.68C7.63 4.86 6 7.42 6 10.5v5l-2 2v1h16v-1l-2-2Z"/>\n</svg>\n\n<svg ng-switch-when="cross" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">\n    <path fill="#424242" d="m12 13.4-4.9 4.9a.948.948 0 0 1-.7.275.948.948 0 0 1-.7-.275.948.948 0 0 1-.275-.7c0-.283.091-.517.275-.7l4.9-4.9-4.9-4.9a.948.948 0 0 1-.275-.7c0-.283.091-.517.275-.7a.948.948 0 0 1 .7-.275c.283 0 .516.092.7.275l4.9 4.9 4.9-4.9a.948.948 0 0 1 .7-.275c.283 0 .516.092.7.275a.948.948 0 0 1 .275.7.948.948 0 0 1-.275.7L13.4 12l4.9 4.9a.948.948 0 0 1 .275.7.948.948 0 0 1-.275.7.948.948 0 0 1-.7.275.948.948 0 0 1-.7-.275L12 13.4Z"/>\n</svg>\n\n<svg ng-switch-when="message" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">\n    <path fill="#424242" d="M17.92 4.5H6.08C4.928 4.5 4 5.418 4 6.558v9.49a2.07 2.07 0 0 0 2.08 2.057h7.528l1.336 1.852c.616.855 1.952.665 2.296-.324l.536-1.528h.144c1.144 0 2.08-.918 2.08-2.058v-9.49A2.07 2.07 0 0 0 17.92 4.5ZM7.912 8.774h8.176a.839.839 0 1 1 0 1.678H7.912a.839.839 0 1 1 0-1.678Zm0 4.71a.839.839 0 1 1 0-1.678H12c.464 0 .848.371.848.838a.839.839 0 0 1-.848.84H7.912Z"/>\n</svg>\n\n<svg ng-switch-when="pencil" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none">\n    <path fill="#424242" d="M3.333 16.667v-3.148l9.778-9.76c.148-.135.312-.24.49-.315a1.532 1.532 0 0 1 1.139 0c.186.075.346.186.482.334l1.019 1.037c.148.136.256.296.324.481a1.604 1.604 0 0 1 0 1.12 1.388 1.388 0 0 1-.324.491l-9.76 9.76H3.333Zm10.815-9.778 1.037-1.037-1.037-1.037-1.037 1.037 1.037 1.037Z"/>\n</svg>\n\n<svg ng-switch-when="import" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">\n    <path fill="#424242" d="M6 20c-.55 0-1.02-.196-1.412-.587A1.926 1.926 0 0 1 4 18v-2c0-.283.096-