click="close()" class="publish-form-header-inner-wrapper">\n            <h3>\n                Publish to Facer\n            </h3>\n            <i ng-show="!page.isDesktopNested()" class="icon-close"></i>\n        </div>\n    </div>\n    <div ng-show="!publishForm.loading" class="row main-publish-form-row">\n        <div ng-show="(!publishForm.saving && !publishForm.success) || !page.isIosClientShareExtension()" class="publish-form-preview col-md-6">\n            <div ng-show="watchface" class="watch-preview">\n                <div class="watch-sizing-wrapper">\n                    <div class="watch-container {{getDisplayFace().id}}">\n                        <div class="watch-background"></div>\n                        <div class="watch-shadow"></div>\n                        <div class="watch-inner-container">\n                            <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.previewUrl + \')\'}"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div ng-show="!watchface && fileImporting" class="publish-form-preview-loading">\n                <spinner/>\n            </div>\n            <div ng-show="!watchface && !fileImporting" class="publish-form-import-field">\n                <div class="watchface-media">\n                    <div class="watchface-media-item watchface-import-item">\n                        <div apple-watchface-file-uploader input-object="inputObject" on-import="onWatchfaceFileImport" importing="fileImporting" ng-class="{\'item-loading\': fileImporting}" class="watchface-media-item-add">\n                            <i class="icon-plus"></i>\n                            <span>\n                                Select <b>.watchface</b> File\n                            </span>\n                            <div class="watchface-media-item-controls">\n                                <div ng-show="fileImporting" class="watchface-media-item-controls-loading">\n                                    <spinner/>\n                                </div>\n                            </div>\n                            <input id="appleWatchfaceFileInput" type="file"/>\n                        </div>\n                    </div>\n                </div>\n                <div ng-show="!page.isIosClientShareExtension()" class="watchface-media-item-help-block">\n                    <a target="_blank" href="https://help.facer.io/hc/en-us/articles/360052939634-What-is-an-Apple-Watch-watchface-file-" class="text-link">\n                        What\'s a ".watchface" file?\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class="publish-form-field col-md-6" ng-class="{\'fill-publish-form\': publishForm.saving || publishForm.success}">\n            <div class="row">\n                <div id="publishForm" class="col-md-12" ng-class="{\'messages\': publishForm.success || saving}">\n\n                    <div ng-show="publishForm.saving || publishForm.success" class="publish-form-save-message">\n                        <div ng-show="publishForm.saving && !publishForm.success">\n                            <h4 class="text-muted">\n                                Please Wait<br>\n                                <small>(We\'re building your watchface)</small>\n                            </h4>\n                            <h3 class="no-margin text-muted">{{publishForm.savingMessage}}</h3>\n                        </div>\n                        <div ng-show="publishForm.success" class="publish-form-save-message">\n                            <h3 class="text-muted">\n                                Success!<br>\n                                <small ng-bind-html="publishForm.successMessage"></small>\n                            </h3>\n                            <div ng-show="shareableLink">\n                                <br>\n                                <a ng-show="!page.isDesktopNested()" class="btn btn-lg btn-primary btn-block" ng-click="share()">\n                                    {{publishForm.linkMessage}}\n                                </a>\n                                <a ng-show="page.isDesktopNested()" class="btn btn-lg btn-primary btn-block" ng-href="{{shareableLink}}" target="_blank">\n                                    View Design\n                                </a>\n                            </div>\n                            <br>\n                            <button ng-show="!page.isDesktopNested()" ng-click="close()" class="f-btn-rounded-default f-btn-block">\n                                Dismiss\n                            </button>\n                        </div>\n                    </div>\n\n\n                    <div ng-if="!publishForm.saving && !publishForm.success">\n                        <div ng-show="isMobile" class="form-group scrollable faded-animated watch-skin-list">\n                            <select class="form-control" name="displatWatchSelect" id="displatWatchSelect" ng-model="displayWatchGetterSetter" ng-model-options="{ getterSetter: true }" ng-options="displayWatch.model group by displayWatch.make for displayWatch in displayWatchList">\n                                <option value="">Select display watch</option>\n                            </select>\n                        </div>\n\n                        <div class="form-group">\n                            <input id="watchfaceListTitle" type="text" ng-model="publishForm.watchface.title" placeholder="Name your watchface..." maxlength="30" class="form-control input-lg"/>\n                        </div>\n\n                        <div class="form-group">\n                            <textarea id="watchfaceDescription" ng-show="!publishForm.saving" placeholder="Describe your watchface..." ng-model="publishForm.watchface.description" cols="8" row="4" class="form-control"></textarea>\n                        </div>\n\n                        <div id="categorySelect" class="form-group dropdown scrollable">\n                            <div ng-show="!isMobile" class="relative">\n                                <button id="categorySelect" class="btn btn-default btn-block dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                                    <b>{{getPrimaryCategoryName() || \'Select category\'}}</b> <span class="caret"></span>\n                                </button>\n                                <ul class="dropdown-menu dropdown-block" role="menu" aria-labelledby="dropdownMenu1">\n                                    <li ng-repeat="category in categoryList" role="presentation">\n                                        <a class="watch-select" ng-click="setPrimaryCategory(category)">\n                                            <b ng-show="publishForm.watchface.categories[0]==category.id">{{category.name}}</b>\n                                            <span ng-hide="publishForm.watchface.categories[0]==category.id">{{category.name}}</span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n\n                            <select ng-show="isMobile" class="form-control" name="categorySelect" id="categorySelect" ng-model="categoryGetterSetter" ng-model-options="{ getterSetter: true }" ng-options="category.name for category in categoryList">\n                                <option value="">Select category</option>\n                            </select>\n                        </div>\n\n                        <div ng-show="!isMobile" class="form-group scrollable faded-animated watch-skin-list">\n                            <div class="relative">\n                                <button id="watchSelect" class="btn btn-default btn-block dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n                                    <b>{{publishForm.watchface.displayFace ? publishForm.watchface.displayFace.name :\n                                        \'Select display watch\'}}</b> <span class="caret"></span>\n                                </button>\n                                <watch-model-list-menu watch-brands="displayWatchBrandList" selected-watch-id="publishForm.watchface.displayFace.id" on-select="setDisplayFace(watchTypeOption)"></watch-model-list-menu>\n                            </div>\n                        </div>\n\n                        <div class="form-group relative">\n                            <tag-input id="watchfaceListTags" tags="publishForm.watchface.tags" maxlength="130"></tag-input>\n                        </div>\n\n                        <div ng-if="!isMobile && publishForm" feature-id="creator-pro" ng-show="accessible">\n                            <div class="form-group">\n                                <label for="watchfaceListTags">Promotional Media</label>\n                                <watchface-media-manager watchface="$parent.publishForm.watchface" media="$parent.publishForm.watchface.media" is-locked="featureIsLocked(\'watchface-media-manager\')"></watchface-media-manager>\n                            </div>\n                        </div>\n\n                        <div class="watchface-options">\n                            <div class="form-group">\n                                <label>\n                                    <input type="checkbox" ng-model="publishForm.acceptedTerms">\n                                    <span ng-show="!page.isIosClientShareExtension()">I accept the <a target="_blank" ui-sref="facer.terms" class="text-link">Terms of Service</a></span>\n                                    <span ng-show="page.isIosClientShareExtension()">\n                                        I accept the Terms of Service\n                                        <br>\n                                    </span>\n                                </label>\n                                <div>\n                                    <small>\n                                        To view the Terms of Service, please visit <span class="text-link" id="tosLink" clipboard="tosLink" success-message="Terms of Service link copied to clipboard">https://www.facer.io/terms</span>\n                                        in your browser\n                                    </small>\n                                </div>\n                            </div>\n                            <div feature-id="premium-publishing" ng-show="accessible && canSaveAsDraft()" class="form-group">\n                                <label>\n                                    <input type="checkbox" ng-model="publishForm.isPremium">\n                                    <span>\n                                        Enable Monetization\n                                    </span>\n                                </label>\n                            </div>\n                        </div>\n\n                        <div class="form-group">\n                            <div ng-show="!publishForm.success && !saving" class="form-group">\n                                <div class="form-group">\n                                    <button ng-click="publish()" class="btn btn-primary btn-lg btn-block">\n                                        {{getPublishButtonLabel()}}\n                                    </button>\n                                </div>\n                                <div class="form-group text-center">\n                                    <div ng-show="canSaveAsDraft()" ng-click="saveAsDraft()" class="text-link">\n                                        Save as draft\n                                    </div>\n                                </div>\n                            </div>\n                            <div ng-show="publishForm.error && !saving" class="text-danger margin-top no-margin-bottom">\n                                {{publishForm.error}}\n                            </div>\n                        </div>\n                        <div ng-if="user && page.isIosClientShareExtension()" class="form-group">\n                            Logged in as <b>{{user.name}}</b> <a class="text-link pull-right" href ng-click="logout()">Logout</a>\n                        </div>\n                        <div ng-if="page.isIosClientShareExtension()" class="form-group">\n                            <small class="text-muted">\n                                <small>{{version.editor}}</small>\n                            </small>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},63591:e=>{var n="/html/size-input.component.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div ng-if="editor.selectedElement.type_opt == preset.value" ng-repeat="preset in option.presets" class="btn-set btn-group">\n\t<button class="btn btn-default" ng-click="updateComplicationSize(editor.selectedElement, size)" ng-repeat="size in preset.sizes" ng-class="{\'active\': isComplicationSize(editor.selectedElement, size)}">\n\t    {{ size.label }}\n\t</button>\n</div>\n')}]),e.exports=n},44647:e=>{var n="/html/slider-input.component.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div class="btn-group dropup btn-set">\n    <button id="opacity" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true">\n        <b>{{label}}: </b>{{ getDisplayValue(element) }}\n    </button>\n    <ul class="dropdown-menu vertical-slider" role="menu" aria-labelledby="opacity">\n        <li role="presentation">\n            <div class="relative">\n                <input type="range" ng-model="element[field]" debounce face-input min