busy\': isQuickReactionBusy() }" ng-init="refreshQuickReactionState()">\n                <div class="watchface-comments-quick-reactions-edge watchface-comments-quick-reactions-edge--left" ng-if="shouldShowQuickReactionLeftArrow()">\n                    <button type="button" class="watchface-comments-quick-reactions-arrow" ng-click="jumpQuickReactionsToStart()" aria-label="Show previous quick reactions">\n                        <facer-icon class="watchface-comments-quick-reactions-arrow-icon watchface-comments-quick-reactions-arrow-icon--left" icon="arrow-pills-right" aria-hidden="true"></facer-icon>\n                    </button>\n                </div>\n                <div class="watchface-comments-quick-reactions-viewport" id="{{ getQuickReactionViewportId() }}">\n                    <div class="watchface-comments-quick-reactions-list">\n                        <button type="button" class="watchface-comments-quick-reaction-chip" ng-repeat="reaction in quickReactions track by reaction" ng-init="$last && refreshQuickReactionState()" ng-click="postQuickReaction(reaction)">\n                            {{ reaction }}\n                        </button>\n                    </div>\n                </div>\n                <div class="watchface-comments-quick-reactions-edge watchface-comments-quick-reactions-edge--right" ng-if="shouldShowQuickReactionRightArrow()">\n                    <button type="button" class="watchface-comments-quick-reactions-arrow" ng-click="jumpQuickReactionsToEnd()" aria-label="Show more quick reactions">\n                        <facer-icon class="watchface-comments-quick-reactions-arrow-icon" icon="arrow-pills-right" aria-hidden="true"></facer-icon>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="comments.length" class="watchface-comments-items" ng-class="{ \'has-active-reply\': hasActiveReply() }">\n            <div class="watchface-comments-item" ng-class="{ \'is-reply-active\': isReplyFormOpen(comment), \'is-deleting\': isDeletingComment(comment), \'is-removing\': isRemovingComment(comment), \'is-newly-inserted\': comment.isNewlyInserted }" ng-repeat="comment in comments track by comment.id">\n                <a class="watchface-comments-item-avatar" user-profile-link="comment.author">\n                    <img ng-src="{{ comment.author.avatar }}" width="40" height="40" alt=""/>\n                </a>\n\n                <div class="watchface-comments-item-body">\n                    <div class="watchface-comments-item-title-row">\n                        <div class="watchface-comments-item-header">\n                            <a class="watchface-comments-item-header-link" user-profile-link="comment.author">\n                                <span class="watchface-comments-item-header-main">\n                                    <span class="author-name">{{\n                                        comment.author.name\n                                    }}</span>\n                                </span>\n                            </a>\n                            <span class="watchface-comments-item-author-label watchface-comments-item-author-label--look" ng-if="commentsFeatures.lookAuthorBadge && comment.isLookAuthor">\n                                Look author\n                            </span>\n                            <span class="watchface-comments-item-author-label" ng-if="comment.isWatchfaceAuthor">\n                                {{ getAuthorLabelText(comment) }}\n                            </span>\n                        </div>\n\n                        <div class="watchface-comments-item-header-actions">\n                            <facer-dropdown class="watchface-comments-item-dropdown">\n                                <facer-dropdown-trigger>\n                                    <button type="button" class="watchface-comments-item-menu f-btn-ghost" aria-label="Comment options">\n                                        <i class="icon-ellipsis-h"></i>\n                                    </button>\n                                </facer-dropdown-trigger>\n                                <facer-dropdown-menu>\n                                    <facer-dropdown-menu-item ng-click="reportComment(comment)">\n                                        <a>Report</a>\n                                    </facer-dropdown-menu-item>\n                                    <facer-dropdown-menu-item ng-if="canDeleteComment(comment)" ng-click="deleteComment(comment)">\n                                        <a class="text-danger">Delete</a>\n                                    </facer-dropdown-menu-item>\n                                </facer-dropdown-menu>\n                            </facer-dropdown>\n                        </div>\n                    </div>\n\n                    <div class="watchface-comments-item-meta">\n                        {{\n                            isDeletingComment(comment)\n                                ? "Deleting..."\n                                : getCommentMetaLine(comment)\n                        }}\n                    </div>\n\n                    <div class="comment-content">\n                        <div class="comment-text" text-scroll="#2BADE3">\n                            {{ getCommentBodyText(comment) }}\n                        </div>\n                    </div>\n\n                    <div ng-if="commentsFeatures.attachments && comment.attachment" class="comment-image" style="background-image:url({{\n                            comment.attachment.imagePreviewMedium\n                        }})" ng-click="viewAttachment(comment)"></div>\n\n                    <div class="watchface-comments-item-reply-link" ng-if="shouldShowReplyAction(comment)">\n                        <div ng-if="!isReplyFormOpen(comment)" class="reply-button" ng-click="reply(comment)">\n                            Reply\n                        </div>\n\n                        <div ng-if="isReplyFormOpen(comment)" class="reply-button reply-button--cancel" ng-click="cancelReply()">\n                            Cancel reply\n                        </div>\n                    </div>\n\n                    <div class="watchface-comments-reply-form-shell" ng-class="{ \'is-active\': isReplyFormOpen(comment) }">\n                        <form ng-submit="submitReply(comment)" class="watchface-comments-form watchface-comments-form--reply">\n                            <div ng-if="currentUser && !page.isMobile()" class="watchface-comments-form-avatar">\n                                <img ng-src="{{ currentUser.avatar }}" alt=""/>\n                            </div>\n                            <input id="{{ getReplyInputId(comment) }}" type="text" placeholder="Write a reply..." class="watchface-comments-text-input" ng-model="replyDraft.text" ng-disabled="isReplyPosting(comment)"/>\n                            <button class="watchface-comments-submit watchface-comments-submit--reply f-btn-rounded-primary-sm" ng-disabled="!canSubmitReply(comment)" ng-class="{ disabled: !canSubmitReply(comment), \'is-busy\': isReplyPosting(comment) }" type="submit">\n                                <span class="watchface-comments-submit-label">\n                                    {{\n                                        isReplyPosting(comment)\n                                            ? "Replying..."\n                                            : "Reply"\n                                    }}\n                                </span>\n                                <facer-icon class="watchface-comments-submit-icon" icon="send" aria-hidden="true"></facer-icon>\n                            </button>\n                        </form>\n                    </div>\n\n                    <div class="watchface-comments-item-reply" ng-class="{ \'is-deleting\': isDeletingComment(replyComment), \'is-removing\': isRemovingComment(replyComment), \'is-newly-inserted\': replyComment.isNewlyInserted }" ng-if="comment.replyComments.length" ng-repeat="replyComment in comment.replyComments track by replyComment.id">\n                        <a class="watchface-comments-item-avatar watchface-comments-item-avatar--reply" user-profile-link="replyComment.author">\n                            <img ng-src="{{ replyComment.author.avatar }}" width="40" height="40" alt=""/>\n                        </a>\n\n                        <div class="watchface-comments-item-body watchface-comments-item-body--reply">\n                            <div class="watchface-comments-item-title-row">\n                                <div class="watchface-comments-item-header">\n                                    <a class="watchface-comments-item-header-link" user-profile-link="replyComment.author">\n                                        <span class="watchface-comments-item-header-main">\n                                            <span class="author-name">{{\n                                                replyComment.author.name\n                                            }}</span>\n                                        </span>\n                                    </a>\n                                    <span class="watchface-comments-item-author-label watchface-comments-item-author-label--look" ng-if="commentsFeatures.lookAuthorBadge && replyComment.isLookAuthor">\n                                        Look author\n                                    </span>\n                                    <span class="watchface-comments-item-author-label" ng-if="replyComment.isWatchfaceAuthor">\n                                        {{ getAuthorLabelText(replyComment) }}\n                                    </span>\n                                </div>\n\n                                <div class="watchface-comments-item-header-actions">\n                                    <facer-dropdown class="watchface-comments-item-dropdown">\n                                        <facer-dropdown-trigger>\n                                            <button type="button" class="watchface-comments-item-menu f-btn-ghost" aria-label="Comment options">\n                                                <i class="icon-ellipsis-h"></i>\n                                            </button>\n                                        </facer-dropdown-trigger>\n                                        <facer-dropdown-menu>\n                                            <facer-dropdown-menu-item ng-click="reportComment(replyComment)">\n                                                <a>Report</a>\n                                            </facer-dropdown-menu-item>\n                                            <facer-dropdown-menu-item ng-if="canDeleteComment(replyComment)" ng-click="deleteComment(replyComment)">\n                                                <a class="text-danger">Delete</a>\n                                            </facer-dropdown-menu-item>\n                                        </facer-dropdown-menu>\n                                    </facer-dropdown>\n                                </div>\n                            </div>\n\n                            <div class="watchface-comments-item-meta">\n                                {{\n                                    isDeletingComment(replyComment)\n                                        ? "Deleting..."\n                                        : getCommentMetaLine(replyComment)\n                                }}\n                            </div>\n\n                            <div class="comment-content">\n                                <div class="comment-text" text-scroll="#2BADE3">\n                                    {{ getCommentBodyText(replyComment) }}\n                                </div>\n                            </div>\n\n                            <div ng-if="commentsFeatures.attachments && replyComment.attachment" class="comment-image" style="background-image:url({{\n                                    replyComment.attachment.imagePreviewMedium\n                                }})" ng-click="viewAttachment(replyComment)"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div ng-show="loading" class="text-center">\n                <button ng-disabled class="btn btn-default disabled" ng-class="{ \'btn-block\': page.isMobile() }">\n                    Loading...\n                </button>\n            </div>\n\n            <div ng-show="!loading" class="text-center">\n                <button ng-show="showLoadMore" ng-click="loadMoreComments()" type="button" class="watchface-comments-show-button text-link">\n                    {{ getLoadMoreCommentsLabel() }}\n                </button>\n            </div>\n        </div>\n\n        <div ng-if="commentsFeatures.emptyPrompt && !loading && !comments.length && !shouldShowRevealButton()" class="looks-comments__empty text-center">\n            <p>{{ emptyCommentsPrompt }}</p>\n        </div>\n\n        <div ng-if="shouldShowRevealButton()" class="watchface-comments-reveal text-center">\n            <button type="button" class="watchface-comments-show-button text-link" ng-click="revealComments()">\n                {{ getRevealCommentsLabel() }}\n            </button>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},75835:e=>{var n="/html/contest-rules.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <p align="center">\n        <strong>FACER WATCH FACE CONTEST </strong>\n    </p>\n    <p align="center">\n        <strong>OFFICIAL RULES</strong>\n    </p>\n    <p align="center">\n        <strong></strong>\n    </p>\n    <p>\n        Sponsored by Little Labs, Inc. (“<strong>Sponsor</strong>”). The Contest\n        begins on Wednesday May 13th 2015 and ends on June 26th 2015 at midnight\n        Pacific Time. VOID WHERE PROHIBITED OR RESTRICTED BY LAW.\n    </p>\n    <p>\n        <strong>1. Eligibility:</strong> The Facer Watch Face Contest (the\n        “<strong>Contest</strong>”) is open to legal residents of the United\n        States, eighteen (18) years of age or older as of the date of entry, who\n        have an active e-mail account, and Internet access as of the beginning\n        of the Contest period. Employees of Sponsor and Sponsor’s parent\n        company, affiliates, subsidiaries, advertising, promotion, fulfillment\n        or other coordinating agencies, individuals providing services to\n        Sponsor through an outsourcer or temporary employment agency during the\n        Contest period, and their respective immediate family members and\n        persons living in their same household, are not eligible to enter in the\n        Contest. Participation in the Contest constitutes entrant’s full and\n        unconditional agreement to and acceptance of these Official Rules\n        (“<strong>Official Rules</strong>”).\n    </p>\n    <p>\n        <strong>2. To Enter: </strong> By entering the Contest, you, as an\n        entrant, agree to be bound by these Official Rules. Entrant may enter\n        the Contest as described below.\n    </p>\n    <p>\n        To enter for a chance to win the Grand Prize you must create a digital\n        watchface using the Facer application http://getfacer.com, export and\n        submit the watchface file to www.getfacer.com/contest. Each digital\n        watchface entry submission for the Contest is referred to as the “\n        <strong>Submission</strong>”.\n    </p>\n    <p>\n        No mechanically reproduced Submissions are allowed and any use of\n        robotic, automatic, programmed or the like entry methods will void all\n        such Submission by such methods.\n    </p>\n    <p>\n        <strong>3. Prize Winner Selection: </strong>\n    </p>\n    <p>\n        A panel of three (3) individuals selected by Sponsor with artistic\n        experience will be responsible for judging Submissions for the Grand\n        Prize.\n    </p>\n    <p>The Submissions will be judged according to the following:</p>\n    <p>a. 50% overall design quality</p>\n    <p>b. 25% creativity</p>\n    <p>c. 25% use of broad range of Facer features</p>\n    <p>\n        The entrant whose Submission earns the highest overall score will win.\n        The decisions of the judges will be final. If any ties must be broken to\n        determine the winner, the judges will choose the tied Submission that is\n        the most artistically unique.\n    </p>\n    <p>\n        <strong>4. Rights to the Submission:</strong>\n    </p>\n    <p>\n        Entrant grants to Sponsor a worldwide, non-exclusive, perpetual,\n        irrevocable, royalty free, fully paid up, transferable right and\n        license, with a right to sublicense through multiple tiers, to use,\n        reproduce, create derivative works based upon, sell and offer for sale,\n        distribute copies of, perform and display publicly, and otherwise\n        exploit Entrant’s Submission, in any manner in which Sponsor sees fit,\n        in any and all media, now existing or hereafter developed. Entrant\n        agrees that Sponsor owns any derivative works based upon a Submission,\n        that it creates or that are created for Sponsor.\n    </p>\n    <p>\n        Entrant’s represents, warrants and covenants that Entrant’s Submission\n        (i) is original and of entrant\'s own creation, (ii) has not been entered\n        in any other competition or contest, including other competitions or\n        contests conducted by Sponsor, (iii) does not violate the intellectual\n        property or proprietary rights of other parties, or third party rights\n        of publicity or rights of privacy, and (iv) is not offensive or\n        defamatory and does not contain vulgar or profane language, as\n        determined by the judges and the Sponsor.\n    </p>\n    <p>\n        Entrant hereby agrees not to instigate, support, maintain or authorize\n        any action, claim or lawsuit against Sponsor, or any other person, on\n        the grounds that any use of the Submission as provided herein, infringes\n        any of entrant’s rights as creator of the Submission, including, without\n        limitation, trademark rights, copyrights and moral rights or “droit\n        moral.”\n    </p>\n    <p>\n        Entrant agrees, to release, indemnify, defend and hold Sponsor and its\n        parent, affiliates, subsidiaries, directors, officers, employees,\n        sponsors and agents, including advertising and promotion agencies, and\n        assigns, and any other organizations related to the Contest,\n        (“Indemnified Parties”), harmless from and against any and all claims,\n        suits, actions, demands, and proceedings of any kind threatened,\n        asserted or filed against Sponsor and/or any Indemnified Party by any\n        third party (collectively "Claims"), and any damages, losses, expenses,\n        liabilities or costs of any kind, (including but not limited to\n        reasonable attorneys\' fees, witness fees and court costs) incurred in\n        connection with such Claims, arising out of or relating to any breach or\n        alleged breach of any warranty, representation or covenant made by\n        Entrant herein. Sponsor will provide Entrant reasonably prompt written\n        notice of any such Claims and provide Entrant with reasonable\n        information and assistance, at Entrant’s expense, to help Entrant to\n        defend such Claims. Entrant will not have any right, without Sponsor’s\n        written consent, to settle any such claim if such settlement contains a\n        stipulation to or admission or acknowledgment of, any liability or\n        wrongdoing (whether in contract, tort or otherwise) on the part of the\n        Sponsor or otherwise requires Sponsor to take or refrain from taking any\n        material action (such as the payment of fees).\n    </p>\n    <p>\n        <strong>5. Prizes and Odds:</strong> The prizes to be awarded from the\n        Contest are described below.\n    </p>\n    <p>\n        Grand Prize: one (1) smartwatch, one (1) watchband and $500 in cash. The\n        prize has a total retail value of $850.\n    </p>\n    <p>\n        The odds of winning a prize depend on the total number of eligible\n        Submissions received. No cash or other substitution of prizes is\n        permitted, except at the sole option of Sponsor for a prize of equal or\n        greater value. Sponsor will not replace any lost or stolen prizes.\n        Winners are solely responsible for any and all federal, state,\n        provincial and local taxes, if any, that apply to prizes. Allow six (6)\n        to eight (8) weeks for delivery of prizes. <strong></strong>\n    </p>\n    <p>\n        <strong>6. Notification of Grand Prize Winner:</strong> Sponsor will\n        notify the Grand Prize winner by e-mail within [five (5)] business days\n        of selection, and the Grand Prize winner may be required to sign and\n        return an affidavit of eligibility and publicity/liability release\n        within [seven (7)] days of notification. If a selected winner cannot be\n        contacted, is ineligible, fails to claim a prize and/or, where\n        applicable, an affidavit of eligibility and publicity/liability release\n        is not timely received, is incomplete or modified, the prize may be\n        forfeited and an alternate winner will be selected from remaining valid,\n        eligible entries timely submitted. In the event of a dispute regarding\n        who submitted a Submission, the Submission will be deemed submitted by\n        the authorized account holder of the e-mail account specified in the\n        entry. "Authorized account holder" is defined as the natural person who\n        is assigned to an e-mail address by an Internet access provider, online\n        service provider, or other organization (e.g., business, educational\n        institution, etc.) that is responsible for assigning e-mail addresses\n        for the domain associated with the submitted e-mail address. No\n        automatically generated entries will be accepted.\n    </p>\n    <p>\n        <strong>7.Disclaimers; Indemnity; Limitation of Liability:</strong> The\n        Contest is offered by Sponsor, 1600 Main Street, Venice CA 90291, which\n        is not responsible for (a) late, lost, delayed, damaged, incomplete,\n        illegible, misdirected or undeliverable Submissions, responses, or other\n        correspondence, whether by e-mail or postal mail or otherwise; (b)\n        theft, destruction, unauthorized access to or alterations of Submission\n        materials; or (c) phone, electrical, network, computer, hardware,\n        software program or transmission malfunctions, failures or difficulties.\n    </p>\n    <p>\n        You further agree to release, indemnify, defend and hold the Indemnified\n        Parties, harmless, from any and all Claims, and any damages, losses,\n        expenses, liabilities or costs of any kind, (including but not limited\n        to reasonable attorneys\' fees, witness fees and court costs) incurred in\n        connection with such Claims, that in any way arise from participation in\n        this Contest or acceptance or use of a prize or parts thereof, including\n        without limitation (i) any condition caused by events beyond Sponsor’s\n        control that may cause the Contest to be disrupted or corrupted; (ii)\n        any injuries, losses, or damages (compensatory, direct, incidental,\n        consequential or otherwise) of any kind arising in connection with or as\n        a result of the prize, or acceptance, possession, or use of the prize,\n        or from participation in the Contest; and (iii) any printing or\n        typographical errors in any materials associated with the Contest.\n        Sponsor will provide Entrant reasonably prompt written notice of any\n        such Claims and provide Entrant with reasonable information and\n        assistance, at Entrant’s expense, to help Entrant to defend such Claims.\n        Entrant will not have any right, without Sponsor’s written consent, to\n        settle any such claim if such settlement contains a stipulation to or\n        admission or acknowledgment of, any liability or wrongdoing (whether in\n        contract, tort or otherwise) on the part of the Sponsor or otherwise\n        requires Sponsor to take or refrain from taking any material action\n        (such as the payment of fees).<strong> </strong>\n    </p>\n    <p>\n        In no event will Sponsor be liable to you for any direct, special,\n        incidental, exemplary, punitive or consequential damages (including loss\n        of use, data, business or profits) arising out of or in connection with\n        your participation in the Contest, whether such liability arises from\n        any claim based upon contract, warranty, tort (including negligence),\n        strict liability or otherwise, and whether or not Sponsor HAs been\n        advised of the possibility of such loss or damage. SPONSOR’S TOTAL\n        LIABILITY TO ANY ENTRANT UNDER THESE OFFICIAL RULES OR RELATING TO THE\n        CONTEST WILL NOT EXCEED THE VALUE OF the GRAND PRIZE. Some jurisdictions\n        do not allow the limitation or exclusion of liability for incidental or\n        consequential damages, so the above limitation or exclusion may not\n        apply to you.\n    </p>\n    <p>\n        <strong>8.Publicity:</strong> Except where prohibited, by participating\n        in the Contest, entrant consents to the use of his/her name, photo\n        and/or likeness, biographical information, and statements attributed to\n        entrant (if true) for advertising and promotional purposes, including\n        without limitation, inclusion in Sponsor’s newsletters, the Contest web\n        page at http://getfacer.com and Sponsor’s website at\n        http://getfacer.com, without additional compensation.\n    </p>\n    <p>\n        <strong>9. Personal Information: </strong> Sponsor may collect personal\n        data about entrants online, in accordance with its privacy policy and as\n        may be more specifically set forth in these Official Rules. Please\n        review these Official Rules and Sponsor’s privacy policy at\n        http://getfacer.com. By participating in the Contest, entrant hereby\n        agrees to Sponsor(s)’s collection and use of entrant’s personal\n        information and acknowledges that entrant has read and accepted\n        Sponsor’s privacy policy.\n    </p>\n    <p>\n        <strong>10. General. </strong> Sponsor reserves the right, in its sole\n        discretion, to cancel, modify or suspend the Contest in whole or in\n        part, in the event of fraud, technical or other difficulties or if the\n        integrity of the Contest is compromised, without liability to the\n        entrant. Sponsor reserves the right to disqualify any entrant or winner,\n        as determined by Sponsor, in its discretion. The Contest is subject to\n        these Official Rules and all applicable federal, state, provincial and\n        local laws and regulations apply. By participating in this Contest,\n        entrant acknowledges that entrant has read these Official Rules and\n        agrees to abide by them and by the decisions of Sponsor, which are final\n        and binding on all matters pertaining to the Contest. These Official\n        Rules are governed by the law of the State of California, without\n        reference to rules governing choice of laws. Any action, suit or case\n        arising out of, or in connection with, this Contest or these Official\n        Rules must be brought in either the federal courts located in the\n        Northern District of California or the state courts located in San\n        Francisco County, California. <strong></strong>\n    </p>\n    <p>\n        <strong>11. Winner’s List, Official Rules:</strong> For a list of prize\n        winners or a copy of these Official Rules, send your request and a\n        stamped, self-addressed envelope to Facer Contest, Little Labs, 1600\n        Main Street or (for Winner’s list only) send an email message to\n        [redacted:email]@Sponsor.com with “Winner’s list” as the email subject and\n        contest name specified in the body of the e-mail.\n    </p>\n    <p>\n        <strong>12. Sponsor(s)’s Addresses: </strong> 1600 Main Street, Venice,\n        CA 90291.\n    </p>\n</div>\n')}]),e.exports=n},11544:e=>{var n="/html/contributed.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<search-bar class="visible-xs visible-sm"></search-bar>\n<category-list></category-list>\n\n<div ng-if="exploreMobileHeader" ng-hide="isWatchfaceExplorePage() || isCollectionExplorePage()">\n    <div class="visible-sm visible-xs">\n        <div class="nav-section">\n            <div class="explore-detail explore-header">\n                <h1 class="explore-page-heading">\n                    <span ng-if="isMainExplorePage()">Browse Watch Faces</span>\n                    <span ng-if="isCategoryExplorePage()">\n                        <i ng-if="category.current.icon" class="{{category.current.icon}}"></i>\n                        {{ category.current.name }}\n                    </span>\n                    <span ng-if="isTagExplorePage()">Tag: {{ tag }}</span>\n                    <span ng-if="isFeatureExplorePage()">Feature: {{ feature }}</span>\n                    <span ng-if="isSearchExplorePage()">Search: {{ search }}</span>\n                </h1>\n            </div>\n        </div>\n\n        <div class="nav-section">\n            <div class="explore-options">\n                <div ng-if="isMainExplorePage()" class="row">\n                    <a ui-sref="facer.explore.option({option:\'popular\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link col-xs-6">Trending</a>\n                    <a ui-sref="facer.explore.option({option:\'newest\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link col-xs-6">Newest</a>\n                </div>\n                <div ng-show="isCategoryExplorePage()" class="row">\n                    <a ui-sref="facer.explore.category.option({category: category.current.id, option:\'popular\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link col-xs-6">Trending</a>\n                    <a ui-sref="facer.explore.category.option({category: category.current.id, option:\'newest\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link col-xs-6">Newest</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div ng-if="!exploreMobileHeader" ng-hide="isWatchfaceExplorePage() || isCollectionExplorePage()" class="hidden-sm hidden-xs container explore-header">\n    <div class="explore-header__title-row">\n        <h1 class="explore-title">Explore watchfaces</h1>\n        <div class="explore-options">\n            <span ng-if="isMainExplorePage()">\n                <a ui-sref="facer.explore.option({option:\'popular\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link">Trending</a>\n                &nbsp;&nbsp;\n                <a ui-sref="facer.explore.option({option:\'newest\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link">Newest</a>\n            </span>\n            <span ng-if="isCategoryExplorePage()">\n                <a ui-sref="facer.explore.category.option({category: category.current.id, option:\'popular\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link">Trending</a>\n                &nbsp;&nbsp;\n                <a ui-sref="facer.explore.category.option({category: category.current.id, option:\'newest\'})" ui-sref-opts="{location: \'replace\'}" fcr-state-active="active" class="option-link">Newest</a>\n            </span>\n        </div>\n    </div>\n\n    <div class="explore-detail">\n        <p ng-if="isCategoryExplorePage()" class="explore-detail-label">\n            Category: {{ category.current.name }}\n        </p>\n        <p ng-if="isTagExplorePage()" class="explore-detail-label">\n            Tag: {{ tag }}\n        </p>\n        <p ng-if="isFeatureExplorePage()" class="explore-detail-label">\n            Feature: {{ feature }}\n        </p>\n        <p ng-if="isSearchExplorePage()" class="explore-detail-label">\n            Search: “{{ search }}”\n        </p>\n    </div>\n</div>\n\n<div id="main" class="container no-padding-top">\n    <div ng-if="!loading && watchfaces.length == 0">\n        <div class="gray-header">No results</div>\n        <br/><br/>\n    </div>\n\n    <div id="watchface-list" class="row" ui-view="watchfaces"></div>\n    <endless margin="0" trigger="loadMoreWatchfaces()" tend-on="done"/>\n</div>\n')}]),e.exports=n},84304:e=>{var n="/html/copyright.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h1>Little Labs COPYRIGHT AND TRADEMARK POLICY</h1>\n\n    <p>Notification of Copyright and/or trademark Infringement:</p>\n    <p>\n        Little Labs, Inc. (“<b>Little Labs</b>”) respects the intellectual\n        property rights of others and expects its users to do the same.\n    </p>\n    <p>\n        It is Little Labs’ policy, in appropriate circumstances and at its\n        discretion, to disable and/or terminate the accounts of users who\n        repeatedly infringe or are repeatedly charged with infringing the\n        copyrights and/or trademarks or other intellectual property rights of\n        others.\n    </p>\n    <p>\n        In accordance with the Digital Millennium Copyright Act of 1998, the\n        text of which may be found on the U.S. Copyright Office website at\n        <a href="http://www.copyright.gov/legislation/dmca.pdf" class="text-link">http://www.copyright.gov/legislation/dmca.pdf</a>, Little Labs will respond expeditiously to claims of copyright\n        infringement committed using the Little Labs website (the “<b>Site</b>”)\n        that are reported to Little Labs’ Designated Copyright Agent, identified\n        in the sample notice below. Little Labs will also respond expeditiously\n        to claims of trademark infringement in the same manner.\n    </p>\n    <p>\n        If you are a copyright and/or trademark owner, or are authorized to act\n        on behalf of one, or authorized to act under any exclusive right under\n        copyright and/or trademark, please report alleged copyright and/or\n        trademark infringements taking place on or through the Site by\n        completing the following DMCA Notice of Alleged Infringement and\n        delivering it to Little Labs’ Designated Copyright Agent (contact\n        information below). Upon receipt of the Notice as described below,\n        Little Labs will take whatever action, in its sole discretion, it deems\n        appropriate, including removal of or disabling access to the challenged\n        material at the Site.\n    </p>\n\n    <h2>DMCA Notice of Alleged Infringement (“Notice”)</h2>\n\n    <ol>\n        <li>\n            Identify the copyrighted and/or trademarked work that you claim has\n            been infringed, or - if multiple copyrighted and/or trademarked\n            works are covered by this Notice - you may provide a representative\n            list of the copyrighted and/or trademarked works that you claim have\n            been infringed.\n        </li>\n        <li>\n            Identify (i) the material that you claim is infringing (or to be the\n            subject of infringing activity) and that is to be removed or access\n            to which is to be disabled, and provide information reasonably\n            sufficient to permit us to locate the material, including at a\n            minimum, if applicable, the URL of the link shown on the Site where\n            such material may be found, and (ii) the reference or link, to the\n            material or activity that you claim to be infringing, that is to be\n            removed or access to which is to be disabled, and information\n            reasonably sufficient to permit us to locate that reference or link,\n            including at a minimum, if applicable, the URL of the link shown on\n            the Site where such reference or link may be found.\n        </li>\n        <li>\n            Provide your mailing address, telephone number, and, if available,\n            email address.\n        </li>\n        <li>\n            Include both of the following statements in the body of the Notice,\n            if they are true:\n            <ul>\n                <li>\n                    “I hereby state that I have a good faith belief that the\n                    disputed use of the copyrighted and/or trademark material or\n                    reference or link to such material is not authorized by the\n                    copyright and/or trademark owner, its agent, or the law\n                    (e.g., as a fair use).”\n                </li>\n                <li>\n                    “I hereby state that the information in this Notice is\n                    accurate and, under penalty of perjury, that I am the owner,\n                    or authorized to act on behalf of the owner, of the\n                    copyright and/or trademark or of an exclusive right under\n                    the copyright and/or trademark that is allegedly infringed.”\n                </li>\n            </ul>\n        </li>\n        <li>\n            Provide your full legal name and your electronic or physical\n            signature.\n        </li>\n    </ol>\n    <p>\n        Deliver this Notice, with all items completed, to Little Labs’\n        Designated Copyright Agent:<br/>\n        <br/>\n        <b>Copyright Manager</b><br/>\n        <b>Little Labs, Inc.</b><br/>\n        <b>10000 Washington Boulevard</b><br/>\n        <b>6th Floor</b><br/>\n        <b>Culver City, CA 90232</b><br/>\n        <b>Phone: 949-704-6123</b><br/>\n        <a href="mailto:[redacted:email]@facer.io" class="text-link">[redacted:email]@facer.io</a><br/>\n    </p>\n\n    <h2>Counter Notices:</h2>\n\n    <p>\n        One who has posted material or a reference or link to material, that\n        allegedly infringes a copyright and/or trademark may send Little Labs a\n        counter notice pursuant to Sections 512(g)(2) and 512(g)(3) of the DMCA.\n        When Little Labs receives a counter notice, Little Labs will reinstate\n        the material or reference or link in question in not less than 10 and\n        not more than 14 business days after Little Labs receives the Counter\n        Notice, unless Little Labs first receives notice from the copyright\n        and/or trademark claimant that he or she has filed a legal action to\n        restrain the allegedly infringing activity. To provide a Counter Notice\n        to Little Labs, please return the following form to Little Labs’\n        designated Copyright Agent. Please note that if you provide a Counter\n        Notice, in accordance with the Little Labs Privacy Policy located at\n        <a href="https://www.facer.io/privacy" class="text-link">https://www.facer.io/privacy</a>\n        and the requirements of the DMCA, a copy of the Counter Notice will be\n        given to the copyright and/or trademark claimant.\n    </p>\n\n    <p><b>Counter Notice</b></p>\n\n    <ol>\n        <li>\n            Identify the material or the reference or link that has been removed\n            or to which access has been disabled and the location at which the\n            material or reference or link appeared before it was removed or\n            access to it was disabled.\n        </li>\n        <li>\n            Provide your mailing address, telephone number, and, if available,\n            email address.\n        </li>\n        <li>\n            Include both of the following statements in the body of the Notice,\n            if true:\n            <ul>\n                <li>\n                    “I hereby state under penalty of perjury that I have a good\n                    faith belief that the material or reference or link was\n                    removed or disabled as a result of mistake or\n                    misidentification of the material or reference or link to be\n                    removed or disabled.” (A “mistake,” for purposes of this\n                    statement, could include an erroneous conclusion that the\n                    material was infringing or that the use of the material was\n                    not permissible as fair use.)\n                </li>\n                <li>\n                    “I hereby state that I consent to the jurisdiction of the\n                    Federal District Court for the judicial district in which my\n                    address is located or, if my address is outside of the\n                    United States, for any judicial district in which Little\n                    Labs may be found, and I will accept service of process from\n                    the complaining party who notified Little Labs of the\n                    alleged infringement or an agent of such person.”\n                </li>\n            </ul>\n        </li>\n\n        <li>\n            Provide your full legal name and your electronic or physical\n            signature.\n        </li>\n    </ol>\n\n    <p>\n        Deliver this Notice, with all items completed, to Little Labs’\n        Designated Copyright Agent:<br/>\n        <br/>\n        <b>Copyright Manager</b><br/>\n        <b>Little Labs, Inc.</b><br/>\n        <b>10000 Washington Boulevard</b><br/>\n        <b>6th Floor</b><br/>\n        <b>Culver City, CA 90232</b><br/>\n        <b>Phone: 949-704-6123</b><br/>\n        <a href="mailto:[redacted:email]@facer.io" class="text-link">[redacted:email]@facer.io</a><br/>\n    </p>\n</div>\n')}]),e.exports=n},80534:e=>{var n="/html/country-picker-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="f-modal-wrapper editor-modal country-picker-modal-wrapper">\n    <div class="f-modal-scroll-wrapper">\n        <div class="f-modal-content">\n            <div class="f-modal-header">\n                <h4 class="f-modal-title">Manage country availability</h4>\n            </div>\n\n            <div class="f-modal-body">\n                <div class="country-picker-modal-wrapper">\n                    <div class="country-picker-modal">\n                        <div ng-show="loading" class="loading-indicator">\n                            Loading countries...\n                        </div>\n                        <div ng-show="loadError" class="error-message">\n                            Failed to load countries. Please try again.\n                        </div>\n                        <div ng-hide="loading || loadError" class="country-picker-list">\n                            <div class="checkbox all-checkbox" ng-class="{\'indeterminate\': isIndeterminate}">\n                                <label ng-click="toggleAll($event)">\n                                    <input type="checkbox" ng-checked="allSelected" tabindex="-1"/>\n                                    <span class="indeterminate-icon" ng-show="isIndeterminate"></span>\n                                    <span>All</span>\n                                </label>\n                            </div>\n\n                            <div ng-repeat="country in countries" class="checkbox">\n                                <label>\n                                    <input type="checkbox" ng-model="country.selected" ng-change="onCountryChange()"/>\n                                    <span>\n                                        {{country.name}}\n                                    </span>\n                                </label>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class="f-btn-wrapper">\n                    <button ng-click="done()" class="f-btn-rounded-primary">\n                        Done\n                    </button>\n\n                    <button ng-click="cancel()" class="f-btn-ghost-primary">\n                        Cancel\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <div ng-click="cancel()" class="f-modal-backdrop">\n            <div class="f-modal-close">\n                <i class="icon-close"></i>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},23102:e=>{var n="/html/creator-pro-lock.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="lock-bg" ng-click="promptUpgrade()">\n    <div class="lock-flag">\n        <img ng-src="{{facerStaticAssetUrl(\'/img/creator-pro-label.svg\')}}"/>\n    </div>\n</div>\n')}]),e.exports=n},55904:e=>{var n="/html/creator-upgrade.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="creator-upgrade-page">\n    <div class="creator-upgrade-page__hero text-center">\n        <h1 class="creator-upgrade-page__section-title">Choose the plan that matches where you are as a creator.</h1>\n        <p class="creator-upgrade-page__description">\n            Start free, unlock advanced tools with Pro, or apply to Partner\n            when you\'re ready to monetize your designs.\n        </p>\n\n        <div class="creator-upgrade-page__billing-controls" ng-if="shouldShowBillingControls()">\n            <div class="creator-upgrade-page__billing-toggle">\n                <button class="creator-upgrade-page__billing-option" ng-class="{\n                        \'is-active\': billingCycle === \'yearly\'\n                    }" ng-click="setBillingCycle(\'yearly\')">\n                    Yearly\n                </button>\n                <button class="creator-upgrade-page__billing-option" ng-class="{\n                        \'is-active\': billingCycle === \'monthly\'\n                    }" ng-click="setBillingCycle(\'monthly\')">\n                    Monthly\n                </button>\n            </div>\n            <div class="creator-upgrade-page__billing-savings" ng-if="yearlySavingsPercent">\n                <span class="creator-upgrade-page__billing-savings-value">\n                    Save {{ yearlySavingsPercent }}%\n                </span>\n                <span class="creator-upgrade-page__billing-savings-copy">\n                    on a yearly subscription\n                </span>\n            </div>\n        </div>\n    </div>\n\n    <subscription-manager ng-if="shouldLoadHiddenProSubscriptionManager()" type="hidden" product="Creator Pro"></subscription-manager>\n\n    <div class="row creator-upgrade-page__plans">\n        <div class="col-md-4 col-sm-6" ng-repeat="plan in plans">\n            <section class="creator-upgrade-card creator-upgrade-card--{{ plan.id }}" ng-class="{\n                    \'creator-upgrade-card--current\': isCurrentPlan(plan.id),\n                    \'creator-upgrade-card--next\': isNextPlan(plan.id),\n                    \'creator-upgrade-card--highlight-once\': shouldHighlightPlan(plan.id)\n                }">\n                <div class="creator-upgrade-card__header">\n                    <div class="creator-upgrade-card__title-row">\n                        <h2>{{ plan.label }}</h2>\n                        <span class="creator-upgrade-card__current" ng-if="isCurrentPlan(plan.id)">\n                            Current plan\n                        </span>\n                    </div>\n                    <p class="creator-upgrade-card__headline">{{ plan.headline }}</p>\n                </div>\n\n                <ul class="creator-upgrade-card__features">\n                    <li ng-repeat="feature in plan.features" ng-class="{\n                            \'creator-upgrade-card__feature--added\': feature.isAdded,\n                            \'creator-upgrade-card__feature--first-added\': feature.isFirstAdded,\n                            \'creator-upgrade-card__feature--pro\': feature.tone === \'pro\',\n                            \'creator-upgrade-card__feature--partner\': feature.tone === \'partner\'\n                        }">\n                        <i class="icon-checkmark"></i>\n                        <span class="creator-upgrade-card__feature-copy">{{ feature.label }}</span>\n                    </li>\n                </ul>\n\n                <div class="creator-upgrade-card__actions" ng-switch="plan.id">\n                    <div ng-switch-when="pro" class="creator-upgrade-card__subscription" ng-if="shouldShowProSubscription()">\n                        <div class="creator-upgrade-card__action-detail">\n                            <div class="creator-upgrade-card__pricing" ng-if="priceAmount">\n                                <div class="creator-upgrade-card__price-amount">\n                                    {{ priceAmount }}\n                                </div>\n                                <div class="creator-upgrade-card__price-meta">\n                                    <div class="creator-upgrade-card__price-period">\n                                        per month\n                                    </div>\n                                    <div class="creator-upgrade-card__price-billing" ng-class="{\n                                            \'creator-upgrade-card__price-billing--placeholder\': !billingNote\n                                        }">\n                                        {{ billingNote || "billed yearly" }}\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <subscription-manager type="subscribe-button" product="Creator Pro"></subscription-manager>\n                    </div>\n\n                    <div ng-switch-when="partner" class="creator-upgrade-card__partner-action" ng-if="!isCurrentPlan(\'partner\')">\n                        <div class="creator-upgrade-card__action-detail" ng-if="!canApplyToPartnerPlan() || hasPartnerReferralCode()">\n                            <div class="creator-upgrade-card__button-note">\n                                {{ hasPartnerReferralCode() ? getPartnerReferralLabel() : getPartnerRequirementLabel() }}\n                            </div>\n                        </div>\n                        <button ng-if="canApplyToPartnerPlan()" type="button" ng-click="handlePartnerApply()" class="btn btn-lg btn-block creator-upgrade-card__action-button creator-upgrade-card__button">\n                            {{ getPartnerActionLabel() }}\n                        </button>\n                        <button ng-if="!canApplyToPartnerPlan()" type="button" class="btn btn-lg btn-block creator-upgrade-card__action-button creator-upgrade-card__button creator-upgrade-card__button--disabled" disabled="disabled">\n                            {{ getPartnerActionLabel() }}\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </div>\n\n    <div class="creator-upgrade-page__coupon" ng-if="showUpgradeCouponCodeInput && showUpgradeCouponCodeInput()">\n        <div class="subscription-coupon" ng-if="shouldShowUpgradeCouponPrompt && shouldShowUpgradeCouponPrompt()">\n            Have a promo code? <span ng-click="openUpgradeCouponInput()" class="text-link">Redeem it here</span>\n        </div>\n        <form ng-if="shouldShowUpgradeCouponForm && shouldShowUpgradeCouponForm()" ng-submit="applyUpgradeCoupon()" class="coupon-code-form creator-upgrade-page__coupon-form">\n            <div class="form-group">\n                <div class="form-inline">\n                    <input class="form-control" id="creatorUpgradeCouponCode" ng-model="upgradeCouponEntry" type="text" placeholder="Coupon code"/>\n                    <button type="submit" class="f-btn-rounded-primary-sm">Apply</button>\n                </div>\n                <span class="help-block" ng-if="getUpgradeCouponCodeMessage && getUpgradeCouponCodeMessage()">\n                    {{ getUpgradeCouponCodeMessage() }}\n                </span>\n            </div>\n        </form>\n    </div>\n\n    <section class="creator-upgrade-creators" ng-if="featuredCreators.length">\n        <div class="creator-upgrade-creators__header text-center">\n            <h2 class="creator-upgrade-page__section-title">The best watch face designers on the planet are already on Facer. Join them today!</h2>\n            <p>See some of the creators already building and growing on Facer.</p>\n        </div>\n\n        <div class="creator-upgrade-creators__viewport">\n            <div class="creator-upgrade-creators__track">\n                <div class="creator-upgrade-creators__sequence" ng-repeat="copyIndex in [0, 1] track by $index" ng-attr-aria-hidden="{{ copyIndex === 1 ? \'true\' : undefined }}">\n                    <a class="creator-upgrade-creators__item" ng-repeat="creator in featuredCreators track by creator.id + \'-\' + copyIndex" user-profile-link="creator" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{ creator.avatar }}" alt="{{ creator.name }}"/>\n                        <span>{{ creator.name }}</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class="creator-upgrade-faq">\n        <div class="creator-upgrade-faq__header text-center">\n            <h2 class="creator-upgrade-page__section-title">Frequently asked questions</h2>\n        </div>\n\n        <div class="creator-upgrade-faq__groups">\n            <div class="creator-upgrade-faq__group" ng-repeat="group in faqGroups">\n                <h3 class="creator-upgrade-faq__group-title">{{ group.title }}</h3>\n\n                <div class="creator-upgrade-faq__items">\n                    <div class="creator-upgrade-faq__item" ng-repeat="item in group.items" ng-class="{ \'is-expanded\': isFaqItemExpanded(item.id) }">\n                        <button type="button" class="creator-upgrade-faq__question" ng-click="toggleFaqItem(item.id)" ng-attr-aria-expanded="{{ isFaqItemExpanded(item.id) ? \'true\' : \'false\' }}" ng-attr-aria-controls="{{ \'creator-upgrade-faq-answer-\' + item.id }}">\n                            <span>{{ item.question }}</span>\n                            <span class="creator-upgrade-faq__icon" aria-hidden="true">\n                                {{ isFaqItemExpanded(item.id) ? "×" : "+" }}\n                            </span>\n                        </button>\n                        <div class="creator-upgrade-faq__answer" ng-show="isFaqItemExpanded(item.id)" ng-attr-id="{{ \'creator-upgrade-faq-answer-\' + item.id }}">\n                            <p ng-if="item.answer">{{ item.answer }}</p>\n                            <p ng-if="item.answerLink">\n                                {{ item.answerPrefix }}<a ng-href="{{ item.answerLink.href }}" target="_blank" rel="noopener noreferrer">{{ item.answerLink.label }}</a>{{ item.answerSuffix }}\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <p class="creator-upgrade-faq__footer">\n            Still have more questions?\n            <a href="https://help.facercreator.io" target="_blank" rel="noopener noreferrer">\n                Check out our help center\n            </a>\n        </p>\n    </section>\n</div>\n')}]),e.exports=n},84337:e=>{var n="/html/crossfader.template.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="watch-inner-container">\n    \x3c!--<img ng-repeat="image in images" ng-class="{\'show-watchface\': $index==currentIndex}" ng-src="{{image.src}}" />--\x3e\n    <div class="byline fade-in-out" ng-repeat-start="watchface in watchfaces" ng-if="!loading && $index==currentIndex">\n        <a ui-sref="facer.watchface({watchface: watchface.id})">{{watchface.title}} by<img ng-src="{{watchface.designer.avatar}}" width="20" height="20"/>{{watchface.designer.name}}</a>\n    </div>\n    <a class="viewer fade-in-out" ng-repeat-end ng-class="{\'show-watchface\': $index==currentIndex && !loading}" ui-sref="facer.watchface({watchface: watchface.id})">\n        <canvas id="viewer{{$index}}"></canvas>\n    </a>\n    <spinner class="fade-in-out" ng-if="loading"/>\n</div>\n')}]),e.exports=n},98853:e=>{var n="/html/debug-info-component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-if="getDebugInfo()" ng-switch="type" class="debug-info">\n    <pre ng-switch-default>{{getDebugInfo()|json}}</pre>\n    <table ng-switch-when="list">\n        <tr ng-repeat="(key, value) in getDebugInfo()">\n            <td class="key">{{key}}</td>\n            <td class="value">{{getDisplayValue(value)}}</td>\n        </tr>\n    </table>\n</div>\n')}]),e.exports=n},19625:e=>{var n="/html/designer-program.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h1>Premium Designer Program</h1>\n\n    <p>\n        We are now accepting applications to become a premium designer, which\n        will allow you to sell your designs through Facer. Here are the steps to\n        apply:\n    </p>\n\n    <ol>\n        <li>\n            Send an email to\n            <a class="text-link" href="mailto:[redacted:email]@facer.io">[redacted:email]@facer.io</a>\n        </li>\n        <li>\n            Include:\n            <ul>\n                <li>Your full name</li>\n                <li>\n                    A link to any of your current Facer designs/your Facer\n                    profile\n                </li>\n                <li>\n                    If you don’t have any Facer designs, you can link to your\n                    design portfolio or any watch faces you’ve created outside\n                    of the Facer platform\n                </li>\n                <li>\n                    Please note that all designs must be completely original\n                    with no copyrighted or trademarked material\n                </li>\n                <li>\n                    Any other information that you would like us to consider\n                </li>\n            </ul>\n        </li>\n    </ol>\n\n    <p>\n        Once your email with the requested information is received, we will get\n        back to you within one week about your application. If you are accepted\n        into the premium designer program, we will share all the details on how\n        to get started with the program. If you are not accepted, don’t worry!\n        Most designers will not be accepted and there are many reasons why. You\n        will still be able to distribute your designs for free and all designs\n        will be considered for promotional placement within our store during our\n        weekly store refreshes. Keep on designing and you will be eligible to\n        apply again after you have an original design that hits 2500 syncs.\n    </p>\n\n    <p>\n        Thank you for your interest in the program and for your continued\n        support of Facer!\n    </p>\n\n    <p>\n        <b>The Facer Team</b>\n    </p>\n</div>\n')}]),e.exports=n},16378:e=>{var n="/html/devices.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="flush-top device-tracker">\n    <div class="container">\n        <div id="pageHeader">\n            <h1>Smartwatch Tracker</h1>\n            <p>\n                The Smartwatch Tracker aggregates data from the Facer platform\n                on a weekly basis to show the most popular operating systems,\n                brands, and devices on the market.\n            </p>\n        </div>\n\n        <div ng-if="loaded">\n            <div class="row charts">\n                <div class="col-lg-4">\n                    <h3>OS <small class="text-muted">% of users</small></h3>\n                    <chart ng-if="data.os" data="data.os" no-labels height="300" maintain-aspect-ratio hover-highlight use-alt-legend></chart>\n                </div>\n\n                <div class="col-lg-4">\n                    <h3>Brand <small class="text-muted">% of users</small></h3>\n                    <chart ng-if="data.brand" data="data.brand" no-labels height="300" maintain-aspect-ratio hover-highlight use-alt-legend></chart>\n                </div>\n\n                <div class="col-lg-4">\n                    <h3>Device <small class="text-muted">% of users</small></h3>\n                    <chart ng-if="data.device" data="data.device" no-labels height="300" maintain-aspect-ratio hover-highlight use-alt-legend></chart>\n                </div>\n            </div>\n\n            <div class="row">\n                <div class="col-lg-12">\n                    <h3 id="rankingHeader">Most Popular Smartwatches</h3>\n                    <table class="table" ng-if="data.topDeviceList">\n                        \x3c!--<thead>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<th class="text-muted device-rank">#</th>\n\t\t\t\t\t\t\t\t<th class="text-muted">Brand</th>\n\t\t\t\t\t\t\t\t<th class="text-muted">Model</th>\n\t\t\t\t\t\t\t\t<th></th>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</thead>--\x3e\n                        <tbody>\n                            <tr ng-repeat="device in data.topDeviceList" ng-class="{\'top-device\': $index < 5}">\n                                <a ui-sref="facer.home" target="_blank">\n                                    <td class="device-rank">{{$index+1}}</td>\n                                    <td class="device-make">\n                                        {{device.info.make}}\n                                    </td>\n                                    <td class="device-name">\n                                        <span>\n                                            <span class="device-name-make">{{device.info.make}}\n                                            </span>\n                                            {{device.info.model}}\n                                            <p ng-if="device.watchface">\n                                                <small>shown here with\n                                                    <a target="_blank" ui-sref="facer.watchface.fullscreen({watchface: device.watchface.id, watchModel: device.info.id})" class="text-link">{{device.watchface.title}}</a>\n                                                    by\n                                                    <a target="_blank" user-profile-link="device.watchface.author" class="text-link">{{device.watchface.author.name}}</a></small>\n                                            </p>\n                                        </span>\n                                    </td>\n                                    <td class="device-image">\n                                        <a target="_blank" ui-sref="facer.watchface.fullscreen({watchface: device.watchface.id, watchModel: device.info.id})" class="device-image-wrapper">\n                                            <div class="watch-sizing-wrapper">\n                                                <div class="watch-container {{device.info.id}}">\n                                                    <div class="watch-background"></div>\n                                                    <div class="watch-shadow"></div>\n                                                    <div class="watch-inner-container">\n                                                        <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + device.image + \')\'}"></div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </a>\n                                    </td>\n                                </a>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n\n            <div class="row">\n                <div class="col-lg-12">\n                    <p id="updateTime" class="text-muted">\n                        <small>Last updated on {{lastUpdatedDate|date}}</small>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <loader ng-if="!loaded && !error"/>\n        <h6 ng-if="error">Error loading data</h6>\n    </div>\n</div>\n')}]),e.exports=n},81248:e=>{var n="/html/facer-plus-lock.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="lock-bg" ng-click="purchaseFacerPlus()">\n    <div class="lock-flag">\n        <img ng-src="{{facerStaticAssetUrl(\'/img/facer-plus.png\')}}"/>\n    </div>\n</div>\n')}]),e.exports=n},19387:e=>{var n="/html/featured.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="flush-top">\n    <div ng-if="preLiveMode" class="container-fluid">\n        <br/>\n        <div class="alert alert-info" role="alert">\n            <b>QA MODE</b> You are currently viewing the pre-live version of the\n            store.\n        </div>\n    </div>\n\n    <div class="container featured-listing-intro sr-only" ng-if="getFeaturedSubheading() || getFeaturedIntro()">\n        <h1 class="featured-listing-subheading" ng-if="getFeaturedSubheading()">\n            {{ getFeaturedSubheading() }}\n        </h1>\n        <p class="featured-listing-intro-copy" ng-if="getFeaturedIntro()">\n            {{ getFeaturedIntro() }}\n        </p>\n    </div>\n\n    <div ng-show="!loadingCarousel">\n        <div id="carousel">\n            <div class="carousel-wrapper">\n                <slick ng-if="carouselEnabled" init-onload="true" data="carousel" settings="carousel.settings" center-mode="!isMobile" current-index="carousel.index" data="carousel.images" dots="false" infinite="true" autoplay-speed="6000" speed="500" autoplay="true" slides-to-show="1" touch-move="true" prev-arrow=".left-arrow" next-arrow=".right-arrow" slides-to-scroll="1">\n                    <div ng-repeat="hero in carousel.images">\n                        <div ng-if="hero==\'facer-2-0\'">\n                            <a ng-click="showVideo()"><img title="Facer" alt="Facer watch faces" draggable="false" ng-src="{{facerStaticAssetUrl(\'/img/banners/generic-facer-banner.png\')}}"/></a>\n                        </div>\n                        <div ng-if="hero!==\'facer-2-0\'">\n                            <a ng-href="{{getSectionUrl(hero)}}">\n                                <img title="{{hero.get(\'name\')}}" alt="{{hero.get(\'description\')}}" draggable="false" ng-src="{{hero.get(\'targetCollection\').get(\'hero_art\').url()}}"/>\n                            </a>\n                        </div>\n                    </div>\n                </slick>\n            </div>\n            <div id="leftArrow" class="left-arrow">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/left-arrow.png\')}}" alt=""/>\n            </div>\n            <div id="rightArrow" class="right-arrow">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/right-arrow.png\')}}" alt=""/>\n            </div>\n        </div>\n\n        <div ng-show="page.isNativeAppleWatchContext()" class="creator-cta">\n            <div feature-id="mobile-creator" class="container">\n                <a ng-show="showMobileCreatorCta()" target="_blank" href="" ng-click="openCreator()">\n                    <img height="36" ng-src="{{facerStaticAssetUrl(\'/img/apple-watch-icon.png\')}}"/> Create\n                    your own design <i class="icon-chevron-right"></i>\n                </a>\n                <a ng-show="!showMobileCreatorCta()" target="_blank" href="https://help.facer.io/hc/en-us/articles/360055127093-How-do-I-publish-my-Apple-Watch-face-designs-">\n                    <img height="36" ng-src="{{facerStaticAssetUrl(\'/img/apple-watch-icon.png\')}}"/> Publish\n                    your own Apple Watch designs\n                    <i class="icon-chevron-right"></i>\n                </a>\n            </div>\n            \x3c!-- <div id="bannerGrid">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/banner-grid-bg.png\')}}" />\n            </div> --\x3e\n        </div>\n        <div ng-show="showBanner && !showFacerPremiumCta()" class="creator-cta">\n            <div class="container">\n                <a target="_blank" ng-href="{{creatorCtaLink}}">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/wireframeicon.png\')}}"/><span>&nbsp;&nbsp; Make your own\n                        watchface</span>\n                    <i class="icon-chevron-right"></i></a>\n            </div>\n            \x3c!-- <div id="bannerGrid">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/banner-grid-bg.png\')}}" />\n            </div> --\x3e\n        </div>\n        <div ng-show="showBanner && showFacerPremiumCta()" class="facer-premium-cta">\n            <div id="premiumBg">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/dots-stripes.png\')}}" class="dots-stripes-bg"/>\n                <img ng-src="{{facerStaticAssetUrl(\'/img/zigzag.png\')}}" class="zigzag-bg"/>\n            </div>\n            <a ui-sref="facer.premium" class="container" ng-click="clickFacerPremiumCta()">\n                <div class="icon-container">\n                    <i class="main-icon icon-premium"></i>\n                </div>\n                <div class="text-container">\n                    <span class="primary-text">Facer Premium</span>\n                    <span class="secondary-text">Instantly access all premium faces.</span>\n                </div>\n                <div class="btn-container">\n                    <button class="btn">{{facerPremiumLinkText()}}</button>\n                </div>\n            </a>\n            \x3c!-- <div id="bannerGrid">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/banner-grid-bg.png\')}}" />\n            </div> --\x3e\n        </div>\n\n        <rating-prompt ng-show="page.isIosClient()"></rating-prompt>\n\n        <h2 class="section-name sr-only">Featured Watch Faces</h2>\n\n        <div class="sections">\n            <div id="section{{section.id}}" class="section-list container" ng-repeat="section in sections.slice(0, getListLength())" list-section>\n                <div ng-if="collection.targetType === \'collection\'">\n                    <div class="section-header">\n                        <a>\n                            <h2 class="section-name">\n                                {{collection.name}}\n                            </h2>\n                            <div class="section-description">\n                                {{collection.description}}\n                            </div>\n                        </a>\n\n                        <div class="see-more" ng-if="!collection.fakeParseObject">\n                            <a ng-href="{{getSeeMoreLink()}}" class="text-link">\n                                MORE\n                            </a>\n                        </div>\n                    </div>\n                    <div id="watchface-list" class="row" ng-include="\'/html/watchfaces.partial.html\'"></div>\n                </div>\n                <div ng-if="collection.targetType === \'userList\'">\n                    <div class="section-header">\n                        <a>\n                            <h2 class="section-name">\n                                {{collection.name}}\n                            </h2>\n                            <div class="section-description">\n                                {{collection.description}}\n                            </div>\n                        </a>\n\n                        <div class="see-more" ng-if="!collection.fakeParseObject">\n                            <a ng-href="{{getSeeMoreLink()}}" class="text-link">\n                                MORE\n                            </a>\n                        </div>\n                    </div>\n                    <div id="user-list" class="row user-list-container">\n                        <div ng-repeat="user in collection.userList.slice(0, 8)" class="user-list-item">\n                            <a user-profile-link="user" class="user-list-avatar" ng-attr-aria-label="{{user.get(\'displayName\') || \'View profile\'}}" style="background-image:url(\'{{user.get(\'file\').url()}}\')"></a>\n                            <a user-profile-link="user" class="user-list-avatar-name">\n                                {{user.get(\'displayName\')}}\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div ng-if="collection.targetType === \'wristSelfies\'">\n                    <div class="section-header">\n                        <a>\n                            <h2 class="section-name">\n                                {{collection.name}}\n                            </h2>\n                            <div class="section-description">\n                                {{collection.description}}\n                            </div>\n                        </a>\n\n                        <div class="see-more">\n                            <a ng-href="{{getSeeMoreLink()}}" class="text-link">\n                                MORE\n                            </a>\n                        </div>\n                    </div>\n                    <div class="featured-looks-list">\n                        <div class="watchfaces-wrapper looks-feed featured-looks-section">\n                            <div class="watchfaces-inner-wrapper">\n                                <div ng-repeat="look in collection.wristSelfies.slice(0, getSectionTileLimit()) track by look.id" class="featured-look-wrapper">\n                                    <looks-card look="look" layout="featured" on-activate="openFeaturedLook(look)"></looks-card>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class="looks-feed featured-looks-modal-host" ng-if="looksDetailModal.isOpen">\n        <div class="looks-feed__modal" ng-click="closeFeaturedLookModal($event)" role="dialog" aria-modal="true" aria-label="Looks detail">\n            <button class="looks-feed__modal-close" type="button" ng-click="closeFeaturedLookModal($event)" aria-label="Close Looks detail">\n                <i class="icon-close"></i>\n            </button>\n\n            <button class="looks-feed__modal-nav looks-feed__modal-nav--previous" type="button" ng-if="looksDetailModal.canNavigatePrevious" ng-click="navigateFeaturedLookModal(-1, $event)" aria-label="Previous Look">\n                <i class="icon-chevron-left"></i>\n            </button>\n\n            <button class="looks-feed__modal-nav looks-feed__modal-nav--next" type="button" ng-if="looksDetailModal.canNavigateNext" ng-click="navigateFeaturedLookModal(1, $event)" aria-label="Next Look">\n                <i class="icon-chevron-right"></i>\n            </button>\n\n            <div class="looks-feed__modal-dialog" ng-click="$event.stopPropagation()" ng-controller="LooksDetail">\n                <div ng-include="\'/components/looks/looks-detail/looks-detail.component.html\'"></div>\n            </div>\n        </div>\n    </div>\n    <endless ready-when="sectionsLoaded && sections.length" busy-when="loadingMore" margin="200" trigger="showMoreSections()" end-on="done"/>\n    <loader ng-if="sectionsLoaded && !done && loadingMore"></loader>\n</div>')}]),e.exports=n},19544:e=>{var n="/html/follow-button.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="follow-button" ng-if="followStatusLoaded && !isCurrentUser" ng-class="{\n        loading: loadingFollow,\n        \'is-following\': isFollowing\n    }">\n    <a ng-if="!isFollowing && !loadingFollow" ng-click="followUser()" class="btn btn-primary btn-block text-center">\n        <i class="icon-person_add_black_24dp"></i>\n        <span>\n            {{ loadingFollow ? "Loading..." : "Follow" }}\n        </span>\n    </a>\n    <a ng-if="isFollowing && !loadingFollow" ng-click="unfollowUser()" class="btn btn-default btn-block text-center">\n        <i class="icon-person_checked_black_24dp"></i>\n        <span>\n            {{ loadingFollow ? "Loading..." : "Following" }}\n        </span>\n    </a>\n    <a ng-if="loadingFollow" ng-click="unfollowUser()" class="btn btn-default btn-block text-center" ng-class="{\n            \'btn-primary\': !isFollowing,\n            \'btn-default\': isFollowing\n        }">\n        <spinner></spinner>\n    </a>\n</div>\n')}]),e.exports=n},62994:e=>{var n="/html/footer.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="footer">\n    <div class="footer__inner">\n        <div class="footer__top">\n            <div class="footer__top-inner">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/logos/facer_logo.png\')}}" alt="{{footerCopy.logo.alt}}" class="footer__logo-image"/>\n                <div class="footer__store-links" role="group" aria-label="Download Facer">\n                    <a class="footer__store-link" app-link="ios" app-link-placement="footer" app-link-label="Download Facer from the App Store" href target="_blank" rel="noopener noreferrer">\n                        <img class="footer__store-badge" ng-src="{{facerStaticAssetUrl(\'/img/logos/appstore-logo.svg\')}}" alt="Download Facer from the App Store"/>\n                    </a>\n                    <a class="footer__store-link" app-link="android" app-link-placement="footer" app-link-label="Download Facer from Google Play" href target="_blank" rel="noopener noreferrer">\n                        <img class="footer__store-badge" ng-src="{{facerStaticAssetUrl(\'/img/logos/playstore-logo.svg\')}}" alt="Download Facer from Google Play"/>\n                    </a>\n                </div>\n            </div>\n            <div class="footer__menus">\n                <div class="footer__menu" ng-repeat="section in footerSections track by section.id">\n                    <strong>{{section.title}}</strong>\n                    <ul>\n                        <li ng-repeat="link in section.links track by link.id">\n                            <a ng-if="link.route" ui-sref="{{link.route}}(link.stateParams)">{{link.label}}</a>\n                            <a ng-if="!link.route && link.communityLinkValue" ng-href="{{link.href}}" community-link="{{link.communityLinkValue}}">{{link.label}}</a>\n                            <a ng-if="!link.route && !link.communityLinkValue" ng-href="{{link.href}}">{{link.label}}</a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class="footer__social-section" aria-labelledby="footer-social-heading">\n            <p class="footer__social-heading" id="footer-social-heading">Connect with us on social</p>\n            <ul class="footer__socials">\n                <li>\n                    <a href="https://www.instagram.com/facer_io" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_ic_01.svg\')}}" alt="{{footerCopy.social.instagram}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.facebook.com/getfacer" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_ic_02.svg\')}}" alt="{{footerCopy.social.facebook}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.youtube.com/channel/UCzV0oVsUSEK4oOPZb6pkeYQ" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_ic_03.svg\')}}" alt="{{footerCopy.social.youtube}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.reddit.com/r/Facer/" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_reddit.svg\')}}" alt="{{footerCopy.social.reddit}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.tiktok.com/@facer_io" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_tiktok.svg\')}}" alt="{{footerCopy.social.tiktok}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://twitter.com/facer_io" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_ic_04.svg\')}}" alt="{{footerCopy.social.twitter}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.snapchat.com/add/facer_io" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_snapchat.svg\')}}" alt="{{footerCopy.social.snapchat}}"/>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.linkedin.com/company/facerio" target="_blank" rel="noopener noreferrer">\n                        <img ng-src="{{facerStaticAssetUrl(\'/img/footer/social/social_linkedin.svg\')}}" alt="{{footerCopy.social.linkedin}}"/>\n                    </a>\n                </li>\n            </ul>\n        </div>\n        <div class="footer__bottom">\n            © {{copyrightYear}} FACER - All rights reserved<span ng-if="version.editor">&nbsp;<button type="button" class="footer-version-copy" ng-click="copyWebVersion()" aria-label="Copy Facer web version v{{version.editor}}">\n                    <span class="footer-version-copy__label">{{ versionCopyLabel || ("v" + version.editor) }}</span>\n                    <span class="footer-version-copy__sizer" aria-hidden="true">{{ "v" + version.editor }}</span>\n                </button>.</span><br/><span ng-bind-html="footerRecaptchaNoticeHtml"></span>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},58066:e=>{var n="/html/gif-maker.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="gif-maker-wrapper">\n    <div class="gif-maker">\n        <div id="watch" class="gif-maker-canvas" style="background:{{bgImage}};">\n            \x3c!--<canvas id="watchfaceGif" class="active gif-maker-canvas" ng-class="{\'fade-load\': loadingWatch}" ng-click="toggleState()"></canvas>\n            <div id="gifFrame" style="position:relative;top:0 !important;left:0 !important;display: inline-block;vertical-align: middle;z-index:1000;">\n                <img id="gifFrame" class="gif-frame" style="position:absolute;">\n            </div>--\x3e\n            <div