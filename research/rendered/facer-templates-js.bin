_logo js-fade-in-up">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/landing/creator/creator_logo.png\')}}" alt="Logo of Facer Creator"/>\n            </div>\n            <div class="home-creator__images js-fade-in-up">\n                <img class="home-creator__image home-creator__image--left is-hidden-mobile" ng-src="{{facerStaticAssetUrl(\'/img/landing/creator/creator_features_01.png\')}}" alt="Create your own watch face"/>\n                <img class="home-creator__image home-creator__image--center" ng-src="{{facerStaticAssetUrl(\'/img/landing/creator/creator_app.png\')}}" alt="Create your own watch face"/>\n                <img class="home-creator__image home-creator__image--right is-hidden-mobile" ng-src="{{facerStaticAssetUrl(\'/img/landing/creator/creator_features_02.png\')}}" alt="Create your own watch face"/>\n            </div>\n            <div class="home-creator__content js-fade-in-up">\n                <h2 class="home-creator__title home-title">\n                    <span>{{homeContent.creator.title}}</span>\n                </h2>\n                <p>\n                    {{homeContent.creator.description}}\n                </p>\n            </div>\n            <a ui-sref="facer.editor(creatorStateParams)" class="home-creator__cta js-fade-in-up">\n                <button class="facer-button btn-primary btn-rounded btn-xl">\n                    <span>{{homeContent.creator.cta}}</span>\n                </button>\n            </a>\n        </div>\n\n        <div class="home-platforms">\n            <h2 class="home-platforms__title home-title js-fade-in-up">\n                <span>{{homeContent.platforms.title}}</span>\n            </h2>\n            <ul class="home-platforms__list">\n                <li ng-repeat="platform in platforms track by $index">\n                    <a ng-href="{{platform.link}}" class="home-platforms__item">\n                        <img ng-src="{{platform.img}}" alt="{{platform.alt}}" class="js-fade-in-up"/>\n                        <span class="home-platforms__item-text js-fade-in-up">{{platform.text}}</span>\n                    </a>\n                </li>\n            </ul>\n            <p class="home-platforms__small-text js-fade-in-up">\n                {{homeContent.platforms.supportedLeadIn}} {{supportedDevicesText}}\n                <a href="https://help.facer.io/hc/en-us/articles/1260801721949-Smartwatch-brands-models-supported-by-Facer" target="_blank">{{homeContent.platforms.moreLabel}}</a>.\n            </p>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},46162:e=>{var n="/html/image-upload-zone.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-class="{ \'is-loading\': isLoading }">\n    <div class="img-upload-zone__wrapper">\n        <div class="img-upload-zone is-loading" ng-if="isLoading">\n            <div>\n                <loader></loader>\n            </div>\n        </div>\n\n        <div ng-if="!isLoading" class="img-upload-zone__preview" ng-class="{ \'is-hidden\': isLoading || !selectedImage }">\n            <img ng-src="{{ selectedImage }}"/>\n\n            <svg ng-click="reset()" width="20" height="21" fill="none" xmlns="http://www.w3.org/2000/svg">\n                <ellipse cx="10" cy="10.7334" rx="10" ry="9.8333" fill="#fff"/>\n                <path d="m13.9843 7.628-3.1566 3.104 3.1566 3.1041c.0732.0719.1097.1577.1097.2573 0 .0995-.0365.1853-.1097.2572l-.6077.5976c-.0731.0719-.1603.1079-.2616.1079s-.1885-.036-.2617-.1079l-3.1566-3.104-3.1566 3.104c-.0732.0719-.1604.1079-.2617.1079s-.1885-.036-.2616-.1079l-.6077-.5976c-.0732-.0719-.1097-.1577-.1097-.2572 0-.0996.0365-.1854.1097-.2573l3.1566-3.1041-3.1566-3.104c-.0732-.072-.1097-.1577-.1097-.2573 0-.0996.0365-.1853.1097-.2572l.6077-.5976c.0731-.072.1603-.108.2616-.108s.1885.036.2617.108l3.1566 3.104 3.1566-3.104c.0732-.072.1604-.108.2617-.108s.1885.036.2616.108l.6077.5976c.0732.0719.1097.1576.1097.2572s-.0365.1854-.1097.2573Z" fill="#424242"/>\n            </svg>\n        </div>\n\n        <div class="img-upload-zone js-img-upload-zone" ng-class="{ \'is-hidden\': isLoading || selectedImage }">\n            <div class="img-upload-zone__text-wrapper">\n                <div class="img-upload-zone__drop-text">Drop here</div>\n                <div class="img-upload-zone__upload-text">\n                    <div class="img-upload-zone__drag-text">\n                        Drag and drop it here, or <span>browse</span>\n                    </div>\n                    <div class="img-upload-zone__file-type-text">\n                        {{ fileTypeLabel }} only\n                    </div>\n                </div>\n            </div>\n            <input type="file" ng-attr-accept="{{ acceptAttribute }}" class="file-input js-img-upload-zone-file-input"/>\n        </div>\n    </div>\n\n    <div ng-class="{ \'is-hidden\': isLoading || selectedImage }" class="img-upload-zone__url-input">\n        <div class="input-group js-img-upload-zone-url-input-group">\n            <input type="text" class="form-control js-img-upload-zone-text-input" placeholder="Paste an image URL"/>\n            <span class="input-group-btn">\n                <button class="btn btn-default" type="button" ng-click="handleUrlInput()">\n                    <svg width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">\n                        <path d="M6.5 20c-1.5167 0-2.8125-.525-3.8875-1.575C1.5375 17.375 1 16.0917 1 14.575c0-1.3.3917-2.4583 1.175-3.475.7833-1.0167 1.8083-1.6667 3.075-1.95.4167-1.5333 1.25-2.775 2.5-3.725C9 4.475 10.4167 4 12 4c1.95 0 3.6042.6792 4.9625 2.0375C18.3208 7.3958 19 9.05 19 11c1.15.1333 2.1042.6292 2.8625 1.4875C22.6208 13.3458 23 14.35 23 15.5c0 1.25-.4375 2.3125-1.3125 3.1875S19.75 20 18.5 20H13c-.55 0-1.0208-.1958-1.4125-.5875C11.1958 19.0208 11 18.55 11 18v-5.15L9.4 14.4 8 13l4-4 4 4-1.4 1.4-1.6-1.55V18h5.5c.7 0 1.2917-.2417 1.775-.725.4833-.4833.725-1.075.725-1.775s-.2417-1.2917-.725-1.775C19.79