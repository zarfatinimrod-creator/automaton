 addMessage }}\n            </span>\n            <input ng-show="!useModal && !$root.page.isIosClient()" id="{{ fileInputId }}" type="file" accept="image/jpeg,image/jpg,image/png"/>\n            <div ng-show="useModal && !$root.page.isIosClient()" ng-click="triggerImageUpload()" class="js-promo-image-upload promo-image-upload"></div>\n            <div ng-if="$root.page.isIosClient()" class="ios-photo-upload" ng-click="iosUploadPhoto()"></div>\n            <div class="watchface-media-item-controls">\n                <div ng-show="uploadingMedia" class="watchface-media-item-controls-loading">\n                    <spinner></spinner>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div ng-show="item.image" class="watchface-media-item {{ type || \'block-item\' }} watchface-media-item-image" style="background-image: url({{ item.image }});height: {{\n            styling.height\n        }};width: {{ styling.width }}" ng-class="{ \'item-loading\': item.loading }">\n        <div class="watchface-media-item-controls">\n            <div ng-show="!item.loading" ng-click="removeItem();$event.stopPropagation()" class="watchface-media-item-controls-remove">\n                <i class="icon-close"></i>\n            </div>\n            <div ng-show="item.loading" class="watchface-media-item-controls-loading">\n                <spinner></spinner>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},76091:e=>{var n="/html/looks/looks-not-found.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="looks-not-found">\n    <div class="looks-not-found__container">\n        <img ng-src="{{facerStaticAssetUrl(\'/img/looks/device.png\')}}" class="looks-not-found__img-device" alt="Facer Watch Face"/>\n        <div class="looks-not-found__content">\n            <h1>\n                This feature is only available on the Facer app.\n            </h1>\n            <p>Download the app to unlock the full Facer experience!</p>\n            <div class="looks-not-found__links">\n                <a app-link="ios" app-link-placement="looks_not_found" href target="_blank">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/looks/logo-appstore.png\')}}" alt="Download Facer from the App Store"/>\n                </a>\n                <a app-link="android" app-link-placement="looks_not_found" href target="_blank">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/looks/logo-playstore.png\')}}" alt="Google Play"/>\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},62185:e=>{var n="/html/main.wrapper.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-if="androidAppBanner.show && !page.isDesktopAuthPage()" class="smartbanner">\n    <div class="smartbanner-container">\n        <a href="#" class="smartbanner-close" ng-click="androidAppBanner.remove()">&times;</a>\n        <span class="smartbanner-icon"></span>\n        <div class="smartbanner-info">\n            <div class="smartbanner-title">Facer</div>\n            <div>Official App</div>\n            <span>Free &ndash; Google Play</span>\n        </div>\n        <a app-link="android" app-link-placement="smartbanner" class="smartbanner-button" ng-click="androidAppBanner.remove()">\n            <span class="smartbanner-button-text">Get it</span>\n        </a>\n    </div>\n</div>\n\n<header ng-if="!page.isDesktopAuthPage()" ui-view="header" class="app-header-wrapper" app-sticky-offset ng-class="{\'has-android-banner\': androidAppBanner.show}"></header>\n\n<div id="wrap" ng-class="{\n        \'android-banner\': androidAppBanner.show && !page.isDesktopAuthPage(),\n        \'ios-client\': page.isIosClient(),\n        \'route-{{stateName}}\': true,\n    }" class="{{(enabledFeatureFlagClassNames || []).join(\' \')}}">\n    <div ui-view="main"></div>\n    <notifications></notifications>\n    <home-download-sheet ng-if="!page.isDesktopAuthPage()"></home-download-sheet>\n</div>\n\n<footer ng-if="!page.isIosClient() && !page.isDesktopAuthPage()" ui-view="footer"></footer>\n\n<app-modal></app-modal>\n')}]),e.exports=n},81185:e=>{var n="/html/media-viewer.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper facer-media-viewer">\n    <div class="media-viewer-carousel">\n        <div class="carousel-wrapper">\n            <slick init-onload="true" settings="carousel.settings" current-index="carousel.index" data="carousel.items" dots="false" infinite="false" slides-to-show="1" touch-move="true" center-mode="false" prev-arrow=".left-arrow" next-arrow=".right-arrow" slides-to-scroll="1">\n                <div ng-repeat="item in carousel.items" ng-click="close(false)">\n                    <div ng-if="item.isImage()" class="carousel-image">\n                        <img ng-click="$event.stopPropagation()" ng-if="item.isImage()" ng-src="{{ item.image }}" image-on-load="onMediaLoaded()"/>\n                    </div>\n                    <div ng-click="$event.stopPropagation()" ng-if="item.isVideo()" class="media-viewer-video" banner-video video="item.videoPlayer"></div>\n                </div>\n            </slick>\n        </div>\n        <div ng-show="!isFirst" id="leftArrow" class="left-arrow">\n            <img ng-src="{{facerStaticAssetUrl(\'/img/left-arrow.png\')}}"/>\n        </div>\n        <div ng-show="!isLast" id="rightArrow" class="right-arrow">\n            <img ng-src="{{facerStaticAssetUrl(\'/img/right-arrow.png\')}}"/>\n        </div>\n    </div>\n\n    <div ng-click="close(false)" class="facer-modal-backdrop">\n        <div class="facer-modal-close">\n            <i class="icon-close"></i>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},55542:e=>{var n="/html/mobile-contest.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <iframe width="100%" src="https://www.youtube.com/embed/cnfqIVkYjG0" frameborder="0" allowfullscreen></iframe>\n    <p>\n        Submit your watchface by June 26th at midnight for a chance to be\n        featured in Facer, win cash, watches, watchbands, and more!\n    </p>\n\n    <h3>Prizes</h3>\n\n    <ul>\n        <li><b>Best watchface:</b></li>\n        <ul>\n            <li>$500 CASH PRIZE!</li>\n            <li>\n                Moto 360 offered by\n                <a href="https://www.motorola.com/us/motomaker?pid=FLEXR3&action=designNew&utm_source=motomaker&utm_medium=referral&utm_campaign=Motomaker_360_Redirect#">Motorola</a>\n            </li>\n            <li>\n                Premium watchband offered by\n                <a href="http://e3motorcycles.com/pages/e3-supply-co-watch-bands-for-android-wear">E3 Supply</a>\n            </li>\n            <li>Your watchface featured in Facer app</li>\n        </ul>\n        <li><b>2nd place watchface:</b></li>\n        <ul>\n            <li>$250 CASH PRIZE!</li>\n            <li>\n                Premium watchband offered by\n                <a href="http://e3motorcycles.com/pages/e3-supply-co-watch-bands-for-android-wear">E3 Supply</a>\n            </li>\n            <li>Your watchface featured in Facer app</li>\n        </ul>\n\n        <li>\n            <b>3rd place watchface:</b>\n        </li>\n        <ul>\n            <li>$100 CASH PRIZE!</li>\n            <li>\n                Premium watchband offered by\n                <a href="http://e3motorcycles.com/pages/e3-supply-co-watch-bands-for-android-wear">E3 Supply</a>\n            </li>\n            <li>Your watchface featured in Facer app</li>\n        </ul>\n        <li>\n            <b>4th to 10th watchface:</b>\n        </li>\n        <ul>\n            <li>$10 gift card for Google Play!</li>\n            <li>Your watchface featured in Facer app</li>\n        </ul>\n    </ul>\n\n    <h3>How to enter</h3>\n\n    <p>\n        Tap on the share button for your watchface and choose "Upload to\n        GetFacer.com"\n    </p>\n\n    <img width="80%" ng-src="{{facerStaticAssetUrl(\'/img/share.png\')}}"/>\n\n    <p>&nbsp;</p>\n\n    <p>\n        <b>NOTE: </b>To be considered in the contest, the watchface cannot\n        infringe on any copyright or trademark\n    </p>\n\n    <p>\n        For more information about the contest, please go to\n        <a href="https://www.getfacer.com">www.getfacer.com</a>\n    </p>\n\n    <h2>Good luck!</h2>\n</div>\n')}]),e.exports=n},11074:e=>{var n="/html/mobile-nav.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<nav id="main-nav" class="mobile-nav" ng-class="{ \'android-banner\': androidAppBanner.show }">\n    <div class="mn-wrapper">\n        <div class="mn-content-wrapper">\n            <div ui-sref="facer.home" class="mn-left mn-content">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/facer-logo-mobile.png\')}}"/>\n            </div>\n            <div class="mn-center mn-content">\n                <div ng-show="currentUser()" id="notificationFeed" class="pull-right nav-link scrollable dropdown" notification-feed mobile-close>\n                    <a ng-click="centerItemClicked()" alt="Notification Feed" href="#" class="dropdown-toggle" role="button" aria-expanded="false">\n                        <i class="icon-bell"></i>\n                        <div class="unread-badge" ng-show="unread.value">\n                            {{ unread.label }}\n                        </div>\n                    </a>\n                    <ul ng-if="$parent.feed.open" class="dropdown-menu dropdown-menu-right notification-feed open fade-in-out" role="menu" ng-include="\'/html/header/notification-feed-menu.partial.html\'"></ul>\n                </div>\n                <div id="deviceSelection" class="nav-link pull-right" ng-class="{\n                        \'nav-link-image\': settings.selectedDevice,\n                        \'nav-link-text\': !settings.selectedDevice\n                    }">\n                    <a href="#" ng-click="$root.settings.promptDeviceSelection()">\n                        <span ng-show="!settings.selectedDevice">Select Device</span>\n                        <span ng-show="settings.selectedDevice == \'apple\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/apple-logo.png\')}}"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'android\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/wearos-logo.png\')}}"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'tizen\'">\n                            <img width="22" ng-src="{{facerStaticAssetUrl(\'/img/platform-logos/tizen-logo.png\')}}"/>\n                        </span>\n                        <span ng-show="settings.selectedDevice == \'wff\'">\n                            <facer-icon icon="wearos6"></facer-icon>\n                        </span>\n                    </a>\n                </div>\n                <div class="pull-right nav-link">\n                    <a id="open-app-button" class="btn btn-primary btn-block text-centery" href="https://bwkf5.app.goo.gl/facer_install">\n                        OPEN APP\n                    </a>\n                </div>\n            </div>\n            <div class="mn-right mn-content" ng-click="rightItemClicked()">\n                <i class="icon-bars"></i>\n            </div>\n        </div>\n    </div>\n\n    <div ng-if="menu.open" class="mn-menu-wrapper fade-in-out">\n        <div class="mn-menu">\n            <search-bar></search-bar>\n\n            <div class="mn-menu-links">\n                <a ui-sref="facer.featured" class="menu-link">\n                    Featured Collections\n                </a>\n                <a ui-sref="facer.explore" class="menu-link">\n                    Trending Watch Faces\n                </a>\n                <a ui-sref="facer.partners" class="menu-link"> Partners </a>\n                <a href="http://news.facer.io" target="_blank" class="menu-link">\n                    Facer News\n                </a>\n                <a href="https://community.facer.io" community-link target="_blank" class="menu-link">\n                    Facer Community\n                </a>\n            </div>\n\n            <div ng-controller="Auth" class="mn-auth-item">\n                <div ng-if="menu.user" class="row">\n                    <div class="col-xs-6 mn-logged-in">\n                        <a user-profile-link="menu.user">\n                            <img ng-src="{{ menu.user.avatar }}" alt=""/>\n                        </a>\n                        <a user-profile-link="menu.user">{{\n                            menu.user.name\n                            }}</a>\n                    </div>\n                    <div class="col-xs-6">\n                        <i class="icon-global-logout"></i>\n                        <a href ng-click="logout()">Logout</a>\n                    </div>\n                </div>\n                <div ng-if="!menu.user" class="row">\n                    <div class="col-xs-6">\n                        <a ui-sref="facer.login({return: true})">Login</a>\n                    </div>\n                    <div class="col-xs-6">\n                        <a ui-sref="facer.signup">Signup</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class="mn-app-item">\n                <span class="mn-app-item-label">Get the App</span>\n                <a app-link="android" app-link-placement="mobile_nav_get_app" href target="_blank" class="mn-app-link">\n                    <i class="icon-android-1"></i>\n                    <div>Android</div>\n                </a>\n                <a app-link="tizen" app-link-placement="mobile_nav_get_app" href target="_blank" class="mn-app-link">\n                    <i class="icon-tizen"></i>\n                    <div>Tizen</div>\n                </a>\n                <a app-link="ios" app-link-placement="mobile_nav_get_app" href target="_blank" class="mn-app-link">\n                    <i class="icon-apple"></i>\n                    <div>Download Facer</div>\n                </a>\n            </div>\n            <div class="mn-close">\n                <i ng-click="close()" class="icon-close"></i>\n            </div>\n        </div>\n        <div class="mn-menu-bg" ng-click="menuBgClicked()"></div>\n    </div>\n</nav>\n')}]),e.exports=n},15431:e=>{var n="/html/modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper editor-modal" ng-class="{\n\t\t\'google-io\': inputType==\'googleio\', \n\t\t\'facer-modal-wide\': isWide(),\n        \'facer-modal-loading-only\': showLoadingOnly\n\t}">\n    <div class="facer-modal-scroll-wrapper">\n        <div ng-if="!videoModal" class="facer-modal-content">\n            <h4 ng-if="!showLoadingOnly && !largeTitle && title" class="facer-modal-title">{{title}}</h4>\n            <div ng-if="image" class="facer-modal-image">\n                <img ng-src="{{image}}"/>\n            </div>\n\n            <h3 ng-if="!showLoadingOnly && largeTitle && title" class="facer-modal-title no-margin-bottom">\n                <b>{{title}}</b>\n            </h3>\n            <div class="facer-modal-body-wrapper">\n                <div ng-if="message && !showLoadingOnly" class="facer-modal-body" text-scroll style="text-align: {{textAlign}}">\n                    <p bind-html-safe="message"></p>\n\n                    <ul ng-if="list">\n                        <li ng-repeat="item in list" class="text-left" bind-html-safe="item"></li>\n                    </ul>\n                </div>\n                <div ng-if="showInput && !showLoadingOnly" ng-form="modalForm.form" class="facer-modal-input">\n                    <div ng-switch="inputType">\n                        <div ng-switch-when="customComplicationProvider">\n                            <div class="form-group">\n                                <label>Custom Provider ID</label>\n                                <input name="Custom Provider ID" ng-model="input.value.packageName" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Provider Type</label>\n                                <select class="form-control" ng-model="input.value.providerType" ng-options="option.value as option.label for option in providerTypeOptions"></select>\n                                <span class="help-block">\n                                    Select the Wear OS complication data type this provider supplies.\n                                </span>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="createComplication">\n                            <div class="form-group">\n                                <label>Title</label>\n                                <input name="Title" ng-minlength="3" ng-maxlength="20" ng-model="input.value.title" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Image</label>\n                                <div class="image-uploader-wrapper">\n                                    <image-uploader image="input.value.file" height="200px" width="200px" use-modal="false" optimization-options="{\'imageMimeType\': \'image/png\', \'width\': 600, \'height\': 600, \'style\': \'cover\'}"></image-uploader>\n                                    <span class="help-block">Preferred format: 600x600</span>\n                                </div>\n                            </div>\n                            <label class="form-group">\n                                <input type="checkbox" ng-model="input.value.useSolidColorTinting"/>\n                                Use solid color tinting\n                            </label>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="designerSalesReports" class="scrollable-modal-input" text-scroll>\n                            <div ng-show="!list.length">\n                                No sales reports available yet\n                            </div>\n                            <table ng-show="list.length" class="table">\n                                <thead>\n                                    <tr>\n                                        <th>Period</th>\n                                        <th class="text-right">Total</th>\n                                        <th class="text-right">Report</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr ng-repeat="report in list|orderBy:\'period\':true">\n                                        <th>{{report.period}}</th>\n                                        <td class="text-right">\n                                            <b>{{report.total|currency:"$"}}</b>\n                                        </td>\n                                        <td>\n                                            <div class="sale-active text-right">\n                                                <a href="{{report.reportUrl}}" target="_blank">\n                                                    <i class="icon-arrow-down"></i>\n                                                </a>\n                                            </div>\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                        <div ng-switch-when="trimCollection">\n                            <div class="form-group">\n                                <label>Trim Value</label>\n                                <input type="number" name="Trim Value" ng-min="50" ng-model="input.value.trim" class="form-control"/>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="rejectWatchface">\n                            <select ng-model="input.value">\n                                <option value="">Choose reason:</option>\n                                <option value="dmca">\n                                    DMCA Takedown (the user will receive an\n                                    email)\n                                </option>\n                                <option value="admin">\n                                    Admin Rejection (ToS violation)\n                                </option>\n                            </select>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="qaRejectWatchface">\n                            <div ng-if="qaRejectReasons && qaRejectReasons.length > 0" class="form-group">\n                                <label>Select a predefined reason (optional):</label>\n                                <select ng-model="selectedRejectReason" ng-change="fillRejectReason(selectedRejectReason)" class="form-control">\n                                    <option value="">Choose a reason...</option>\n                                    <option ng-repeat="reason in qaRejectReasons" value="{{reason}}">{{reason}}</option>\n                                </select>\n                            </div>\n                            <div class="form-group">\n                                <label>Rejection reason:</label>\n                                <textarea ng-model="input.value" placeholder="{{placeholder}}" class="form-control" rows="4"></textarea>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="videoUpload">\n                            <div ng-show="!loading">\n                                <div class="form-group">\n                                    <label>Video File</label>\n                                    <video-uploader video="input.value.file"></video-uploader>\n                                    <span class="help-block">Must be MP4 (less than 20mb).</span>\n                                </div>\n                                <div class="form-group">\n                                    <label>Preview Image</label>\n                                    <image-uploader image="input.value.preview" height="358px" use-modal="false" optimization-options="{\'disableOptimization\': true}"></image-uploader>\n                                    <span class="help-block">Preview image is required.</span>\n                                </div>\n                                <div ng-if="error" class="alert alert-danger">\n                                    {{error}}\n                                </div>\n                            </div>\n                            <div ng-show="loading" class="facer-modal-loader">\n                                <spinner/>\n                                <h3>{{loadingMessage || "Uploading media..."}}</h3>\n                            </div>\n                        </div>\n                        <div ng-switch-when="addToCollection">\n                            <select class="form-control" ng-if="selectOptions" ng-model="input.value.collection" ng-options="option as option.adminListName group by option.group for option in selectOptions"></select>\n                            <div ng-if="input.value.collection.id==\'NEW\'">\n                                <div class="form-group">\n                                    <label>Cover Image</label>\n                                    <image-uploader image="input.value.newCollection.hero_art" height="118px" use-modal="false" optimization-options="{\'width\': 1800, \'height\': 750, \'style\': \'cover\'}"></image-uploader>\n                                    <span class="help-block">Preferred format: 1800x750px</span>\n                                </div>\n                                <div class="form-group">\n                                    <label>Name</label>\n                                    <input name="Name" ng-maxlength="40" ng-model="input.value.newCollection.name" placeholder="{{placeholder}}" class="form-control"/>\n                                </div>\n                                <div ng-if="input.value.admin" class="form-group">\n                                    <label>Slug (what will be in the url)</label>\n                                    <input name="Slug" ng-maxlength="40" slug-from="input.value.newCollection.name" ng-model="input.value.newCollection.slug" placeholder="{{placeholder}}" class="form-control"/>\n                                </div>\n                                <div class="form-group">\n                                    <label>Description</label>\n                                    <textarea ng-model="input.value.newCollection.description" placeholder="{{placeholder}}" class="form-control"></textarea>\n                                </div>\n                                <div ng-if="input.value.admin" class="form-group">\n                                    <label>Platform (DEPRECATED)</label>\n                                    <select ng-model="input.value.newCollection.platform_type" class="form-control">\n                                        <option value="android">Android</option>\n                                        <option value="ios">iOS</option>\n                                    </select>\n                                </div>\n                                <div ng-if="isAdmin" class="row">\n                                    <div class="col-xs-12">\n                                        <div class="form-group">\n                                            <label>Google Play ID (optional — created on Publish Bundle)</label>\n                                            <input ng-model="input.value.newCollection.googlePlayId" class="form-control"/>\n                                        </div>\n                                    </div>\n                                    <div class="col-xs-12">\n                                        <div class="form-group">\n                                            <label>Google Play Sale ID (optional — created on Publish Bundle)</label>\n                                            <input ng-model="input.value.newCollection.flashSaleGooglePlayId" class="form-control"/>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <label ng-if="input.value.admin" class="form-group">\n                                <input type="checkbox" ng-model="input.value.clear"/>\n                                Clear from review queue\n                            </label>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="editStoreSection">\n                            <div class="form-group">\n                                <label>Name</label>\n                                <input required ng-model="input.value.name" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Description</label>\n                                <textarea required ng-model="input.value.description" placeholder="{{placeholder}}" class="form-control"></textarea>\n                            </div>\n                            <div class="form-group">\n                                <label>Visual</label>\n                                <select required ng-model="input.value.visual" class="form-control">\n                                    <option value="hero">Hero</option>\n                                    <option value="list">List</option>\n                                </select>\n                            </div>\n                            <div class="form-group">\n                                <label>URL Override</label>\n                                <input ng-model="input.value.targetUrl" name="URL Override Slug" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Target Platforms</label>\n                                <div class="checkbox-group">\n                                    <div ng-repeat="platform in platformOptions" class="checkbox">\n                                        <label>\n                                            <input type="checkbox" ng-checked="input.value.targetPlatforms.indexOf(platform.value) > -1" ng-click="togglePlatformSelection(platform.value)"/>\n                                            {{platform.label}}\n                                        </label>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="form-group relative" ng-if="isAdmin">\n                                <label>Internal Tags</label>\n                                <tag-input id="watchfaceListTags" tags="input.value.internalTags" maxlength="130"></tag-input>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="createStoreSection">\n                            <div class="form-group">\n                                <label>Name</label>\n                                <input ng-model="input.value.name" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Description</label>\n                                <textarea ng-model="input.value.description" placeholder="{{placeholder}}" class="form-control"></textarea>\n                            </div>\n                            <div class="form-group">\n                                <label>Visual</label>\n                                <select ng-model="input.value.visual" class="form-control" name="Visual" required>\n                                    <option value="hero">Hero</option>\n                                    <option value="list">List</option>\n                                </select>\n                            </div>\n                            <div class="form-group">\n                                <label>URL Override</label>\n                                <input ng-model="input.value.targetUrl" name="URL Override Slug" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Collection Slug</label>\n                                <input ng-model="input.value.slug" name="Collection Slug" placeholder="{{placeholder}}" class="form-control" required/>\n                            </div>\n                            <div class="form-group">\n                                <label>Order</label>\n                                <input min="0" type="number" ng-model="input.value.order" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Target Platforms</label>\n                                <div class="checkbox-group">\n                                    <div ng-repeat="platform in platformOptions" class="checkbox">\n                                        <label>\n                                            <input type="checkbox" ng-checked="input.value.targetPlatforms.indexOf(platform.value) > -1" ng-click="togglePlatformSelection(platform.value)"/>\n                                            {{platform.label}}\n                                        </label>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="form-group relative" ng-if="isAdmin">\n                                <label>Internal Tags</label>\n                                <tag-input id="watchfaceListTags" tags="input.value.internalTags" maxlength="130"></tag-input>\n                            </div>\n                            <input type="hidden" ng-model="input.value.status"/>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                            <div ng-if="liveWarning">\n                                WARNING: This content will be visible on the app\n                                & website once you hit save.\n                            </div>\n                        </div>\n                        <div ng-switch-when="editCollection">\n                            <div class="row">\n                                <div class="col-xs-6">\n                                    <div class="form-group">\n                                        <label>Cover Image</label>\n                                        <image-uploader image="input.value.hero_art" height="118px" use-modal="false" optimization-options="{\'width\': 1800, \'height\': 750, \'style\': \'cover\'}"></image-uploader>\n                                        <span class="help-block">Preferred format: 1800x750px</span>\n                                    </div>\n                                    <div class="form-group">\n                                        <label>Name</label>\n                                        <input ng-model="input.value.name" placeholder="{{placeholder}}" class="form-control"/>\n                                    </div>\n                                    <div class="form-group">\n                                        <label>Description</label>\n                                        <textarea ng-model="input.value.description" placeholder="{{placeholder}}" class="form-control"></textarea>\n                                    </div>\n                                    <div ng-if="error" class="alert alert-danger">\n                                        {{error}}\n                                    </div>\n                                    <div class="form-group relative" ng-if="isAdmin">\n                                        <label>Internal Tags</label>\n                                        <tag-input id="watchfaceListTags" tags="input.value.internal_tags" maxlength="130"></tag-input>\n                                    </div>\n                                </div>\n                                <div class="col-xs-6">\n                                    <div class="form-group">\n                                        <label>Watch Faces</label>\n                                        \x3c!-- watchfaces --\x3e\n                                        <div class="watchface-table draggable-table">\n                                            <ul dnd-list="input.value.products">\n                                                <li ng-repeat="watchface in input.value.products" dnd-moved="input.value.products.splice($index, 1)" dnd-draggable="watchface" dnd-effect-allowed="move" ng-on-contextmenu="$event.preventDefault(); $event.stopPropagation(); return false" ng-ontouchstart="event.preventDefault()">\n                                                    <table class="table">\n                                                        <tbody>\n                                                            <tr>\n                                                                <th class="col-md-1 handle reorder-handle" oncontextmenu="return false;" ontouchstart="this.style.webkitUserSelect=\'none\';" ontouchend="this.style.webkitUserSelect=\'auto\';">\n                                                                    <span class="vertical-arrow-toggle inline-row-tool">\n                                                                        <i class="icon-grab-dots"></i>\n                                                                    </span>\n                                                                </th>\n\n                                                                <td class="col-md-1">\n                                                                    <img ng-src="{{watchface.image}}" width="40" height="40"/>\n                                                                </td>\n                                                                <td class="watchface-name">\n                                                                    {{watchface.title}}\n                                                                </td>\n                                                                <td class="col-md-6 remove-button">\n                                                                    <i class="icon-close" ng-click="input.value.products.splice($index, 1)"></i>\n                                                                </td>\n                                                            </tr>\n                                                        </tbody>\n                                                    </table>\n                                                </li>\n                                                <li class="dndPlaceholder"></li>\n                                            </ul>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div ng-if="isAdmin" class="row">\n                                <div class="col-xs-6">\n                                    <div class="form-group">\n                                        <label>Google Play ID (optional — created on Publish Bundle)</label>\n                                        <input ng-model="input.value.googlePlayId" class="form-control"/>\n                                    </div>\n                                </div>\n                                <div class="col-xs-6">\n                                    <div class="form-group">\n                                        <label>Google Play Sale ID (optional — created on Publish Bundle)</label>\n                                        <input ng-model="input.value.flashSaleGooglePlayId" class="form-control"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div ng-switch-when="createCollection">\n                            <div class="form-group">\n                                <label>Name</label>\n                                <input ng-model="input.value.name" name="Name" required placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Slug (what will be in the url)</label>\n                                <input ng-model="input.value.slug" slug-from="input.value.name" name="Slug" required placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Description</label>\n                                <textarea ng-model="input.value.description" placeholder="{{placeholder}}" class="form-control"></textarea>\n                            </div>\n                            <div class="form-group">\n                                <label>Platform (DEPRECATED)</label>\n                                <select ng-model="input.value.platform_type" class="form-control">\n                                    <option value="android">Android</option>\n                                    <option value="ios">iOS</option>\n                                </select>\n                            </div>\n                        </div>\n                        <div ng-switch-when="financialReports">\n                            <select class="form-control" ng-if="selectOptions" ng-model="input.value.period" ng-options="option as option for option in selectOptions"></select>\n                        </div>\n                        <div ng-switch-when="flashSale">\n                            <div class="form-group row">\n                                <div class="form-group col-lg-4">\n                                    <label>Collection</label>\n                                    <select ng-if="selectOptions" class="form-control" ng-model="input.value.collection" ng-options="option as option.adminListName for option in selectOptions">\n                                        <option value="">Choose one:</option>\n                                    </select>\n                                    <span ng-if="input.value.collection && loadingPreFillContent">Loading...</span>\n                                    <span ng-if="input.value.collection && !loadingPreFillContent" class="help-block text-link" ng-click="preFillFlashSaleData(input.value.collection.slug, input.value.id)">Pre-Fill Content</span>\n                                </div>\n                                <div class="form-group col-lg-4">\n                                    <label>Start Date</label>\n                                    <input ng-model="input.value.startDate" date-floor="hour" type="datetime-local" class="form-control"/>\n                                </div>\n                                <div class="form-group col-lg-4">\n                                    <label>End Date</label>\n                                    <input ng-model="input.value.endDate" date-floor="hour" type="datetime-local" class="form-control"/>\n                                </div>\n                            </div>\n                            <hr/>\n                            <div class="form-group row">\n                                <div class="form-group col-lg-6">\n                                    <label>Push Image</label>\n                                    <image-uploader image="input.value.pushImage" height="118px" use-modal="false"></image-uploader>\n                                    <span class="help-block">Preferred format: 900x375px</span>\n                                </div>\n                                <div class="form-group col-lg-6 row">\n                                    <div class="form-group col-lg-12">\n                                        <label>Push Title</label>\n                                        <input ng-model="input.value.pushTitle" type="text" class="form-control"/>\n                                    </div>\n                                    <div class="form-group col-lg-12">\n                                        <label>Push Text</label>\n                                        <input ng-model="input.value.pushContent" type="text" class="form-control"/>\n                                    </div>\n                                    <div class="form-group col-lg-12">\n                                        <label>Push delivery hour (0-23)</label>\n                                        <input ng-model="input.value.pushDeliveryHour" min="0" max="23" type="text" int-input class="form-control"/>\n                                    </div>\n                                </div>\n                            </div>\n                            <hr/>\n                            \x3c!--<div class="form-group row">\n\t\t\t\t\t\t\t\t<div class="form-group col-lg-6">\n\t\t\t\t\t\t\t\t\t<label>Email Subject</label>\n\t\t\t\t\t\t\t\t\t<input ng-model="input.value.emailContent.subject" type="text" class="form-control" />\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="form-group col-lg-6">\n\t\t\t\t\t\t\t\t\t<label>Email Preview Text</label>\n\t\t\t\t\t\t\t\t\t<input ng-model="input.value.emailContent.previewText" type="text" class="form-control" />\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>--\x3e\n                            <div class="form-group row">\n                                <div class="col-lg-6">\n                                    <div class="form-group">\n                                        <label>Email Subject</label>\n                                        <input ng-model="input.value.emailContent.subject" type="text" class="form-control"/>\n                                    </div>\n                                    <div class="form-group">\n                                        <label>Email Template Header</label>\n                                        <input ng-model="input.value.emailContent.templateHeader" type="text" class="form-control"/>\n                                    </div>\n                                    <div class="form-group">\n                                        <label>Email Template Footnote</label>\n                                        <input ng-model="input.value.emailContent.templateFootnote" type="text" class="form-control"/>\n                                    </div>\n                                </div>\n                                <div class="form-group col-lg-6">\n                                    <label>Email Template Body</label>\n                                    <textarea ng-model="input.value.emailContent.templateBody" class="form-control"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div ng-switch-when="platformMappingInfo">\n                            <div class="col-xs-12">\n                                <div ng-if="input.value.isPremium" class="form-group">\n                                    <label>Google Play ID</label>\n                                    <input ng-model="input.value.googlePlayId" class="form-control"/>\n                                </div>\n\n                                <div class="form-group">\n                                    <label>Google Play Standalone Mapping\n                                        Id</label>\n                                    <input ng-model="input.value.extGooglePlayStandaloneId" class="form-control"/>\n                                </div>\n\n                                <div class="form-group">\n                                    <label>Galaxy App Standalone Mapping Id</label>\n                                    <input ng-model="input.value.extGalaxyAppsStandaloneId" class="form-control"/>\n                                </div>\n\n                                <div class="form-group">\n                                    <label>App Store Standalone Mapping Id</label>\n                                    <input ng-model="input.value.extAppStoreStandaloneId" class="form-control"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div ng-switch-when="select">\n                            <select ng-if="selectOptions" ng-model="input.value" ng-options="option.value as option.label for option in selectOptions">\n                                <option value="">Choose one:</option>\n                            </select>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="checkbox">\n                            <div class="form-group">\n                                <label>\n                                    <input type="checkbox" ng-model="input.value"/>\n                                    {{label}}\n                                </label>\n                            </div>\n                        </div>\n                        <div ng-switch-when="googleio">\n                            \x3c!--<div class="form-group">\n\t\t\t\t\t\t\t\t<label>Name</label>\n\t\t\t\t\t\t\t\t<input ng-model="input.value.name" placeholder="Your Name" class="form-control" />\n\t\t\t\t\t\t\t</div>--\x3e\n                            <div class="form-group">\n                                <label>\n                                    Email Address\n                                    <p>\n                                        Enter your email so we can send you your\n                                        watchface!<br/><small>If you already have an account,\n                                            we\'ll add your watchface to\n                                            it.</small>\n                                    </p>\n                                </label>\n                                <input ng-model="input.value.email" placeholder="Email Address (optional)" class="form-control"/>\n                                <div class="text-left">\n                                    <small class="text-muted">Note: We\'ll be sending an email to this\n                                        address.</small>\n                                </div>\n                            </div>\n                            <div class="form-group">\n                                <label>\n                                    Twitter Handle\n                                    <p>\n                                        We\'re live tweeting some of the best\n                                        watchfaces - make sure you\'re mentioned\n                                        if we pick yours!\n                                    </p>\n                                </label>\n                                <input ng-model="input.value.twitter_handle" placeholder="Twitter Handle (optional)" class="form-control"/>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="editStarterTemplate">\n                            <div class="form-group">\n                                <label>Title</label>\n                                <input ng-model="input.value.title" name="Title" required ng-maxlength="100" class="form-control"/>\n                            </div>\n                            <div class="form-group">\n                                <label>Description</label>\n                                <textarea name="Description" ng-model="input.value.description" ng-maxlength="115" maxlength="115" rows="4" class="form-control"></textarea>\n                                <div class="text-muted text-right">\n                                    {{(input.value.description || "").length}}/115\n                                </div>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-when="expressionDescription">\n                            <div class="form-group">\n                                <label>Expression description</label>\n                                <input name="expressionDescription" ng-model="input.value" ng-required="true" ng-maxlength="inputMaxLength || 100" maxlength="{{inputMaxLength || 100}}" placeholder="{{placeholder}}" class="form-control" select-all/>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                        <div ng-switch-default>\n                            <div class="form-group">\n                                <input ng-model="input.value" placeholder="{{placeholder}}" class="form-control"/>\n                            </div>\n                            <div ng-if="error" class="alert alert-danger">\n                                {{error}}\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div ng-if="showLoadingOnly" class="facer-modal-loader">\n                    <div class="facer-modal-loader-copy">\n                        <h3 class="facer-modal-loading-title">\n                            {{title || loadingMessage}}\n                        </h3>\n                        <p ng-if="subtitle" class="facer-modal-loading-subtitle">\n                            {{subtitle}}\n                        </p>\n                    </div>\n                    <loader/>\n                </div>\n                <div ng-show="!loading" class="facer-modal-form">\n                    <div class="submit-btn-wrapper">\n                        <button ng-click="close((showInput || hasInput) ? {result: true, input:input.value} : true)" class="btn btn-lg btn-{{style || \'primary\'}}" ng-class="{\'btn-block\': $root.page.isMobile()}">\n                            {{confirmMessage || \'Yes\'}}\n                        </button>\n\n                        <button ng-if="cancelable" ng-click="close(false)" class="btn btn-lg btn-default">\n                            {{cancelMessage || \'Cancel\'}}\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div ng-if="videoModal" class="facer-modal-content facer-modal-video">\n            <div you-tube="video" id="player" class="youtube_player"></div>\n            <div class="app-badge">\n                <a app-link="android" app-link-placement="video_modal" id="download_badge" target="_blank" href>\n                    <img height="50px" alt="Android app on Google Play" ng-src="{{facerStaticAssetUrl(\'/img/get-it-on-android.png\')}}"/>\n                </a>\n\n                <a app-link="ios" app-link-placement="video_modal" id="download_badge" target="_blank" href>\n                    <img height="50px" alt="Download Facer from the App Store" ng-src="{{facerStaticAssetUrl(\'/img/get-it-on-ios.png\')}}"/>\n                </a>\n            </div>\n        </div>\n        <div ng-click="close(false)" class="facer-modal-backdrop">\n            <div ng-show="!loading" class="facer-modal-close">\n                <i class="icon-close"></i>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},37829:e=>{var n="/html/modals/edit-watchface-img-upload-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="f-modal-wrapper" no-scroll>\n    <div class="f-modal-scroll-wrapper">\n        <div class="f-modal-content">\n            <div class="f-modal-header">\n                <div class="f-modal-title">Image Source</div>\n            </div>\n            <div class="f-modal-body">\n                <image-upload-zone on-image-selected="handleImageSelected(imageData, event, maintainSizeAndAspectRatio)" hide-image-checkbox="hideImageCheckbox" initial-image-data="initialImageData" accepted-types="{{ acceptedTypes }}"></image-upload-zone>\n\n                <div class="f-btn-wrapper">\n                    <button ng-click="close({ result: hasSelectedImage })" class="f-btn-rounded-primary" ng-disabled="!hasSelectedImage">\n                        {{confirmMessage || \'Set Image\'}}\n                    </button>\n                    <button ng-if="cancelable" ng-click="close(false)" class="f-btn-ghost-primary f-btn-lg">\n                        {{cancelMessage || \'Cancel\'}}\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div ng-click="close(false)" class="f-modal-backdrop"></div>\n</div>\n')}]),e.exports=n},80181:e=>{var n="/html/notifications.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-show="notifications.length > 0" id="notifications">\n    <div ng-repeat="notification in notifications" ng-click="removeNotification(notification.id)" class="notification fade-in-out notification-{{notification.type||default}}">\n        <div class="notification-message" bind-html-safe="notification.message"></div>\n        <div ng-if="notification.actions" class="notification-actions">\n            <div ng-repeat="action in notification.actions" class="notification-action" ng-if="!action.isExternal" ng-click="action.onClick(notification);$event.stopPropagation()">\n                {{action.text}}\n            </div>\n\n            <div ng-repeat="action in notification.actions" class="notification-action" ng-if="action.isExternal" ng-click="handleExternalLink(action.url, $event)">\n                {{action.text}}\n            </div>\n\n        </div>\n    </div>\n</div>')}]),e.exports=n},92256:e=>{var n="/html/onboarding-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper" no-scroll>\n    <div class="facer-modal-content facer-modal-content-clear facer-onboarding-modal">\n        <div>\n            <img class="facer-header" ng-src="{{facerStaticAssetUrl(\'/img/facer.png\')}}" alt="facer"/>\n        </div>\n        <h4>Select your device type:</h4>\n\n        <button type="button" ng-click="close(\'apple\')" class="facer-onboarding-modal-device-option">\n            Apple Watch\n        </button>\n        <hr/>\n        <button type="button" ng-click="close(\'wff\')" class="facer-onboarding-modal-device-option">\n            Wear OS (WFF)\n        </button>\n        <hr/>\n        <button type="button" ng-click="close(\'android\')" class="facer-onboarding-modal-device-option">\n            Wear OS (Legacy)\n        </button>\n        <hr/>\n        <button type="button" ng-click="close(\'tizen\')" class="facer-onboarding-modal-device-option">\n            Samsung Tizen\n        </button>\n        <hr/>\n        <button type="button" ng-click="close(\'\')" class="facer-onboarding-modal-device-option facer-onboarding-modal-device-option-skip">\n            Skip\n        </button>\n    </div>\n    <div ng-click="close(false)" class="facer-modal-backdrop">\n        <div class="facer-modal-close">\n            <i class="icon-close"></i>\n        </div>\n    </div>\n</div>')}]),e.exports=n},60954:e=>{var n="/html/page-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper page-modal">\n    <div class="iframe-wrapper">\n        <iframe ng-src="{{url}}"></iframe>\n    </div>\n    <div ng-click="close(false)" class="facer-modal-backdrop">\n        <div ng-show="!loading" class="facer-modal-close">\n            <i class="icon-close"></i>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},50666:e=>{var n="/html/partners.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="partners">\n    <div class="banner-wrapper container-fluid" style="">\n        <div class="banner" ng-style="{\'background-image\': \'url(\' + facerStaticAssetUrl(\'/img/banners/partner-banner2.png\') + \')\'}">\n            <div class="col-md-6 col-md-offset-3 text-center">\n                <h1 class="text-center">PARTNER WITH FACER</h1>\n                <h2 class="text-center">\n                    Your Brand, Available on<br/>Millions of Smartwatches\n                </h2>\n                <a href="#contact" class="btn btn-default btn-primary btn-lg" disable>Contact Us to Partner</a>\n            </div>\n        </div>\n    </div>\n\n    <div class="row">\n        <div class="col-md-6 col-md-offset-3">\n            <h2 class="text-center">Why Smartwatches?</h2>\n            <p class="text-center">\n                Are you ready to be part of the most personal device ever?\n            </p>\n\n            <div class="text-center">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/brands/hero.png\')}}" id="partners-hero" width="100%"/>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/growth.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/growth@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/growth@3x.png\')}} 3x" class="icon brand"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Millions of wrists</h3>\n                    <p>\n                        Over 21 million smart watches shipped in 2016 alone, and\n                        that figure is expected to grow significantly in 2017. We\n                        support every major smartwatch in the market, including\n                        WearOS watches, Samsung Watches, and Apple Watch. Join\n                        Facer and you\'re ready to be on millions of wrists!\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/exposure.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/exposure@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/exposure@3x.png\')}} 3x" class="icon exposure"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Incredible Exposure &amp; Engagement for Your Brand</h3>\n                    <p>\n                        You\'ll be the main entry point on the most personal\n                        devices ever. Our customers look at their watch faces\n                        over 80 times per day, generating hundreds of millions\n                        of impressions every month.\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/diverse.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/diverse@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/diverse@3x.png\')}} 3x" class="icon diverse"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>A Diverse Audience</h3>\n                    <p>\n                        Smartwatch owners have a wide array of interests - you\n                        can see that from the diversity in our watch face\n                        collection. From fitness junkies to to fashion\n                        aficionados, you\'ll have access to a wide demographic on\n                        our platform.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class="row full logos">\n        <h2 class="text-center brand-header">\n            Just a Few Brands That\n            <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>\n            Facer Today\n        </h2>\n        <div class="container">\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/mvmt" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/mvmt.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/mvmt@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/mvmt@3x.png\')}} 3x" class="mvmt"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/snyper" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/snyper.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/snyper@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/snyper@3x.png\')}} 3x" class="snyper"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/mauricelacroix" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/maurice-lacroix-logo.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/maurice-lacroix-logo@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/maurice-lacroix-logo@3x.png\')}} 3x" class="maurice-lacroix-logo"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/vaer" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/vaer.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/vaer@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/vaer@3x.png\')}} 3x" class="vaer"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/user/fesk4fgZMr" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/garfield-logo.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/garfield-logo@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/garfield-logo@3x.png\')}} 3x" class="garfield-logo"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/Star-Trek" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/star-trek.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/star-trek@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/star-trek@3x.png\')}} 3x" class="star-trek"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/user/ypyLYZpfbN" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/ghostbusters.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/ghostbusters@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/ghostbusters@3x.png\')}} 3x" class="ghostbusters"/></a>\n            </div>\n\n            <div class="col-sm-3">\n                <a href="https://www.facer.io/u/tetris" target="_blank"><img ng-src="{{facerStaticAssetUrl(\'/img/brands/tetris.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/tetris@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/tetris@3x.png\')}} 3x" class="tetris"/></a>\n            </div>\n        </div>\n    </div>\n\n    <div class="row">\n        <div class="col-md-6 col-md-offset-3">\n            <h2 class="text-center">Maximize your Impact with Facer</h2>\n            <p class="text-center">\n                Work with us to connect your brand with our digitally savvy,\n                fashion forward customers on the largest watch face platform in\n                the world.\n            </p>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/design.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/design@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/design@3x.png\')}} 3x" class="icon design"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Have your watch faces designed and built by Facer</h3>\n                    <p>\n                        Unleash the true power of Facer - leverage our\n                        incredibly talented team to design and/or build your\n                        custom watch face for our platform.\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/audience.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/audience@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/audience@3x.png\')}} 3x" class="icon audience"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Enjoy prominent featuring with our audience</h3>\n                    <p>\n                        Work with our staff to build solid, wide reaching\n                        marketing campaigns through app notifications, email\n                        campaigns, featured sales and more! Additionally, you\'ll\n                        have an exclusive verified profile in our apps where you\n                        can add your own videos, banners and links to drive\n                        traffic to your business.\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/success.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/success@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/success@3x.png\')}} 3x" class="icon success"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Track your success</h3>\n                    <p>\n                        Get daily stats on the number of times your watch faces\n                        have been viewed, synced, and purchased. You can easily\n                        watch and analyze your trends to maximize the success of\n                        your campaign.\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/rev.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/rev@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/rev@3x.png\')}} 3x" class="icon rev"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Earn revenue while running your campaigns</h3>\n                    <p>\n                        Provide your watches for free, or earn revenue by\n                        selling watch faces on Facer. You can publish to over 1\n                        million Facer customers in 1 click!\n                    </p>\n                </div>\n            </div>\n\n            <div class="clearfix">\n                <div class="col-xs-2">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/brands/copyright.png\')}}" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/brands/copyright@2x.png\')}} 2x, {{facerStaticAssetUrl(\'/img/brands/copyright@3x.png\')}} 3x" class="icon copyright"/>\n                </div>\n                <div class="col-xs-10">\n                    <h3>Get automatic copyright protection</h3>\n                    <p>\n                        We can provide our partners with automatic notices if\n                        our system detects anyone using your brand assets on\n                        their own watch faces without your permission.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <a name="contact"></a>\n    <div class="row full">\n        <h2 class="text-center brand-header">Contact Us to Get Started</h2>\n        <div class="col-md-6 col-md-offset-3">\n            <form id="partner-form" ng-submit="contact()" novalidate ng-show="!partnerForm.success">\n                <div class="form-group">\n                    <label for="fullname">Full Name*</label>\n                    <input id="fullname" name="fullname" class="form-control" placeholder="Enter your full name" required ng-model="partnerForm.fullname"/>\n                    <div class="help-block with-errors"></div>\n                </div>\n                <div class="form-group">\n                    <label for="company">Company*</label>\n                    <input id="company" name="company" class="form-control" placeholder="Enter your company or brand name" required ng-model="partnerForm.company"/>\n                    <div class="help-block with-errors"></div>\n                </div>\n\n                <div class="form-group">\n                    <label for="email">Email address*</label>\n                    <input id="email" name="email" class="form-control" placeholder="Enter email" required ng-model="partnerForm.email"/>\n                    <div class="help-block with-errors"></div>\n                </div>\n\n                <div class="form-group">\n                    <label for="message">Message*</label>\n                    <textarea id="message" name="message" class="form-control" rows="5" placeholder="Type your message here" required ng-model="partnerForm.message"></textarea>\n                    <div class="help-block with-errors"></div>\n                </div>\n\n                <div class="text-center">\n                    <button id="contact-button" type="submit" class="btn btn-green btn-lg" disable>\n                        Submit\n                    </button>\n                </div>\n\n                <div ng-show="partnerForm.error" class="alert alert-danger margin-top no-margin-bottom">\n                    {{partnerForm.error}}\n                </div>\n            </form>\n            <div ng-show="partnerForm.success" class="alert alert-success margin-top no-margin-bottom form-success">\n                {{partnerForm.success}}\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},64:e=>{var n="/html/pending-watchface-images.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n    <h2>Pending watchface images</h2>\n    <div class="row watchface-image-list">\n        <div ng-show="watchfaceImages" class="fade">\n            <div ng-repeat="image in watchfaceImages" class="watchface-image col-md-2 col-sm-3 col-xs-6">\n                <img ng-src="{{image.image.get(\'image\').url()}}"/>\n                <span class="label label-{{image.image.get(\'status\')|statusClass}}">\n                    {{image.image.get(\'status\')|statusName}}\n                    <i ng-if="image.image.get(\'isPreview\')" class="icon-image"></i>\n                </span>\n                <h5 class="watchface-title">\n                    {{image.image.get(\'watchface\').get(\'title\')}}\n                    <br/>\n                    <small>#{{image.image.id}}</small>\n                </h5>\n                <div ng-if="!image.loading && image.image.get(\'status\') == \'pending-approval\'">\n                    <button title="Approve as preview" ng-click="updateImage(image, \'approve\', true)" class="btn btn-success btn-sm">\n                        <i class="icon-checkmark"></i>\n                        <i class="icon-image"></i>\n                    </button>\n                    <button title="Approve" ng-click="updateImage(image, \'approve\', false)" class="btn btn-success btn-sm">\n                        <i class="icon-checkmark"></i>\n                    </button>\n                    <button title="Reject" ng-click="updateImage(image, \'reject\')" class="btn btn-danger btn-sm">\n                        <i class="icon-close"></i>\n                    </button>\n                </div>\n                <div ng-if="image.loading">\n                    <button class="btn btn-link" disabled="disabled">Loading...</button>\n                </div>\n            </div>\n        </div>\n        <loader ng-if="loading"/>\n        <endless margin="0" trigger="loadMoreWatchfaceImages()" end-on="done"/>\n    </div>\n</div>\n')}]),e.exports=n},3778:e=>{var n="/html/pending.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n    <h2>\n        Pending watchfaces &nbsp;&nbsp;\n        <small><a ui-sref="facer.admin.pending.option({option:\'recent\'})" ui-sref-active="active" class="option-link">Recent</a></small>\n        &nbsp;&nbsp;\n        <small><a ui-sref="facer.admin.pending.option({option:\'backlog\'})" ui-sref-active="active" class="option-link">Backlog</a></small>\n        &nbsp;&nbsp;\n        <small><a ui-sref="facer.admin.pending.option({option:\'legacy\'})" ui-sref-active="active" class="option-link">Legacy</a></small>\n    </h2>\n    <div id="watchface-list" class="row">\n        <div ng-show="watchfaces" class="fade" admin-watchfaces="watchfaces"></div>\n        <loader ng-if="loading"/>\n        <endless margin="0" trigger="loadMoreWatchfaces()" end-on="done"/>\n    </div>\n</div>\n')}]),e.exports=n},84197:e=>{var n="/html/premium-v2.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="premium-page" ng-class="{\'premium-page-is-loading\': premiumV2ViewModel.loading}" ng-attr-lang="{{premiumV2ViewModel.locale}}">\n    \x3c!--<div class="premium-page-close">\n\n    </div>--\x3e\n    <div class="premium-page-loading">\n        <spinner></spinner>\n        <p ng-bind="premiumV2ViewModel.loadingMessage"></p>\n    </div>\n    <div class="premium-page-section premium-page-header-image">\n        <img ng-src="{{premiumV2ViewModel.headerImage}}" ng-attr-alt="{{premiumV2ViewModel.copy.accessibility.headerImage}}"/>\n    </div>\n    <div class="premium-page-section premium-page-logo">\n        <img ng-if="!premiumV2ViewModel.active" class="premium-page-logo__logo" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/premium-logo.png\')}} 2x" ng-src="{{facerStaticAssetUrl(\'/img/premium-logo.png\')}}" ng-attr-alt="{{premiumV2ViewModel.copy.accessibility.premiumLogo}}"/>\n        <img ng-if="premiumV2ViewModel.active" class="premium-page-logo__icon" ng-attr-srcset="{{facerStaticAssetUrl(\'/img/premium-icon.png\')}} 2x" ng-src="{{facerStaticAssetUrl(\'/img/premium-icon.png\')}}" ng-attr-alt="{{premiumV2ViewModel.copy.accessibility.premiumLogo}}"/>\n    </div>\n    <div class="premium-page-section premium-page-title">\n        <h1 ng-if="premiumV2ViewModel.active">\n            <span ng-bind="premiumV2ViewModel.copy.title.activePrefix"></span><br/>Facer Premium\n        </h1>\n        <h1 ng-if="!premiumV2ViewModel.active" ng-bind="premiumV2ViewModel.copy.title.inactive"></h1>\n        <p ng-if="!premiumV2ViewModel.active" class="premium-page__promo" ng-bind="premiumV2ViewModel.copy.title.promo"></p>\n    </div>\n    <div class="premium-page__active-content" ng-if="premiumV2ViewModel.active">\n        <p ng-bind="premiumV2ViewModel.copy.active.welcome"></p>\n        <div class="premium-page__active-content-list">\n            <p>\n                <strong ng-bind="premiumV2ViewModel.copy.active.included"></strong>\n            </p>\n            <ul>\n                <li>\n                    <facer-icon icon="star"></facer-icon>\n                    <span ng-bind="premiumV2ViewModel.copy.active.benefits.unlimited"></span>\n                </li>\n                <li>\n                    <facer-icon icon="star"></facer-icon>\n                    <span ng-bind="premiumV2ViewModel.copy.active.benefits.adFree"></span>\n                </li>\n                <li ng-if="premiumV2ViewModel.selected && premiumV2ViewModel.selected === \'year\'">\n                    <facer-icon icon="star"></facer-icon>\n                    <span ng-bind="premiumV2ViewModel.copy.active.benefits.bandDiscount"></span>\n                </li>\n            </ul>\n        </div>\n    </div>\n    <div ng-if="premiumV2ViewModel.productInfo && !premiumV2ViewModel.active" class="premium-page-section premium-page-purchase-info" ng-class="{\'premium-page-purchase-info-bottom\': premiumV2ViewModel.movePurchaseInfoToBottom}">\n        <p bind-html-safe="premiumV2ViewModel.productInfo"></p>\n    </div>\n\n    <div class="premium-page-section premium-page-purchase-buttons">\n        <div ng-if="premiumV2ViewModel.buttonLabel" class="premium-page-purchase-button-label">\n            <p bind-html-safe="premiumV2ViewModel.buttonLabel"></p>\n        </div>\n        <button ng-if="premiumV2ViewModel.mainButton" class="btn btn-primary facer-button" ng-click="premiumV2ViewModel.mainButton.onClick()">\n            <img ng-show="!premiumV2ViewModel.secondaryButton" ng-src="{{facerStaticAssetUrl(\'/img/white-arrow-right.png\')}}" class="arrow-helper"/>\n            <span ng-show="!premiumV2ViewModel.secondaryButton" class="arrow-helper"></span>\n            {{premiumV2ViewModel.mainButton.text}}\n            <span ng-if="premiumV2ViewModel.secondaryButton && premiumV2ViewModel.bestDealTag && premiumV2ViewModel.bestDealTag.show" class="facer-button-tag" ng-bind="premiumV2ViewModel.bestDealTag.text" ng-style="{\n                    \'background-color\': premiumV2ViewModel.bestDealTag.backgroundColor,\n                    color: premiumV2ViewModel.bestDealTag.textColor\n                }"></span>\n            <span ng-show="!premiumV2ViewModel.secondaryButton" class="arrow-helper"></span>\n            <img ng-show="!premiumV2ViewModel.secondaryButton" ng-src="{{facerStaticAssetUrl(\'/img/white-arrow-right.png\')}}"/>\n        </button>\n        <button ng-if="premiumV2ViewModel.secondaryButton" class="btn btn-primary-v2 facer-button" ng-click="premiumV2ViewModel.secondaryButton.onClick()">\n            {{premiumV2ViewModel.secondaryButton.text}}\n        </button>\n    </div>\n\n    <div class="premium-page-section premium-page-footer" ng-if="!premiumV2ViewModel.active">\n        <ul>\n            <li>\n                <a target="_blank" rel="noopener noreferrer" ui-sref="facer.terms" ng-bind="premiumV2ViewModel.copy.footer.terms"></a>\n            </li>\n            <li>\n                <a target="_blank" ui-sref="facer.privacy" ng-bind="premiumV2ViewModel.copy.footer.privacy"></a>\n            </li>\n            <li>\n                <a ng-click="restore()" ng-bind="premiumV2ViewModel.copy.footer.restore"></a>\n            </li>\n        </ul>\n    </div>\n    <div class="premium-page-background"></div>\n    <subscription-manager type="hidden" product="All Access"></subscription-manager>\n</div>\n')}]),e.exports=n},71940:e=>{var n="/html/premium.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="premium-page-wrapper premium-page__wrapper">\n    <div class="premium-page__bg" ng-style="{\'background-image\': \'url(\' + facerStaticAssetUrl(\'/img/premium/gradient_bg.png\') + \')\'}"></div>\n\n    <div class="premium-page-header collection-header premium-page__header">\n        <watchface-carousel size="sm"></watchface-carousel>\n    </div>\n\n    <div id="main" class="premium-container text-center">\n        <div class="container-fluid premium-content-container">\n            <div class="row">\n                <div class="premium-page__logo">\n                    <img ng-src="{{facerStaticAssetUrl(\'/img/premium/facer-logo.png\')}}" alt="Facer Premium Logo"/>\n                </div>\n\n                <div ng-show="page.isIosClient()" class="ios-feature-description col-md-6 col-md-offset-3">\n                    <div ng-if="premiumContent.loading">\n                        <div class="loading-spinner">Loading...</div>\n                    </div>\n                    <div ng-if="premiumContent.error && !premiumContent.loading">\n                        <div class="error-message">Unable to load content. Please try again later.</div>\n                    </div>\n                    <div ng-if="!premiumContent.loading && !premiumContent.error">\n                        <h1 ng-if="premiumContent.ios && premiumContent.ios.title">{{premiumContent.ios.title}}</h1>\n                        <h3 ng-if="premiumContent.ios && premiumContent.ios.subtitle">{{premiumContent.ios.subtitle}}</h3>\n                    </div>\n                </div>\n\n                <div ng-hide="page.isIosClient()" class="premium-page__title-wrapper">\n                    <div ng-if="premiumContent.loading">\n                        <div class="loading-spinner">Loading...</div>\n                    </div>\n                    <div ng-if="premiumContent.error && !premiumContent.loading">\n                        <div class="error-message">Unable to load content. Please try again later.</div>\n                    </div>\n                    <div ng-if="!premiumContent.loading && !premiumContent.error">\n                        <h1 class="premium-page__title" ng-if="premiumContent.web && premiumContent.web.title">\n                            {{premiumContent.web.title}}</h1>\n                        <div class="premium-page__coupon" ng-if="premiumContent.web && premiumContent.web.couponMessage">\n                            <span ng-switch="!!appliedCoupon">\n                                <span ng-switch-when="true">\n                                    Coupon {{appliedCoupon}} applied. Enjoy your discount!\n                                </span>\n                                <span ng-switch-default>\n                                    {{premiumContent.web.couponMessage}}\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n\n                <div ng-hide="page.isIosClient()" class="col-md-6 col-md-offset-3">\n                    <ul class="premium-page__benefits" ng-if="!premiumContent.loading && !premiumContent.error">\n                        <li ng-repeat="benefit in premiumBenefits" class="premium-page__benefit">\n                            <facer-icon icon="star"></facer-icon>\n                            <span>{{benefit}}</span>\n                        </li>\n                    </ul>\n                </div>\n\n                <div class="col-md-6 col-md-offset-3 subscription-manager-wrapper">\n                    <div ng-show="showSubscriptionManager()" class="subscription-manager-wrapper">\n                        <subscription-manager type="subscribe-button" variant="options" product="All Access"></subscription-manager>\n                    </div>\n                </div>\n\n                <div class="col-md-12">\n                    <div class="premium-page__footer" ng-if="!premiumContent.loading && !premiumContent.error && premiumContent.footer && premiumContent.footer.text" ng-bind-html="premiumContent.footer.text">\n                    </div>\n                </div>\n\n                <div ng-show="page.isIosClient()" class="ios-app-footer">\n                    <small>\n                        <a ui-sref="facer.privacy" class="text-link" target="_blank">Privacy Policy</a>\n                        -\n                        <a ui-sref="facer.terms" class="text-link" target="_blank">Terms of Service</a>\n                    </small>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},1713:e=>{var n="/html/privacy.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h1>Privacy Policy</h1>\n    <p align="center"><strong>Last Updated: 04/17/2015</strong></p>\n    <p><strong></strong></p>\n\n    <p>\n        Protecting your privacy is really important to us. With this in mind,\n        we’re providing this Privacy Policy to explain our practices regarding\n        the collection, use and disclosure of information that we receive\n        through our Services. This Privacy Policy does not apply to any\n        third-party websites, services or applications, even if they are\n        accessible through our Services. Also, please note that, unless we\n        define a term in this Privacy Policy, all capitalized terms used in this\n        Privacy Policy have the same meanings as in our Terms of Service. So,\n        please make sure that you have read and understand our Terms of Service.\n    </p>\n\n    <h2><strong>Revisions to this Privacy Policy</strong></h2>\n\n    <p>\n        Any information that is collected via our Services is covered by the\n        Privacy Policy in effect at the time such information is collected. We\n        may revise this Privacy Policy from time to time. If we make any\n        material changes to this Privacy Policy, we’ll notify you of those\n        changes by posting them on the Services or by sending you an email or\n        other notification, and we’ll update the “Last Updated Date” above to\n        indicate when those changes will become effective.\n    </p>\n\n    <h2><strong>Collection and Use of Information</strong></h2>\n    <p><strong>Information Collected or Received from You</strong></p>\n\n    <p>\n        Our primary goals in collecting information are to provide and improve\n        our Services, to administer your use of the Services (including your\n        Account, if you are an Account holder), and to enable you to enjoy and\n        easily navigate our Services. We may also use your information to send\n        you e-mails and materials that directly promote our Services.\n    </p>\n\n    <p>\n        <u>Account Information</u> . If you create an Account, we’ll collect\n        certain information that can be used to identify you (“<strong>Personally Identifiable Information</strong>” or “ <strong>PII</strong>”), such as your name, email address,\n        profile photograph and a short biography. If you create an Account using\n        your login credentials from one of your SNS Accounts, we’ll be able to\n        access and collect your name and email address and other PII that your\n        privacy settings on the SNS Account permit us to access. If you create\n        an Account through the Site or one of your SNS Accounts, we may also\n        collect other information that is not considered PII because it cannot\n        be used by itself to identify you, such the country and city where you\n        are located. If you create an Account on behalf of an organization,\n        we’ll also collect your organization’s corporate name. When you register\n        for any Paid Services, we’ll collect your credit card information or\n        other billing information you provide to us.\n    </p>\n\n    <p>\n        <u>Information Collected Using Cookies and other Web Technologies</u> .\n        Like many website owners and operators, we use automated data collection\n        tools such as Cookies and Web Beacons to collect certain information.\n    </p>\n\n    <p>\n        “<strong>Cookies</strong>” are small text files that are placed on your\n        hard drive by a Web server when you access our Services. We may use both\n        session Cookies and persistent Cookies to identify that you’ve logged in\n        to the Services and to tell us how and when you interact with our\n        Services. We may also use Cookies to monitor aggregate usage and web\n        traffic routing on our Services and to customize and improve our\n        Services. Unlike persistent Cookies, session Cookies are deleted when\n        you log off from the Services and close your browser. Although most\n        browsers automatically accept Cookies, you can change your browser\n        options to stop automatically accepting Cookies or to prompt you before\n        accepting Cookies. Please note, however, that if you don’t accept\n        Cookies, you may not be able to access all portions or features of the\n        Services. Some third-party services providers that we engage may also\n        place their own Cookies on your hard drive, such as Google Analytics and\n        Mixpanel. Note that this Privacy Policy covers only our use of Cookies\n        and does not include use of Cookies by such third parties.\n    </p>\n\n    <p>\n        “<strong>Web Beacons</strong>” (also known as Web bugs, pixel tags or\n        clear GIFs) are tiny graphics with a unique identifier that may be\n        included on our Services for several purposes, including to deliver or\n        communicate with Cookies, to track and measure the performance of our\n        Services and to monitor how many visitors view our Services. Unlike\n        Cookies, which are stored on the user’s hard drive, Web Beacons are\n        typically embedded invisibly on web pages.\n    </p>\n\n    <p>\n        <u>Information Related to Use of the Services</u> . Our servers\n        automatically record certain information about how a person uses our\n        Services (we refer to this information as “<strong>Log Data</strong>”),\n        including both Account holders and non-Account holders (either, a\n        “<strong>User</strong>”). Log Data may include information such as a\n        User’s Internet Protocol (IP) address, browser type, operating system,\n        the web page that a User was visiting before accessing our Services, the\n        pages or features of our Services to which a User browsed and the time\n        spent on those pages or features, search terms on the Services, the\n        links on our Services that a User clicked on and other statistics. We\n        use Log Data to administer the Services and we analyze (and may engage\n        third parties to analyze) Log Data to improve, customize and enhance our\n        Services by expanding their features and functionality and tailoring\n        them to our Users’ needs and preferences. We may also track the watch\n        faces Account holders have created and watch faces on their own\n        collection on the Services.\n    </p>\n\n    <p>\n        <u>Information Sent by Your Mobile Device</u> . We or third party\n        services provider we engage will collect certain information that your\n        mobile device sends when you use our Services, like a device identifier,\n        user settings and the operating system of your device, as well as\n        information about your use of our Services.\n    </p>\n\n    <p>\n        <u>Location Information</u> . When you use our Services, we may collect\n        and store information about your location by accessing your mobile\n        device’s GPS coordinates or coarse location if you enable location\n        services on your device, or when you provide us your country and city\n        during the registration process. We may use location information to\n        improve and personalize our Services for you. If you do not want us to\n        collect location information, you may disable that feature on your\n        mobile device.\n    </p>\n\n    <p>\n        <u>Transactional Information</u> . We may collect information about the\n        transaction in which you engage using the Paid Services, which may\n        include PII about you relating to the transaction in question.\n    </p>\n\n    <h2><strong>Information that We Share with Third Parties</strong></h2>\n\n    <p>\n        We will not share any PII that we have collected from or regarding you\n        except as described below:\n    </p>\n\n    <p>\n        <u>Information Shared with </u>\n        <u>the General Public or other </u>\n        <u>Account holders.</u> When you create your profile, the general public\n        and other Account holders will be able to view your profile information\n        (including your name, photograph, biography and city or country).\n        <u></u>\n    </p>\n\n    <p>\n        <u>Information Shared with Our Services Providers</u> . We may engage\n        third-party services providers to work with us to administer and provide\n        the Services. These third-party services providers have access to your\n        PII only for the purpose of performing services on our behalf.\n    </p>\n\n    <p>\n        <u>Information Shared with Third Parties</u> . We may share aggregated\n        information and non-identifying information with third parties for\n        industry research and analysis, demographic profiling and other similar\n        purposes.\n    </p>\n\n    <p>\n        <u>Information Disclosed in Connection with Business Transactions</u> .\n        Information that we collect from our users, including PII, is considered\n        to be a business asset. Thus, if we are acquired by a third party as a\n        result of a transaction such as a merger, acquisition or asset sale or\n        if our assets are acquired by a third party in the event we go out of\n        business or enter bankruptcy, some or all of our assets, including your\n        PII, may be disclosed or transferred to a third party acquirer in\n        connection with the transaction.\n    </p>\n\n    <p>\n        <u>Information Disclosed for Our Protection and the Protection of\n            Others</u>\n        . We cooperate with government and law enforcement officials or private\n        parties to enforce and comply with the law. We may disclose any\n        information about you to government or law enforcement officials or\n        private parties as we, in our sole discretion, believe necessary or\n        appropriate: (i) to respond to claims, legal process (including\n        subpoenas); (ii) to protect our property, rights and safety and the\n        property, rights and safety of a third party or the public in general;\n        and (iii) to stop any activity that we consider illegal, unethical or\n        legally actionable activity.\n    </p>\n\n    <h2><strong>Your Choices</strong></h2>\n\n    <p>\n        We offer you choices regarding the collection, use and sharing of your\n        PII and we’ll respect the choices you make. Please note that if you\n        decide not to provide us with the PII that we request, you may not be\n        able to access all of the features of the Services.\n    </p>\n\n    <p>\n        <u>Opt-Out</u> . We may periodically send you free newsletters and\n        e-mails that directly promote our Services. When you receive such\n        promotional communications from us, you will have the opportunity to\n        “opt-out” by following the unsubscribe instructions provided in the\n        e-mail you receive. We do need to send you certain communications\n        regarding the Services and you will not be able to opt out of those\n        communications – e.g., communications regarding updates to our Terms of\n        Service or this Privacy Policy or information about billing.\n    </p>\n\n    <p>\n        <u>Modifying Your Information</u> . You can access and modify the PII\n        associated with your Account by editing your profile on your Account,\n        but some information may remain in archived/backup copies for our\n        records or as otherwise required by law.\n    </p>\n\n    <p><strong>Responding to Do Not Track Signals</strong></p>\n\n    <p>\n        Our Site does not have the capability to respond to “Do Not Track”\n        signals received from various web browsers.\n    </p>\n\n    <p><strong>The Security of Your Information</strong></p>\n\n    <p>\n        We take reasonable administrative, physical and electronic measures\n        designed to protect the information that we collect from or about you\n        (including your PII) from unauthorized access, use or disclosure. When\n        you enter sensitive information on our forms, we encrypt this data.\n        Please be aware, however, that no method of transmitting information\n        over the Internet or storing information is completely secure.\n        Accordingly, we cannot guarantee the absolute security of any\n        information.\n    </p>\n\n    <p><strong>Links to Other Sites</strong></p>\n\n    <p>\n        Our Services may contain links to websites and services that are owned\n        or operated by third parties (each, a “<strong>Third-party Service</strong>”). Any information that you provide on or to a Third-party Service or\n        that is collected by a Third-party Service is provided directly to the\n        owner or operator of the Third-party Service and is subject to the\n        owner’s or operator’s privacy policy. We’re not responsible for the\n        content, privacy or security practices and policies of any Third-party\n        Service. To protect your information we recommend that you carefully\n        review the privacy policies of all Third-party Services that you access.\n    </p>\n\n    <p><strong>International Transfer</strong></p>\n\n    <p>\n        Your PII may be transferred to, and maintained on, computers located\n        outside of your state, province, country or other governmental\n        jurisdiction where the privacy laws may not be as protective as those in\n        your jurisdiction. If you’re located outside the United States and\n        choose to provide your PII to us, we may transfer your PII to the United\n        States and process it there.\n    </p>\n\n    <p><strong>Our Policy Toward Children</strong></p>\n\n    <p>\n        Our Services are not directed to children under 13 and we do not\n        knowingly collect PII from children under 13. If we learn that we have\n        collected PII of a child under 13 we will take steps to delete such\n        information from our files as soon as possible.\n    </p>\n\n    <p><strong>Your California Privacy Rights</strong></p>\n\n    <p>\n        California residents may request and obtain from us, once a year, free\n        of charge, a list of third parties, if any, to which we disclosed their\n        PII for direct marketing purposes during the preceding calendar year and\n        the categories of PII shared with those third parties. If you are a\n        California resident and wish to obtain that information, please submit\n        your request by sending us an email at [redacted:email]@facer.io with “California\n        Privacy Rights” in the subject line.\n    </p>\n\n    <p><strong>Questions?</strong></p>\n\n    <p>\n        Please contact us at [redacted:email]@facer.io if you have any questions about\n        our Privacy Policy.\n    </p>\n</div>\n')}]),e.exports=n},69673:e=>{var n="/html/profile-links.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="profile-links">\n    <a ng-if="websiteLink" ng-href="{{ websiteLink.url }}" class="profile-links__website" rel="nofollow">\n        {{ websiteLink.label }}\n    </a>\n\n    <div class="profile-links__socials" ng-if="socialLinks.length">\n        <a ng-repeat="link in socialLinks" ng-href="{{ link.url }}" ng-class="{\n                \'profile-links__social\': true,\n                \'profile-links__social--icon\': !link.imageSrc\n            }" rel="nofollow">\n            <img ng-if="link.imageSrc" ng-src="{{ link.imageSrc }}" alt="{{ link.imageAlt }}"/>\n            <i ng-if="!link.imageSrc" class="{{ link.icon }}"></i>\n        </a>\n    </div>\n</div>\n')}]),e.exports=n},60150:e=>{var n="/html/rating-prompt.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-if="currentItem" class="items-wrapper fade-in-out">\n    <div ng-repeat="item in items" ng-if="item.shouldShow()" class="facer-panel {{ item.style }}">\n        <div class="facer-panel-content">\n            <div class="facer-panel-icon">\n                <i class="{{ item.icon }}"></i>\n            </div>\n            <div class="facer-panel-body">\n                <div class="facer-panel-text">\n                    {{ item.text }}\n                </div>\n                <div class="facer-panel-actions">\n                    <div ng-click="item.mainActionOnClick()" class="facer-panel-action facer-panel-main-action">\n                        {{ item.mainActionLabel }}\n                    </div>\n                    <div class="facer-panel-action" ng-click="item.dismissActionOnClick()">\n                        {{ item.dismissActionLabel }}\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <a ng-hide href class="external-link" target="_blank"></a>\n</div>\n')}]),e.exports=n},75464:e=>{var n="/html/search-bar.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<form search-bar ng-submit="submitSearch($event)" action class="mn-search-item">\n    <div class="mn-search-wrapper">\n        <input name="search" ng-model="search" placeholder="Search"/>\n        <button type="submit">\n            <i class="icon-global-search"></i>\n        </button>\n    </div>\n</form>\n')}]),e.exports=n},4430:e=>{var n="/html/share-image-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper facer-share-modal" no-scroll>\n    <div ng-if="!videoModal" class="facer-modal-content facer-image-modal-content">\n        <div ng-show="image" class="facer-modal-image visible-sm visible-md visible-lg">\n            <img ng-src="{{image}}"/>\n        </div>\n        <div class="facer-modal-body-wrapper">\n            <h4 class="facer-modal-title">Share it!</h4>\n            <div class="facer-modal-form">\n                <div ng-if="!page.isMobile() && !page.isMacOSClient()" class="share-buttons">\n                    <a ng-click="close(\'facebook\')" type="button" class="share-button share-button-facebook">\n                        <i class="icon-facebook"></i>\n                    </a>\n                    <a ng-click="close(\'twitter\')" type="button" class="share-button share-button-twitter">\n                        <i class="icon-twitter"></i>\n                    </a>\n                    <a ng-click="close(\'reddit\')" type="button" class="share-button share-button-reddit">\n                        <i class="icon-reddit"></i>\n                    </a>\n                    <a ng-show="!noDownload" ng-href="{{image}}" ng-click="close(\'\')" download="watchface" target="_blank" type="button" class="share-button share-button-download">\n                        <i class="icon-cloud-download"></i>\n                    </a>\n                </div>\n                <div ng-if="page.isMobile() || page.isMacOSClient()" class="btn-group">\n                    <a ng-href="{{getShareLink(\'facebook\')}}" type="button" class="share-button share-button-facebook" target="_blank">\n                        <i class="icon-facebook"></i>\n                    </a>\n                    <a ng-href="{{getShareLink(\'twitter\')}}" type="button" class="share-button share-button-twitter" target="_blank">\n                        <i class="icon-twitter"></i>\n                    </a>\n                    <a ng-href="{{getShareLink(\'reddit\')}}" type="button" class="share-button share-button-reddit" target="_blank">\n                        <i class="icon-reddit"></i>\n                    </a>\n                    <a ng-show="!noDownload" ng-href="{{image}}" download="watchface" target="_blank" type="button" class="share-button share-button-download">\n                        <i class="cloud-download"></i>\n                    </a>\n                    \x3c!--<a id="copyShareableLink" class="btn btn-default" clipboard="modalShareableLink">\n\t\t\t\t\t\t<i class="icon-link"></i>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a id="modalEmbedCode" class="btn btn-default" clipboard="modalEmbedCode" success-message="Embed Code copied!">\n\t\t\t\t\t\t<i class="icon-code"></i>\n\t\t\t\t\t</a>--\x3e\n                </div>\n                <hr/>\n                <div>\n                    <div>\n                        <div class="facer-modal-share-cta">Direct Link</div>\n                        <div class="input-group">\n                            <input id="modalShareableLink" value="{{ shareableLink }}" class="form-control" clipboard="modalShareableLink"/>\n                            <div class="input-group-btn">\n                                <a class="btn btn-default" id="basic-addon3" clipboard="modalShareableLink">COPY</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div ng-show="embedCode">\n                    <br/>\n                    <div>\n                        <div class="facer-modal-share-cta">Embed</div>\n                        <div class="input-group">\n                            <input id="modalEmbedCode" value="{{ embedCode }}" class="form-control" clipboard="modalEmbedCode" success-message="Embed Code copied!"/>\n                            <div class="input-group-btn">\n                                <a class="btn btn-default" id="basic-addon3" clipboard="modalEmbedCode" success-message="Embed Code copied!">COPY</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div ng-if="watchface.isOwner()" class="facer-modal-inspect-cta">\n                    <i class="icon-magnifier"></i>\n                    <span>\n                        Inspect Mode\n                        <div class="tooltip-dot tooltip-dot-small tooltip-dot-gray" tooltip data-html="true" data-toggle="tooltip" title="Inspect mode gives other designers a chance to learn from your designs and makes them featurable in the Community tab!">\n                            ?\n                        </div>\n                    </span>\n                    <div ng-click="watchface.toggleInspection()" ng-class="{\'enabled\': watchface.isInspectable}" class="toggle">\n                        <div class="toggle-btn"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div ng-click="close(false)" class="facer-modal-backdrop">\n        <div class="facer-modal-close">\n            <i class="icon-close"></i>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},94190:e=>{var n="/html/spinner.template.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<svg width="194px" height="194px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid" class="uil-default">\n    <rect x="0" y="0" width="100" height="100" fill="none" class="bk"></rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(0 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(30 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.08333333333333333s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(60 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.16666666666666666s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(90 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.25s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(120 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.3333333333333333s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(150 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.4166666666666667s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(180 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.5s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(210 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.5833333333333334s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(240 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.6666666666666666s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(270 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.75s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(300 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.8333333333333334s" repeatCount="indefinite"/>\n    </rect>\n    <rect x="46.5" y="40" width="7" height="20" rx="5" ry="5" fill="#828282" transform="rotate(330 50 50) translate(0 -30)">\n        <animate attributeName="opacity" from="1" to="0" dur="1s" begin="0.9166666666666666s" repeatCount="indefinite"/>\n    </rect>\n</svg>\n')}]),e.exports=n},25937:e=>{var n="/html/store-sections.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<a ui-sref="facer.admin" class="text-link">Back to Admin Page</a>\n<h2>\n    Store Sections &nbsp;&nbsp;\n    \x3c!--<small><a ui-sref="facer.admin.storeSections.option({option: \'all\'})" ui-sref-active="active" class="option-link">All</a></small>\n\t&nbsp;&nbsp--\x3e\n    <small><a ui-sref="facer.admin.storeSections.option({option: \'live\'})" ui-sref-active="active" class="option-link">Live</a></small>\n    &nbsp;&nbsp;\n    <small><a ui-sref="facer.admin.storeSections.option({option: \'staging\'})" ui-sref-active="active" class="option-link">Staging</a></small>\n    &nbsp;&nbsp;\n    <small><a ui-sref="facer.admin.storeSections.option({option: \'archive\'})" ui-sref-active="active" class="option-link">Archive</a></small>\n\n    <a ng-if="!loading && option==\'live\'" ui-sref="facer.featured({preLive:\'false\'})" class="btn btn-primary pull-right margin-left" target="_blank">\n        View live front page\n    </a>\n    <a ng-if="!loading && option==\'staging\'" ui-sref="facer.featured({preLive:\'true\'})" class="btn btn-primary pull-right margin-left" target="_blank">\n        View pre-live front page\n    </a>\n\n    <button ng-if="!loading && option==\'live\'" ng-click="sendFeatureEmails()" class="btn btn-primary pull-right margin-left">\n        Send Feature Emails\n    </button>\n\n    <button ng-if="!loading && option==\'staging\' && storeIsPublishable()" ng-click="publishStore()" class="btn btn-primary pull-right margin-left">\n        Publish Store\n    </button>\n    <button ng-if="!loading && option==\'staging\'" ng-click="createStoreSection()" class="btn btn-default pull-right">\n        Create Store Section\n    </button>\n</h2>\n\n<br/>\n\n<div ng-if="option==\'archive\'">\n    <form class="form-inline">\n        <div class="form-group">\n            <label>Show live store sections on:</label>\n            <input type="datetime-local" class="form-control" ng-model="filters.date"/>\n        </div>\n    </form>\n\n    <br/>\n</div>\n\n<div dnd-list="storeSections" dnd-drop="updateStoreSections(item, index);" dnd-disable-if="reorderingDisabled">\n    <div class="dndPlaceholder"></div>\n    <div ng-repeat="storeSection in storeSections|filter:filterArchive track by $index" class="panel panel-default" ng-class="{\'panel-success\': isNewlyPublished(storeSection), \'panel-info\': isNewlyCreated(storeSection)}" dnd-draggable="storeSection" dnd-effect-allowed="move" dnd-disable-if="option!==\'staging\'">\n        <div class="panel-heading">\n            <h3>\n                <span class="handle"><i ng-if="option==\'staging\'" class="icon-grab-dots"></i>{{\'#\' + $index}}\n                </span>{{storeSection.get(\'name\')}}\n                <small ng-if="option!==\'archive\'"><small>\n                        &nbsp;\n                        \x3c!--<a ng-if="storeSection.get(\'status\') == \'pre-live\'" ng-click="publishStoreSection(storeSection)" class="text-link" ng-class="{\'disabled\': !storeSectionIsPublishable(storeSection)}">PUBLISH</a>\n                    &nbsp;--\x3e\n                        <a ng-show="canCreateStagingVersion(storeSection)" ng-click="createStagingStoreSection(storeSection)" class="text-link">CREATE STAGING\n                            VERSION</a>\n                        &nbsp;\n                        <a ng-if="storeSection.get(\'status\') == \'pre-live\'" ng-click="editStoreSection(storeSection)" class="text-link">EDIT</a>\n                        &nbsp;\n                        <a ng-click="deleteStoreSection(storeSection)" class="text-link">\n                            {{ option==\'live\' ? \'ARCHIVE\' : \'DELETE\' }}\n                        </a>\n                    </small></small>\n                <i ng-if="storeSection.get(\'visual\')==\'hero\'" class="pull-right icon-image"></i>\n                <i ng-if="storeSection.get(\'visual\')==\'list\'" class="pull-right icon-list-ul"></i>\n            </h3>\n        </div>\n\n        \x3c!-- Table --\x3e\n        <table class="table">\n            <thead>\n                <tr>\n                    <th class="col-md-1">Status</th>\n                    <th ng-if="option!==\'staging\'" class="col-md-2" ng-class="{\'success\': isNewlyPublished(storeSection)}">\n                        Published At\n                    </th>\n                    <th class="col-md-2" ng-class="{\'info\': isNewlyCreated(storeSection)}">\n                        Created At\n                    </th>\n                    <th ng-if="option==\'archive\'" class="col-md-2">\n                        Archived At\n                    </th>\n                    <th class="col-md-1">Platform (DEPRECATED)</th>\n                    <th class="col-md-1">Target Platforms</th>\n                    <th class="col-md-1">Order</th>\n                    <th class="col-md-1">Visual</th>\n                    <th class="col-md-6">Description</th>\n                    <th class="col-md-1">Collection</th>\n                    <th class="col-md-1">Coll. Status</th>\n                    <th ng-if="option==\'staging\'" class="col-md-1">\n                        Coll. Ready\n                    </th>\n                    <th class="col-md-2">Collection\'s Hero Image</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <th>{{storeSection.get(\'status\')|uppercase}}</th>\n                    <td ng-if="option!==\'staging\'" ng-class="{\'success\': isNewlyPublished(storeSection)}">\n                        {{storeSection.get(\'publishedAt\')|date:\'medium\'}}\n                    </td>\n                    <td ng-class="{\'info\': isNewlyCreated(storeSection)}">\n                        {{storeSection.createdAt|date:\'medium\'}}\n                    </td>\n                    <td ng-if="option==\'archive\'">\n                        {{storeSection.get(\'archivedAt\')|date:\'medium\'}}\n                    </td>\n                    <td>{{storeSection.get(\'platform_type\')}}</td>\n                    <td>\n                        <span ng-repeat="platform in storeSection.get(\'targetPlatforms\')" class="badge">\n                            {{platform}}<span ng-if="!$last">, </span>\n                        </span>\n                        <span ng-if="!storeSection.get(\'targetPlatforms\') || storeSection.get(\'targetPlatforms\').length === 0" class="text-muted">\n                            None selected\n                        </span>\n                    </td>\n                    <td>{{storeSection.get(\'order\')}}</td>\n                    <td>{{storeSection.get(\'visual\')}}</td>\n                    <td>{{storeSection.get(\'description\')}}</td>\n                    <td>\n                        <a ui-sref="facer.collection({collection:storeSection.get(\'targetCollection\').id})" class="text-link">{{storeSection.get(\'targetCollection\').id}}</a>\n                    </td>\n                    <td>\n                        {{storeSection.get(\'targetCollection\').get(\'status\')}}\n                    </td>\n                    <td ng-if="option==\'staging\'" ng-init="ready=collectionIsPublishable(storeSection.get(\'targetCollection\'))">\n                        <span ng-show="ready" class="green-text"><b>YES</b></span>\n                        <span ng-show="!ready" class="red-text"><b>NO</b></span>\n                    </td>\n                    <td>\n                        <img ng-src="{{storeSection.get(\'targetCollection\').get(\'hero_art\').url().replace(\'http://\', \'https://s3.amazonaws.com/\')}}" width="150"/>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n</div>\n<loader ng-if="loading"></loader>\n')}]),e.exports=n},20203:e=>{var n="/html/subscribe-button.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div>\n    <div ng-show="showAsOptions()" class="subscription-options">\n        <div class="subscription-option">\n            <button ng-click="subscribeYearly()" class="f-btn-rounded-primary-xl subscription-option__primary">\n                <span class="subscription-option__label">\n                    {{ getSubscriptionPlanLabel(\'yearly\') }}\n                </span>\n                <span class="subscription-option__callout">\n                    Best deal\n                </span>\n            </button>\n        </div>\n        <div class="subscription-option">\n            <button ng-click="subscribeMonthly()" class="f-btn-ghost-primary-xl subscription-option__secondary">\n                <span class="subscription-option__label">\n                    {{ getSubscriptionPlanLabel(\'monthly\') }}\n                </span>\n            </button>\n        </div>\n    </div>\n    <div ng-hide="showAsOptions()">\n        <div ng-show="showPaymentRequestButton()">\n            <h4 ng-show="getPaymentRequestButtonHeader()" class="payment-request-button-header">\n                {{ getPaymentRequestButtonHeader() }}\n            </h4>\n            <div ng-click="clickPaymentRequestButton()" id="paymentRequestButton"></div>\n            <h5></h5>\n        </div>\n        <button ng-click="subscribe()" ng-disabled="!subscribeButtonEnabled()" ng-show="!showPaymentRequestButton()" class="btn btn-lg btn-block creator-upgrade-card__action-button">\n            {{ getSubscribeButtonText() }}\n        </button>\n    </div>\n</div>')}]),e.exports=n},79335:e=>{var n="/html/subscription-manager.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-show="showSubMgr()" class="subscription-manager">\n    <div ng-show="showBg()" id="premiumPanelBg">\n        <img ng-show="!isLightTheme()" ng-src="{{facerStaticAssetUrl(\'/img/dots-stripes.png\')}}" class="dots-stripes-bg"/>\n        <img ng-show="!isLightTheme()" ng-src="{{facerStaticAssetUrl(\'/img/zigzag.png\')}}" class="zigzag-bg"/>\n        <img ng-show="isLightTheme()" ng-src="{{facerStaticAssetUrl(\'/img/dots-stripes-dark.png\')}}" class="dots-stripes-bg"/>\n        <img ng-show="isLightTheme()" ng-src="{{facerStaticAssetUrl(\'/img/zigzag-dark.png\')}}" class="zigzag-bg"/>\n    </div>\n\n    <div class="subscription-manager-content">\n        <div ng-show="showInfoPanel()" class="subscription-manager-header">\n            <div class="subscription-manager-header-icon">\n                <img src="{{ getInfoPanelImage() }}"/>\n            </div>\n            <div class="subscription-manager-header-text">\n                <h2 class="subscription-manager-title">\n                    {{ getTitleContent() }}\n                </h2>\n                <h3 class="subscription-manager-subtitle">\n                    {{ getSubtitleContent() }}\n                </h3>\n            </div>\n        </div>\n\n        <div class="subscription-manager-actions">\n            <div ng-show="showButtonTitle()" class="subscription-manager-button-title">\n                <h3>{{ getButtonTitle() }}</h3>\n            </div>\n            <div class="subscription-manager-buttons">\n                <loader ng-show="showLoader()"></loader>\n                <a ng-show="showLearnMoreButton()" ng-href="{{ getLearnMoreLink() }}" class="btn btn-lg">Learn More</a>\n\n                <a ng-show="showSubscribedButton()" ng-click="product.onSubscribedCtaClick()" class="btn btn-lg">{{\n                    getSubscribedCta() }}</a>\n                <subscribe-button ng-if="showSubscribeButton()" variant="{{getVariant()}}"></subscribe-button>\n                <button ng-show="showReactivationButton()" ng-click="reactivateSubscription()" class="btn btn-lg">\n                    Click to reactivate!\n                </button>\n                <button ng-show="showFetchStatusButton()" ng-click="getSubscriptionStatus()" class="btn">\n                    Fetch subscription status (test only)\n                </button>\n            </div>\n            <div ng-show="!showAsOptions() && showActionInfoLabel()" class="subscription-manager-action-info">\n                <span ng-class="{ strikethrough: strikethroughActionInfoLabel() }">{{ getActionInfoLabel() }}</span>\n                <span class="action-info-detail">{{\n                    getActionInfoDetail()\n                    }}</span>\n                <small ng-show="showSubscriptionEditButton()">\n                    &nbsp;<i ng-click="toggleSubscriptionSettings()" class="icon-pencil"></i>\n                </small>\n\n                <div>\n                    <div ng-show="showYearlySubscriptionOption()" class="yearly-toggle-checkbox checkbox" ng-class="{\n                            \'yearly-toggle-checked\': yearlyOptionChecked\n                        }">\n                        <label for="yearlyToggle">\n                            <input class="checkbox" id="yearlyToggle" ng-model="yearlyOptionChecked" ng-change="planToggleClicked()" type="checkbox"/>\n                            <span ng-bind-html="getYearlyOptionPromoText()"></span>\n                        </label>\n                    </div>\n                </div>\n            </div>\n            <div ng-show="showInlineCouponCodeInput() && !haveCoupon && showCouponCodeInput()" class="subscription-coupon">\n                Have a promo code? <span ng-click="haveCoupon=true" class="text-link">Redeem it here</span>\n            </div>\n            <form ng-submit="applyCoupon()" ng-show="showInlineCouponCodeInput() && !coupon && haveCoupon && showCouponCodeInput()" class="coupon-code-form">\n                <div class="form-group">\n                    <div class="form-inline">\n                        <input class="form-control" id="couponCode" ng-model="couponEntry" type="text" placeholder="Coupon code"/>\n                        <button type="submit" class="f-btn-rounded-primary-sm">Apply</button>\n                    </div>\n                    <span class="help-block" ng-show="coupon">{{ getCouponCodeMessage() }}</span>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <div ng-show="showSubscriptionSettings()" class="subscription-manager-settings">\n        <hr/>\n\n        <div class="subscription-manager-settings-info">\n            <div ng-show="isGooglePurchase() && product.id == \'All Access\'" class="subscription-manager-settings-status">\n                <b>Subscription settings can be managed in the Google Play\n                    App</b>\n            </div>\n            <div ng-show="isApplePurchase() && product.id == \'All Access\'" class="subscription-manager-settings-status">\n                <b>Subscription settings can be managed in the Apple App\n                    Store</b>\n            </div>\n            <div ng-show="!isStripePurchase() && product.id == \'Creator Pro\'" class="subscription-manager-settings-status">\n                <b>Enabled automatically with \'Partner\' status</b>\n            </div>\n            <div ng-show="isFacerPurchase() && product.id == \'All Access\'" class="subscription-manager-settings-status">\n                <b>To inquire about your subscription, please contact [redacted:email]@facer.io</b>\n            </div>\n            <div ng-show="isStripePurchase()" class="subscription-manager-settings-status">\n                <b>{{ getSubscriptionSettingsStatus() }}</b>\n                <br/>\n                <small>{{ getSubscriptionSettingsMessage() }}</small>\n            </div>\n            <div ng-show="isStripePurchase()" class="subscription-manager-settings-action">\n                <button ng-show="showUpdatePaymentInfoButton()" ng-click="updatePaymentInfo()" class="f-btn-rounded-primary">\n                    Update Payment Info\n                </button>\n                <button ng-show="showCancelButton()" ng-click="cancelSubscription()" class="f-btn-rounded-primary">\n                    Cancel\n                </button>\n                <button ng-show="showReactivationButton()" ng-click="reactivateSubscription()" class="f-btn-rounded-primary">\n                    Reactivate\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},14209:e=>{var n="/html/sync-button-component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-if="watchface" ng-mouseenter="onHover()" ng-mouseleave="offHover()" class="{{getClass()}} sync-wrapper">\n    <button ng-click="onClick()" class="sync-button" ng-class="{\'is-text-button\': shouldShowText()}">\n        <img ng-if="shouldShowLogo()" class="logo" ng-src="{{facerStaticAssetUrl(\'/img/facer.png\')}}"/>\n        <facer-icon ng-if="!shouldShowText() && shouldShowIcon()" icon="{{getIcon()}}"></facer-icon>\n        <span ng-if="shouldShowText()">Sync</span>\n        <loader ng-if="shouldShowLoader()" class="spinner-white button-spinner"></loader>\n    </button>\n    <a target="_blank" id="syncButtonExternalLink" ng-show="externalUrl" ng-href="{{externalUrl}}" class="external-url-link"></a>\n\n    <div class="sync-message-wrapper">\n        <div ng-show="shouldShowMessage()" bind-html-safe="getMessage()" class="sync-message fade-in-out"></div>\n    </div>\n\n    <div ng-show="shouldShowButtonLabel()" class="button-label-wrapper">\n        <div class="button-label" bind-html-safe="getButtonLabel()"></div>\n    </div>\n\n    \x3c!--<debug-info\n\t\tdata="getDebugInfo()"\n\t></debug-info>--\x3e\n</div>')}]),e.exports=n},86964:e=>{var n="/html/team.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="team-container">\n    <div class="header">\n        <h1>The Team</h1>\n        <p>\n            Facer is the #1 watch face platform for smartwatches, featured by\n            Apple, Google, Samsung and partner of some of the biggest names in\n            the industry.\n        </p>\n        <p>\n            Our core team is based in Los Angeles, California, but we welcome\n            team members from all over the world.\n        </p>\n        <p>\n            <a class="team-join-link" href="https://careers.facer.io/">Join us today! ⚡️</a>\n        </p>\n    </div>\n\n    <main class="team-members-container">\n        <div ng-repeat="teamMember in teamMembers" class="team-member-profile-container">\n            <a user-profile-link="teamMember" facer-io-link class="team-member-profile" ng-style="{\'background-image\': \'url(\' + teamMember.image + \')\'}" aria-label="{{ teamMember.name }} Watch Faces"></a>\n            <a user-profile-link="teamMember" facer-io-link class="team-member-info">\n                <span>{{ teamMember.name }}</span>\n                <span>{{ teamMember.position }}</span>\n            </a>\n            <div ng-if="teamMember.currentWatchface" class="team-member-watchface-container">\n                <span>Currently wearing</span>\n                <span>{{ teamMember.currentWatchface.title }}</span>\n            </div>\n            <a ui-sref="facer.watchface({watchface:teamMember.currentWatchface.id, watchModel: teamMember.currentWatchface.displayFace.id})" facer-io-link class="device-image-wrapper">\n                <div class="watch-sizing-wrapper">\n                    <div class="watch-container {{teamMember.currentWatchface.displayFace.id}}">\n                        <div class="watch-background" style="height: 50px"></div>\n                        <div class="watch-shadow" style="height: 100%"></div>\n                        <div class="watch-inner-container" style="height: 100%">\n                            <div class="watchface-image" style="height: 100%" ng-style="{\'background-image\': \'url(\' + teamMember.currentWatchface.image + \')\'}"></div>\n                        </div>\n                    </div>\n                </div>\n            </a>\n        </div>\n    </main>\n\n    <section class="cta-join-the-team">\n        <a href="https://careers.facer.io/">Join the team</a>\n    </section>\n</div>\n')}]),e.exports=n},85604:e=>{var n="/html/template-select-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper editor-modal template-select-modal" no-scroll>\n    <div class="facer-modal-content">\n        <h4 class="facer-modal-title facer-modal-title-flex">\n            <div class="header-title">New Design</div>\n            <div class="header-options">\n                <div class="btn" feature-id="apple-watch-creator" ng-show="accessible" ng-click="$parent.filteredPlatform = \'ios\';selectFilteredPlatform(\'ios\')" ng-class="{\n                        \'btn-primary\': $parent.filteredPlatform == \'ios\' || !filteredPlatform,\n                        \'btn-default\': $parent.filteredPlatform != \'ios\' && filteredPlatform\n                    }">\n                    Apple Watch\n                </div>\n                <div class="btn" ng-click="filteredPlatform = \'android\';selectFilteredPlatform(\'android\')" ng-class="{\n                        \'btn-primary\': filteredPlatform == \'android\',\n                        \'btn-default\': filteredPlatform != \'android\'\n                    }">\n                    WearOS / RTOS / Tizen\n                </div>\n            </div>\n            <div class="header-close-button" ng-click="close(false)">\n                <i class="icon-close"></i>\n            </div>\n        </h4>\n\n        <div class="facer-modal-body">\n            <div ng-repeat="watchface in list track by watchface.uid" ng-show="filteredPlatform == watchface.platform || (!filteredPlatform && watchface.platform == \'ios\')" class="col-xs-3 watchface-wrapper">\n                <watchface ng-click="close(watchface);$event.preventDefault()" watchface-id="watchface" ng-class="{\n                        \'wearos-tizen-watchface\': watchface.isAndroid()\n                    }" type="list" config="{\n                        showWatchSkin: false,\n                        showAuthor: false,\n                        showTitleBadge: false,\n                        showMainSyncButton: false,\n                        linksDisabled: true,\n                        hideTools: true,\n                        showTemplateButton: true\n                    }"></watchface>\n            </div>\n        </div>\n    </div>\n    <div class="facer-modal-backdrop"></div>\n</div>\n')}]),e.exports=n},21098:e=>{var n="/html/terms.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <h1 align="center">Terms of Service</h1>\n    <p align="center"><strong>Last Updated: 04/17/2015</strong></p>\n\n    <p>\n        Welcome to FACER! FACER is a service offered by Little Labs, Inc.\n        (“<strong>Little Labs</strong>”). Please read these Terms of Service\n        (the “ <strong>Terms</strong>”) carefully because they govern your use\n        of our website located at http://www.facer.io (the\n        “<strong>Site</strong>”), our online platform, which enables users to\n        design watch faces and download watch faces existent in the public\n        repository, and related services accessible via our Site and our mobile\n        device application (“<strong>App</strong>”). To make these Terms easier\n        to read, the Site, our services and App are collectively called the\n        “<strong>Services</strong>.”\n    </p>\n\n    <p>\n        By using our Services, you agree to be bound by these Terms. If you\n        don’t agree to these Terms, do not use the Services. If you are\n        accessing and using the Services on behalf of a company (such as your\n        employer) or other legal entity, you represent and warrant that you have\n        the authority to bind that company or other legal entity to these Terms.\n        In that case, “you” and “your” will refer to that company or other legal\n        entity.\n    </p>\n\n    <h2><strong>Changes to Terms or Services</strong></h2>\n\n    <p>\n        We may modify the Terms at any time, in our sole discretion. If we do\n        so, we’ll let you know either by posting the modified Terms on the Site\n        or through other communications. It’s important that you review the\n        Terms whenever we modify them because if you continue to use the\n        Services after we have posted modified Terms on the Site, you are\n        indicating to us that you agree to be bound by the modified Terms. If\n        you don’t agree to be bound by the modified Terms, then you may not use\n        the Services anymore. Because our Services are evolving over time we may\n        change or discontinue all or any part of the Services, at any time and\n        without notice, at our sole discretion.\n    </p>\n\n    <p><strong>Who May Use the Services</strong></p>\n    <p><u>Eligibility</u></p>\n\n    <p>\n        You may use the Services only if you are 13 years or older and are not\n        barred from using the Services under applicable law. In order to use the\n        Paid Services (as defined below), you must be 18 years or older, capable\n        of forming a binding contract with Little Labs, and not barred from\n        using the Services under applicable law.\n    </p>\n\n    <p><u>Registration and Your Information</u></p>\n\n    <p>\n        If you want to use certain features of the Services you’ll have to\n        create an account (“<strong>Account</strong>”). You can do this via the\n        Site or through your account with certain third-party social networking\n        services such as Facebook or Twitter (each, an “<strong>SNS Account</strong>”). If you choose the SNS Account\n        option we’ll create your Account by\n        extracting from your SNS Account certain personal information such as\n        your name and email address and other personal information that your\n        privacy settings on the SNS Account permit us to access.\n    </p>\n\n    <p>\n        It’s important that you provide us with accurate, complete and\n        up-to-date information for your Account and you agree to update such\n        information, as needed, to keep it accurate, complete and up-to-date. If\n        you don’t, we might have to suspend or terminate your Account. You agree\n        that you won’t disclose your Account password to anyone and you’ll\n        notify us immediately of any unauthorized use of your Account. You’re\n        responsible for all activities that occur under your Account, whether or\n        not you know about them.\n    </p>\n\n    <p><strong>How do the Services Work?</strong></p>\n    <p><u>Using the Services</u></p>\n\n    <p>\n        Through the Services, Little Labs provides Account holders with tools\n        which enable Account holders to create and design their own watch faces\n        for smart watch devices as available on the Services, for instance, for\n        running WearOS, which watch faces are for the purposes of these Terms,\n        User Content (as defined below).\n    </p>\n\n    <p>\n        Additionally, from time to time, we may offer Account holders with\n        access to certain optional features that require payment of a fee (the\n        <strong>“Paid Features”</strong>).\n    </p>\n\n    <p><u>Payment</u></p>\n\n    <p>\n        Creation of an Account and use of basic Services is free. If you sign up\n        for Paid Features, you agree to pay fees as listed on the Services. You\n        will make payment to us through credit card, or any other method of\n        payment we make available on the Services. You authorize Little Labs and\n        any payment service providers we engage to charge your payment method\n        for the fees. All fees or payments that you make pursuant to these Terms\n        are non-refundable, even if you cancel your Account.\n    </p>\n\n    <p><strong>Feedback</strong></p>\n\n    <p>\n        We welcome feedback, comments and suggestions for improvements to the\n        Services (“<strong>Feedback</strong>”). You can submit Feedback by\n        emailing us at [redacted:email]@facer.io. You grant to us a non-exclusive,\n        worldwide, perpetual, irrevocable, fully-paid, royalty-free,\n        sublicensable and transferable license under any and all intellectual\n        property rights that you own or control to use, copy, modify, create\n        derivative works based upon and otherwise exploit the Feedback for any\n        purpose.\n    </p>\n\n    <p><strong>Privacy Policy</strong></p>\n\n    <p>\n        Please refer to our\n        <a ui-sref="facer.privacy" class="text-link">Privacy Policy</a> for\n        information on how we collect, use and disclose information from our\n        users.\n    </p>\n\n    <p><strong>Content and Content Rights</strong></p>\n\n    <p>\n        For purposes of these Terms: (i) “<strong>Content</strong>” means text,\n        graphics, images, music, software, audio, video, works of authorship of\n        any kind, and information or other materials that are posted, generated,\n        provided or otherwise made available through the Services; and (ii) “\n        <strong>User Content</strong>” means any Content that Account holders\n        (including you) provide to be made available through the Services,\n        including watch faces created, designed and customized by you. Content\n        includes without limitation User Content.\n    </p>\n\n    <p><strong>Content Ownership, Responsibility and Removal</strong></p>\n\n    <p>\n        Little Labs does not claim any ownership rights in any User Content and\n        nothing in these Terms will be deemed to restrict any rights that you\n        may have to use and exploit your User Content. Subject to the foregoing,\n        Little Labs and its licensors exclusively own all right, title and\n        interest in and to the Services and Content (other than User Content),\n        including all associated intellectual property rights. You acknowledge\n        that the Services and Content are protected by copyright, trademark, and\n        other laws of the United States and foreign countries. You agree not to\n        remove, alter or obscure any copyright, trademark, service mark or other\n        proprietary rights notices incorporated in or accompanying the Services\n        or Content.\n    </p>\n\n    <p><u>Rights in User Content Granted by You</u></p>\n\n    <p>\n        By making any User Content available through Services you hereby grant\n        to Little Labs a perpetual, non-exclusive, transferable, worldwide,\n        irrevocable, royalty-free, fully paid up rights and license, with a\n        right to sublicense through multiple tiers, including to other Account\n        holders, to use, copy, reproduce, modify for formatting and correction\n        purposes, sell and offer for sale, distribute copies of, publicly\n        display, publicly perform and otherwise exploit your User Content, in\n        any manner in which Little Labs sees fit, in any and all media, now\n        existing or hereafter developed, including, but not limited to, in\n        connection with operating and providing the Services and Content to you\n        and to other Account holders, and for any and all purposes, including\n        for commercial and for-profit purposes. You expressly acknowledge that\n        under this license, Little Labs will have the right to commercialize\n        your User Content without any compensation to be paid to you.\n    </p>\n\n    <p>\n        You agree that you are solely responsible for all your User Content. You\n        represent and warrant that (i) your User Content is original; (ii) you\n        own all your User Content or you have all rights that are necessary to\n        grant us the license rights in your User Content under these Terms; and\n        (iii) neither your User Content, nor your use and provision of your User\n        Content to be made available through the Services, nor any use of your\n        User Content by Little Labs on or through the Services, or by other\n        individuals, including Account holders, will infringe, misappropriate or\n        violate a third party’s intellectual property rights, or rights of\n        publicity or privacy, or result in the violation of any applicable law\n        or regulation.\n    </p>\n\n    <p>\n        To the fullest extent permitted by applicable law, you waive and agree\n        never to assert, any and all Moral Rights (as defined below) that you\n        may have in or with respect to any User Content, during and after the\n        term of these Terms. “<strong>Moral Rights</strong>” mean any rights to\n        claim authorship of a work, to object to or prevent the modification or\n        destruction of a work, to withdraw from circulation or control the\n        publication or distribution of a work, and any similar right, existing\n        under judicial or statutory law of any country in the world, or under\n        any treaty, regardless of whether or not such right as called or\n        generally referred to as a “moral right.”\n    </p>\n\n    <p>\n        We are not responsible or liable for the removal or deletion of (or the\n        failure to remove or delete) any of your User Content.\n    </p>\n\n    <p><u></u></p>\n    <p><u>Rights in Content and User Content Granted by Little Labs</u></p>\n\n    <p>\n        Subject to your compliance with these Terms, Little Labs grants you a\n        limited, non-exclusive, non-transferable, non-sublicensable license to\n        use, publicly perform and publicly display User Content uploaded by\n        other Account holders, solely in connection with creation of a watch\n        face in accordance with your permitted use of the Services and solely\n        for your personal and non-commercial purposes.\n    </p>\n\n    <p><strong></strong></p>\n    <p><strong>Rights and Terms for Apps</strong></p>\n    <p><u>Rights in App Granted by Little Labs</u></p>\n\n    <p>\n        Subject to your compliance with these Terms, Little Labs grants you a\n        limited non-exclusive, non-transferable, non-sublicenseable license to\n        download and install a copy of the App on a mobile device or computer\n        that you own or control and to run such copy of the App solely for your\n        own personal non-commercial purposes. You may not copy the App, except\n        for making a reasonable number of copies for backup or archival\n        purposes. Except as expressly permitted in these Terms, you may not: (i)\n        copy, modify or create derivative works based on the App; (ii)\n        distribute, transfer, sublicense, lease, lend or rent the App to any\n        third party; (iii) reverse engineer, decompile or disassemble the App;\n        or (iv) make the functionality of the App available to multiple users\n        through any means. Little Labs reserves all rights in and to the App not\n        expressly granted to you under these Terms.\n    </p>\n\n    <p>\n        If you accessed or downloaded the App from any app store or distribution\n        platform (like the Google Play or the Amazon Appstore) (each, an “\n        <strong>App Provider</strong>”), then you acknowledge and agree that:\n    </p>\n\n    <p>\n        · These Terms are concluded between you and Little Labs, and not with\n        App Provider, and that, as between Little Labs and the App Provider,\n        Little Labs, is solely responsible for the App.\n    </p>\n\n    <p>\n        · App Provider has no obligation to furnish any maintenance and support\n        services with respect to the App.\n    </p>\n\n    <p>\n        · In the event of any failure of the App to conform to any applicable\n        warranty, you may notify App Provider and App Provider will refund the\n        purchase price for the App to you (if applicable) and, to the maximum\n        extent permitted by applicable law, App Provider will have no other\n        warranty obligation whatsoever with respect to the App. Any other\n        claims, losses, liabilities, damages, costs or expenses attributable to\n        any failure of an App to conform to any warranty will be the sole\n        responsibility of Little Labs.\n    </p>\n\n    <p>\n        · App Provider is not responsible for addressing any claims you have or\n        any claims of any third party relating to the App or your possession and\n        use of the App, including, but not limited to: (i) product liability\n        claims; (ii) any claim that the App fails to conform to any applicable\n        legal or regulatory requirement; and (iii) claims arising under consumer\n        protection or similar legislation.\n    </p>\n\n    <p>\n        · In the event of any third-party claim that the App or your possession\n        and use of the App infringes that third party’s intellectual property\n        rights, Little Labs will be solely responsible for the investigation,\n        defense, settlement and discharge of any such intellectual property\n        infringement claim to the extent required by these Terms.\n    </p>\n\n    <p>\n        · App Provider and its subsidiaries are third-party beneficiaries of\n        these Terms as related to your license of the App, and that, upon your\n        acceptance of the terms and conditions of these Terms, App Provider will\n        have the right (and will be deemed to have accepted the right) to\n        enforce these Terms as related to your license of the App against you as\n        a third party beneficiary thereof.\n    </p>\n\n    <p>\n        · You must also comply with all applicable third-party terms of service\n        when using the App.\n    </p>\n\n    <p>\n        · You agree to comply with all U.S. and foreign export laws and\n        regulations to ensure that neither the App nor any technical data\n        related thereto nor any direct product thereof is exported or\n        re-exported directly or indirectly in violation of, or used for any\n        purposes prohibited by, such laws and regulations. By using the App you\n        represent and warrant that: (i) you are not located in a country that is\n        subject to a U.S. Government embargo, or that has been designated by the\n        U.S. Government as a “terrorist supporting” country; and (ii) you are\n        not listed on any U.S. Government list of prohibited or restricted\n        parties.]\n    </p>\n\n    <p>\n        <strong>General Prohibitions</strong>\n        <strong> </strong>\n    </p>\n\n    <p>You agree not to do any of the following:</p>\n\n    <p>\n        · Post, upload, publish, submit or transmit any User Content that: (i)\n        infringes, misappropriates or violates a third party’s patent,\n        copyright, trademark, trade secret, moral rights or other intellectual\n        property rights, or rights of publicity or privacy; (ii) violates, or\n        encourages any conduct that would violate, any applicable law or\n        regulation or would give rise to civil liability; (iii) is fraudulent,\n        false, misleading or deceptive; (iv) is defamatory, obscene,\n        pornographic, vulgar or offensive; (v) promotes discrimination, bigotry,\n        racism, hatred, harassment or harm against any individual or group; (vi)\n        is violent or threatening or promotes violence or actions that are\n        threatening to any person or entity; or (vii) promotes illegal or\n        harmful activities or substances.\n    </p>\n\n    <p>\n        · Use, display, mirror or frame the Services or any individual element\n        within the Services, Little Labs’ name, any Little Labs trademark, logo\n        or other proprietary information, or the layout and design of any page\n        or form contained on a page, without Little Labs’ express written\n        consent;\n    </p>\n\n    <p>\n        · Access, tamper with, or use non-public areas of the Services, Little\n        Labs’ computer systems, or the technical delivery systems of Little\n        Labs’ providers;\n    </p>\n\n    <p>\n        · Attempt to probe, scan or test the vulnerability of any Little Labs\n        system or network or breach any security or authentication measures;\n    </p>\n\n    <p>\n        · Avoid, bypass, remove, deactivate, impair, descramble or otherwise\n        circumvent any technological measure implemented by Little Labs or any\n        of Little Labs’ providers or any other third party (including another\n        user) to protect the Services or Content;\n    </p>\n\n    <p>\n        · Attempt to access or search the Services or Content or download\n        Content from the Services through the use of any engine, software, tool,\n        agent, device or mechanism (including spiders, robots, crawlers, data\n        mining tools or the like) other than the software and/or search agents\n        provided by Little Labs or other generally available third-party web\n        browsers;\n    </p>\n\n    <p>\n        · Send any unsolicited or unauthorized advertising, promotional\n        materials, email, junk mail, spam, chain letters or other form of\n        solicitation;\n    </p>\n\n    <p>\n        · Use any meta tags or other hidden text or metadata utilizing a Little\n        Labs trademark, logo URL or product name without Little Labs’ express\n        written consent;\n    </p>\n\n    <p>\n        · Use the Services or Content, or any portion thereof, for any\n        commercial purpose or for the benefit of any third party or in any\n        manner not permitted by these Terms;\n    </p>\n\n    <p>\n        · Forge any TCP/IP packet header or any part of the header information\n        in any email or newsgroup posting, or in any way use the Services or\n        Content to send altered, deceptive or false source-identifying\n        information;\n    </p>\n\n    <p>\n        · Attempt to decipher, decompile, disassemble or reverse engineer any of\n        the software used to provide the Services or Content;\n    </p>\n    <p>\n        · Interfere with, or attempt to interfere with, the access of any user,\n        host or network, including, without limitation, sending a virus,\n        overloading, flooding, spamming, or mail-bombing the Services;\n    </p>\n\n    <p>\n        · Collect or store any personally identifiable information from the\n        Services from other users of the Services without their express\n        permission;\n    </p>\n\n    <p>\n        · Impersonate or misrepresent your affiliation with any person or\n        entity;\n    </p>\n\n    <p>· Violate any applicable law or regulation; or</p>\n\n    <p>\n        · Encourage or enable any other individual to do any of the foregoing.\n    </p>\n\n    <h2><strong>Little Labs’ Enforcement Rights</strong></h2>\n\n    <p>\n        Although we’re not obligated to monitor access to or use of the Services\n        or Content or to review or edit any Content, we have the right to do so\n        for the purpose of operating the Services, to ensure compliance with\n        these Terms, and to comply with applicable law or other legal\n        requirements. We reserve the right, but are not obligated, to remove or\n        disable access to any Content, including User Content, at any time and\n        without notice, including, but not limited to, if we, at our sole\n        discretion, consider any Content to be objectionable or in violation of\n        these Terms. We have the right to investigate violations of these Terms\n        or conduct that affects the Services. We may also consult and cooperate\n        with law enforcement authorities to prosecute users who violate the law.\n    </p>\n\n    <p><strong>DMCA/Copyright Policy</strong></p>\n\n    <p>\n        Little Labs respects copyright law and expects its users to do the same.\n        It is Little Labs’ policy to terminate in appropriate circumstances\n        Account holders who repeatedly infringe or are believed to be repeatedly\n        infringing the rights of copyright holders. Please see Little Labs’\n        Copyright and IP Policy at\n        <a ui-sref="facer.copyright" class="text-link">Copyright Policy</a>, for\n        further information.\n    </p>\n\n    <p><strong>Links to Third Party Websites or Resources</strong></p>\n\n    <p>\n        The Services and App may contain links to third-party websites or\n        resources. We provide these links only as a convenience and are not\n        responsible for the content, products or services on or available from\n        those websites or resources or links displayed on such websites. You\n        acknowledge sole responsibility for and assume all risk arising from,\n        your use of any third-party websites or resources.\n    </p>\n\n    <p><strong>Termination</strong></p>\n\n    <p>\n        We may terminate your access to and use of the Services, at our sole\n        discretion, at any time and without notice to you. You may cancel your\n        Account at any time by sending an email to us at [redacted:email]@facer.io. Upon\n        any termination, discontinuation or cancellation of Services or your\n        Account, the following provisions will survive: “Payment”, “Feedback”,\n        “Privacy Policy”, “Content and Content Rights”, “Content Ownership,\n        Responsibility and Removal”, “General Prohibitions”, “Little Labs’\n        Enforcement Rights”, “DMCA/Copyright Policy”, “Links to Third Party\n        Websites or Resources”, “Warranty Disclaimers”, “Indemnity”, “Limitation\n        of Liability”, “Dispute Resolution” and “General Terms”.<strong> </strong>\n    </p>\n\n    <p><strong>Warranty Disclaimers</strong></p>\n\n    <p>\n        The Services and Content are provided “AS IS,” without warranty of any\n        kind. Without limiting the foregoing, WE EXPLICITLY DISCLAIM ANY\n        WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, QUIET\n        ENJOYMENT OR NON-INFRINGEMENT, AND ANY WARRANTIES ARISING OUT OF COURSE\n        OF DEALING OR USAGE OF TRADE. We make no warranty that the Services will\n        meet your requirements or be available on an uninterrupted, secure, or\n        error-free basis. We make no warranty regarding the quality, accuracy,\n        timeliness, truthfulness, completeness or reliability of any Content.\n    </p>\n\n    <p><strong></strong></p>\n    <p><strong>Indemnity</strong></p>\n\n    <p>\n        You will indemnify, defend and hold harmless Little Labs and its parent,\n        affiliates, subsidiaries, officers, directors, employees and agents, and\n        assigns (the “<strong>Indemnified Parties</strong>”), from and against\n        any claims, disputes, demands, and proceedings of any kind threatened,\n        asserted or filed against Indemnified Party, and any liabilities,\n        damages, losses, and costs and expenses of any kind, including, without\n        limitation, reasonable legal and accounting fees incurred in connection\n        of such Claims or arising out of or in any way connected with (i) your\n        access to or use of the Services or Content, (ii) your User Content,\n        (iii) breach or alleged breach of any warranty or representation made by\n        you herein; and (iv) your violation of these Terms.\n    </p>\n\n    <p><strong></strong></p>\n    <p><strong>Limitation of Liability</strong></p>\n\n    <p>\n        NEITHER Little Labs NOR ANY OTHER party involved in creating, producing,\n        or delivering the services or content will be liable for any incidental,\n        special, exemplary or consequential damages, INCLUDING LOST PROFITS,\n        LOSS OF DATA OR GOODWILL, SERVICE INTERRUPTION, COMPUTER DAMAGE OR\n        SYSTEM FAILURE OR THE COST OF SUBSTITUTE SERVICES arising ouT of or in\n        connection with thESE TERMS or from the use OF or inability to use the\n        ServiceS or CONTENT, whether based on warranty, contract, tort\n        (including negligence), PRODUCT LIABILITY or any other legal theory, and\n        whether or not LITTLE LABS has been informed of the possibility of such\n        damage, EVEN IF A limited REMEDY SET FORTH HEREIN IS FOUND TO HAVE\n        FAILED OF ITS ESSENTIAL PUrPOSE. SOME JURISDICTIONS DO NOT ALLOW THE\n        EXCLUSION OR LIMITATION OF LIABILITY FOR CONSEQUENTIAL OR INCIDENTAL\n        DAMAGES, SO THE ABOVE LIMITATION MAY NOT APPLY TO YOU.\n    </p>\n\n    <p>\n        In no event will Little Labs’ total liability arising out of or in\n        connection with THESE TERMS OR FROM THE USE OF OR INABILITY TO USE the\n        ServiceS or content EXCEED THE AMOUNTS YOU HAVE PAID TO LITTLE LABS FOR\n        USE OF THE SERVICES OR content OR ONE HUNDRED DOLLARS ($100), IF YOU\n        HAVE NOT HAD ANY PAYMENT OBLIGATIONS TO LITTLE LABS, AS APPLICABLE.\n    </p>\n\n    <p>\n        THE EXCLUSIONS AND LIMITATIONS OF DAMAGES SET FORTH ABOVE ARE\n        FUNDAMENTAL ELEMENTS OF THE BASIS OF THE BARGAIN BETWEEN LITTLE LABS AND\n        YOU.\n    </p>\n\n    <h2><strong>Dispute Resolution</strong></h2>\n    <p><u>Governing Law</u></p>\n\n    <p>\n        These Terms and any action related thereto will be governed by the laws\n        of the State of California without regard to its conflict of laws\n        provisions.\n    </p>\n\n    <p><u></u></p>\n    <p><u>Agreement to Arbitrate</u></p>\n    <p>\n        You and Little Labs agree that\n        <em>any dispute, claim or controversy arising out of or relating to\n            these Terms or the breach, termination, enforcement, interpretation\n            or validity thereof or the use of the Services or Content\n            (collectively, “<strong>Disputes</strong>”) will be settled by\n            binding arbitration, except that each party retains the right: (i)\n            to bring an individual action in small claims court and (ii) to\n            seek</em>\n        injunctive or other equitable relief in a court of competent\n        jurisdiction to prevent the actual or threatened infringement,\n        misappropriation or violation of a party’s copyrights, trademarks, trade\n        secrets, patents or other intellectual property rights (the action\n        described in the foregoing clause (ii), an “\n        <strong>IP Protection Action</strong>”). The exclusive jurisdiction and\n        venue of any IP Protection Action will be the state and federal courts\n        located in the Northern District of California and each of the parties\n        hereto waives any objection to jurisdiction and venue in such courts.\n        <em><strong>You acknowledge and agree that you and Little Labs</strong></em>\n        <strong>are each waiving the right to a trial by jury or to participate as\n            a plaintiff or class member in any purported class action or\n            representative proceeding.</strong>\n        Further, unless both you and Little Labs otherwise agree in writing, the\n        arbitrator may not consolidate more than one person\'s claims, and may\n        not otherwise preside over any form of any class or representative\n        proceeding. If this specific paragraph is held unenforceable, then the\n        entirety of this “Dispute Resolution” section will be deemed void.\n        Except as provided in the preceding sentence, this “Dispute Resolution”\n        section will survive any termination of these Terms.\n    </p>\n\n    <p><em></em></p>\n\n    <p>\n        <em><u>Arbitration Rules</u></em>\n        <em></em>\n    </p>\n\n    <p>\n        <em>The arbitration will be administered by </em> the American\n        Arbitration Association (“<strong>AAA</strong>”)<strong> </strong><em>in accordance with the </em>Commercial\n        Arbitration Rules and the\n        Supplementary Procedures for Consumer Related Disputes (the “<strong>AAA Rules</strong>”) then in effect, except\n        as modified by this “Dispute Resolution”\n        section. (The AAA Rules are available at\n        <a href="http://www.adr.org/arb_med">www.adr.org/arb_med</a> or by\n        calling the AAA at 1-800-778-7879.) The Federal Arbitration Act will\n        govern the interpretation and enforcement of this Section.\n    </p>\n\n    <p><u>Arbitration Process</u></p>\n\n    <p>\n        A party who desires to initiate arbitration must provide the other party\n        with a written Demand for Arbitration as specified in the AAA Rules.\n        (The AAA provides a form Demand for Arbitration at\n        <a href="http://www.adr.org/aaa/ShowPDF?doc=ADRSTG_015820">http://www.adr.org/aaa/ShowPDF?doc=ADRSTG_015820</a>\n        and a separate form for California residents at\n        http://www.adr.org/aaa/ShowPDF?doc=ADRSTG_015822.) The arbitrator will\n        be either a retired judge or an attorney licensed to practice law and\n        will be selected by the parties from the AAA’s roster of arbitrators. If\n        the parties are unable to agree upon an arbitrator within seven (7) days\n        of delivery of the Demand for Arbitration, then the AAA will appoint the\n        arbitrator in accordance with the AAA Rules.\n    </p>\n\n    <p><u>Arbitration Location and Procedure</u></p>\n\n    <p>\n        Unless you and Little Labs otherwise agree, the arbitration will be\n        conducted in the county where you reside. If your claim does not exceed\n        $10,000, then the arbitration will be conducted solely on the basis of\n        the documents that you and Little Labs submit to the arbitrator, unless\n        you request a hearing or the arbitrator determines that a hearing is\n        necessary. If your claim exceeds $10,000, your right to a hearing will\n        be determined by the AAA Rules. Subject to the AAA Rules, the arbitrator\n        will have the discretion to direct a reasonable exchange of information\n        by the parties, consistent with the expedited nature of the arbitration.\n    </p>\n\n    <p><u>Arbitrator’s Decision</u></p>\n\n    <p>\n        The arbitrator will render an award within the time frame specified in\n        the AAA Rules. The arbitrator’s decision will include the essential\n        findings and conclusions upon which the arbitrator based the award.\n        Judgment on the arbitration award may be entered in any court having\n        jurisdiction thereof. The arbitrator’s award of damages must be\n        consistent with the terms of the “Limitation of Liability” section above\n        as to the types and amounts of damages for which a party may be held\n        liable. The arbitrator may award declaratory or injunctive relief only\n        in favor of the claimant and only to the extent necessary to provide\n        relief warranted by the claimant’s individual claim. If you prevail in\n        arbitration you will be entitled to an award of attorneys’ fees and\n        expenses, to the extent provided under applicable law. Little Labs will\n        not seek, and hereby waives all rights it may have under applicable law\n        to recover, attorneys’ fees and expenses if it prevails in arbitration.\n    </p>\n\n    <p><u></u></p>\n    <p><u>Fees</u></p>\n\n    <p>\n        Your responsibility to pay any AAA filing, administrative and arbitrator\n        fees will be solely as set forth in the AAA Rules. However, if your\n        claim for damages does not exceed $75,000, Little Labs will pay all such\n        fees unless the arbitrator finds that either the substance of your claim\n        or the relief sought in your Demand for Arbitration was frivolous or was\n        brought for an improper purpose (as measured by the standards set forth\n        in Federal Rule of Civil Procedure 11(b)).\n    </p>\n\n    <p><u>Changes</u></p>\n\n    <p>\n        Notwithstanding the provisions of the “Changes to the Terms or Services”\n        section above, if Little Labs changes this “Dispute Resolution” section\n        after the date you first accepted these Terms (or accepted any\n        subsequent changes to these Terms), you may reject any such change by\n        sending us written notice (including by email to [redacted:email]@facer.io)\n        within 30 days of the date such change became effective, as indicated in\n        the “Last Updated” date above or in the date of Little Labs’ email to\n        you notifying you of such change. By rejecting any change, you are\n        agreeing that you will arbitrate any Dispute between you and Little Labs\n        in accordance with the provisions of this “Dispute Resolution” section\n        as of the date you first accepted these Terms (or accepted any\n        subsequent changes to these Terms).\n    </p>\n\n    <p><strong>General Terms</strong></p>\n\n    <p>\n        These Terms constitute the entire and exclusive understanding and\n        agreement between Little Labs and you regarding the Services and\n        Content, and these Terms supersede and replace any and all prior oral or\n        written understandings or agreements between Little Labs and you\n        regarding the Services and Content. If for any reason a court of\n        competent jurisdiction finds any provision of these Terms invalid or\n        unenforceable, that provision will be enforced to the maximum extent\n        permissible and the other provisions of these Terms will remain in full\n        force and effect.\n    </p>\n\n    <p>\n        You may not assign or transfer these Terms, by operation of law or\n        otherwise, without Little Labs’ prior written consent. Any attempt by\n        you to assign or transfer these Terms, without such consent, will be\n        null. Little Labs may freely assign or transfer these Terms without\n        restriction. Subject to the foregoing, these Terms will bind and inure\n        to the benefit of the parties, their successors and permitted assigns.\n    </p>\n\n    <p>\n        Any notices or other communications provided by Little Labs under these\n        Terms, including those regarding modifications to these Terms, will be\n        given: (i) via email; or (ii) by posting to the Services. For notices\n        made by e-mail, the date of receipt will be deemed the date on which\n        such notice is transmitted.\n    </p>\n\n    <p>\n        Little Labs’ failure to enforce any right or provision of these Terms\n        will not be considered a waiver of such right or provision. The waiver\n        of any such right or provision will be effective only if in writing and\n        signed by a duly authorized representative of Little Labs. Except as\n        expressly set forth in these Terms, the exercise by either party of any\n        of its remedies under these Terms will be without prejudice to its other\n        remedies under these Terms or otherwise.\n    </p>\n\n    <p><strong></strong></p>\n    <p><strong>Contact Information</strong></p>\n\n    <p>\n        If you have any questions about these Terms or the Services, please\n        contact Little Labs at <em>[redacted:email]@facer.io</em>.\n    </p>\n</div>')}]),e.exports=n},25286:e=>{var n="/html/top-charts.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="flush-top top-charts">\n    <div ng-if="topChartsMobileHeader && shouldShowChartControls()">\n        <div class="top-charts-mobile-header">\n            <div class="top-charts-header-title">\n                <h1>{{ getTopChartsPageTitle() }}</h1>\n                <div class="top-charts-header-subtitle" ng-if="getHeaderSubtitle()">\n                    {{getHeaderSubtitle()}}\n                </div>\n                <p class="top-charts-intro" ng-if="getTopChartsIntro()">\n                    {{ getTopChartsIntro() }}\n                </p>\n            </div>\n        </div>\n        <div class="nav-section">\n            <div class="explore-options">\n                <div class="row">\n                    <a ng-href="{{getPriceFilterUrl(\'premium\')}}" ng-class="{\'active\': showPremiumWatchfaces()}" class="option-link col-xs-6">Premium Faces</a>\n                    <a ng-href="{{getPriceFilterUrl(\'free\')}}" ng-class="{\'active\': showFreeWatchfaces()}" class="option-link col-xs-6">Free Faces</a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div ng-if="topChartsMobileHeader && shouldShowDesignersHeader()" class="top-charts-mobile-header">\n        <div class="top-charts-header-title">\n            <h1>{{ getTopChartsPageTitle() }}</h1>\n            <div class="top-charts-header-subtitle" ng-if="getHeaderSubtitle()">\n                {{getHeaderSubtitle()}}\n            </div>\n        </div>\n    </div>\n\n    <div class="container">\n        <div class="top-charts-header" ng-if="!topChartsMobileHeader && shouldShowChartControls()">\n            <div class="top-charts-header-title">\n                <h1>{{ getTopChartsPageTitle() }}</h1>\n                <div class="top-charts-header-subtitle" ng-if="getHeaderSubtitle()">\n                    {{getHeaderSubtitle()}}\n                </div>\n                <p class="top-charts-intro" ng-if="getTopChartsIntro()">\n                    {{ getTopChartsIntro() }}\n                </p>\n            </div>\n            <div class="top-charts-header-nav">\n                <div class="top-charts-filter dropdown" data-updated-at-free="{{chartsUpdatedAt.free}} ({{chartsUpdatedAt.free|timeAgo}})" data-updated-at-premium="{{chartsUpdatedAt.premium}} ({{chartsUpdatedAt.premium|timeAgo}})">\n                    <button class="btn btn-default dropdown-toggle" type="button" id="desktopPriceType" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                        {{getCurrentlyShownPrice()}}\n                        <facer-icon icon="caret-down"></facer-icon>\n                    </button>\n                    <ul class="f-dropdown dropdown-menu dropdown-menu-right" aria-labelledby="desktopPriceType">\n                        <li ng-class="{\'active\': isSelectedPrice(\'premium\')}">\n                            <a ng-href="{{getPriceFilterUrl(\'premium\')}}">Premium</a>\n                        </li>\n                        <li ng-class="{\'active\': isSelectedPrice(\'free\')}">\n                            <a ng-href="{{getPriceFilterUrl(\'free\')}}">Free</a>\n                        </li>\n                    </ul>\n                </div>\n                <div class="top-charts-filter dropdown">\n                    <button class="btn btn-default dropdown-toggle" type="button" id="desktopPlatformType" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                        {{getCurrentlyShownPlatform()}}\n                        <facer-icon icon="caret-down"></facer-icon>\n                    </button>\n                    <ul class="f-dropdown dropdown-menu dropdown-menu-right" aria-labelledby="desktopPlatformType">\n                        <li ng-class="{\'active\': isSelectedPlatform(\'ios\', \'watchos\')}">\n                            <a ng-href="{{getPlatformFilterUrl(\'ios\', \'watchos\')}}">\n                                watchOS\n                            </a>\n                        </li>\n                        <li ng-class="{\'active\': isSelectedPlatform(\'wff\', \'wff\')}">\n                            <a ng-href="{{getPlatformFilterUrl(\'wff\', \'wff\')}}">\n                                Wear OS (WFF)\n                            </a>\n                        </li>\n                        <li ng-class="{\'active\': isSelectedPlatform(\'android\', \'wearos\')}">\n                            <a ng-href="{{getPlatformFilterUrl(\'android\', \'wearos\')}}">\n                                Wear OS (Legacy)\n                            </a>\n                        </li>\n                        <li ng-class="{\'active\': isSelectedPlatform(\'tizen\', \'tizen\')}">\n                            <a ng-href="{{getPlatformFilterUrl(\'tizen\', \'tizen\')}}">\n                                Tizen\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n        <div class="top-charts-header" ng-if="!topChartsMobileHeader && shouldShowDesignersHeader()">\n            <div class="top-charts-header-title">\n                <h1>{{ getTopChartsPageTitle() }}</h1>\n                <div class="top-charts-header-subtitle" ng-if="getHeaderSubtitle()">\n                    {{getHeaderSubtitle()}}\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="getStatusMessage()" class="top-charts-empty-state">\n            {{getStatusMessage()}}\n        </div>\n\n        <div ng-if="loaded && !shouldShowEmptyState()" class="device-tracker">\n            <div ng-if="showDesigners()">\n                <table class="table">\n                    <tbody>\n                        <tr ng-repeat="user in designers" ng-class="{\'top-device\': $index < 5}" class="top-charts-row">\n                            <a user-profile-link="user" target="_blank">\n                                <td class="vertical-center">\n                                    <div class="top-chart-info">\n                                        <div ng-show="showDelta" class="top-chart-delta" ng-class="{\n\t\t\t\t\t\t\t\t\t\t\t\t\'positive\': user.delta > 0,\n\t\t\t\t\t\t\t\t\t\t\t\t\'negative\': user.delta < 0,\n\t\t\t\t\t\t\t\t\t\t\t\t\'stable\': user.delta === 0,\n\t\t\t\t\t\t\t\t\t\t\t\t\'new\': user.delta === null,\n\t\t\t\t\t\t\t\t\t\t\t}">\n                                            <div class="positive-arrow">\n                                                <i class="icon-arrow-up"></i>\n                                            </div>\n                                            <div class="top-chart-delta-number">\n                                                {{user.delta}}\n                                            </div>\n                                            <div class="top-chart-new">\n                                                <i class="icon-plus"></i>\n                                            </div>\n                                            <div class="negative-arrow">\n                                                <i class="icon-arrow-down"></i>\n                                            </div>\n                                        </div>\n                                        <div class="top-chart-rank">\n                                            {{$index+1}}\n                                        </div>\n                                    </div>\n                                </td>\n                                <td class="col-xs-8 col-sm-10 vertical-center">\n                                    <div class="artist-name">\n                                        <a class="watchface-artist" user-profile-link="user" facer-io-link>\n                                            {{getDeltaDisplayValue(user.name)}}\n                                            <user-badge user="user"></user-badge>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td class="col-xs-2">\n                                    <div class="user-widget">\n                                        <div>\n                                            <a user-profile-link="user" facer-io-link class="artist" style="background-image: url(\'{{user.avatar}}\')" square-fit></a>\n\n                                            \x3c!--<div>\n\t\t\t\t\t\t\t\t            \t<follow-button class="follow-button-inline-block" user="user"></follow-button>\n\t\t\t\t\t\t\t            \t</div>--\x3e\n                                        </div>\n                                    </div>\n                                </td>\n                            </a>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <div ng-if="showFreeWatchfaces()">\n                <table class="table top-watchface-list">\n                    <tbody>\n                        <tr ng-repeat="watchface in freeWatchfaces" ng-class="{\'top-device\': $index < 5}">\n                            <td class="vertical-center top-watchface-list-rank top-watchface-list-section">\n                                <div class="top-chart-info">\n                                    <div ng-show="showDelta" class="top-chart-delta" ng-class="{\n\t\t\t\t\t\t\t\t\t\t\t\'positive\': watchface.delta > 0,\n\t\t\t\t\t\t\t\t\t\t\t\'negative\': watchface.delta < 0,\n\t\t\t\t\t\t\t\t\t\t\t\'stable\': watchface.delta === 0,\n\t\t\t\t\t\t\t\t\t\t\t\'new\': watchface.delta === null,\n\t\t\t\t\t\t\t\t\t\t}">\n                                        <div class="positive-arrow">\n                                            <i class="icon-arrow-up"></i>\n                                        </div>\n                                        <div class="top-chart-delta-number">\n                                            {{getDeltaDisplayValue(watchface.delta)}}\n                                        </div>\n                                        <div class="top-chart-new">\n                                            <i class="icon-plus"></i>\n                                        </div>\n                                        <div class="negative-arrow">\n                                            <i class="icon-arrow-down"></i>\n                                        </div>\n                                    </div>\n                                    <div class="top-chart-rank">\n                                        {{$index+1}}\n                                    </div>\n                                </div>\n                            </td>\n                            <td class="device-name top-watchface-list-section">\n                                <div class="top-watchface-list-name">\n                                    <div class="top-watchface-list-name-avatar">\n                                        <a user-profile-link="watchface.author" facer-io-link class="top-watchface-avatar-link">\n                                            <img ng-src="{{watchface.author.avatar}}"/>\n                                        </a>\n                                    </div>\n                                    <div class="top-watchface-list-name-section">\n                                        <a ui-sref="facer.watchface({watchface: watchface.id, watchModel: watchface.displayFace.id})" facer-io-link class="top-watchface-title-link">\n                                            <span class="badge-string">\n                                                <div class="badge-string-content">\n                                                    {{watchface.title}}\n                                                </div>\n                                                <div class="badge-string-icon">\n                                                    <i ng-if="watchface.isPremium" class="icon-star premium-text icon-badge"></i>\n                                                </div>\n                                            </span>\n                                        </a>\n                                        <p ng-if="watchface" class="top-watchface-list-author">\n                                            <small>by\n                                                <a user-profile-link="watchface.author" facer-io-link class="text-link">{{watchface.author.name}}</a></small>\n                                        </p>\n                                    </div>\n                                </div>\n                            </td>\n                            <td class="device-image top-watchface-list-image top-watchface-list-section">\n                                <a ui-sref="facer.watchface({watchface: watchface.id, watchModel: watchface.displayFace.id})" facer-io-link class="device-image-wrapper">\n                                    <div class="watch-sizing-wrapper">\n                                        <div class="watch-container {{watchface.displayFace.id}}">\n                                            <div class="watch-background"></div>\n                                            <div class="watch-shadow"></div>\n                                            <div class="watch-inner-container">\n                                                <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.image + \')\'}">\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <admin-watchface-stats watchface="watchface"></admin-watchface-stats>\n                                </a>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <div ng-if="showPremiumWatchfaces()">\n                <table class="table top-watchface-list">\n                    <tbody>\n                        <tr ng-repeat="watchface in premiumWatchfaces" ng-class="{\'top-device\': $index < 5}">\n                            <td class="vertical-center top-watchface-list-rank top-watchface-list-section">\n                                <div class="top-chart-info">\n                                    <div ng-show="showDelta" class="top-chart-delta" ng-class="{\n\t\t\t\t\t\t\t\t\t\t\t\'positive\': watchface.delta > 0,\n\t\t\t\t\t\t\t\t\t\t\t\'negative\': watchface.delta < 0,\n\t\t\t\t\t\t\t\t\t\t\t\'stable\': watchface.delta === 0,\n\t\t\t\t\t\t\t\t\t\t\t\'new\': watchface.delta === null,\n\t\t\t\t\t\t\t\t\t\t}">\n                                        <div class="positive-arrow">\n                                            <i class="icon-arrow-up"></i>\n                                        </div>\n                                        <div class="top-chart-delta-number">\n                                            {{getDeltaDisplayValue(watchface.delta)}}\n                                        </div>\n                                        <div class="top-chart-new">\n                                            <i class="icon-plus"></i>\n                                        </div>\n                                        <div class="negative-arrow">\n                                            <i class="icon-arrow-down"></i>\n                                        </div>\n                                    </div>\n                                    <div class="top-chart-rank">\n                                        {{$index+1}}\n                                    </div>\n                                </div>\n                            </td>\n                            <td class="device-name top-watchface-list-section">\n                                <div class="top-watchface-list-name">\n                                    <div class="top-watchface-list-name-avatar">\n                                        <a user-profile-link="watchface.author" facer-io-link class="top-watchface-avatar-link">\n                                            <img ng-src="{{watchface.author.avatar}}"/>\n                                        </a>\n                                    </div>\n                                    <div class="top-watchface-list-name-section">\n                                        <a ui-sref="facer.watchface({watchface: watchface.id, watchModel: watchface.displayFace.id})" facer-io-link class="top-watchface-title-link">\n                                            <span class="badge-string">\n                                                <div class="badge-string-content">\n                                                    {{watchface.title}}\n                                                </div>\n                                                <div class="badge-string-icon">\n                                                    <i ng-if="watchface.isPremium" class="icon-star premium-text icon-badge"></i>\n                                                </div>\n                                            </span>\n                                        </a>\n                                        <p ng-if="watchface" class="top-watchface-list-author">\n                                            <small>by\n                                                <a user-profile-link="watchface.author" facer-io-link class="text-link">{{watchface.author.name}}</a></small>\n                                        </p>\n                                    </div>\n                                </div>\n                            </td>\n                            <td class="device-image top-watchface-list-image top-watchface-list-section">\n                                <a ui-sref="facer.watchface({watchface: watchface.id, watchModel: watchface.displayFace.id})" facer-io-link class="device-image-wrapper">\n                                    <div class="watch-sizing-wrapper">\n                                        <div class="watch-container {{watchface.displayFace.id}}">\n                                            <div class="watch-background"></div>\n                                            <div class="watch-shadow"></div>\n                                            <div class="watch-inner-container">\n                                                <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.image + \')\'}">\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <admin-watchface-stats watchface="watchface"></admin-watchface-stats>\n                                </a>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </div>\n        <loader ng-if="!loaded && !loadError"/>\n    </div>\n</div>')}]),e.exports=n},30020:e=>{var n="/html/upload.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <div class="row">\n        <div class="col-md-5">\n            <h3>Instructions:</h3>\n\n            <ol>\n                <li>\n                    Create your watchface using\n                    <a app-link="android" app-link-placement="upload_instructions" href>Facer for Android</a>\n                </li>\n\n                <li>\n                    Export your watchface (see\n                    <a href="http://wiki.getfacer.com/wiki/Exporting_a_Watchface">howto</a>)\n                </li>\n\n                <li>Submit your .face file here</li>\n            </ol>\n\n            <h3>Guidelines:</h3>\n\n            <ul>\n                <li>\n                    All watchfaces should contain an active and a dimmed mode\n                </li>\n                <li>Dimmed mode should be 90% black</li>\n                <li>\n                    The watchface cannot infringe on any copyright or trademark\n                </li>\n                <li>\n                    The watchface cannot contain any offensive or defamatory\n                    content\n                </li>\n            </ul>\n\n            <h3>Questions?</h3>\n\n            <p>\n                Send us an email at\n                <a href="mailto:[redacted:email]@facer.io">[redacted:email]@facer.io</a>\n            </p>\n        </div>\n\n        <div class="col-md-7">\n            <div class="panel panel-default">\n                <div class="panel-body">\n                    <div ng-if="!loading && !watchfaceForm.success && !watchfaceForm.failure" id="submit_container">\n                        <h1>Submit your watchface</h1>\n\n                        <p>\n                            Want to share your watchface with the world? Submit\n                            your watchface today!\n                        </p>\n\n                        <form id="upload-form" ng-submit="uploadWatchface()" novalidate>\n                            <div class="form-group">\n                                <label for="inputFile">Your Facer file</label>\n                                <input type="file" id="inputFile" upload="watchface" upload-type="arrayBuffer" required/>\n                                <div class="help-block with-errors"></div>\n                            </div>\n\n                            <img ng-if="watchfaceForm.watchface.previewBase64" ng-src="{{\'data:image/png;base64,\' + watchfaceForm.watchface.previewBase64}}" class="watchface_submit_preview"/>\n\n                            <div class="form-group">\n                                <label for="inputBio">Description</label>\n                                <textarea rows="3" name="desc" type="desc" class="form-control" id="desc" ng-model="watchfaceForm.description" placeholder="A few words about the watchface..."></textarea>\n                                <div class="help-block with-errors"></div>\n                            </div>\n\n                            <div class="checkbox">\n                                <label>\n                                    <input id="ack-check" type="checkbox" ng-model="watchfaceForm.acceptedTerms" required/>\n                                    I confirm the watchface does not infringe on\n                                    any copyright or trademarks\n                                </label>\n                                <div class="help-block with-errors"></div>\n                            </div>\n\n                            <div ng-if="watchfaceForm.error" class="submit-error">\n                                {{watchfaceForm.error}}\n                            </div>\n\n                            <button type="submit" class="btn btn-primary">\n                                Submit your watchface\n                            </button>\n                        </form>\n                    </div>\n\n                    <div ng-if="loading" id="pleasewait">\n                        <h1 class="text-center">\n                            Please Wait...\n                            <loader/>\n                        </h1>\n                    </div>\n\n                    <div ng-if="watchfaceForm.success" id="thankyou">\n                        <h1>Thank you!</h1>\n                        <p>\n                            Your watchface was received and we will notify you\n                            with next steps shortly.\n                        </p>\n\n                        <p>\n                            <a id="watchfacelink" ui-sref="facer.watchface({watchface: watchfaceForm.watchfaceId})">See your watchface</a>\n                        </p>\n\n                        <a id="thankyou" href ng-click="reset()">Submit another watchface?</a>\n                    </div>\n\n                    <div ng-if="watchfaceForm.failure" id="error">\n                        <h1>Uh Oh...</h1>\n\n                        <p>\n                            It looks like there was an error submitting your\n                            watchface. We have been notified and are looking\n                            into the issue.\n                        </p>\n\n                        <a id="thankyou" href ng-click="reset()">Try again?</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},85088:e=>{var n="/html/user-account.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <div class="row">\n        <div class="col-md-6 col-md-offset-3">\n            <div ng-if="googleIoWatchfaceClaimed" class="alert alert-success text-center" role="alert">\n                <b>Your watchface from Google I/O has been claimed!</b>\n                <br/>\n                To continue to your watchfaces, please fill out your profile\n                below.\n            </div>\n\n            <a ui-sref="facer.user.edit" class="text-link">Back to Edit Profile</a>\n\n            <h1>Manage Account</h1>\n\n            <div id="signup_container">\n                <br/>\n                <div ng-if="!lastLoginType.includes(\'-sso\')">\n                    <h4>Account Settings</h4>\n                    <div class="panel panel-default">\n                        <div class="panel-body">\n                            <form id="edit-form" ng-submit="updateProfile()" data-toggle="validator">\n                                <div class="form-group">\n                                    <label for="inputName">Email</label>\n                                    <input name="email" type="text" class="form-control" id="email" placeholder="Your email address" data-minlength="3" ng-model="profile.email" required/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n\n                                <div ng-if="profile.error" class="submit-error">\n                                    {{profile.error}}\n                                </div>\n\n                                <button type="submit" class="btn btn-default btn-primary">\n                                    Update\n                                </button>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n\n                <br/>\n                <h4>Products</h4>\n                <div feature-id="premium" ng-show="accessible" class="panel panel-default premium-panel premium-blue">\n                    <div class="panel-body">\n                        <subscription-manager type="panel" product="All Access"></subscription-manager>\n                    </div>\n                </div>\n\n                <div feature-id="premium" ng-show="accessible" class="panel panel-default premium-panel creator-pro-panel">\n                    <div class="panel-body">\n                        <subscription-manager type="panel" product="Creator Pro"></subscription-manager>\n                    </div>\n                </div>\n            </div>\n\n            <div ng-show="showUpdatePaymentInfoButton()" class="panel panel-default">\n                <div class="panel-body">\n                    <div class="form-group">\n                        <label>Payment Settings</label>\n                    </div>\n\n                    <button ng-click="updatePaymentInfo()" class="btn btn-default" ng-disabled="updatePaymentInfoLoading">\n                        {{ updatePaymentInfoLoading ? \'Loading...\' : \'Update\n                        Payment Info\' }}\n                    </button>\n                </div>\n            </div>\n\n            <div ng-if="!lastLoginType.includes(\'-sso\')">\n                <br/>\n                <h4>Other Options</h4>\n\n                <div class="panel panel-default">\n                    <div class="panel-body">\n                        <div class="form-group">\n                            <label>Change Password</label>\n                        </div>\n\n                        <div ng-if="profile.error" class="submit-error">\n                            {{profile.error}}\n                        </div>\n\n                        <button ng-click="changePassword()" class="btn btn-default">\n                            Change my password\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <div class="panel panel-default">\n                <div class="panel-body">\n                    <div class="form-group">\n                        <label>Delete Account</label>\n                        <br/>\n                        <small>WARNING: This action cannot be undone!</small>\n                    </div>\n\n                    <div ng-if="profile.error" class="submit-error">\n                        {{profile.error}}\n                    </div>\n\n                    <button ng-click="deleteAccount()" class="btn btn-danger">\n                        Delete my account\n                    </button>\n                </div>\n            </div>\n\n            <br/>\n            <br/>\n            <br/>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},94075:e=>{var n="/html/user-edit.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="user-profile user-profile-edit">\n    <div class="container user-profile-edit__alerts">\n        <div ng-if="googleIoWatchfaceClaimed" class="alert alert-success text-center" role="alert">\n            <b>Your watchface from Google I/O has been claimed!</b>\n            <br/>\n            To continue to your watchfaces, please fill out your profile below.\n        </div>\n    </div>\n\n    <div class="container user-profile-edit__shell">\n        <div class="banner-wrapper user-profile-edit__banner-wrapper">\n            <div class="banner user-profile-edit__banner" ng-class="{\'empty-banner\': !profile.coverImage}" ng-style="profile.coverImage && {\'background-image\': \'url(\' + profile.coverImage + \')\'}">\n                <div class="user-profile-edit__cover-actions" ng-show="accessible" feature-id="user-cover-image">\n                    <label for="cover" class="user-profile-edit__cover-upload">\n                        <span class="user-profile-edit__media-action">\n                            Change cover\n                        </span>\n                        <input ng-if="!$root.page.hasNativePhotoUploadBridge()" id="cover" type="file" accept="image/jpeg,image/jpg,image/png" style="display: none" upload="cover"/>\n                        <div ng-if="$root.page.hasNativePhotoUploadBridge()" ios-upload="cover" id="cover" class="ios-upload-overlay"></div>\n                    </label>\n                </div>\n            </div>\n\n            <div class="user-profile-edit__hero">\n                <div class="user-profile-edit__hero-inner">\n                    <div class="user-profile-edit__avatar-upload">\n                        <div class="user-profile-edit__avatar" ng-style="{\'background-image\': \'url(\' + ((profile.avatar) || \'img/avatar.png\') + \')\'}">\n                        </div>\n                        <input ng-if="!$root.page.hasNativePhotoUploadBridge()" id="avatar" type="file" accept="image/jpeg,image/jpg,image/png" style="display: none" upload="avatar"/>\n                        <label ng-if="!$root.page.hasNativePhotoUploadBridge()" for="avatar" class="user-profile-edit__avatar-trigger">\n                            <span class="user-profile-edit__media-action">\n                                Change avatar\n                            </span>\n                        </label>\n                        <div ng-if="$root.page.hasNativePhotoUploadBridge()" ios-upload="avatar" id="avatar" class="user-profile-edit__avatar-trigger">\n                            <span class="user-profile-edit__media-action">\n                                Change avatar\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class="container user-profile-edit__content">\n        <div class="row">\n            <div class="col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">\n                <div class="user-profile-edit__intro">\n                    <h1>Edit Profile</h1>\n                    <p>Tell the Facer community who you are</p>\n                </div>\n\n                <form id="edit-form" class="user-profile-edit__form" ng-submit="updateProfile()" data-toggle="validator">\n                    <div class="form-group">\n                        <label for="name">Name</label>\n                        <input name="name" type="text" class="form-control" id="name" placeholder="Your name" data-minlength="3" ng-model="profile.name" required/>\n                        <div class="help-block with-errors"></div>\n                    </div>\n\n                    <div class="form-group" ng-show="accessible" feature-id="user-url-slug">\n                        <label for="urlSlug">Profile URL</label>\n                        <div class="input-group user-profile-edit__url-group">\n                            <span class="input-group-addon" id="profile-url-prefix">\n                                https://www.facer.io/u/\n                            </span>\n                            <input name="urlSlug" type="text" class="form-control" id="urlSlug" ng-model="profile.urlSlug" placeholder="Reserve a url for your profile"/>\n                        </div>\n                        <div class="help-block with-errors"></div>\n                    </div>\n\n                    <div class="form-group">\n                        <label for="bio">Bio</label>\n                        <textarea rows="4" name="bio" class="form-control" id="bio" ng-model="profile.bio" placeholder="A quick bio"></textarea>\n                        <div class="help-block with-errors"></div>\n                    </div>\n\n                    <div class="form-group">\n                        <label id="country-label">Country</label>\n                        <p id="country-help" class="user-profile-edit__helper">\n                            Optional. Shown on your public profile and watchface details.\n                        </p>\n                        <country-select ng-model="profile.country" countries="countries" loading="countriesLoading" load-error="countriesLoadError" retry="loadCountries(true)" aria-labelledby="country-label" aria-describedby="country-help"></country-select>\n                    </div>\n\n                    <div class="user-profile-edit__section">\n                        <div class="user-profile-edit__section-header">\n                            <h2>Social accounts</h2>\n                            <p class="user-profile-edit__helper">Add your website and handles so people can follow your work.</p>\n                        </div>\n\n                        <div class="form-group">\n                            <label for="url">Website</label>\n                            <input name="url" type="url" class="form-control" id="url" ng-model="profile.url" placeholder="Optional website or portfolio"/>\n                            <div class="help-block with-errors"></div>\n                        </div>\n\n                        <div class="row">\n                            <div class="col-sm-6">\n                                <div class="form-group">\n                                    <label for="instagramHandle">Instagram Handle</label>\n                                    <input name="instagramHandle" type="text" class="form-control" id="instagramHandle" placeholder="Your Instagram Handle" data-minlength="3" ng-model="profile.instagramHandle"/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n                            </div>\n\n                            <div class="col-sm-6">\n                                <div class="form-group">\n                                    <label for="facebookHandle">Facebook Handle</label>\n                                    <input name="facebookHandle" type="text" class="form-control" id="facebookHandle" placeholder="Your Facebook Handle" data-minlength="3" ng-model="profile.facebookHandle"/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n                            </div>\n\n                            <div class="col-sm-6">\n                                <div class="form-group">\n                                    <label for="twitter_handle">X (formerly Twitter)</label>\n                                    <input name="twitter_handle" type="text" class="form-control" id="twitter_handle" placeholder="Your X Handle" data-minlength="3" ng-model="profile.twitter_handle"/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n                            </div>\n\n                            <div class="col-sm-6">\n                                <div class="form-group">\n                                    <label for="dribbbleHandle">Dribbble Handle</label>\n                                    <input name="dribbbleHandle" type="text" class="form-control" id="dribbbleHandle" placeholder="Your Dribbble Handle" data-minlength="3" ng-model="profile.dribbbleHandle"/>\n                                    <div class="help-block with-errors"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div ng-if="profile.error" class="submit-error">\n                        {{profile.error}}\n                    </div>\n\n                    <div class="user-profile-edit__actions">\n                        <button type="submit" class="f-btn-rounded-primary-xl user-profile-edit__submit" ng-disabled="loading">\n                            {{loading ? \'Updating...\' : \'Update Profile\'}}\n                        </button>\n\n                        <button type="button" class="f-btn-ghost-primary-xl user-profile-edit__cancel" ng-click="cancelEdit()" ng-disabled="loading">\n                            Cancel\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},89907:e=>{var n="/html/user-list.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<header ui-view="header" class="app-header-wrapper"></header>\n\n<div class="container">\n    <div class="user-list-title">{{userListName}}</div>\n    <div class="user-list-subtitle">{{userListDescription}}</div>\n    <div class="row">\n        <div ng-repeat="user in userListUsers">\n            <div class="clearfix" ng-if="$index % 3 == 0"></div>\n            <div class="col-sm-4">\n                <div class="user-list-panel">\n                    <a class="user-list-banner" style="background-image:url({{user.bannerImage}})" ng-class="{\'user-list-empty-banner\': !user.bannerImage}" user-profile-link="user" aria-label="{{user.name}} Watch Faces"></a>\n                    <a class="user-list-icon" style="background-image:url({{user.avatar}})" user-profile-link="user" aria-label="{{user.name}} Watch Faces"></a>\n                    <a class="user-list-name" user-profile-link="user">\n                        {{user.name}}\n                    </a>\n                    <div class="user-list-info">\n                        <div class="user-list-info-label">FACES</div>\n                        <div class="user-list-info-data">\n                            {{userFaceCount[user.id]|largeNumber}}\n                        </div>\n                    </div>\n                    <div class="user-list-info">\n                        <div class="user-list-info-label">FOLLOWERS</div>\n                        <div class="user-list-info-data">\n                            {{user.followerCount|largeNumber}}\n                        </div>\n                    </div>\n                    <div class="user-list-follow-button">\n                        <follow-button class="follow-button-inline-block" user="user"></follow-button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<footer ui-view="footer"></footer>\n')}]),e.exports=n},4058:e=>{var n="/html/user.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="user-profile">\n    <div class="container user-profile__banner-shell">\n        <div class="banner-wrapper">\n            <div class="banner" ng-class="{\'empty-banner\': !user.bannerImage}" ng-style="user.bannerImage && {\'background-image\': \'url(\' + user.bannerImage + \')\'}"></div>\n        <div ng-if="user.isWatchmakerSeries()" class="verified-ribbon hidden-xs">\n            <div class="row">\n                <div class="col-md-3 hidden-sm"></div>\n                <div class="col-md-9">WATCHMAKER SERIES</div>\n            </div>\n        </div>\n        </div>\n    </div>\n    <div class="container">\n        <div ng-if="beta" class="alert alert-success text-center" role="alert">\n            Thanks for signing up for the beta. You\'ll receive an email with\n            further instructions on how to access the new <b>Facer Creator</b>.\n        </div>\n\n        <div ng-if="googleIoWatchfaceClaimed" class="alert alert-success text-center" role="alert">\n            <b>Your watchface from Mobile World Congress 2017 has been\n                claimed!</b>\n        </div>\n\n        <div ng-show="user" class="row fade">\n            <div class="col-xs-12">\n                <div class="user-details-wrapper row">\n                    <div class="box-container user-details col-md-3 col-sm-8 col-sm-offset-2 col-md-offset-0 col-xs-12">\n                        <div class="row">\n                            <div class="col-xs-4 col-sm-4 col-md-12">\n                                <div class="row">\n                                    <div class="col-md-8 col-md-offset-2 col-sm-12 col-xs-12 col-xs-offset-1">\n                                        <div class="artist" role="img" ng-attr-aria-label="{{ user.name | profilePictureAlt }}" style="background-image: url(\'{{user.avatarLarge}}\')" square-fit="true"></div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="col-xs-8 col-sm-8 col-md-12">\n                                <div class="row">\n                                    <div id="userStats" class="col-md-12 col-md-offset-0 col-sm-12 col-xs-12">\n                                        <div class="user-stat">\n                                            <p class="user-stat-value">\n                                                {{user.watchfaceCount|largeNumber}}\n                                            </p>\n                                            <small>FACES</small>\n                                        </div>\n                                        <div class="user-stat">\n                                            <p class="user-stat-value">\n                                                {{user.followerCount|largeNumber}}\n                                            </p>\n                                            <small>FOLLOWERS</small>\n                                        </div>\n                                        <div class="user-stat">\n                                            <p class="user-stat-value">\n                                                {{user.followingCount|largeNumber}}\n                                            </p>\n                                            <small>FOLLOWING</small>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="row">\n                            <div class="col-xl-12 col-md-12 col-md-offset-0 col-sm-8 col-sm-offset-4">\n                                <follow-button user="user"></follow-button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class="col-md-5 col-sm-9 col-sm-offset-2 col-md-offset-0 col-xs-12 user-description">\n                        <div class="username-heading">\n                            <span class="badge-string">\n                                <h1 class="username badge-string-content">{{user.name}}</h1>\n                                <div class="badge-string-icon">\n                                    <user-badge user="user"></user-badge>\n                                    <span ng-show="page.isMobile()">&nbsp;</span>\n                                    <div ng-show="isCurrentUser || showRestorePurchaseButton() || canReportUser() || $root.isAdmin || accessible" class="edit-profile">\n                                        <div class="btn-icon dropdown">\n                                            <button type="button" class="user-actions-menu__trigger dropdown-toggle" id="watchOptions" data-toggle="dropdown" aria-expanded="false">\n                                                <i class="icon-settings"></i>\n                                            </button>\n\n                                            <ul class="dropdown-menu profile-menu user-actions-menu" role="menu" aria-labelledby="watchOptions">\n                                                <li ng-if="isCurrentUser" class="profile-menu__item">\n                                                    <a role="menuitem" ui-sref="facer.user.edit({user: user.id})">\n                                                        <facer-icon icon="pencil"></facer-icon>\n                                                        Edit Profile\n                                                    </a>\n                                                </li>\n                                                <li ng-if="isCurrentUser" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="logOut()">\n                                                        <facer-icon icon="logout"></facer-icon>\n                                                        Logout\n                                                    </button>\n                                                </li>\n                                                <li ng-if="showRestorePurchaseButton()" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="restorePurchases()">\n                                                        Restore Purchases\n                                                    </button>\n                                                </li>\n                                                <li ng-if="canReportUser()" class="profile-menu__item">\n                                                    <a role="menuitem" target="_blank" ng-href="{{ reportUserEmailLink }}">\n                                                        Report this user\n                                                    </a>\n                                                </li>\n                                                <li ng-if="canReportUser()" user-block-button="user" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="onClick()">\n                                                        {{getBlockAction()}}\n                                                    </button>\n                                                </li>\n                                                <li ng-if="$root.isAdmin || accessible" class="divider-horizontal"></li>\n                                                <li ng-if="$root.isAdmin || accessible" class="profile-menu__section-header">\n                                                    <span>Admin</span>\n                                                </li>\n                                                <li ng-if="$root.isAdmin || accessible" class="profile-menu__item">\n                                                    <span class="profile-menu__info">\n                                                        User ID:\n                                                        <button type="button" class="profile-menu__info-value" ng-click="copyUserId($event)">\n                                                            {{ userIdCopied ? \'Copied!\' : user.id }}\n                                                        </button>\n                                                    </span>\n                                                </li>\n                                                <li ng-if="$root.isAdmin" class="profile-menu__item">\n                                                    <span class="profile-menu__info">\n                                                        Email:\n                                                        <span ng-if="!contactInfo" class="profile-menu__info-mask">*****</span>\n                                                        <button type="button" ng-if="!contactInfo" class="profile-menu__info-show" ng-click="revealContactInfo($event)">\n                                                            Show\n                                                        </button>\n                                                        <button type="button" ng-if="contactInfo" class="profile-menu__info-value" ng-click="copyContactInfo($event)">\n                                                            {{ contactInfoCopied ? \'Copied!\' : contactInfo }}\n                                                        </button>\n                                                    </span>\n                                                </li>\n                                                <li ng-if="$root.isAdmin" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="user.transferWatchface()">\n                                                        Transfer Watchface\n                                                        to User\n                                                    </button>\n                                                </li>\n                                                <li ng-if="$root.isAdmin && !user.isPremium" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="user.markAsPremiumDesigner(true)">\n                                                        Mark as Facer Creator Partner\n                                                    </button>\n                                                </li>\n                                                <li ng-if="$root.isAdmin && user.isPremium" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-click="user.markAsPremiumDesigner(false)">\n                                                        Remove from Facer Creator Partner list\n                                                    </button>\n                                                </li>\n                                                <li feature-id="suspend-user" ng-show="accessible" class="divider-horizontal"></li>\n                                                <li feature-id="suspend-user" ng-show="accessible" class="profile-menu__item">\n                                                    <button type="button" role="menuitem" ng-if="!user.isSuspended" class="profile-menu__danger-action" ng-click="user.suspend()">\n                                                        Suspend User\n                                                    </button>\n                                                    <button type="button" role="menuitem" ng-if="user.isSuspended" class="profile-menu__danger-action" ng-click="user.unsuspend()">\n                                                        Unsuspend User\n                                                    </button>\n                                                </li>\n                                            </ul>\n                                        </div>\n                                    </div>\n                                </div>\n                            </span>\n                        </div>\n                        <p class="user-category" ng-if="user.category">\n                            <span ng-switch="user.category">\n                                <span ng-switch-when="PARTNER">\n                                    Facer Creator Partner\n                                </span>\n                                <span ng-switch-when="BRAND">\n                                    Official Brand\n                                </span>\n                            </span>\n                        </p>\n                        <p class="user-country" ng-if="user.countryName">\n                            <img class="user-country__flag" ng-src="{{user.countryFlagUrl}}" alt=""/>\n                            <span>{{user.countryName}}</span>\n                        </p>\n                        <p class="bio" ng-bind="user.bio"></p>\n\n                        <profile-links user="user"></profile-links>\n                    </div>\n\n                    <div ng-if="!page.isMobile()" class="col-md-3 hidden-sm hidden-xs current-watch">\n                        <watchface ng-if="currentWatchface.isLive()" type="list" watchface-id="currentWatchface" autorun="true" title-label="Currently Wearing:" class="disable-curtain"></watchface>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div ng-class="{\'container\': !$root.page.isMobile()}">\n        <div class="col-xs-12">\n            <div class="user-profile__content-shell">\n                <div class="user-profile__content-tabs">\n                    <button type="button" class="user-profile__content-tab" ng-class="{\'is-active\': isProfileTabActive(\'designs\')}" ng-click="selectProfileTab(\'designs\')" aria-pressed="{{ isProfileTabActive(\'designs\') }}">\n                        <facer-icon icon="design" aria-hidden="true"></facer-icon>\n                        <span>Designs</span>\n                    </button>\n\n                    <button type="button" class="user-profile__content-tab" ng-class="{\'is-active\': isProfileTabActive(\'looks\')}" ng-click="selectProfileTab(\'looks\')" aria-pressed="{{ isProfileTabActive(\'looks\') }}">\n                        <facer-icon icon="looks" aria-hidden="true"></facer-icon>\n                        <span>Looks</span>\n                    </button>\n\n                    <button type="button" class="user-profile__content-tab" ng-class="{\'is-active\': isProfileTabActive(\'favorites\')}" ng-click="selectProfileTab(\'favorites\')" aria-pressed="{{ isProfileTabActive(\'favorites\') }}">\n                        <i class="glyphicon glyphicon-heart" aria-hidden="true"></i>\n                        <span>Favorites</span>\n                    </button>\n                </div>\n\n                <loader ng-if="isProfileTabPending()"></loader>\n\n                <div class="user-profile__content-pane user-profile__content-pane--designs" ng-show="isProfileTabActive(\'designs\')" aria-hidden="{{ !isProfileTabActive(\'designs\') }}">\n                    <div class="col-xs-12" ng-if="collections && collections.length > 0 && !$root.page.isMobile()" show-more="collections">\n                        <div ng-class="{\'show-some\': !showAllCollections}">\n                            <div class="col-md-4 col-sm-4 col-xs-6" show-more-target ng-repeat="collection in collections">\n                                <collection collection="collection" type="grid"></collection>\n                            </div>\n                        </div>\n                        <div ng-show="couldShowMore" class="show-more-link">\n                            <a ng-click="showAllCollections=!showAllCollections" class="text-link">\n                                {{showAllCollections ? \'SHOW LESS\' : \'SHOW MORE\'}}\n                            </a>\n                        </div>\n                    </div>\n\n                    <div ng-if="collections && collections.length > 0 && $root.page.isMobile()" class="collection-slider-container">\n                        <div class="collection-slider">\n                            <div class="collection-slider-item" ng-repeat="collection in collections.slice(0, 20)">\n                                <collection collection="collection" type="grid"></collection>\n                            </div>\n                        </div>\n                    </div>\n\n                    <hr ng-if="collections && collections.length > 0" class="user-collections-divider"/>\n\n                    <loader ng-if="loading || collectionsLoading"></loader>\n\n                    <div id="upload-cta" ng-if="showDesignsEmptyState() && isCurrentUser">\n                        <span ng-show="!page.isNativeAppleWatchContext()">You haven\'t published any designs yet.\n                            <a ui-sref="facer.editor" target="_blank">\n                                Create one today!</a></span>\n                        <span id="applewatch-upload-cta" ng-show="page.isNativeAppleWatchContext()">\n                            Publish your first design<br/>from the Apple Watch app.\n                            <br/><br/>\n                            <a target="_blank" href="https://help.facer.io/hc/en-us/articles/360055127093" class="btn btn-lg btn-primary">\n                                Show me how!\n                            </a>\n                        </span>\n                    </div>\n\n                    <div class="user-empty-follow-message" ng-if="showDesignsEmptyState() && !isCurrentUser">\n                        <p class="user-empty-follow-message__lead">\n                            {{(user.name || \'This creator\') + " hasn\'t released faces for your smartwatch yet."}}\n                        </p>\n                        <p class="user-empty-follow-message__cta">\n                            Follow them to be notified when their first faces are released!\n                        </p>\n                    </div>\n\n                    <div id="watchface-list" class="row" ui-view="watchfaces"></div>\n                    <endless margin="0" trigger="showMoreWatchfaces()" end-on="done" ready-when="isProfileTabActive(\'designs\')" busy-when="loading || designsLoadingMore"/>\n                    <loader ng-if="designsLoadingMore"></loader>\n                </div>\n\n                <section class="user-profile__content-pane user-profile__content-pane--looks user-looks" ng-if="isProfileTabActive(\'looks\')">\n                    <loader ng-if="looksLoading"></loader>\n\n                    <div class="user-looks__grid" ng-if="!looksLoading && looks.length">\n                        <a class="user-looks__card" ng-repeat="look in looks track by look.id" ui-sref="facer.looks.detail({looks: look.id})" aria-label="Open look featuring {{ look.watchfaceTitle }}">\n                            <img class="user-looks__media" ng-if="!look.media.isAnimated" ng-src="{{ look.media.url }}" alt="{{ look.watchfaceTitle }}"/>\n\n                            <video class="user-looks__media" ng-if="look.media.isAnimated" autoplay muted loop playsinline ng-attr-poster="{{ look.media.posterUrl }}">\n                                <source video-src="{{ look.media.url }}" type="video/mp4"/>\n                            </video>\n\n                            <div class="user-looks__overlay">\n                                <div class="user-looks__watchface">\n                                    <img class="user-looks__watchface-preview" ng-if="look.watchfacePreviewUrl" ng-src="{{ look.watchfacePreviewUrl }}" alt="{{ look.watchfaceTitle }}"/>\n                                    <div class="user-looks__watchface-preview user-looks__watchface-preview--placeholder" ng-if="!look.watchfacePreviewUrl">\n                                        {{ look.watchfaceTitle.charAt(0) }}\n                                    </div>\n\n                                    <div class="user-looks__watchface-copy">\n                                        <span class="user-looks__watchface-title">\n                                            {{ look.watchfaceTitle }}\n                                        </span>\n                                        <span class="user-looks__watchface-device">\n                                            On {{ look.deviceName }}\n                                        </span>\n                                    </div>\n                                </div>\n\n                                <div class="user-looks__meta">\n                                    <span class="user-looks__meta-pill">\n                                        <i class="glyphicon glyphicon-heart"></i>\n                                        {{ look.likeCount }}\n                                    </span>\n                                    <span class="user-looks__meta-time">\n                                        {{ look.formattedCreatedAt }}\n                                    </span>\n                                </div>\n                            </div>\n                        </a>\n                    </div>\n\n                    <div class="show-more-link" ng-if="shouldShowMoreLooks()">\n                        <a ng-click="showMoreLooks()" class="text-link">\n                            SHOW MORE\n                        </a>\n                    </div>\n\n                    <loader ng-if="looksLoadingMore"></loader>\n\n                    <div id="upload-cta" ng-if="showLooksEmptyState() && isCurrentUser">\n                        <span>You haven\'t shared any looks yet.</span>\n                    </div>\n\n                    <div class="user-empty-follow-message" ng-if="showLooksEmptyState() && !isCurrentUser">\n                        <p class="user-empty-follow-message__lead">\n                            {{(user.name || \'This user\') + " hasn\'t shared any looks yet."}}\n                        </p>\n                    </div>\n                </section>\n\n                <section class="user-profile__content-pane user-profile__content-pane--favorites" ng-if="isProfileTabActive(\'favorites\')">\n                    <div ng-show="favoriteWatchfaces.length" class="watchfaces-wrapper">\n                        <div class="watchfaces-inner-wrapper">\n                            <div ng-repeat="watchface in favoriteWatchfaces track by watchface.uid" class="{{watchfaceColumnSize && (\'col-md-\' + watchfaceColumnSize) || \'col-md-2-4 col-md-lg-3\'}} col-sm-4 col-xs-6 watchface-wrapper">\n                                <watchface watchface-id="watchface" type="list" search-query="search" search-ranking="$index + 1"></watchface>\n                            </div>\n                        </div>\n                    </div>\n\n                    <endless margin="0" trigger="showMoreFavoriteWatchfaces()" end-on="favoritesDone"></endless>\n                    <loader ng-if="favoritesLoading"></loader>\n\n                    <div id="upload-cta" ng-if="showFavoritesEmptyState() && isCurrentUser">\n                        <span>You haven\'t favorited any watch faces yet.</span>\n                    </div>\n\n                    <div class="user-empty-follow-message" ng-if="showFavoritesEmptyState() && !isCurrentUser">\n                        <p class="user-empty-follow-message__lead">\n                            {{(user.name || \'This user\') + " hasn\'t favorited any watch faces yet."}}\n                        </p>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>\n    <loader ng-if="loadingUser"></loader>\n</div>\n')}]),e.exports=n},31184:e=>{var n="/html/video-uploader.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="watchface-media">\n    <input id="promoVideoUpload" type="file"/>\n</div>\n')}]),e.exports=n},18930:e=>{var n="/html/watch-model-list-menu.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<ul class="dropdown-menu watch-model-list-menu {{menuClass}}" role="menu" aria-labelledby="dropdownMenu1">\n    <li class="watch-model-list-filters" ng-click="$event.stopPropagation()">\n        <div class="watch-model-list-filters__inner">\n            <div class="watch-model-list-filters__header">\n                <span class="watch-model-list-filters__title">DEVICE SELECT</span>\n                <a href class="watch-model-list-filters__clear" ng-if="getActiveFilterCount() > 0" ng-click="$event.preventDefault(); clearFilters()">Clear filters</a>\n            </div>\n            <div class="watch-model-list-filters__controls">\n                <input type="text" class="form-control input-sm watch-model-list-filters__search" placeholder="Search model or brand" ng-model="searchText" ng-click="$event.stopPropagation()">\n                <div class="watch-model-list-filters__group watch-model-list-filters__group--brand">\n                    <select class="form-control input-sm" ng-model="selectedBrand" ng-click="$event.stopPropagation()">\n                        <option value="">All brands</option>\n                        <option ng-repeat="brandName in brandOptions" value="{{brandName}}">{{brandName}}</option>\n                    </select>\n                </div>\n            </div>\n        </div>\n    </li>\n    <li class="watch-model-list-menu__grid-row">\n        <div class="watch-model-list-menu__grid">\n            <div ng-repeat="watchTypeOption in visibleWatches" class="watch-model-list-menu__grid-item" role="presentation">\n                <a class="watch-select watch-model-list-menu__card" ng-class="{\'is-selected\': isSelected(watchTypeOption), \'is-labs\': watchTypeOption.isLab}" ng-click="handleSelect(watchTypeOption)" title="{{showTitleTooltip ? watchTypeOption.model : \'\'}}">\n                    <span class="watch-model-list-menu__card-flags" ng-if="watchTypeOption.adminOnly || watchTypeOption.isLab">\n                        <span class="watch-model-list-menu__card-flag watch-model-list-menu__card-flag--labs" ng-if="watchTypeOption.isLab">\n                            Labs\n                        </span>\n                        <span class="watch-model-list-menu__card-flag" ng-if="watchTypeOption.adminOnly">\n                            Admin\n                        </span>\n                    </span>\n                    <div class="watch-model-list-menu__card-preview-wrap" ng-if="showPreviewSkin !== false">\n                        <div class="watch-container {{watchTypeOption.id}} watch-skin-preview watch-model-list-menu__card-preview"></div>\n                    </div>\n                    <div class="watch-model-list-menu__card-copy">\n                        <span class="watch-model-list-menu__card-brand">{{watchTypeOption.make}}</span>\n                        <span class="watch-model-list-menu__card-title" title="{{watchTypeOption.model}}">{{getModelLabel(watchTypeOption)}}</span>\n                        <span class="watch-model-list-menu__card-year">{{getReleaseYear(watchTypeOption)}}</span>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </li>\n    <li class="dropdown-header text-center watch-model-list-menu__empty-state" ng-if="!visibleWatches.length">\n        No matching watches\n    </li>\n</ul>\n')}]),e.exports=n},21090:e=>{var n="/html/watch-skin-list.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div>\n    <i id="watchSelect" class="icon-clock-1 dropdown-toggle" data-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="true"></i>\n    <watch-model-list-menu watch-brands="watchBrands" selected-watch-id="getDisplayFaceClass()" on-select="setWatchType(watchTypeOption)" hide-ios="true" show-preview-skin="false"></watch-model-list-menu>\n</div>\n')}]),e.exports=n},48863:e=>{var n="/html/watchface-admin-toolbar.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-if="showReviewToolbar()" class="toolbar">\n    <button ng-if="!showNotInContentReviewLabel()" ng-class="{\'disabled\': addButtonDisabled()}" ng-click="addToCollection(null, {admin: true})" title="Add to Collection" class="btn btn-success">\n        +\n    </button>\n    <button ng-if="!showNotInContentReviewLabel()" ng-class="{\'disabled\': clearButtonDisabled()}" ng-click="adminReview(\'cleared\')" title="Ignore" class="btn">\n        {{ getClearButtonText() || \'CLEAR\' }}\n    </button>\n    <button ng-if="showNotInContentReviewLabel()" class="disabled btn btn-default">\n        {{ getNotInContentReviewText() }}\n    </button>\n</div>\n\n<div ng-if="showQaToolbar()" class="toolbar">\n    <a ng-if="showQaInspectButton()" ui-sref="facer.watchface({watchface: watchface.id})" target="_blank" title="QA" class="btn btn-default">\n        <i class="icon-eye"></i>\n    </a>\n    <button ng-if="showQaApproveButton()" ng-click="qaApprove()" ng-class="{\'disabled\': !canQaApprove() || watchface.isQaApproved()}" title="Approve" class="btn btn-success">\n        {{ getQaApproveButtonText() }}</button><br/><br/>\n    <button ng-if="showQaApproveButton()" ng-click="qaApprove(null, { silentRelease: true })" ng-class="{\'disabled\': !canQaApprove() || watchface.isQaApproved()}" title="Approve" class="btn btn-success">\n        {{ getQaApproveButtonText() }} (no feed item)</button><br/><br/>\n    <button ng-if="showQaRejectButton()" ng-click="qaReject()" ng-class="{\'disabled\': qaRejectButtonDisabled()}" title="Reject" class="btn btn-danger">\n        {{ getQaRejectButtonText() || \'REJECT\' }}\n    </button>\n    <button ng-if="showNotInReviewLabel()" class="disabled btn btn-default">\n        NOT IN REVIEW\n    </button>\n</div>\n\n<div ng-if="showPlatformToolbar()" class="toolbar">\n    <button ng-class="{\'disabled\': rejectButtonDisabled()}" ng-click="reject()" title="Reject" class="btn btn-danger">\n        {{ getRejectButtonText() || \'REMOVE\' }}\n    </button>\n    <button ng-if="showPlatformClearButton()" ng-click="adminReview(\'in-queue\')" title="Reject" class="btn">\n        CLEAR\n    </button>\n</div>\n\n<div class="gpid-details" ng-if="showGooglePlayIdInfo()">\n    <small class="gpid" ng-if="watchface.googlePlayId">\n        Google Play ID: <b>{{watchface.googlePlayId}}</b> &nbsp;<a ng-if="!watchface.isRejected()" ng-click="updatePlatformMappingInfo()" class="text-link">Edit</a>\n    </small>\n    <small ng-if="!watchface.googlePlayId" class="add-gpid text-link" ng-click="updatePlatformMappingInfo()">\n        Add Google Play ID\n    </small>\n</div>\n')}]),e.exports=n},51987:e=>{var n="/html/watchface-comments.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,"\x3c!-- Replaced by /html/comments-thread.component.html — kept so old $templateCache keys do not break cold caches during deploy. --\x3e\n<div ng-include=\"'/html/comments-thread.component.html'\"></div>\n")}]),e.exports=n},75454:e=>{var n="/html/watchface-component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="watchface-hover-wrapper" ng-mouseenter="hovered=true" ng-mouseleave="hovered=false" ng-class="{\'no-skin-watchface\': !showWatchSkin(), \'square-watchface\': loaded && !isCircular(), \'circular-watchface\': loaded && isCircular()}">\n    <div ng-if="!loaded" class="loading-curtain fade-in-out">\n        <center ng-if="watchfaceNotFound">\n            {{error || "Watchface not found"}}\n        </center>\n        <loader ng-if="!watchfaceNotFound"></loader>\n    </div>\n\n    <div ng-if="showWatchSkin()" class="watch-sizing-wrapper opacity-fade" ng-class="{\'opacity-show\': loaded}">\n        <a target="_blank" ui-sref="facer.watchface({watchface: watchface.id, watchModel: getDisplayFaceId()})" disable-link-if="!watchfaceLinkIsActive()" class="watch-container square disable-link {{getDisplayFaceClass()}}" ng-click="tapScreen(); trackSearchResultClick()" ng-attr-aria-label="{{ watchface.title | watchfaceDetailAlt:watchface.author.name }}">\n            <div class="watch-background"></div>\n            <div class="watch-shadow"></div>\n            <div class="watch-inner-container">\n                <canvas ng-if="!isStatic()" id="componentLiveCanvas" class="active"></canvas>\n                <div ng-if="isStatic()" title="{{watchface.title}}" class="watchface-image" ng-style="{\'background-image\': \'url(\' + getWatchfaceImage() + \')\'}"></div>\n            </div>\n        </a>\n        <canvas id="printCanvas{{scope.uid}}"></canvas>\n    </div>\n    <div ng-if="!showWatchSkin()" class="no-skin-watch-preview-wrapper no-skin-watch-container {{ getDisplayFaceClass() }} opacity-fade" ng-class="{\'ios-no-skin-watch-preview\': watchface.isIos(), \'opacity-show\': loaded}">\n        <canvas ng-if="!isStatic()" id="componentLiveCanvas" class="active"></canvas>\n        <a ng-if="isStatic()" target="_blank" ui-sref="facer.watchface({watchface: watchface.id})" class="watch-preview-link" disable-link-if="linksAreDisabled()" ng-click="trackSearchResultClick()" ng-attr-aria-label="{{ watchface.title | watchfaceDetailAlt:watchface.author.name }}">\n            <img ng-src="{{getWatchfaceImage()}}" draggable="false" alt="{{ watchface.title | watchfaceDetailAlt:watchface.author.name }}"/>\n        </a>\n        <canvas id="printCanvas{{scope.uid}}"></canvas>\n    </div>\n\n    <div class="embed-toolbar">\n        <div ng-if="showTools()" class="fade-in-out vertical-toolbar" ng-class="{\'hidden-sm hidden-xs\': !isEmbed() && !isHero()}">\n            <button ng-if="showDesktopSyncButton()" type="button" class="btn-icon watchface-desktop-sync-toolbar-button" ng-click="syncToDesktop($event)" aria-label="Sync to Desktop" title="Sync to Desktop">\n                <span class="watchface-desktop-sync-toolbar-button__icon"></span>\n            </button>\n            <div ng-if="canLike()" class="btn-icon selected">\n                <i ng-click="addToFavorites()" class="icon-heart" ng-class="{\'red-text\': isLiked()}"></i>\n            </div>\n            <div ng-if="canAddToCollection()" class="btn-icon">\n                <i ng-click="addToCollection()" class="icon-plus"></i>\n            </div>\n            <div ng-if="hasChime()" class="btn-icon">\n                <i ng-click="playChime()" class="feature-icon icon-sound" ng-class="{\'active\': isPlayingChime}"></i>\n            </div>\n            <div ng-show="canToggleDimMode()" class="btn-icon">\n                <i ng-click="toggleDimMode()" class="{{getDimModeButtonIcon()}}"></i>\n            </div>\n            <div ng-if="showPlayButton()" class="btn-icon">\n                <i ng-click="toggleSpeed()" class="{{getSpeedButtonIcon()}}"></i>\n            </div>\n            <div ng-if="showWatchList()" class="btn-icon watch-skin-list" anchored-portal="watchSkinMenu.open" portal-placement="right" portal-class="watch-skin-list watch-skin-list-portal">\n                <i id="watchSelect" class="icon-clock-1" type="button" aria-haspopup="true" ng-attr-aria-expanded="{{!!watchSkinMenu.open}}" ng-click="toggleWatchSkinMenu($event)"></i>\n                <anchored-portal-content ng-non-bindable>\n                    <watch-model-list-menu watch-brands="watchBrands" selected-watch-id="getDisplayFaceClass()" on-select="setWatchType(watchTypeOption); closeWatchSkinMenu()" truncate-length="25"></watch-model-list-menu>\n                </anchored-portal-content>\n            </div>\n            <div class="btn-icon dropdown scrollable dropup">\n                <i class="icon-settings dropdown-toggle" type="button" id="watchOptions" data-toggle="dropdown" aria-expanded="true"></i>\n\n                <ul ng-if="watchface" class="dropdown-menu" role="menu" aria-labelledby="watchOptions">\n                    <li ng-show="(watchface.isOwner() || isAdmin) && accessible" feature-id="watchface-stats" class="visible-md visible-lg">\n                        <a class="watch-select external-url-link" role="menuitem" target="_blank" ui-sref="facer.editor.insights({\'jump-to\': watchface.id, user: isAdmin ? watchface.author.id : null})">\n                            Show stats\n                        </a>\n                    </li>\n                    <li ng-if="!watchface.isAppleWatchfaceFile() && (watchface.isOwner() || isAdmin)">\n                        <a class="watch-select external-url-link" role="menuitem" target="_blank" ui-sref="facer.editWatchface({watchface: watchface.id})">\n                            <span class="list-content">\n                                Edit<span ng-if="watchface.face.get(\'draft\')">\n                                    Draft</span>\n                                <br/>\n                                <tiny ng-if="watchface.face.get(\'draft\')" class="text-muted">Last edited:\n                                    {{watchface.face.updatedAt|date:\'medium\'}}</tiny>\n                            </span>\n                        </a>\n                    </li>\n                    <li ng-if="watchface.isOwner() && watchface.face.get(\'draft\') && watchface.face.get(\'file\')" ng-class="{\'disabled\': loadingDiscardDraft}">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="discardDraft()" ng-disabled="loadingDiscardDraft">\n                            {{!loadingDiscardDraft ? \'Discard Draft\' :\n                            \'Discarding Draft...\'}}\n                        </button>\n                    </li>\n                    <li ng-if="watchface.isOwner()" ng-class="{\'disabled\': loadingDeleteWatchface}">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="deleteWatchface()" ng-disabled="loadingDeleteWatchface">\n                            {{!loadingDeleteWatchface ? \'Delete\' : \'Deleting watchface...\'}}\n                        </button>\n                    </li>\n                    <li ng-if="!watchface.isOwner()">\n                        <a class="watch-select" role="menuitem" target="_blank" rel="noopener noreferrer" ng-href="{{ reportWatchfaceFormLink }}" ng-click="handleExternalLink(reportWatchfaceFormLink, $event)">\n                            Report this watchface\n                        </a>\n                    </li>\n\n                    <li ng-if="loadingWatchfaceUpdate" class="disabled">\n                        <button type="button" class="watch-select" role="menuitem" disabled="disabled">\n                            Loading...\n                        </button>\n                    </li>\n\n                    <li ng-if="isAdmin" class="divider-horizontal"></li>\n                    <li ng-if="isAdmin" class="dropdown-header">\n                        Admin Actions\n                    </li>\n\n                    <li feature-id="universal-clone-watchface-access" ng-show="accessible && !loadingWatchfaceUpdate">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.adminClone()">\n                            Clone to my account...\n                        </button>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface">\n                        <a class="watch-select" role="menuitem" ui-sref="facer.importWatchface({ existingWatchface: watchface.id })">\n                            Import/Update Variant\n                        </a>\n                    </li>\n\n                    <li ng-if="isAdmin && !loadingWatchfaceUpdate">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="adminTweetWatchface()">\n                            Tweet this watchface...\n                        </button>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface && !loadingWatchfaceUpdate">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.prettyPrint()">\n                            Pretty Print\n                        </button>\n                    </li>\n                    <li ng-if="isAdmin && watchface && !loadingWatchfaceUpdate">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.prettyPrint({includeAllJsonFiles: true})">\n                            Pretty Print (include json files)\n                        </button>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface && !loadingWatchfaceUpdate && !watchface.isStatic">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="optimizeFaceFile()">\n                            Optimize Face File (old)\n                        </button>\n                    </li>\n                    <li ng-if="isAdmin && watchface && !loadingWatchfaceUpdate && !watchface.isStatic">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.optimize()">\n                            Optimize Face File (new)\n                        </button>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface && (watchface.face.get(\'optimizedDraft\') || watchface.face.get(\'optimizedFile\'))" ng-class="{\'disabled\': viewingDraft}">\n                        <a class="watch-select" role="menuitem" target="_blank" ui-sref="facer.editWatchface({watchface: watchface.id, usePublished: !watchface.useDraft() && \'1\', useOptimized: \'1\'})">\n                            Inspect optimized version\n                        </a>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface && watchface.googlePlayUrl">\n                        <a class="watch-select" ng-href="{{watchface.googlePlayUrl}}">\n                            Google Play Store Page\n                        </a>\n                    </li>\n\n                    <li ng-if="isAdmin && watchface && watchface.galaxyAppUrl">\n                        <a class="watch-select" ng-href="{{watchface.galaxyAppUrl}}">\n                            Galaxy App Store Page\n                        </a>\n                    </li>\n                    <li ng-if="isAdmin">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="updatePlatformMappingInfo()">\n                            Edit Platform Mapping Info\n                        </button>\n                    </li>\n                    <li ng-if="isAdmin && watchface.faceUrl">\n                        <a class="watch-select" ng-href="{{watchface.faceUrl}}" download>\n                            Download .face file\n                        </a>\n                    </li>\n                    <li ng-if="isAdmin && watchface.appleWatchfaceFileUrl">\n                        <a class="watch-select" ng-href="{{watchface.appleWatchfaceFileUrl}}" download>\n                            Download .watchface file\n                        </a>\n                    </li>\n                    <li ng-show="(accessible || (watchface && watchface.isOwner())) && watchface.fullPreviewImage" feature-id="universal-preview-image-access">\n                        <a class="watch-select" target="_blank" ng-href="{{watchface.fullPreviewImage}}">\n                            Download Preview Image\n                        </a>\n                    </li>\n                    <li ng-show="(accessible || (watchface && watchface.isOwner())) && watchface.fullPreviewImageDim" feature-id="universal-preview-image-access">\n                        <a class="watch-select" target="_blank" ng-href="{{watchface.fullPreviewImageDim}}">\n                            Download Preview Image (Dim)\n                        </a>\n                    </li>\n                    <li ng-show="(accessible || (watchface && watchface.isOwner())) && watchface.fullPreviewImageSquare" feature-id="universal-preview-image-access">\n                        <a class="watch-select" target="_blank" ng-href="{{watchface.fullPreviewImageSquare}}">\n                            Download Square Preview Image\n                        </a>\n                    </li>\n                    <li ng-show="(accessible || (watchface && watchface.isOwner())) && watchface.fullPreviewImageDimSquare" feature-id="universal-preview-image-access">\n                        <a class="watch-select" target="_blank" ng-href="{{watchface.fullPreviewImageDimSquare}}">\n                            Download Square Preview Image (Dim)\n                        </a>\n                    </li>\n\n                    <li feature-id="developer-tools" ng-show="accessible">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="showCompIds()">\n                            Show Complication IDs\n                        </button>\n                    </li>\n\n                    <li feature-id="watchface-publishing" ng-show="accessible && (isAdmin || (watchface && watchface.isOwner()))" class="divider-horizontal"></li>\n                    <li feature-id="watchface-publishing" ng-show="accessible && (isAdmin || (watchface && watchface.isOwner()))" class="dropdown-header">\n                        Galaxy Store Actions\n                    </li>\n\n                    <li feature-id="watchface-publishing" ng-show="accessible && (isAdmin || (watchface && watchface.isOwner()))">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.triggerBuild()">\n                            Trigger Build\n                        </button>\n                    </li>\n                    <li feature-id="watchface-publishing" ng-show="accessible && watchface.hasFreemiumFeatures() && (isAdmin || (watchface && watchface.isOwner()))">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.triggerBuild(true)">\n                            Trigger Freemium Build\n                        </button>\n                    </li>\n                    <li feature-id="watchface-publishing" ng-show="accessible && isAdmin">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.triggerBuild(false, {test: true})">\n                            Trigger Dev Build\n                        </button>\n                    </li>\n                    <li feature-id="watchface-publishing" ng-show="accessible && watchface.hasFreemiumFeatures() && isAdmin">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.triggerBuild(true, {test: true})">\n                            Trigger Freemium Dev Build\n                        </button>\n                    </li>\n                    <li ng-if="isAdmin">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.getLatestBuildInfo()">\n                            Get Latest Build Info\n                        </button>\n                    </li>\n                    <li ng-if="isAdmin">\n                        <button type="button" class="watch-select" role="menuitem" ng-click="watchface.getLatestBuildInfo({test: true})">\n                            Get Latest Dev Build Info\n                        </button>\n                    </li>\n\n                    <span ng-if="isAdmin">\n                        <li class="divider-horizontal"></li>\n                        <li class="dropdown-header">QA Actions</li>\n\n                        <li>\n                            <watchface-list watchfaces="[watchface]" type="qa" class="options-list"></watchface-list>\n                        </li>\n                    </span>\n                    <span ng-if="isAdmin">\n                        <li class="divider-horizontal"></li>\n                        <li class="dropdown-header">Store Actions</li>\n\n                        <li>\n                            <watchface-list watchfaces="[watchface]" type="review" class="options-list"></watchface-list>\n                        </li>\n                    </span>\n                    <span ng-show="accessible" feature-id="watchface-takedowns">\n                        <li class="divider-horizontal"></li>\n                        <li class="dropdown-header">Platform Actions</li>\n\n                        <li>\n                            <watchface-list watchfaces="[watchface]" type="platform" class="options-list"></watchface-list>\n                        </li>\n                    </span>\n                </ul>\n            </div>\n            <a ng-if="watchface.isShareable() && !$root.page.isIosClient()" class="btn-icon" ng-click="shareWatchface()">\n                <i class="icon-share-alt"></i>\n            </a>\n        </div>\n\n        <div ng-if="config.showAsTeaser">\n            <div class="watchface-teaser-header">\n                <div class="watchface-teaser-title">\n                    {{watchface.title}}\n                </div>\n                <div class="watchface-teaser-platforms">\n                    <facer-icon ng-if="watchface.isIos()" icon="apple"></facer-icon>\n                    <facer-icon ng-if="watchface.isAndroid()" icon="wearos"></facer-icon>\n                    <facer-icon ng-if="watchface.isAndroid()" icon="wearos6"></facer-icon>\n                    <facer-icon ng-if="watchface.isAndroid()" icon="tizen"></facer-icon>\n                    <facer-icon ng-if="watchface.isAndroid() && isAdmin" icon="veewear"></facer-icon>\n                </div>\n            </div>\n            <div class="watchface-teaser-description">\n                {{watchface.description}}\n            </div>\n        </div>\n\n        <div ng-if="config.showTemplateButton" class="watchface-template-button">\n            <div class="btn btn-primary">{{watchface.title}}</div>\n        </div>\n    </div>\n    <div ng-if="showInfo()" class="watchface-info">\n        <div>\n            <a ng-if="showAuthorAvatar()" target="_blank" user-profile-link="watchface.author" class="watchface-author-avatar disable-link" role="img" ng-attr-aria-label="{{ watchface.author.name | profilePictureAlt }}" style="background-image:url({{watchface.author.avatar}})"></a>\n            <div class="watchface-author-text">\n                <div ng-if="titleLabel" class="title-label">\n                    <small> {{titleLabel}} </small>\n                </div>\n                <a target="_blank" ui-sref="facer.watchface({watchface: watchface.id})" class="watchface-author-title disable-link" ng-show="config.showTitle">\n                    <span class="badge-string">\n                        <div class="badge-string-content">\n                            {{watchface.title}}\n                        </div>\n                        <div ng-show="showTitleBadge()" class="badge-string-icon">\n                            <i ng-if="watchface.isPremium" class="icon-star premium-text icon-badge"></i>\n                        </div>\n                    </span>\n                </a>\n                <a target="_blank" user-profile-link="watchface.author" class="watchface-author-byline disable-link" ng-show="showAuthor()">\n                    <span class="badge-string">\n                        <div class="badge-string-content">\n                            {{watchface.author.name}}\n                        </div>\n                        <div class="badge-string-icon">\n                            <user-badge user="watchface.user"></user-badge>\n                        </div>\n                    </span>\n                </a>\n                <span ng-if="$root.page.isBootstrapMobile()" class="premium-text" ng-class="{\'opacity-hide\': !showPremiumLabel()}">\n                    Premium\n                </span>\n                <div ng-if="isFullscreen()">\n                    <small>\n                        shown on the\n                        <b>{{getDisplayFace().name}}</b>\n                    </small>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class="embed-byline">\n        <div class="byline">\n            <a ng-if="watchface" target="_blank" ui-sref="facer.watchface({watchface: watchface.id})" class="title">\n                <span class="badge-string">\n                    <div class="badge-string-content">{{watchface.title}}</div>\n                    <div class="badge-string-icon">\n                        <i ng-if="watchface.isPremium" class="icon-star premium-text icon-badge"></i>\n                    </div>\n                </span>\n            </a>\n            <a ng-if="watchface" target="_blank" user-profile-link="watchface.author" class="author">\n                <img ng-src="{{watchface.author.avatar}}" width="20" height="20" alt="{{ watchface.author.name | profilePictureAlt }}"/>\n                {{watchface.author.name}}\n                <user-badge user="watchface.user"></user-badge>\n            </a>\n        </div>\n        <sync-button></sync-button>\n    </div>\n</div>\n\n<a ng-if="watchface && !isFullscreen()" ui-sref="facer.home" target="_blank" class="powered-by-facer">\n            <img ng-src="{{facerStaticAssetUrl(\'/img/facer.png\')}}" alt="Facer"/>\n    <span class="powered-by-facer-text">Powered by Facer</span>\n</a>\n\n<a ng-if="watchface && isFullscreen()" ui-sref="facer.featured" class="powered-by-facer">\n            <img ng-src="{{facerStaticAssetUrl(\'/img/facer.png\')}}" alt="Facer"/>\n    <div class="logo-side-text">\n        <div><b>Powered by Facer</b></div>\n        <div><small>Explore thousands more faces</small></div>\n    </div>\n</a>\n<div ng-show="showMainSyncButton()" class="floating-btn-wrapper">\n    <sync-button ng-class="{\'large\': !isList()}"></sync-button>\n</div>\n\n<div ng-if="showFullscreenToolbar()" class="fullscreen-toolbar fade-in-out visible-md visible-lg">\n    <div class="btn-icon toggle-lights" ng-click="$parent.$parent.lightsOff=!$parent.$parent.lightsOff">\n        <i class="icon-lightbulb-o"></i>\n    </div>\n\n    <a class="btn-icon exit-fullscreen" ng-click="exitFullScreen()">\n        <i class="icon-arrow-shrink"></i>\n    </a>\n    <a class="btn-icon enter-fullscreen" ng-click="enterFullScreen()">\n        <i class="icon-arrow-expand"></i>\n    </a>\n</div>\n\n<admin-watchface-stats watchface="watchface"></admin-watchface-stats>\n')}]),e.exports=n},10836:e=>{var n="/html/watchface-coupon-list.partial.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="watchface-coupon-outer-wrapper watchface-coupon-list" ng-class="{\n        \'lights-off\': lightsOff\n    }">\n    <div class="watchface-coupon-wrapper">\n        <div class="watchface-coupon-list-header">\n            <div class="coupon-list-page-title">\n                <h1><span>COUPONS</span></h1>\n                <h2><span>Get your free watch face today.</span></h2>\n            </div>\n        </div>\n        <div ng-if="loading" class="loader">\n            <spinner/>\n        </div>\n        <div ng-if="error" class="coupon-list-error">\n            <span ng-bind-html="error"></span>\n        </div>\n        <div ng-click="trackPromotionClick(promotion.watchface)" ui-sref="facer.watchfaceCoupon({\n                watchface: promotion.watchface.id,\n                nightMode: true,\n                watchModel: \'galaxyactive\',\n                static: true\n            })" ng-repeat="promotion in promotions" class="watchface-coupon-list-item">\n            <div class="coupon-promo-product">\n                <div ng-show="promotion.featureEndDate" class="coupon-promo-timer">\n                    Expires in\n                    <span class="timer-number">{{ promotion.timerMessage.hours }}</span>h\n                    <span class="timer-number">{{ promotion.timerMessage.minutes }}</span>m\n                    <span class="timer-number">{{ promotion.timerMessage.seconds }}</span>s\n                </div>\n                <watchface watchface-id="promotion.watchface" lights="lightsOff" type="coupon-list-item" autorun=""></watchface>\n            </div>\n            <div class="coupon-promo-product-info">\n                <div class="watchface-coupon-tool-product-info">\n                    <a target="_blank" class="user-avatar">\n                        <img ng-src="{{promotion.watchface.author.avatar}}"/>\n                    </a>\n                    <div class="watchface-title-wrapper">\n                        <a target="_blank" class="watchface-title-wrapper-title">\n                            {{promotion.watchface.title}}\n                        </a>\n                        <a target="_blank" class="watchface-title-wrapper-author">\n                            {{promotion.watchface.author.name}}\n                        </a>\n                    </div>\n                    <div class="watchface-cta-wrapper">\n                        <div class="watchface-cta-button">\n                            <i class="icon-arrow-right"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},76365:e=>{var n="/html/watchface-coupon.partial.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="watchface-coupon-outer-wrapper" ng-class="{\n\t\t\'lights-off\': lightsOff\n    }">\n    <div class="watchface-coupon-wrapper">\n        <div class="watchface-coupon-product">\n            <watchface watchface-id="watchface" lights="lightsOff" type="coupon" autorun="{{ static === \'true\' ? \'\' : \'true\' }}"></watchface>\n        </div>\n        <div watchface-coupon-generator class="watchface-coupon-tool">\n            <div>\n                <div ng-show="!watchface" class="watchface-coupon-tool-product-info placeholder">\n                    <div class="user-avatar"></div>\n                    <div class="watchface-title-wrapper">\n                        <div class="watchface-title-wrapper-title"></div>\n                        <div class="watchface-title-wrapper-author"></div>\n                    </div>\n                </div>\n                <div ng-show="watchface" class="watchface-coupon-tool-product-info">\n                    <a target="_blank" ng-href="{{watchface.galaxyAppUrl}}" class="user-avatar" app-link app-link-event-action="click watch face author avatar link" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">\n                        <img ng-src="{{watchface.author.avatar}}"/>\n                    </a>\n                    <div class="watchface-title-wrapper">\n                        <a target="_blank" ng-href="{{watchface.galaxyAppUrl}}" class="watchface-title-wrapper-title" app-link app-link-event-action="click watch face title link" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">\n                            {{watchface.title}}\n                        </a>\n                        <a target="_blank" ng-href="{{watchface.galaxyAppUrl}}" class="watchface-title-wrapper-author" app-link app-link-event-action="click watch face author link" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">\n                            {{watchface.author.name}}\n                        </a>\n                    </div>\n                </div>\n                <div class="watchface-coupon-tool-title">\n                    <div class="watchface-coupon-tool-title-wrapper">\n                        <span class="top-line">Redeem your</span>\n                        <br/>\n                        <span class="bottom-line">FREE Coupon</span>\n                    </div>\n                </div>\n                <div class="watchface-coupon-tool-form">\n                    <div ng-hide="coupon || error" class="watchface-coupon-tool-form-group" ng-if="!coupon">\n                        <div ng-class="{\n                            \'opacity-hide\': loading || !watchface,\n                            \'error\': formError\n                        }" class="watchface-coupon-tool-form-country-select">\n                            <label ng-class="{\'opacity-hide\': loading || !watchface}" class="select-caret">\n                                Select your country\n                            </label>\n                            <select ng-change="formError=null" ng-model="couponForm.country" ng-options="country as country for country in countries">\n                                <option value="">Select your country</option>\n                            </select>\n                        </div>\n                        <div ng-class="{\'opacity-hide\': loading || !watchface}" class="watchface-coupon-tool-form-submit">\n                            <button ng-click="getCoupon()">\n                                Get my coupon\n                            </button>\n                        </div>\n\n                        <div ng-if="loading" class="loader">\n                            <spinner/>\n                        </div>\n                    </div>\n\n                    <div ng-if="coupon || error" class="watchface-coupon-tool-form-group">\n                        <div class="watchface-coupon-tool-code-wrapper">\n                            <div ng-class="{\'opacity-hide\': error}">\n                                <label> Your coupon code: </label>\n                            </div>\n                            <div class="watchface-coupon-tool-code-box-wrapper">\n                                <div ng-hide="error" id="couponCode" class="watchface-coupon-tool-code-box">\n                                    {{coupon}}\n                                </div>\n                                <div ng-hide="error" clipboard="couponCode" clipboard-callback="onCopied" class="watchface-coupon-tool-code-copy-button" ng-class="{\'copied\': copied}">\n                                    {{ copied ? \'COPIED\' : \'COPY\' }}\n                                </div>\n                                <div ng-if="error" class="watchface-coupon-tool-code-box watchface-coupon-tool-error">\n                                    <div>{{ error.message }}</div>\n                                    <div class="watchface-coupon-tool-error-detail" ng-show="error.messageDetail">\n                                        {{error.messageDetail}}\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="watchface-coupon-tool-form-submit">\n                            <a ng-href="{{watchface.galaxyAppUrl}}" app-link app-link-event-action="{{getRedeemLinkEventAction()}}" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">\n                                Go to Galaxy App Store\n                            </a>\n                        </div>\n                    </div>\n\n                    \x3c!--<div ng-class="{\'opacity-hide\': error}" class="watchface-coupon-tool-form-submit submit-secondary">\n                    <a \n                        ng-click="trackCouponListClick()"\n                        ui-sref="facer.watchfaceCouponList({watchModel: \'galaxyactive\'})"\n                    >\n                        More free faces\n                    </a>\n                </div>--\x3e\n                </div>\n                <div class="watchface-coupon-tool-footer">\n                    <div class="watchface-coupon-tool-footer-left">\n                        <a target="_blank" href="https://bit.ly/FacerCouponHelp" class="text-link" ng-class="{\'animated\': coupon}" app-link app-link-event-action="click redeem coupon help link" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">\n                            How do I use coupons?\n                        </a>\n                    </div>\n                    <div class="watchface-coupon-tool-footer-right">\n                        Need help?\n                        <a target="_blank" href="mailto:[redacted:email]@facer.io" class="text-link" app-link app-link-event-action="click email support email link" app-link-event-category="{{analyticsOptions.category}}" app-link-event-label="{{analyticsOptions.label}}">Email us</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},28180:e=>{var n="/html/watchface-embed-test.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<iframe id="embed0" height="100%" width="100%" style="border: 0; padding: 10px"></iframe>\n')}]),e.exports=n},61726:e=>{var n="/html/watchface-embed.component.html";window.angular.module("facer.t