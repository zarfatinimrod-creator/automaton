te="getColorsUsed()" ng-change="updateThemeColor()" ng-model="editor.tag.preferences.themes[getThemePrefKey()]" ng-class="{\'disabled\': getThemeLayers().length == 0}"></div>\n                </div>\n            </div>\n        </div>\n        <hr>\n    </div>\n    <div ng-show="shouldShow(section)" ng-repeat="section in sections" class="palette-section palette-section-new">\n        <creator-pro-lock class="padded" ng-show="featureIsLocked(section.featureId)"></creator-pro-lock>\n        <div class="palette-title">\n            {{section.title}}\n        </div>\n        <div class="palette-body">\n            <div ng-show="shouldShow(item)" ng-repeat="item in section.items" class="palette-item" ng-class="{\'palette-item-title-only\': item.type==\'checkbox\'}">\n                <div class="palette-item-title-bar">\n                    <div class="palette-item-title">\n                        {{item.label}}\n                    </div>\n                    <div ng-show="showValuePreview(item)" class="palette-item-value">\n                        {{item.displayValue()}}\n                    </div>\n                    <div ng-if="item.type==\'checkbox\'" class="palette-item-value">\n                        <input type="checkbox" ng-model="item.value" ng-model-options="{ getterSetter: true }" face-input/>\n                    </div>\n                </div>\n                <div ng-if="item.slider" class="palette-item-input">\n                    <input type="range" ng-model="item.value" ng-model-options="{ getterSetter: true }" face-input int min="{{item.slider.min}}" max="{{item.slider.max}}" class="slider-input">\n                </div>\n                <div ng-if="item.smoothSlider" class="palette-item-input">\n                    <input type="range" ng-model="item.value" ng-model-options="{ getterSetter: true }" face-input step="{{item.smoothSlider.step}}" min="{{item.smoothSlider.min}}" max="{{item.smoothSlider.max}}" class="slider-input">\n                </div>\n