yFace.id}}">\n                <div class="watch-background"></div>\n                <div class="watch-shadow"></div>\n                <div class="watch-inner-container">\n                    <a ng-show="config.inspectOnly" ui-sref="facer.inspectWatchface({watchface: watchface.id})" class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.image + \')\'}"></a>\n                    <a ng-show="!config.inspectOnly" ng-click="editWatchface(watchface)" class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.image + \')\'}"></a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class="dashboard-watchface-item-title-outer-wrapper">\n        <div ng-show="config.showAuthor" class="dashboard-watchface-item-author-avatar">\n            <a user-profile-link="watchface.author" facer-io-link style="background-image:url({{watchface.author.avatar}})">\n            </a>\n        </div>\n        <div class="dashboard-watchface-item-title-inner-wrapper">\n            <div class="dashboard-watchface-item-title">\n                <span class="badge-string">\n                    <a ng-show="config.inspectOnly" ui-sref="facer.inspectWatchface({watchface: watchface.id})" class="badge-string-content">\n                        {{watchface.title}}\n                    </a>\n                    <a ng-show="!config.inspectOnly" ng-click="editWatchface(watchface)" class="badge-string-content">\n                        {{watchface.title}}\n                    </a>\n                    <div ng-show="config.showTitleBadge" class="badge-string-icon">\n                        <i ng-if="watchface.isPremium" class="icon-star premium-text icon-badge"></i>\n                    </div>\n                    <div ng-show="watchface.imported" class="dashboard-watchface-item__imported-tag">\n                        Imported\n                    </div>\n                </span>\n            </div>\n            <div ng-show="config.showAuthor" class="dashboard-watchface-item-author">\n                by <a user-profile-link="watchface.author" class="text-link" facer-io-link>{{watchface.author.name}}</a>\n            </div>\n        </div>\n    </div>\n    <div ng-if="config.showDetails" class="dashboard-watchface-item-details">\n        <watchface-status type="pill" watchface="watchface"></watchface-status>\n        <span class="premium-flag" ng-show="watchface.isPremium"><i class="icon-star"></i></span>\n        <span class="edit-date">{{getDateString()}}</span>\n    </div>\n    <div ng-show="config.showDetails" class="dashboard-watchface-item-extra-details">\n        <div class="dashboard-watchface-item-stats">\n            <span class="dashboard-watchface-item-stat" tooltip title="{{watchface.syncCount|number}}">\n                <i class="icon-pushtowatch"></i>\n                {{watchface.syncCount|largeNumber}}\n            </span>\n            <span class="dashboard-watchface-item-stat" tooltip data-original-title="{{comments.length|number}}">\n                <i class="icon-comment"></i>\n                {{comments.length|largeNumber}}\n            </span>\n        </div>\n        <div class="dashboard-watchface-item-platforms">\n            <div ng-show="watchface.isIos()" tooltip title="watchOS">\n                <facer-icon icon="apple"></facer-icon>\n            </div>\n            <div ng-show="watchface.isWearOS()" tooltip title="Wear OS (Legacy)">\n                <facer-icon icon="wearos"></facer-icon>\n            </div>\n            <div ng-show="watchface.isWFF()" tooltip title="Wear OS (WFF)">\n                <facer-icon icon="wearos6"></facer-icon>\n            </div>\n            <div ng-show="watchface.isTizen()" tooltip title="Tizen">\n                <facer-icon icon="tizen"></facer-icon>\n            </div>\n            <div ng-show="watchface.isLPFE() && isAdmin()" tooltip title="VEE Wear">\n                <facer-icon icon="veewear"></facer-icon>\n            </div>\n        </div>\n    </div>\n    <div class="dashboard-watchface-item-actions">\n        <div ng-show="config.inspectOnly" ui-sref="facer.inspectWatchface({watchface: watchface.id})" class="f-btn-rounded-primary-sm">\n            Inspect\n        </div>\n        <div ng-show="!config.inspectOnly" ng-click="editWatchface(watchface)" class="f-btn-rounded-primary-sm">\n            Edit\n        </div>\n        <sync-button type="text">\n        </sync-button>\n\n        <facer-dropdown class="more-actions-button" ng-show="config.showOptions && displayUnpublishFlow">\n            <facer-dropdown-trigger>\n                <button class="f-btn-ghost" type="button" id="options{{watchface.id}}" data-toggle="dropdown" aria-expanded="true" ng-disabled="isActionInProgress()" ng-click="isActionInProgress() && $event.stopPropagation()">\n                    <i ng-hide="isActionInProgress()" class="icon-ellipsis-h"></i>\n                    <span ng-show="duplicating">Duplicating...</span>\n                    <span ng-show="savingStarterTemplate">Saving template...</span>\n                    <span ng-show="discarding || publishing || unpublishing">Loading...</span>\n                </button>\n            </facer-dropdown-trigger>\n            <facer-dropdown-menu>\n                <facer-dropdown-menu-item ng-if="watchface.isReadyForPublish()" ng-click="publishWatchface(watchface)" class="has-divider">\n                    <a>Publish</a>\n                </facer-dropdown-menu-item>\n\n                <facer-dropdown-menu-item>\n                    <a ui-sref="facer.watchface({watchface: watchface.id})" target="_blank" facer-io-link>\n                        View in Facer\n                        <facer-icon icon="open-in-new-tab"></facer-icon>\n                    </a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-show="canDiscardDraft(watchface)" ng-click="discardDraft(watchface)">\n                    <a>Discard Draft</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="canDuplicate(watchface)" ng-click="duplicateWatchface(watchface)" ng-class="{\'has-divider\': !canImport(watchface)}">\n                    <a>Duplicate</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="canSaveStarterTemplate(watchface)" ng-click="saveAsStarterTemplate(watchface)">\n                    <a>Save as Template</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="shouldShowStarterTemplateUpgrade()" ng-click="goToStarterTemplateUpgrade($event)">\n                    <a>\n                        Save as Template\n                        <facer-pill-pro></facer-pill-pro>\n                    </a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="canImport(watchface)" ng-click="importWatchface(watchface)" class="has-divider">\n                    <a>Import/Update (Admin Only)</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="watchface.isPublished()" ng-click="unpublishWatchface(watchface)">\n                    <a>Unpublish</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-click="deleteWatchface(watchface)">\n                    <a class="text-danger">Delete</a>\n                </facer-dropdown-menu-item>\n            </facer-dropdown-menu>\n        </facer-dropdown>\n\n        <facer-dropdown class="more-actions-button" ng-show="config.showOptions && !displayUnpublishFlow">\n            <facer-dropdown-trigger>\n                <button class="f-btn-ghost" type="button" id="options{{watchface.id}}" data-toggle="dropdown" aria-expanded="true" ng-disabled="isActionInProgress()" ng-click="isActionInProgress() && $event.stopPropagation()">\n                    <i ng-hide="isActionInProgress()" class="icon-ellipsis-h"></i>\n                    <span ng-show="duplicating">Duplicating...</span>\n                    <span ng-show="savingStarterTemplate">Saving template...</span>\n                    <span ng-show="discarding || publishing || unpublishing">Loading...</span>\n                </button>\n            </facer-dropdown-trigger>\n            <facer-dropdown-menu>\n                <facer-dropdown-menu-item ng-if="watchface.isReadyForPublish()" ng-click="publishWatchface(watchface)" class="has-divider">\n                    <a>Publish</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item>\n                    <a ui-sref="facer.watchface({watchface: watchface.id})" target="_blank" facer-io-link>View</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-show="canDiscardDraft(watchface)" ng-click="discardDraft(watchface)">\n                    <a>Discard Draft</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="canDuplicate(watchface)" ng-click="duplicateWatchface(watchface)">\n                    <a>Duplicate</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item class="has-divider" ng-if="canImport(watchface)" ng-click="importWatchface(watchface)">\n                    <a>Import/Update Variant (Admin Only)</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="canSaveStarterTemplate(watchface)" ng-click="saveAsStarterTemplate(watchface)">\n                    <a>Save as Template</a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-if="shouldShowStarterTemplateUpgrade()" ng-click="goToStarterTemplateUpgrade($event)">\n                    <a>\n                        Save as Template\n                        <facer-pill-pro></facer-pill-pro>\n                    </a>\n                </facer-dropdown-menu-item>\n                <facer-dropdown-menu-item ng-click="delete