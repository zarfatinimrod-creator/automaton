             <i title="{{feature.name}}" class="{{feature.icon}}"></i>\n                    </li>\n                </ul>\n            </a>\n        </div>\n    </div>\n    <div ng-if="showAdminTools()">\n        <watchface-list watchfaces="watchfaces" type="review"></watchface-list>\n    </div>\n</div>\n<loader ng-if="loading"></loader>\n')}]),e.exports=n},65505:e=>{var n="/html/watchface-media-manager.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-hide="!loadingMedia" class="watchface-media">\n    <div class="watchface-media-item small-item loader-item">\n        <spinner></spinner>\n    </div>\n</div>\n<div ng-show="!loadingMedia" class="watchface-media">\n    <div ng-if="!hasVideo()" class="watchface-media-item small-item">\n        <div ng-class="{ \'item-loading\': uploadingVideo }" class="watchface-media-item-add" ng-click="openVideoUploadModal()">\n            <i id="addIcon" class="icon-video-camera"></i>\n            <span ng-show="!uploadingVideo">Add Video</span>\n            <div class="watchface-media-item-controls">\n                <div ng-show="uploadingVideo" class="watchface-media-item-controls-loading">\n                    <spinner></spinner>\n                </div>\n            </div>\n        </div>\n        <creator-pro-lock ng-show="isLocked"></creator-pro-lock>\n    </div>\n    <div ng-repeat="item in media|filter:{ contentType: \'video\' }" class="watchface-media-item small-item watchface-media-item-image" style="background-image: url({{ item.imagePreviewSmall }})" ng-class="{ \'item-loading\': item.loading }">\n        <div ng-click="viewItem(item.i)" class="watchface-media-item-controls">\n            <div ng-show="!item.loading" ng-click="removeItem(item);$event.stopPropagation()" class="watchface-media-item-controls-remove">\n                <i class="icon-close"></i>\n            </div>\n            <div ng-show="item.loading" class="watchface-media-item-controls-loading">\n                <spinner></spinner>\n            </div>\n            <div ng-show="item.isVideo() && !item.loading" class="watchface-media-buttons">\n                <div class="watchface-media-button">\n                    <i class="icon-play"></i>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class="watchface-media-item small-item">\n        <div ng-class="{ \'item-loading\': uploadingMedia }" class="watchface-media-item-add">\n            <i id="addIcon" class="icon-image"></i>\n            <span class="add-text">Add Image</span>\n            <input id="promoImageUpload" type="file"/>\n            <div class="watchface-media-item-controls">\n                <div ng-show="uploadingMedia" class="watchface-media-item-controls-loading">\n                    <spinner></spinner>\n                </div>\n            </div>\n        </div>\n        <creator-pro-lock ng-show="isLocked"></creator-pro-lock>\n    </div>\n    <div ng-repeat="item in media|filter:{ contentType: \'image\' }" class="watchface-media-item small-item watchface-media-item-image" style="background-image: url({{ item.imagePreviewSmall }})" ng-class="{ \'item-loading\': item.loading }">\n        <div ng-click="viewItem(item.i)" class="watchface-media-item-controls">\n            <div ng-show="!item.loading" ng-click="removeItem(item);$event.stopPropagation()" class="watchface-media-item-controls-remove">\n                <i class="icon-close"></i>\n            </div>\n            <div ng-show="item.loading" class="watchface-media-item-controls-loading">\n                <spinner></spinner>\n            </div>\n            <div ng-show="item.isVideo()" class="watchface-media-buttons">\n                <div class="watchface-media-button">\n                    <i class="icon-play"></i>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},78900:e=>{var n="/html/watchface-search.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="container">\n    <div ng-if="loading || watchfaces.length > 0">\n        <h2 class="gray-header">Watchface search: "{{search}}"</h2>\n        <div id="watchface-list" class="row" ui-view="watchfaces"></div>\n        <endless margin="0" trigger="loadMoreWatchfaces()" end-on="done"/>\n    </div>\n\n    <div ng-if="!loading && watchfaces.length == 0">\n        <div class="gray-header">No results for: "{{search}}"</div>\n        <br/><br/>\n        <center>\n            <h3 class="text-muted">Suggested Searches</h3>\n            <div ng-repeat="search in suggestedSearches">\n                <a class="text-muted" ui-sref="facer.search({search: search})">{{search}}</a>\n            </div>\n        </center>\n    </div>\n</div>\n')}]),e.exports=n},15296:e=>{var n="/html/watchface-stats.component.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper watchface-stats">\n    <div class="stat-wrapper">\n        <div class="stat-header">\n            <h2>\n                <div class="stat-image">\n                    <img ng-src="{{ watchface.image }}"/>\n                </div>\n                {{ watchface.title }}\n            </h2>\n        </div>\n        <hr/>\n        <div class="highlight-stats row">\n            <div ng-repeat="stat in watchface.stats.values" class="highlight-stat col-xs-4">\n                <div class="highlight-stat-value">\n                    {{ stat.aggregate.value | largeNumber }}\n                </div>\n                <div class="highlight-stat-label">\n                    {{ stat.aggregate.label }}\n                </div>\n            </div>\n        </div>\n        <hr/>\n        <chart ng-if="data" data="data"></chart>\n        <div class="options">\n            <span ng-if="!hasStats()">There are no stats available for this watch face yet</span>\n            <button class="option" style="background-color: {{ option.color }};border: 1px solid {{\n                    option.color\n                }};color: {{ option.color }};" ng-repeat="option in options" ng-click="option.onClick()" ng-class="{\n                    selected: !option.visible,\n                    \'not-selected\': option.visible\n                }">\n                {{ option.label }}\n            </button>\n        </div>\n        <center ng-show="hasStats()">\n            <small>\n                NOTE: Purchase and revenues stats are only tracked since\n                12/18/2018.\n            </small>\n        </center>\n    </div>\n\n    <div ng-click="close(false)" class="facer-modal-backdrop">\n        <div class="facer-modal-close">\n            <i class="icon-close"></i>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},48958:e=>{var n="/html/watchface-status.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'\x3c!-- category --\x3e\n\n<div ng-if="showStatus()">\n    <div ng-if="showStatusText()">\n        <div>\n            Status:\n            <span class="watchface-status {{watchface.getStatusDisplayId()}}">{{watchface.getStatusDisplayLabel()}}</span>\n            <div ng-if="showStatusTooltip()" class="tooltip-dot large {{watchface.getStatusDisplayId()}}" tooltip tooltip-title="getStatusTooltipContent()">\n                ?\n            </div>\n        </div>\n        <div ng-if="showReviewStatus()">\n            <small>Review Status:\n                <span class="watchface-status rejected">Rejected</span></small>\n            <div class="tooltip-dot large rejected" tooltip tooltip-title="getReviewStatusTooltipContent()">\n                ?\n            </div>\n        </div>\n        <div ng-if="showPublishType()">\n            <small>Publish Type:\n                <span class="watchface-status {{watchface.getStatusDisplayId()}}">{{getPublishTypeString()}}</span>\n            </small>\n            <div class="tooltip-dot large {{watchface.getStatusDisplayId()}}" tooltip tooltip-title="getPublishTypeTooltopContent()">\n                ?\n            </div>\n        </div>\n    </div>\n    <div ng-if="showStatusPill()" class="watchface-status-pills">\n        <span class="tag-pill tag-pill-block {{getTagPillClass()}}" tooltip tooltip-title="getStatusPillTooltipContent()">{{showSummaryMetadata() ? \'Status: \' : \'\'}}{{getTagPillText()}}</span>\n        <span ng-if="showSummaryMetadata() && showReviewStatus()" class="tag-pill tag-pill-block tag-pill-red" tooltip tooltip-title="getReviewStatusTooltipContent()">Review: Rejected</span>\n        <span ng-if="showSummaryMetadata() && showPublishType()" class="tag-pill tag-pill-block tag-pill-gray" tooltip tooltip-title="getPublishTypeTooltopContent()">Publish: {{getPublishTypeString()}}</span>\n    </div>\n</div>\n\n\x3c!--\n\npermissions - "A" admin - "O" owner - "E" everyone\n\nStatus: draft | live (private?) | in review \t\t\t\t\t\t\t\t\t\t\t\t\t"AO"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// if not \'draft\'\n\tDraft in Progress: yes | no \t\t\t\t\t\t\t\t\t\t\t\t\t\t \t\t"AO"\nPremium: yes | no \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t \t\t"AO"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// if \'yes\'\n\tGP ID: ""  \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t"A"\n\tQA: approved | not in review | in review | rejected (reason) \t\t\t\t\t\t\t\t"AO"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// if \'no\'\n\tQA: approved | not in review | in review \t\t\t\t\t\t\t\t\t\t\t\t\t"A"\n\n\n--\x3e\n')}]),e.exports=n},17575:e=>{var n="/html/watchface.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div id="main" class="flush-top">\n    <div class="container watchface-page">\n\n        <div ng-if="published" class="facer-panel facer-panel-new facer-panel-blue margin-top" role="alert">\n            <div class="facer-panel-content">\n                <div class="facer-panel-icon">\n                    <i class="icon-category-fun"></i>\n                </div>\n                <div class="facer-panel-body">\n                    <div class="facer-panel-text">\n                        Now you can share your creation with your friends.\n                    </div>\n                    <div class="facer-panel-actions">\n                        <div ng-click="shareWatchface()" class="facer-panel-action facer-panel-main-action btn">\n                            Share it\n                        </div>\n                        <div class="facer-panel-action facer-panel-dismiss-action" ng-click="dismissPublishedPanel()">\n                            <i class="icon-close"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="!loading && !isLive" class="alert alert-info" role="alert">\n            <strong>PREVIEW MODE:</strong> this face is not yet published and is not available to all users\n        </div>\n\n        <div ng-show="watchface" class="row">\n            <div class="col-sm-7">\n                <div id="watch" class="watchface-model" ng-class="{\'is-inspectable\': watchface.isInspectable}">\n                    <watchface ng-if="watchface" watchface-id="watchface" config="watchfaceConfig" type="hero" autorun="true" on-desktop-sync="syncWatchfaceToDesktop()"></watchface>\n                    <div class="watchface-inspect" ng-if="watchface.isInspectable">\n                        <a class="f-btn-icon f-btn-secondary f-btn-xl" target="_blank" ui-sref="facer.inspectWatchface({watchface:watchface.id})">\n                            <img ng-src="{{facerStaticAssetUrl(\'/img/logos/facer_creator_icon.svg\')}}" alt=""/>\n                            <span>INSPECT IN FACER CREATOR</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <div class="col-sm-5 box-container">\n                <div class="watchface-details">\n                    <div class="watchface-identity">\n                        <h1 id="watchface-name">\n                            {{watchface.name}}\n                            <i ng-if="watchface.isPremium" class="icon-badge icon-star premium-text"></i>\n                        </h1>\n\n                        <div ng-show="watchface.getCompatibilityMessage()" class="device-compatibility">\n                            {{watchface.getCompatibilityMessage()}}\n                        </div>\n\n                        <div class="watchface-byline">\n                            <div class="watchface-byline-info">\n                                <a user-profile-link="watchface.face.get(\'user\')" class="artist" role="img" ng-attr-aria-label="{{ watchface.artist | profilePictureAlt }}" style="background-image: url(\'{{watchface.artistImage}}\')"></a>\n                                <span id="watchface-artist" class="watchface-artist badge-string">\n                                    <h2 class="badge-string-content watchface-artist-name">\n                                        <a user-profile-link="watchface.face.get(\'user\')" class="text-link">\n                                            {{watchface.artist}}\n                                        </a>\n                                    </h2>\n                                    <user-badge class="badge-string-icon" user="watchface.user"></user-badge>\n                                </span>\n                            </div>\n                            <follow-button user="watchface.user" class="follow-button-compact"></follow-button>\n                        </div>\n                    </div>\n\n                    <section class="watchface-content-section">\n                        <div id="watchface-desc" class="lead">\n                            <div class="watchface-desc-container" ng-class="{\'is-truncated\': isTruncated && !descriptionExpanded, \'is-expanded\': descriptionExpanded}">\n                                <span id="watchface-description-text" ng-bind="descriptionExpanded || !isTruncated ? watchface.description : truncatedDescription" class="watchface-desc-text js-watchface-desc-text"></span><button ng-if="isTruncated" type="button" ng-click="toggleDescription()" class="watchface-desc-toggle" ng-attr-aria-expanded="{{descriptionExpanded}}" aria-controls="watchface-description-text">\n                                    {{descriptionExpanded ? \'Show less\' : \'Show more\'}}\n                                </button>\n                            </div>\n                        </div>\n\n                        <div ng-if="watchface.media && watchface.media.length" class="watchface-media">\n                            <div ng-repeat="media in watchface.media" class="watchface-media-item watchface-media-item-image">\n                                <button ng-if="media.isImage()" type="button" class="watchface-media-open" ng-click="viewWatchfaceMedia($index)" ng-attr-aria-label="View media for {{watchface.name}}">\n                                    <img class="watchface-media-item-img" ng-src="{{ media.imagePreviewMedium }}" alt="{{ watchface.name | watchfaceDetailAlt:watchface.artist }}"/>\n                                </button>\n                                <video ng-if="media.isVideo()" class="watchface-media-item-video" ng-attr-poster="{{ media.imagePreviewMedium }}" preload="metadata" muted playsinline>\n                                    <source video-src="{{ media.video }}" type="video/mp4"/>\n                                </video>\n                                <a ng-if="media.isVideo()" class="watchface-media-watch-link" ui-sref="facer.watchface.promoWatch({ watchface: watchface.id, media: media.id })" ng-click="$event.stopPropagation()">\n                                    Watch video\n                                </a>\n                                <div ng-show="media.isVideo()" class="watchface-media-buttons">\n                                    <button type="button" class="watchface-media-button" ng-click="viewWatchfaceMedia($index)" ng-attr-aria-label="Preview video for {{watchface.name}}">\n                                        <i class="icon-play"></i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                        <section ng-if="!currentUser() && !page.isBootstrapMobile() && desktopDownloadAppUrl" class="watchface-section watchface-download-cta" aria-label="{{desktopDownloadAppLabel}}">\n                            <a class="f-btn-rounded-primary watchface-download-cta__button" ng-href="{{desktopDownloadAppUrl}}" ng-click="trackDesktopDownloadAppClick()" aria-label="{{desktopDownloadAppLabel}}" title="{{desktopDownloadAppLabel}}" target="_blank" rel="noopener">\n                                <span class="watchface-download-cta__icon" aria-hidden="true">\n                                    <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">\n                                        <path d="M14.5312 19.3906C14.3854 19.3385 14.25 19.25 14.125 19.125L9.625 14.625C9.375 14.375 9.25521 14.0833 9.26562 13.75C9.27604 13.4167 9.39583 13.125 9.625 12.875C9.875 12.625 10.1719 12.4948 10.5156 12.4844C10.8594 12.474 11.1562 12.5938 11.4062 12.8438L13.75 15.1875V6.25C13.75 5.89583 13.8698 5.59896 14.1094 5.35938C14.349 5.11979 14.6458 5 15 5C15.3542 5 15.651 5.11979 15.8906 5.35938C16.1302 5.59896 16.25 5.89583 16.25 6.25V15.1875L18.5938 12.8438C18.8438 12.5938 19.1406 12.474 19.4844 12.4844C19.8281 12.4948 20.125 12.625 20.375 12.875C20.6042 13.125 20.724 13.4167 20.7344 13.75C20.7448 14.0833 20.625 14.375 20.375 14.625L15.875 19.125C15.75 19.25 15.6146 19.3385 15.4688 19.3906C15.3229 19.4427 15.1667 19.4688 15 19.4688C14.8333 19.4688 14.6771 19.4427 14.5312 19.3906ZM7.5 25C6.8125 25 6.22396 24.7552 5.73438 24.2656C5.24479 23.776 5 23.1875 5 22.5V20C5 19.6458 5.11979 19.349 5.35938 19.1094C5.59896 18.8698 5.89583 18.75 6.25 18.75C6.60417 18.75 6.90104 18.8698 7.14062 19.1094C7.38021 19.349 7.5 19.6458 7.5 20V22.5H22.5V20C22.5 19.6458 22.6198 19.349 22.8594 19.1094C23.099 18.8698 23.3958 18.75 23.75 18.75C24.1042 18.75 24.401 18.8698 24.6406 19.1094C24.8802 19.349 25 19.6458 25 20V22.5C25 23.1875 24.7552 23.776 24.2656 24.2656C23.776 24.7552 23.1875 25 22.5 25H7.5Z" fill="white"/>\n                                    </svg>\n                                </span>\n                                <span>{{desktopDownloadAppLabel}}</span>\n                            </a>\n                        </section>\n                        <ad target="watchface.face.id" type="watchface"></ad>\n                    </section>\n\n                    <section ng-if="watchfacePlatforms && watchfacePlatforms.length" class="watchface-section watchface-platforms" aria-labelledby="watchface-platforms-heading">\n                        <h2 id="watchface-platforms-heading" class="watchface-section__title">Compatible with</h2>\n                        <div class="watchface-spec-pill-list">\n                            <span class="watchface-platform-pill-item" ng-repeat="platform in watchfacePlatforms track by platform.value">\n                                <a ng-if="platform.listingPlatformSlug" ui-sref="facer.featured.platform({listingPlatformSlug: platform.listingPlatformSlug})" class="watchface-spec-pill watchface-platform-pill">\n                                    <facer-icon class="watchface-spec-pill__icon" icon="{{platform.icon}}"></facer-icon>\n                                    <span class="watchface-spec-pill__name" ng-bind="platform.label"></span>\n                                </a>\n                                <span ng-if="!platform.listingPlatformSlug" class="watchface-spec-pill watchface-platform-pill">\n                                    <facer-icon class="watchface-spec-pill__icon" icon="{{platform.icon}}"></facer-icon>\n                                    <span class="watchface-spec-pill__name" ng-bind="platform.label"></span>\n                                </span>\n                            </span>\n                        </div>\n                    </section>\n\n                    <div ng-if="watchface.face">\n                        <div feature-list="watchface.face">\n                            <section ng-if="visibleFeatures.length" id="features" class="watchface-section watchface-features" aria-labelledby="watchface-features-heading">\n                                <h2 id="watchface-features-heading" class="watchface-section__title">Features</h2>\n                                <div id="feature-list" class="watchface-spec-pill-list">\n                                    <a ng-repeat="feature in visibleFeatures|orderBy:\'i\'" ui-sref="facer.explore.feature({feature: feature.value})" class="watchface-spec-pill watchface-feature-pill">\n                                        <i class="watchface-spec-pill__icon {{feature.icon}}" aria-hidden="true"></i>\n                                        <span class="watchface-spec-pill__name" ng-bind="feature.name"></span>\n                                    </a>\n                                </div>\n                            </section>\n                        </div>\n                    </div>\n\n                    <section ng-if="watchface.category || (watchface.tags && watchface.tags.length)" class="watchface-section watchface-explore-more" aria-labelledby="watchface-explore-more-heading">\n                        <h2 id="watchface-explore-more-heading" class="watchface-section__title">Explore more</h2>\n                        <div class="watchface-tags watchface-spec-pill-list watchface-specification-tags">\n                            <a ng-if="watchface.category" ui-sref="facer.explore.category({category: watchface.category.id})" class="watchface-spec-pill main">{{watchface.category.name}}</a>\n                            <a ng-repeat="tag in watchface.tags" ui-sref="facer.explore.tag({tag: tag})" class="watchface-spec-pill">\n                                {{tag}}\n                            </a>\n                        </div>\n                    </section>\n\n                    <section ng-if="watchface.requiresPermissions()" class="watchface-section watchface-permissions" aria-labelledby="watchface-permissions-heading">\n                        <h2 id="watchface-permissions-heading" class="watchface-section__title">Permissions</h2>\n                        <p>\n                            This watch face requires:\n                            <strong>{{watchface.getPermissionsString()}}</strong>\n                        </p>\n                    </section>\n\n                    <section ng-if="watchface.author.countryName || watchface.firstPublish || watchfaceCopyrightText" class="watchface-section watchface-public-details" aria-label="Watchface details">\n                        <ul class="watchface-public-details__list">\n                            <li class="watchface-origin" ng-if="watchface.author.countryName">\n                                <img class="watchface-origin__flag" ng-src="{{watchface.author.countryFlagUrl}}" alt=""/>\n                                <span>Made in {{watchface.author.countryName}}</span>\n                            </li>\n                            <li class="watchface-public-details__secondary" ng-if="watchface.firstPublish">\n                                Published on {{watchface.firstPublish | date: "MMM d, yyyy"}}\n                            </li>\n                            <li class="watchface-public-details__secondary" ng-if="watchfaceCopyrightText">\n                                {{watchfaceCopyrightText}}\n                            </li>\n                        </ul>\n                    </section>\n\n                    <section class="watchface-private-details" ng-if="privateDetailsVariant" ng-class="{\'is-expanded\': privateDetailsExpanded}" aria-labelledby="watchface-private-details-heading">\n                        <h2 id="watchface-private-details-heading" class="sr-only">\n                            {{privateDetailsVariant === \'admin\' ? \'Admin only\' : \'Author only\'}}\n                        </h2>\n                        <div class="watchface-private-details__header">\n                            <button type="button" class="watchface-private-details__toggle" ng-click="togglePrivateDetails()" ng-attr-aria-expanded="{{privateDetailsExpanded ? \'true\' : \'false\'}}" aria-controls="watchface-private-details-body">\n                                <span class="watchface-private-details__identity">\n                                    <i class="icon-lock watchface-private-details__lock" aria-hidden="true"></i>\n                                    <span class="watchface-section__title">\n                                        {{privateDetailsVariant === \'admin\' ? \'Admin only\' : \'Author only\'}}\n                                    </span>\n                                </span>\n                                <span class="watchface-private-details__toggle-controls">\n                                    <watchface-status ng-if="!privateDetailsExpanded" class="watchface-private-details__summary-status" watchface="watchface" type="summary"></watchface-status>\n                                    <i class="icon-caret-down watchface-private-details__toggle-icon" aria-hidden="true"></i>\n                                </span>\n                            </button>\n                        </div>\n                        <div id="watchface-private-details-body" class="watchface-private-details__body" ng-show="privateDetailsExpanded">\n                            <watchface-status watchface="watchface"></watchface-status>\n\n                            <div class="watchface-private-details__licensing" ng-if="watchfaceLicensingModel">\n                                <h3>Licensing</h3>\n                                <ol class="watchface-licensing-list">\n                                    <li>\n                                        <watchface-license model="watchfaceLicensingModel" index="1"></watchface-license>\n                                    </li>\n                                    <li ng-repeat="model in watchfaceLicensingModel.nextModels">\n                                        <watchface-license model="model"></watchface-license>\n                                    </li>\n                                </ol>\n                            </div>\n                        </div>\n                    </section>\n\n                    <div ng-show="!page.isMobile()"><br/><br/></div>\n                </div>\n            </div>\n        </div>\n        <loader id="watchfaceSpinner" ng-if="loading && !error"/>\n\n        <div ng-if="error">\n            <div class="row">\n                <div class="col-xs-12">\n                    <br/><br/>\n                    <h3 class="text-muted text-center">{{error}}</h3>\n                    <br/>\n                    <div class="device-image-wrapper">\n                        <div class="watch-sizing-wrapper">\n                            <div class="watch-container android_draft">\n                                <div class="watch-background"></div>\n                                <div class="watch-shadow"></div>\n                                <div class="watch-inner-container">\n                                    <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + watchface.image + \')\'}"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="watchfaceLooksLoading || watchfaceLooks.length" class="section-list watchface-looks">\n            <br/>\n            <div class="section-header">\n                <h2 class="section-name">Looks for This Face</h2>\n            </div>\n\n            <loader ng-if="watchfaceLooksLoading"></loader>\n\n            <div ng-if="!watchfaceLooksLoading && watchfaceLooks.length" class="watchface-looks__grid">\n                <a class="watchface-looks__card" ng-repeat="look in watchfaceLooks track by look.id" ui-sref="facer.looks.detail({ looks: look.id })" aria-label="Open look {{ look.watchfaceTitle }} by {{ look.authorName }}">\n                    <img class="watchface-looks__media" ng-if="!look.media.isAnimated" ng-src="{{ look.media.url }}" alt="{{ look.watchfaceTitle }}"/>\n\n                    <video class="watchface-looks__media" ng-if="look.media.isAnimated" autoplay muted loop playsinline ng-attr-poster="{{ look.media.posterUrl }}">\n                        <source video-src="{{ look.media.url }}" type="video/mp4"/>\n                    </video>\n\n                    <div class="watchface-looks__overlay watchface-looks__overlay--top">\n                        <div class="watchface-looks__author">\n                            <img class="watchface-looks__author-avatar" ng-if="look.authorAvatarUrl" ng-src="{{ look.authorAvatarUrl }}" alt="{{ look.authorName }}"/>\n                            <div class="watchface-looks__author-avatar watchface-looks__author-avatar--placeholder" ng-if="!look.authorAvatarUrl">\n                                {{ look.authorName.charAt(0) }}\n                            </div>\n\n                            <div class="watchface-looks__author-copy">\n                                <span class="watchface-looks__author-name">\n                                    {{ look.authorName }}\n                                </span>\n                                <span class="watchface-looks__author-time">\n                                    {{ look.formattedCreatedAt }}\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class="watchface-looks__overlay watchface-looks__overlay--bottom">\n                        <div class="watchface-looks__likes">\n                            <i class="glyphicon glyphicon-heart"></i>\n                            <span>\n                                {{ look.likeCount }}\n                                {{ look.likeCount === 1 ? \'Like\' : \'Likes\' }}\n                            </span>\n                        </div>\n                    </div>\n                </a>\n            </div>\n\n            <br/>\n        </div>\n\n        <div ng-if="watchfaces && watchfaces.length" class="section-list">\n            <br/>\n            <div class="section-header">\n                <h2 class="section-name">Other Faces by {{watchface.artist}}</h2>\n            </div>\n            <div id="watchface-list" class="row" ng-include="\'/html/watchfaces.partial.html\'"></div>\n            <br/>\n        </div>\n\n        <hr ng-show="watchface && !page.isMobile()"/>\n        <div ng-show="watchface" class="section-list">\n            <div class="section-header">\n                <h2 class="section-name">\n                    Comments\n                    <span class="watchface-comments-count" ng-if="watchface.commentsCount || watchface.commentsCount === 0">\n                        ({{ watchface.commentsCount }})\n                    </span>\n                </h2>\n            </div>\n            <watchface-comments watchface="watchface"></watchface-comments>\n        </div>\n    </div>\n</div>\n')}]),e.exports=n},31503:e=>{var n="/html/watchfaces-admin.partial.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-repeat="watchface in watchfaces" class="{{watchfaceColumnSize && (\'col-md-\' + watchfaceColumnSize) || \'col-md-3\'}} col-sm-4 admin-watchface-wrapper">\n    <div id="watch_thumb" class="{{(watchface.get(\'preview_type\')||watchface.get(\'watch_type\'))|watchClass}}">\n        <a ng-href="watchface/{{watchface.id}}"><img id="watchface" class="active" ng-src="{{watchface.get(\'preview\') && (watchface.get(\'preview\').url()|https)}}"/></a>\n\n        <div ng-if="watchface.get(\'editor_version\') || watchface.get(\'legacy_migrated\')" class="text-left text-muted watchface-meta-info">\n            <a ng-if="watchface.get(\'adminIgnore\')" class="watchface-meta-label" target="_blank">\n                NOINDEX\n            </a>\n            <a ng-if="watchface.get(\'googleIoContest\')" class="watchface-meta-label io-blue" target="_blank">GOOGLE IO</a>\n            <a ng-if="watchface.get(\'user\') && watchface.get(\'user\').get(\'premiumDesigner\')" ng-href="user/{{watchface.get(\'user\').id}}" class="watchface-meta-label green" target="_blank">PREMIUM DESIGNER</a>\n            <a ng-if="watchface.get(\'file\') && (watchface.get(\'status\') == \'live\' || watchface.get(\'status\') == \'active\' || watchface.get(\'status\') == \'featured\')" ng-href="watchface/{{watchface.id}}" class="watchface-meta-label blue" target="_blank">LIVE VERSION</a>\n            <div class="watchface-meta-label" ng-style="{\'background-color\': (watchface.get(\'userUpdatedAt\')|timeInQueueColor)}">\n                <span ng-if="watchface.get(\'userUpdatedAt\')">{{ watchface.get(\'userUpdatedAt\')|timeAgo }}<br/></span>\n                Editor<br/>\n                {{watchface.get(\'editor_version\')}}<br/>\n                <span ng-if="watchface.get(\'legacy_migrated\')">MIGRATED</span>\n            </div>\n        </div>\n    </div>\n\n    <a ng-href="watchface/{{watchface.id}}">\n        <div class="watchface-thumb-title">{{watchface.get(\'title\')}}</div>\n        <ul class="watchface-thumb-features" feature-list>\n            \x3c!-- <li ng-if="watchface.get(\'platform_type\')!==\'ios\'">\n            \t<img title="Designed for Android Wear" class="feature-icon" ng-src="{{facerStaticAssetUrl(\'/img/features/android12.png\')}}"/>\n            </li>\n            <li ng-if="watchface.get(\'platform_type\')==\'ios\'">\n            \t<img title="Designed for Apple Watch" class="feature-icon" ng-src="{{facerStaticAssetUrl(\'/img/features/apple.png\')}}"/>\n            </li> --\x3e\n            <li ng-hide="feature.deprecated" ng-repeat="feature in features|orderBy:\'i\'">\n                <i title="{{feature.name}}" class="{{feature.icon}}"></i>\n            </li>\n        </ul>\n    </a>\n\n    <div ng-if="!watchface.loading && canIndexWatchface(watchface)" class="text-center">\n        <button title="Index & Mark as Feature Candidate" ng-click="indexWatchface(watchface, false, true)" class="btn btn-success btn-sm">\n            <i class="icon-checkmark"></i>\n            <i class="icon-star"></i>\n        </button>\n        <button title="Index" ng-click="indexWatchface(watchface)" class="btn btn-success btn-sm">\n            <i class="icon-checkmark"></i>\n        </button>\n        <button title="Ignore" ng-click="indexWatchface(watchface, true)" class="btn btn-danger btn-sm">\n            <i class="icon-close"></i>\n        </button>\n    </div>\n    <div ng-if="watchface.loading">\n        <button class="btn btn-link" disabled="disabled">Loading...</button>\n    </div>\n</div>\n')}]),e.exports=n},65861:e=>{var n="/html/watchfaces.partial.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div ng-show="watchfaces" class="watchfaces-wrapper">\n    <div class="watchfaces-inner-wrapper" ng-show="!showAdminTools()">\n        <div ng-repeat="watchface in watchfaces track by watchface.uid" class="{{watchfaceColumnSize && (\'col-md-\' + watchfaceColumnSize) || \'col-md-2-4 col-md-lg-3\'}} col-sm-4 {{watchfaceXsColumnSize && (\'col-xs-\' + watchfaceXsColumnSize) || \'col-xs-6\'}} watchface-wrapper">\n            <watchface watchface-id="watchface" type="list" search-query="search" search-ranking="$index + 1"></watchface>\n        </div>\n    </div>\n    <div class="watchfaces-inner-wrapper" ng-if="showAdminTools()">\n        <watchface-list watchfaces="watchfaces" type="review"></watchface-list>\n    </div>\n</div>\n<loader ng-if="loading"></loader>\n')}]),e.exports=n},8460:e=>{var n="/html/comment-list.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper editor-modal comment-modal" no-scroll>\n\t<div class="facer-modal-content">\n\t\t<h4 class="facer-modal-title">\n\t\t\tComment List\n\t\t\t<div class="header-close-button" ng-click="close(false)">\n\t\t\t\t<i class="icon-close"></i>\n\t\t\t</div>\n\t\t</h4>\n\t\t<div class="facer-modal-body-wrapper">\n\t\t\t<div class="facer-modal-image">\n\t\t\t\t<a target="_blank" ui-sref="facer.watchface({watchface:preview.id})" class="watch-container {{preview.watch}}">\n\t\t            <div class="watch-background"></div>\n\t\t            <div class="watch-inner-container">\n\t\t                <div class="watchface-image" ng-style="{\'background-image\': \'url(\' + preview.image + \')\'}"></div>\n\t\t            </div>\n\t\t        </a>\n\t\t\t</div>\n\n\t\t\t<div class="facer-modal-body">\n\t\t\t\t<div class="comment-list" text-scroll="#2BADE3">\n\t\t\t\t\t<div ng-repeat="comment in comments" class="comment">\n\t\t\t\t\t\t<div class="user">\n\t\t\t\t\t\t\t<img ng-src="{{comment.author.avatar}}" width="24"/>\n\t\t\t\t\t\t\t<a target="_blank" user-profile-link="comment.author">\n\t\t\t\t\t\t\t\t<span class="author-name">{{comment.author.name}}</span> - {{comment.date}}\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div ng-if="comment.attachment" class="comment-image" text-scroll="#2BADE3">\n\t\t\t\t\t\t\t<img ng-src="{{comment.attachment.image}}"/>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class="comment-text" ellipsis="150">\n\t\t\t\t\t\t\t"{{comment.displayText || comment.text}}"\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="facer-modal-form">\n\t\t\t\t\t\t\t<div class="submit-btn-wrapper">\n\t\t\t\t\t\t\t\t<div ng-if="!comment.hasReplied" class="btn btn-md btn-primary" ng-click="close({result: true, input:comment})">\n\t\t\t\t\t\t\t\t\tReply\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div ng-if="comment.hasReplied" class="btn btn-md btn-link disabled" ng-disabled>\n\t\t\t\t\t\t\t\t\t<i class="icon-checkmark"></i> Replied\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div ng-click="close(false)" class="facer-modal-backdrop"></div>\n</div>')}]),e.exports=n},23138:e=>{var n="/html/edit-script-modal.html";window.angular.module("facer.templates").run(["$templateCache",function(e){e.put(n,'<div class="facer-modal-wrapper editor-modal edit-script-modal template-select-modal">\n    <div class="facer-modal-content">\n        <h4 class="facer-modal-title facer-modal-title-flex">\n            <div class="header-title">{{title}}</div>\n            <div class="header-options">\n                \n            </div>\n            <div class="header-close-button" ng-click="close(false)">\n                <i class="icon-close"></i>\n            </div>\n        </h4>\n\n        <div class="facer-modal-body-wrapper">\n            <div class="facer-modal-body">\n                <form class="facer-modal-form" ng-submit="close(scriptString)">\n                    <div>\n                        <script-editor></script-editor>\n                    </div>\n                    <div class="submit-btn-wrapper">\n                        <button type="submit" class="btn btn-md btn-primary">\n                            Save\n                        </button>\n                        <button ng-if="cancelable" ng-click="close(false)" class="btn btn-default">\n                            {{cancelMessage || \'Cancel\'}}\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},31853:e=>{var n="/html/publish-modal.html";windo