atchfaceHref }}" aria-label="Open watch face {{ look.watchfaceTitle }}">\n                    <div class="looks-detail__watchface-preview">\n                        <img class="looks-detail__watchface-preview-image" ng-if="look.watchfacePreviewUrl" ng-src="{{ look.watchfacePreviewUrl }}" alt="{{ look.watchfaceTitle }}"/>\n                        <div class="looks-detail__watchface-preview-placeholder" ng-if="!look.watchfacePreviewUrl">\n                            {{ look.watchfaceTitle.charAt(0) }}\n                        </div>\n                    </div>\n\n                    <div class="looks-detail__watchface-copy">\n                        <h1 class="looks-detail__watchface-title">\n                            {{ look.watchfaceTitle }}\n                        </h1>\n                        <div class="looks-detail__watchface-author" ng-if="look.watchfaceAuthorName">\n                            <img class="looks-detail__watchface-author-avatar" ng-if="look.watchfaceAuthorAvatarUrl" ng-src="{{ look.watchfaceAuthorAvatarUrl }}" alt="{{ look.watchfaceAuthorName }}"/>\n                            <div class="looks-detail__watchface-author-avatar looks-detail__watchface-author-avatar--placeholder" ng-if="!look.watchfaceAuthorAvatarUrl">\n                                {{ look.watchfaceAuthorName.charAt(0) }}\n                            </div>\n\n                            <span class="looks-detail__watchface-author-name">\n                                By {{ look.watchfaceAuthorName }}\n                            </span>\n                        </div>\n                        <span class="looks-detail__watchface-device">On {{ look.deviceName }}</span>\n                    </div>\n\n                    <i class="icon-chevron-right looks-detail__watchface-arrow"></i>\n                </a>\n            </div>\n\n            <div class="looks-detail__likes">\n                <div class="looks-detail__engagement-item">\n                    <button class="looks