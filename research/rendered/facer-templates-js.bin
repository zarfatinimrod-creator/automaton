eator-pro-logo-small.png?v=1\')}}"/>\n            </a>\n            <a ng-if="!isCreatorPartner() && publishMode.enabled" id="logo" ng-click="close(parseWatchface && parseWatchface.id, {}, true)">\n                <img ng-if="!isCreatorPro()" ng-src="{{facerStaticAssetUrl(\'/img/facer-creator-logo-small.png?v=1\')}}"/>\n                <img ng-if="isCreatorPro()" ng-src="{{facerStaticAssetUrl(\'/img/facer-creator-pro-logo-small.png?v=1\')}}"/>\n            </a>\n            <a ng-if="isCreatorPartner() && !publishMode.enabled" id="logo" ui-sref="facer.editor(localeStateParams)">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/facer-creator-partner-logo-small.png?v=1\')}}"/>\n            </a>\n            <a ng-if="isCreatorPartner() && publishMode.enabled" id="logo" ng-click="close(parseWatchface && parseWatchface.id, {}, true)">\n                <img ng-src="{{facerStaticAssetUrl(\'/img/facer-creator-partner-logo-small.png?v=1\')}}"/>\n            </a>\n\n        </div>\n\n\n        <div class="nav-section nav-section-center">\n            <div ng-if="!browsingMode && !publishMode.enabled && !loading" id="watchfaceTitle" class="list-input" tooltip title="Rename" data-placement="bottom" data-trigger="hover">\n                <input id="watchfaceListTitle" type="text" maxlength="30" ng-model="editor.face.description.title" placeholder="Name your watchface..." autocomplete="false" blur-on-enter save-on-enter/>\n            </div>\n        </div>\n\n\n        <div id="menu" class="nav-section nav-section-right">\n            <div ng-include="\'/html/watchface-edit-toolbar.partial.html\'"></div>\n\n            <comment-feed></comment-feed>\n\n            <notification-feed></notification-feed>\n\n            <editor-support></editor-support>\n\n            <current-user></current-user>\n        </div>\n    </header>\n</div>\n')}]),e.exports=n},1814:e=>{var n="/html/editor-insights.partial.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div class="editor-insights">\n\t<div class="editor-insights-master" ng-class="{\'loading\': loading}">\n\t\t<div ng-show="!loading">\n\t\t\t<div class="insight-item" ng-class="{\'insight-item-selected\': isSelected(user)}" ng-click="select(user)">\n\t\t\t\t<div class="insight-item-preview">\n\t\t\t\t\t<img class="insight-item-preview-image" ng-src="{{user.preview}}">\n\t\t\t\t</div>\n\t\t\t\t<div class="insight-item-label">\n\t\t\t\t\t<div class="insight-item-label-primary">{{user.name}}</div>\n\t\t\t\t\t<a ng-show="user.rank > 0" class="insight-item-label-secondary">\n\t\t\t\t\t\t#{{user.rank}} in Top Designers\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div class="insight-item-right-label">\n\t\t\t\t\t<span>{{getItemLabel(user)}}</span>\n\t\t\t\t\t<i ng-show="getItemIcon(user)" class="{{getItemIcon(user)}}"></i>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class="insights-section-header">\n\t\t\t\tWATCHFACES\n\t\t\t\t<span class="sort-option" ng-click="sortBy(\'name\')" ng-class="{\'selected\': sortOptionIsSelected(\'name\')}">\n\t\t\t\t\tName\n\t\t\t\t\t<span ng-class="{\'dropup\': !sortOptionIsDescending(\'name\')}">\n\t\t\t\t\t\t<span class="caret"></span>\n\t\t\t\t\t</span>\n\t\t\t\t</span>\n\t\t\t\t<span class="sort-option" ng-click="sortBy(\'stats.values.syncCount.aggregate.value\')" ng-class="{\'selected\': sortOptionIsSelected(\'stats.values.syncCount.aggregate.value\')}">\n\t\t\t\t\tSyncs\n\t\t\t\t\t<span ng-class="{\'dropup\': !sortOptionIsDescending(\'stats.values.syncCount.aggregate.value\')}">\n\t\t\t\t\t\t<span class="caret"></span>\n\t\t\t\t\t</span>\n\t\t\t\t</span>\n\t\t\t\t<span ng-show="isPremiumDesigner()" class="sort-option" ng-click="sortBy(\'stats.values.estimatedNetRevenue.aggregate.value\')" ng-class="{\'selected\': sortOptionIsSelected(\'stats.values.estimatedNetRevenue.aggregate.value\')}">\n\t\t\t\t\tNet Rev.\n\t\t\t\t\t<span ng-class="{\'dropup\': !sortOptionIsDescending(\'stats.values.estimatedNetRevenue.aggregate.value\