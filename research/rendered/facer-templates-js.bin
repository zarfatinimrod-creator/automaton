 (googleIoMode || !style.googleIo)">\n            {{style.label}}<br>\n        </h5>\n    </div>\n\n    <div ng-if="isImageSequenceWidget()" class="style-list">\n        <div class="add-image list-group">\n            <i class="icon-plus"></i>\n            <input id="imageUpload" type="file" upload-image="both" layer-type="sequence" title="Add image to sequence" max-error="Image sequence can have up to {{imageSequenceMax}} images" max="{{imageSequenceMax - getImageSequnceLength(editor.selectedElement)}}" accepted-types="gif,jpg,jpeg,png" multiple="multiple"/>\n        </div>\n        <div class="list-group" ng-repeat="image in getImageSequence(editor.selectedElement)" ng-class="{\'active\': isCurrentImageInSequence(image)}">\n            <a href class="list-group-item" style="background-image:url(\'{{editor.face.images[image.hash_round].data}}\');">\n            </a>\n            <div class="active-border"></div>\n            <div class="item-controls">\n                <div class="item-controls-remove" ng-click="removeImageFromSequence(image)">\n                    <i class="icon-close"></i>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>')}]),e.exports=n},58018:e=>{var n="/html/progress-bar-toolbar.component.html";window.angular.module("facer.editor").run(["$templateCache",function(e){e.put(n,'<div ng-if="editor.selectedElement && editor.selectedElement.type_opt==\'progress_bar\'" class="btn-toolbar">\n\t<div class="btn-group btn-set">\n        <button class="btn btn-default" ng-click="editor.selectedElement.progress_bar_type=\'donut\';editor.selectedElement.shape_type=0;updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.progress_bar_type==\'donut\'}">\n            Circular\n        </button>\n        <button class="btn btn-default" ng-click="editor.selectedElement.progress_bar_type=\'bar\';editor.selectedElement.shape_type=1;updateSelectedElement(true)" ng-class="{\'active\': editor.selectedElement.progress_