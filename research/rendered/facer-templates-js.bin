ror\': !loading && errorMessage,\n        \'looks-detail--modal\': isModalMode(),\n        \'looks-detail--standalone\': !isModalMode() && look\n    }">\n    <div class="looks-detail__container">\n        <div class="looks-detail__state" ng-if="loading">\n            <loader></loader>\n            <p>Loading Look...</p>\n        </div>\n\n        <div class="looks-detail__state" ng-if="!loading && errorMessage">\n            <h1>Looks detail unavailable</h1>\n            <p>{{ errorMessage }}</p>\n        </div>\n\n        <article class="looks-detail__card" ng-if="!loading && look">\n            <div class="looks-detail__hero" ng-dblclick="likeFromDoubleClick($event)">\n                <div class="looks-media-protection" ng-class="{\n                        \'looks-media-protection--interactive\':\n                            !isModalMode() && look.media.isAnimated\n                    }">\n                    <img class="looks-media-protection__media looks-detail__media" ng-if="mediaReady && !look.media.isAnimated" ng-src="{{ look.media.url }}" alt="{{ look.watchfaceTitle }}" draggable="false"/>\n\n                    <video class="looks-media-protection__media looks-detail__media" ng-if="mediaReady && look.media.isAnimated" autoplay muted loop playsinline ng-attr-preload="{{\n                            !isModalMode() ? \'metadata\' : undefined\n                        }}" ng-attr-controls="{{\n                            !isModalMode() ? \'controls\' : undefined\n                        }}" disablepictureinpicture disableremoteplayback controlslist="nodownload noplaybackrate noremoteplayback" ng-attr-poster="{{ look.media.posterUrl }}" aria-label="Video of {{ look.authorName }} wearing {{\n                            look.watchfaceTitle\n                        }} on {{ look.deviceName }}">\n                        <source video-src="{{ look.media.url }}" type="video/mp4"/>\n                    </video>\n\n                    <div class="looks-media-protection__